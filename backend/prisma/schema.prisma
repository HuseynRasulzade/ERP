  newStaffingPositionId String? @map("new_staffing_position_id")
  newBranchId     String?  @map("new_branch_id")
  newManagerEmploymentId String? @map("new_manager_employment_id")
  newLocationId   String?  @map("new_location_id")
  newFte          Decimal? @map("new_fte") @db.Decimal(5, 4)
  newWorkScheduleId String? @map("new_work_schedule_id")
