model FinancialReportingFramework {
  id           String  @id @default(uuid())
  tenantId     String  @map("tenant_id")
  code         String
  name         String
  frameworkType String @map("framework_type") // INTERNAL_ACCOUNTING|IFRS_STYLE|LOCAL_STATUTORY|MANAGEMENT_FINANCIAL|CUSTOM
