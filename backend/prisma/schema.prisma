  tenant   Tenant           @relation(fields: [tenantId], references: [id])
  run      FXRevaluationRun @relation(fields: [runId], references: [id])
  currency Currency         @relation(fields: [currencyId], references: [id])

  @@index([tenantId, runId, sourceType])
}

model PeriodAccrual {
  id                        String    @id @default(uuid())
  tenantId                  String    @map("tenant_id")
  organizationId            String    @map("organization_id")
  financialPeriodId         String    @map("financial_period_id")
  accrualType               String    @map("accrual_type") // EXPENSE_ACCRUAL|REVENUE_ACCRUAL|PAYROLL_ACCRUAL|INTEREST_ACCRUAL|UTILITIES_ACCRUAL|SERVICE_ACCRUAL|OTHER
  category                  String?
  counterpartyId            String?   @map("counterparty_id")
  contractId                String?   @map("contract_id")
  costCenterId              String?   @map("cost_center_id")
  projectId                 String?   @map("project_id")
  amount                    Decimal   @db.Decimal(18, 6)
  currencyId                String    @map("currency_id")
  basis                     String?
  reversalPolicy            String    @default("AUTO_REVERSE_NEXT_PERIOD") @map("reversal_policy") // AUTO_REVERSE_NEXT_PERIOD|CLEAR_AGAINST_ACTUAL|MANUAL|NO_REVERSAL
  estimateSource            String?   @map("estimate_source")
  status                    String    @default("DRAFT") // DRAFT|POSTED|REVERSED|MATCHED
  journalEntryId            String?   @map("journal_entry_id")
  reversalJournalEntryId    String?   @map("reversal_journal_entry_id")
  matchedActualDocumentType String?   @map("matched_actual_document_type")
  matchedActualDocumentId   String?   @map("matched_actual_document_id")
  matchedVariance           Decimal?  @map("matched_variance") @db.Decimal(18, 6)

