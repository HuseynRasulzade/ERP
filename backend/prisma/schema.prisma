model FinancialReportingFrameworkVersion {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  frameworkId   String    @map("framework_id")
  version       Int
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  status        String    @default("DRAFT") // DRAFT|ACTIVE|RETIRED
  approvedBy    String?   @map("approved_by")
  approvedAt    DateTime? @map("approved_at")
  description   String?

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant    Tenant                      @relation(fields: [tenantId], references: [id])
  framework FinancialReportingFramework @relation(fields: [frameworkId], references: [id])

  statementVersions FinancialStatementVersion[]
  mappings          FinancialReportMapping[]
  reportRuns        FinancialReportRun[]
  translationRules  FinancialTranslationRule[]

  @@unique([tenantId, frameworkId, version])
}

model FinancialStatementDefinition {
  id            String  @id @default(uuid())
  tenantId      String  @map("tenant_id")
  code          String
  name          String
  statementType String  @map("statement_type") // TRIAL_BALANCE|BALANCE_SHEET|PROFIT_AND_LOSS|CASH_FLOW|CHANGES_IN_EQUITY|SUPPORTING_SCHEDULE|CUSTOM_FINANCIAL_REPORT
  active        Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant   Tenant                      @relation(fields: [tenantId], references: [id])
  versions FinancialStatementVersion[]
  reportRuns FinancialReportRun[]

  @@unique([tenantId, code])
}

model FinancialStatementVersion {
  id                     String    @id @default(uuid())
  tenantId               String    @map("tenant_id")
  statementDefinitionId  String    @map("statement_definition_id")
  frameworkVersionId     String?   @map("framework_version_id")
  version                Int
  effectiveFrom          DateTime  @map("effective_from") @db.Date
  effectiveTo            DateTime? @map("effective_to") @db.Date
  status                 String    @default("DRAFT") // DRAFT|ACTIVE|RETIRED

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant               Tenant                       @relation(fields: [tenantId], references: [id])
  statementDefinition  FinancialStatementDefinition @relation(fields: [statementDefinitionId], references: [id])
  frameworkVersion     FinancialReportingFrameworkVersion? @relation(fields: [frameworkVersionId], references: [id])

  rows       FinancialReportRowDefinition[]
  mappings   FinancialReportMapping[]
  layouts    FinancialReportLayout[]
  reportRuns FinancialReportRun[]
  notes      FinancialStatementNote[]

  @@unique([tenantId, statementDefinitionId, version])
}

model FinancialReportRowDefinition {
  id                  String  @id @default(uuid())
  tenantId            String  @map("tenant_id")
  statementVersionId  String  @map("statement_version_id")
  rowCode             String  @map("row_code")
  parentRowId         String? @map("parent_row_id")
  label               String
  rowType             String  @default("DATA") @map("row_type") // DATA|FORMULA|SUBTOTAL|HEADER|TEXT|SEPARATOR|CALCULATED_RATIO|NOTE_REFERENCE
  sequence            Int     @default(0)
  level               Int     @default(0)
  signPolicy          String  @default("AS_IS") @map("sign_policy") // AS_IS|FLIP
  formula             String? // e.g. "REVENUE - COST_OF_SALES" referencing other row codes
  mappingGroup        String? @map("mapping_group")
  displayZeroPolicy   String  @default("SHOW") @map("display_zero_policy") // SHOW|HIDE_IF_ALL_PERIODS_ZERO|ALWAYS_SHOW_REQUIRED|HIDE_DETAIL_KEEP_SUBTOTAL
  drilldownEnabled    Boolean @default(true) @map("drilldown_enabled")
  notesReference      String? @map("notes_reference")

  tenant           Tenant                        @relation(fields: [tenantId], references: [id])
  statementVersion FinancialStatementVersion     @relation(fields: [statementVersionId], references: [id])
  parentRow        FinancialReportRowDefinition? @relation("RowHierarchy", fields: [parentRowId], references: [id])
  childRows        FinancialReportRowDefinition[] @relation("RowHierarchy")
  mappings         FinancialReportMapping[]

  @@unique([statementVersionId, rowCode])
}

model FinancialReportMapping {
  id                  String    @id @default(uuid())
  tenantId            String    @map("tenant_id")
  frameworkVersionId  String    @map("framework_version_id")
  statementVersionId  String    @map("statement_version_id")
  reportRowId         String    @map("report_row_id")
  strategy            String    @default("EXACT_ACCOUNT") // EXACT_ACCOUNT|ACCOUNT_TREE|ACCOUNT_RANGE|ACCOUNT_TAG|DIMENSION_FILTER|FORMULA|EXCLUSION
  accountId           String?   @map("account_id")
  accountCodeFrom     String?   @map("account_code_from")
  accountCodeTo       String?   @map("account_code_to")
  accountTag          String?   @map("account_tag")
  dimensionFilter     Json?     @map("dimension_filter")
  organizationId      String?   @map("organization_id")
  balanceSide         String?   @map("balance_side") // DEBIT|CREDIT|NET
  movementType        String    @default("BALANCE") @map("movement_type") // BALANCE|PERIOD_MOVEMENT
  signMultiplier      Int       @default(1) @map("sign_multiplier")
  effectiveFrom       DateTime  @map("effective_from") @db.Date
  effectiveTo         DateTime? @map("effective_to") @db.Date
  mappingPriority     Int       @default(100) @map("mapping_priority")
  status              String    @default("ACTIVE") // ACTIVE|INACTIVE

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  approvedBy String? @map("approved_by")
  approvedAt DateTime? @map("approved_at")

  tenant           Tenant                             @relation(fields: [tenantId], references: [id])
  frameworkVersion FinancialReportingFrameworkVersion  @relation(fields: [frameworkVersionId], references: [id])
  statementVersion FinancialStatementVersion           @relation(fields: [statementVersionId], references: [id])
  reportRow        FinancialReportRowDefinition        @relation(fields: [reportRowId], references: [id])
  account          Account?                            @relation(fields: [accountId], references: [id])

  @@index([tenantId, statementVersionId, status])
  @@index([tenantId, accountId])
}

model FinancialReportLayout {
  id                  String  @id @default(uuid())
  tenantId            String  @map("tenant_id")
  statementVersionId  String  @map("statement_version_id")
  code                String
  name                String
  config              Json    // columns/labels/indentation/hide-zero/page sections/signature blocks
  status              String  @default("DRAFT") // DRAFT|PUBLISHED|RETIRED
  version             Int     @default(1)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant           Tenant                    @relation(fields: [tenantId], references: [id])
  statementVersion FinancialStatementVersion @relation(fields: [statementVersionId], references: [id])

  @@unique([tenantId, statementVersionId, code, version])
}

model FinancialReportRun {
  id                     String    @id @default(uuid())
  tenantId               String    @map("tenant_id")
  organizationId         String    @map("organization_id")
  statementDefinitionId  String    @map("statement_definition_id")
  statementVersionId     String    @map("statement_version_id")
  frameworkVersionId     String    @map("framework_version_id")
  financialPeriodId      String?   @map("financial_period_id") // Phase 22 FinancialPeriod
  closeRunId             String?   @map("close_run_id") // Phase 22 PeriodCloseRun — close-version awareness
  asOfDate               DateTime? @map("as_of_date") @db.Date
  periodStart            DateTime? @map("period_start") @db.Date
  periodEnd              DateTime? @map("period_end") @db.Date
  reportingCurrencyId    String    @map("reporting_currency_id")
  comparativePeriods     Json?     @map("comparative_periods")
  runType                String    @default("PREVIEW") @map("run_type") // PREVIEW|MANAGEMENT_PREVIEW|CLOSED_PERIOD|FINAL|RESTATED
  status                 String    @default("CREATED") // CREATED|CALCULATING|CALCULATED|VALIDATION_WARNING|VALIDATION_ERROR|REVIEWED|APPROVED|FINAL|SIGNED|SUPERSEDED
  calculationVersion     Int       @default(1) @map("calculation_version")
  supersedesRunId        String?   @map("supersedes_run_id")
  restatementReason      String?   @map("restatement_reason")
  generatedBy            String    @map("generated_by")
  generatedAt            DateTime  @default(now()) @map("generated_at")
  reviewedBy             String?   @map("reviewed_by")
  approvedBy             String?   @map("approved_by")
  finalizedBy            String?   @map("finalized_by")
  finalizedAt            DateTime? @map("finalized_at")

  tenant              Tenant                             @relation(fields: [tenantId], references: [id])
  organization        Organization                       @relation(fields: [organizationId], references: [id])
  statementDefinition FinancialStatementDefinition        @relation(fields: [statementDefinitionId], references: [id])
  statementVersion    FinancialStatementVersion           @relation(fields: [statementVersionId], references: [id])
  frameworkVersion    FinancialReportingFrameworkVersion  @relation(fields: [frameworkVersionId], references: [id])
  reportingCurrency   Currency                            @relation(fields: [reportingCurrencyId], references: [id])

  cells               FinancialReportCell[]
  validationResults   FinancialReportValidationResult[]
  notes               FinancialStatementNote[]
  signatures          FinancialReportSignature[]

  @@index([tenantId, organizationId, statementDefinitionId, status])
}

model FinancialReportCell {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  reportRunId    String   @map("report_run_id")
  rowCode        String   @map("row_code")
  columnCode     String   @map("column_code") // CURRENT|PRIOR_PERIOD|CURRENT_YTD|PRIOR_YTD|VARIANCE|VARIANCE_PCT
  amount         Decimal  @db.Decimal(18, 2)
  originalAmount Decimal? @map("original_amount") @db.Decimal(18, 2) // pre-translation, if a translation was applied
  currencyId     String   @map("currency_id")
  sourceCount    Int?     @map("source_count") // number of GL movements aggregated into this cell
  calculatedAt   DateTime @default(now()) @map("calculated_at")

  tenant    Tenant             @relation(fields: [tenantId], references: [id])
  reportRun FinancialReportRun @relation(fields: [reportRunId], references: [id])
  currency  Currency           @relation(fields: [currencyId], references: [id])

  @@unique([reportRunId, rowCode, columnCode])
  @@index([tenantId, reportRunId])
}

model FinancialReportValidationRule {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  ruleCode      String    @map("rule_code")
  statementType String?   @map("statement_type")
  description   String
  formula       String?
  tolerance     Decimal   @default(0.01) @map("tolerance") @db.Decimal(18, 6)
  severity      String    @default("BLOCKING")
  blocking      Boolean   @default(true)
  effectiveFrom DateTime  @default(now()) @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  tenant  Tenant                             @relation(fields: [tenantId], references: [id])
  results FinancialReportValidationResult[]

  @@unique([tenantId, ruleCode])
}

model FinancialReportValidationResult {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  reportRunId String   @map("report_run_id")
  ruleId      String   @map("rule_id")
  status      String   @default("PASS") // PASS|WARNING|FAIL|BLOCKING
  detail      Json?

  createdAt DateTime @default(now()) @map("created_at")

  tenant    Tenant                          @relation(fields: [tenantId], references: [id])
  reportRun FinancialReportRun              @relation(fields: [reportRunId], references: [id])
  rule      FinancialReportValidationRule   @relation(fields: [ruleId], references: [id])

  @@index([tenantId, reportRunId, status])
}

model CashFlowCategory {
  id                 String  @id @default(uuid())
  tenantId           String  @map("tenant_id")
  code               String
  name               String
  parentCategoryId   String? @map("parent_category_id")
  classification     String  @map("classification") // OPERATING|INVESTING|FINANCING

  tenant         Tenant             @relation(fields: [tenantId], references: [id])
  parentCategory CashFlowCategory?  @relation("CashFlowCategoryHierarchy", fields: [parentCategoryId], references: [id])
  childCategories CashFlowCategory[] @relation("CashFlowCategoryHierarchy")
  mappingRules   CashFlowMappingRule[]

  @@unique([tenantId, code])
}

model CashFlowMappingRule {
  id                   String    @id @default(uuid())
  tenantId             String    @map("tenant_id")
  sourceOperationType  String?   @map("source_operation_type")
  bankCashAccountId    String?   @map("bank_cash_account_id")
  counterAccountId     String?   @map("counter_account_id")
  documentType         String?   @map("document_type")
  counterpartyCategory String?   @map("counterparty_category")
  cashFlowCategoryId   String    @map("cash_flow_category_id")
  priority             Int       @default(100)
  isInternalTransfer   Boolean   @default(false) @map("is_internal_transfer") // excluded from external Cash Flow (spec section 44)
  effectiveFrom        DateTime  @default(now()) @map("effective_from") @db.Date
  effectiveTo          DateTime? @map("effective_to") @db.Date

  tenant           Tenant           @relation(fields: [tenantId], references: [id])
  cashFlowCategory CashFlowCategory @relation(fields: [cashFlowCategoryId], references: [id])

  @@index([tenantId, sourceOperationType])
}

model EquityComponent {
  id                  String  @id @default(uuid())
  tenantId            String  @map("tenant_id")
  code                String
  name                String
  componentType       String  @map("component_type") // SHARE_CAPITAL|ADDITIONAL_CAPITAL|RETAINED_EARNINGS|CURRENT_YEAR_RESULT|REVALUATION_RESERVE|OTHER_RESERVE
  accountMappingKey   String? @map("account_mapping_key") // resolved via AccountingMappingService

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
}

model FinancialTranslationRule {
  id                  String    @id @default(uuid())
  tenantId            String    @map("tenant_id")
  frameworkVersionId  String?   @map("framework_version_id")
  reportRowCode       String?   @map("report_row_code")
  accountCategory     String?   @map("account_category") // e.g. AccountClass value, when not row-specific
  translationMethod   String    @map("translation_method") // CLOSING_RATE|PERIOD_AVERAGE_RATE|HISTORICAL_RATE|TRANSACTION_RATE|NO_TRANSLATION
  rateType            String    @default("OFFICIAL") @map("rate_type")
  effectiveFrom       DateTime  @default(now()) @map("effective_from") @db.Date
  effectiveTo         DateTime? @map("effective_to") @db.Date

  tenant           Tenant                              @relation(fields: [tenantId], references: [id])
  frameworkVersion FinancialReportingFrameworkVersion? @relation(fields: [frameworkVersionId], references: [id])

  @@index([tenantId, reportRowCode])
}

model FinancialStatementNote {
  id                  String  @id @default(uuid())
  tenantId            String  @map("tenant_id")
  statementVersionId  String? @map("statement_version_id")
  reportRunId         String? @map("report_run_id")
  rowCode             String? @map("row_code")
  noteNumber          String  @map("note_number")
  title               String
  body                String
  attachmentRef       String? @map("attachment_ref")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant           Tenant                     @relation(fields: [tenantId], references: [id])
  statementVersion FinancialStatementVersion? @relation(fields: [statementVersionId], references: [id])
  reportRun        FinancialReportRun?        @relation(fields: [reportRunId], references: [id])

  @@index([tenantId, reportRunId])
}

model FinancialReportSignature {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  reportRunId   String    @map("report_run_id")
  signerUserId  String    @map("signer_user_id")
  signerRole    String?   @map("signer_role")
  signedAt      DateTime  @default(now()) @map("signed_at")
  signatureType String    @default("INTERNAL_APPROVAL") @map("signature_type") // real qualified digital-signature integration is Phase 28
  reportHash    String    @map("report_hash")
  status        String    @default("ACTIVE") // ACTIVE|REVOKED

  tenant    Tenant             @relation(fields: [tenantId], references: [id])
  reportRun FinancialReportRun @relation(fields: [reportRunId], references: [id])

  @@index([tenantId, reportRunId])
}
// ============================================================
// Phase 24 — Management Reporting / KPI Engine / Profitability
// Engine / Budget-Forecast-Scenario / Dashboard Platform
// See docs/MANAGEMENT_REPORTING.md
// ============================================================

model ManagementSemanticModel {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  code     String
  name     String
  active   Boolean @default(true)

  tenant   Tenant                          @relation(fields: [tenantId], references: [id])
  versions ManagementSemanticModelVersion[]

  @@unique([tenantId, code])
}

model ManagementSemanticModelVersion {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  semanticModelId String   @map("semantic_model_id")
  version        Int
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date
  status         String    @default("DRAFT") // DRAFT|ACTIVE|RETIRED
  approvedBy     String?   @map("approved_by")
  definitionHash String?   @map("definition_hash")
  notes          String?

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant         Tenant                  @relation(fields: [tenantId], references: [id])
  semanticModel  ManagementSemanticModel @relation(fields: [semanticModelId], references: [id])
  measures       ManagementMeasureDefinition[]
  kpiDefinitions KPIDefinition[]

  @@unique([tenantId, semanticModelId, version])
}

model ManagementMeasureDefinition {
  id                String    @id @default(uuid())
  tenantId          String    @map("tenant_id")
  semanticModelVersionId String @map("semantic_model_version_id")
  code              String
  name              String
  description       String?
  sourceFact        String    @map("source_fact") // SALES|PURCHASE|INVENTORY|SETTLEMENT|CASH|EXPENSE|PAYROLL|PRODUCTION|BUDGET|FORECAST|DERIVED
  aggregationType   String    @default("SUM") @map("aggregation_type") // SUM|AVG|COUNT|LAST|FORMULA
  formula           String? // for DERIVED measures, e.g. "NET_REVENUE - COGS"
  currencyBehavior  String    @default("BASE_CURRENCY") @map("currency_behavior")
  unit              String    @default("AMOUNT") // AMOUNT|QUANTITY|DAYS|PERCENT|RATIO|COUNT
  nullBehavior      String    @default("ZERO") @map("null_behavior") // ZERO|NULL|ERROR
  signPolicy        String    @default("AS_IS") @map("sign_policy")
  measureType       String    @default("FINANCIAL") @map("measure_type") // FINANCIAL|OPERATIONAL|RATIO|STATISTICAL|FORECAST|SCENARIO
  effectiveFrom     DateTime  @default(now()) @map("effective_from") @db.Date
  effectiveTo       DateTime? @map("effective_to") @db.Date
  owner             String?
  status            String    @default("ACTIVE")

  tenant                 Tenant                         @relation(fields: [tenantId], references: [id])
  semanticModelVersion   ManagementSemanticModelVersion @relation(fields: [semanticModelVersionId], references: [id])

  @@unique([tenantId, semanticModelVersionId, code])
}

model KPIDefinition {
  id                     String    @id @default(uuid())
  tenantId               String    @map("tenant_id")
  semanticModelVersionId String    @map("semantic_model_version_id")
  code                   String
  name                   String
  category               String?
  numeratorMeasure       String    @map("numerator_measure")
  denominatorMeasure     String?   @map("denominator_measure")
  formula                String?
  unit                   String    @default("PERCENT")
  directionality         String    @default("HIGHER_IS_BETTER") // HIGHER_IS_BETTER|LOWER_IS_BETTER|TARGET_RANGE|INFORMATIONAL
  warningThreshold       Decimal?  @map("warning_threshold") @db.Decimal(18, 4)
  criticalThreshold      Decimal?  @map("critical_threshold") @db.Decimal(18, 4)
  aggregationBehavior    String    @default("PERIOD") @map("aggregation_behavior")
  effectiveFrom          DateTime  @default(now()) @map("effective_from") @db.Date
  effectiveTo            DateTime? @map("effective_to") @db.Date
  owner                  String?
  description            String?

  tenant               Tenant                         @relation(fields: [tenantId], references: [id])
  semanticModelVersion ManagementSemanticModelVersion @relation(fields: [semanticModelVersionId], references: [id])
  targets              KPITarget[]
  snapshots            KPIResultSnapshot[]

  @@unique([tenantId, semanticModelVersionId, code])
}

model KPITarget {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  kpiDefinitionId String  @map("kpi_definition_id")
  organizationId String   @map("organization_id")
  departmentId   String?  @map("department_id")
  productGroupId String?  @map("product_group_id")
  period         String // YYYY-MM
  scenario       String   @default("BUDGET")
  target         Decimal  @db.Decimal(18, 4)
  minimum        Decimal? @db.Decimal(18, 4)
  maximum        Decimal? @db.Decimal(18, 4)

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  kpi    KPIDefinition @relation(fields: [kpiDefinitionId], references: [id])

  @@unique([tenantId, kpiDefinitionId, organizationId, period, scenario])
}

model KPIResultSnapshot {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  kpiDefinitionId String  @map("kpi_definition_id")
  organizationId String   @map("organization_id")
  period         String
  dimensions     Json?
  actual         Decimal? @db.Decimal(18, 4)
  target         Decimal? @db.Decimal(18, 4)
  variance       Decimal? @db.Decimal(18, 4)
  variancePct    Decimal? @map("variance_pct") @db.Decimal(18, 4)
  semanticVersion Int     @map("semantic_version")
  sourceFreshness String? @map("source_freshness") // PRELIMINARY|FINAL
  calculatedAt   DateTime @default(now()) @map("calculated_at")

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  kpi    KPIDefinition @relation(fields: [kpiDefinitionId], references: [id])

  @@index([tenantId, kpiDefinitionId, organizationId, period])
}

model ProfitabilityLayerDefinition {
  id                  String @id @default(uuid())
  tenantId            String @map("tenant_id")
  code                String
  name                String
  sequence            Int    @default(0)
  includedCostMeasures Json  @map("included_cost_measures") // array of measure codes deducted at this layer
  allocationTreatment String @default("DIRECT_ONLY") @map("allocation_treatment") // DIRECT_ONLY|INCLUDE_ALLOCATED

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
}

model ManagementPnLDefinition {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  code     String
  name     String
  active   Boolean @default(true)

  tenant Tenant             @relation(fields: [tenantId], references: [id])
  rows   ManagementPnLRow[]

  @@unique([tenantId, code])
}

model ManagementPnLRow {
  id            String  @id @default(uuid())
  tenantId      String  @map("tenant_id")
  definitionId  String  @map("definition_id")
  rowCode       String  @map("row_code")
  label         String
  rowType       String  @default("MEASURE") // MEASURE|FORMULA|SUBTOTAL|HEADER
  measureCode   String? @map("measure_code")
  formula       String?
  sequence      Int     @default(0)
  parentRowId   String? @map("parent_row_id")

  tenant     Tenant                   @relation(fields: [tenantId], references: [id])
  definition ManagementPnLDefinition  @relation(fields: [definitionId], references: [id])
  parentRow  ManagementPnLRow?        @relation("MgmtPnlRowHierarchy", fields: [parentRowId], references: [id])
  childRows  ManagementPnLRow[]       @relation("MgmtPnlRowHierarchy")

  @@unique([definitionId, rowCode])
}

model ManagementAllocationRule {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  code           String
  name           String
  sourceMeasure  String    @map("source_measure") // or a cost-pool descriptor
  targetDimension String   @map("target_dimension") // CUSTOMER|PRODUCT|CHANNEL|PROJECT|PROFIT_CENTER
  driverMeasure  String    @map("driver_measure") // e.g. NET_REVENUE, SALES_QTY, HEADCOUNT
  scenario       String    @default("ACTUAL")
  effectiveFrom  DateTime  @default(now()) @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date
  ruleVersion    Int       @default(1) @map("rule_version")
  active         Boolean   @default(true)

  tenant Tenant                    @relation(fields: [tenantId], references: [id])
  runs   ManagementAllocationRun[]

  @@unique([tenantId, code, ruleVersion])
}

model ManagementAllocationRun {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  ruleId         String   @map("rule_id")
  organizationId String   @map("organization_id")
  period         String
  poolAmount     Decimal  @map("pool_amount") @db.Decimal(18, 2)
  status         String   @default("COMPLETED")
  runBy          String   @map("run_by")

  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant                     @relation(fields: [tenantId], references: [id])
  rule   ManagementAllocationRule   @relation(fields: [ruleId], references: [id])
  lines  ManagementAllocationLine[]

  @@unique([tenantId, ruleId, organizationId, period])
}

model ManagementAllocationLine {
  id             String  @id @default(uuid())
  tenantId       String  @map("tenant_id")
  runId          String  @map("run_id")
  targetKey      String  @map("target_key") // e.g. a customerId/productId/projectId value
  driverValue    Decimal @map("driver_value") @db.Decimal(18, 4)
  driverShare    Decimal @map("driver_share") @db.Decimal(9, 6)
  allocatedAmount Decimal @map("allocated_amount") @db.Decimal(18, 2)

  tenant Tenant                  @relation(fields: [tenantId], references: [id])
  run    ManagementAllocationRun @relation(fields: [runId], references: [id])

  @@index([tenantId, runId])
}

model BudgetVersion {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  organizationId String    @map("organization_id")
  fiscalYear     Int       @map("fiscal_year")
  version        Int
  scenario       String    @default("BUDGET")
  status         String    @default("DRAFT") // DRAFT|WORKING|SUBMITTED|APPROVED|LOCKED|SUPERSEDED
  effectiveFrom  DateTime? @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date
  approvedAt     DateTime? @map("approved_at")
  approvedBy     String?   @map("approved_by")
  baseCurrencyId String    @map("base_currency_id")
  recordVersion  Int       @default(1) @map("record_version") // optimistic-lock counter (spec section 149)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  currency     Currency     @relation(fields: [baseCurrencyId], references: [id])
  facts        BudgetFact[]

  @@unique([tenantId, organizationId, fiscalYear, version, scenario])
}

model BudgetFact {
  id            String  @id @default(uuid())
  tenantId      String  @map("tenant_id")
  budgetVersionId String @map("budget_version_id")
  period        String // YYYY-MM
  departmentId  String? @map("department_id")
  costCenterId  String? @map("cost_center_id")
  projectId     String? @map("project_id")
  productGroupId String? @map("product_group_id")
  customerId    String? @map("customer_id")
  measureCode   String  @map("measure_code")
  amount        Decimal @db.Decimal(18, 2)
  quantity      Decimal? @db.Decimal(18, 6)

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  budgetVersion BudgetVersion @relation(fields: [budgetVersionId], references: [id])

  @@index([tenantId, budgetVersionId, period, measureCode])
}

model ManagementForecastVersion {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  organizationId String    @map("organization_id")
  fiscalYear     Int       @map("fiscal_year")
  code           String // e.g. FC1, FC2
  publishedAt    DateTime? @map("published_at")
  status         String    @default("DRAFT") // DRAFT|PUBLISHED
  publishedBy    String?   @map("published_by")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  facts        ForecastFact[]

  @@unique([tenantId, organizationId, fiscalYear, code])
}

model ForecastFact {
  id                String  @id @default(uuid())
  tenantId          String  @map("tenant_id")
  forecastVersionId String  @map("forecast_version_id")
  period            String
  departmentId      String? @map("department_id")
  costCenterId      String? @map("cost_center_id")
  projectId         String? @map("project_id")
  measureCode       String  @map("measure_code")
  amount            Decimal @db.Decimal(18, 2)

  tenant          Tenant                    @relation(fields: [tenantId], references: [id])
  forecastVersion ManagementForecastVersion @relation(fields: [forecastVersionId], references: [id])

  @@index([tenantId, forecastVersionId, period, measureCode])
}

model ManagementScenario {
  id             String  @id @default(uuid())
  tenantId       String  @map("tenant_id")
  code           String
  name           String
  scenarioType   String  @default("CUSTOM") @map("scenario_type") // ACTUAL|BUDGET|FORECAST|BASE_CASE|OPTIMISTIC|PESSIMISTIC|STRESS|CUSTOM
  baseScenario   String? @map("base_scenario") // scenario code this one derives from, e.g. ACTUAL

  tenant      Tenant                 @relation(fields: [tenantId], references: [id])
  assumptions ScenarioAssumption[]
  results     ScenarioResult[]

  @@unique([tenantId, code])
}

model ScenarioAssumption {
  id           String  @id @default(uuid())
  tenantId     String  @map("tenant_id")
  scenarioId   String  @map("scenario_id")
  measureCode  String  @map("measure_code") // measure the assumption perturbs, e.g. NET_REVENUE, SALES_QTY
  adjustmentType String @default("PERCENT") @map("adjustment_type") // PERCENT|ABSOLUTE
  adjustmentValue Decimal @map("adjustment_value") @db.Decimal(18, 6)
  description  String?

  tenant   Tenant             @relation(fields: [tenantId], references: [id])
  scenario ManagementScenario @relation(fields: [scenarioId], references: [id])

  @@index([tenantId, scenarioId])
}

model ScenarioResult {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  scenarioId     String   @map("scenario_id")
  organizationId String   @map("organization_id")
  period         String
  measureCode    String   @map("measure_code")
  baseValue      Decimal  @map("base_value") @db.Decimal(18, 4)
  scenarioValue  Decimal  @map("scenario_value") @db.Decimal(18, 4)
  calculatedAt   DateTime @default(now()) @map("calculated_at")

  tenant   Tenant             @relation(fields: [tenantId], references: [id])
  scenario ManagementScenario @relation(fields: [scenarioId], references: [id])

  @@index([tenantId, scenarioId, organizationId, period])
}

model ManagementReportingSnapshot {
  id                  String   @id @default(uuid())
  tenantId            String   @map("tenant_id")
  organizationId      String   @map("organization_id")
  snapshotType        String   @default("MONTH_END") @map("snapshot_type") // DAILY|WEEKLY|MONTH_END|BOARD_PACK|FORECAST|SCENARIO
  period              String
  closeRunId          String?  @map("close_run_id")
  semanticModelVersionId String? @map("semantic_model_version_id")
  allocationRunIds    Json?    @map("allocation_run_ids")
  budgetVersionId     String?  @map("budget_version_id")
  forecastVersionId   String?  @map("forecast_version_id")
  scenarioId          String?  @map("scenario_id")
  payload             Json // frozen KPI/measure results at generation time
  status              String   @default("FINAL")
  generatedAt         DateTime @default(now()) @map("generated_at")
  generatedBy         String   @map("generated_by")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([tenantId, organizationId, snapshotType, period])
}

model ManagementDashboard {
  id                    String  @id @default(uuid())
  tenantId              String  @map("tenant_id")
  code                  String
  name                  String
  audience              String? // e.g. EXECUTIVE, SALES, FINANCE
  semanticModelVersionId String? @map("semantic_model_version_id")
  widgets               Json // array of {code, type, title, measureCode|kpiCode, dimensions, filters}
  status                String  @default("DRAFT")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
}

model ManagementAlertRule {
  id             String  @id @default(uuid())
  tenantId       String  @map("tenant_id")
  code           String
  name           String
  kpiCode        String? @map("kpi_code")
  measureCode    String? @map("measure_code")
  condition      String // e.g. "LT 15" | "GT 60" — operator + threshold, evaluated by ManagementAlertService
  severity       String  @default("WARNING") // INFO|WARNING|CRITICAL
  active         Boolean @default(true)

  tenant  Tenant                   @relation(fields: [tenantId], references: [id])
  results ManagementAlertResult[]

  @@unique([tenantId, code])
}

model ManagementAlertResult {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  ruleId         String   @map("rule_id")
  organizationId String   @map("organization_id")
  period         String
  dimensionKey   String?  @map("dimension_key")
  actualValue    Decimal  @map("actual_value") @db.Decimal(18, 4)
  severity       String
  triggeredAt    DateTime @default(now()) @map("triggered_at")

  tenant Tenant              @relation(fields: [tenantId], references: [id])
  rule   ManagementAlertRule @relation(fields: [ruleId], references: [id])

  @@index([tenantId, ruleId, organizationId, period])
}

model ManagementAdjustment {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  organizationId String   @map("organization_id")
  period         String
  measureCode    String   @map("measure_code")
  dimensionKey   String?  @map("dimension_key")
  amount         Decimal  @db.Decimal(18, 2)
  reason         String
  approvedBy     String?  @map("approved_by")
  createdBy      String   @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([tenantId, organizationId, period, measureCode])
}
// ============================================================
// Phase 26 — Workflow / Approval Engine
// See docs/WORKFLOW_ENGINE.md
// ============================================================

model WorkflowDefinition {
  id                 String  @id @default(uuid())
  tenantId           String  @map("tenant_id")
  code               String
  name               String
  businessObjectType String  @map("business_object_type")
  actionType         String  @map("action_type") // POST|PAYMENT|CLOSE|REOPEN|DISPOSAL|EXPORT|CONFIG_ACTIVATION|CUSTOM
  category           String?
  owner              String? // e.g. "FINANCE"|"HR"|"TREASURY"|"PROCUREMENT"
  active             Boolean @default(true)
  defaultVersionId   String? @map("default_version_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant                       @relation(fields: [tenantId], references: [id])
  versions WorkflowDefinitionVersion[]  @relation("DefinitionVersions")
  instances WorkflowInstance[]

  @@unique([tenantId, code])
}

model WorkflowDefinitionVersion {
  id                String    @id @default(uuid())
  tenantId          String    @map("tenant_id")
  workflowDefinitionId String @map("workflow_definition_id")
  version           Int
  organizationId    String?   @map("organization_id") // null = tenant-wide default (spec section 111-112)
  effectiveFrom     DateTime  @map("effective_from") @db.Date
  effectiveTo       DateTime? @map("effective_to") @db.Date
  status            String    @default("DRAFT") // DRAFT|REVIEW|APPROVED|ACTIVE|RETIRED|CANCELLED
  priority          Int       @default(100) // resolution priority when multiple versions could match (lower = more specific)
  triggerType       String    @map("trigger_type") // DOCUMENT_SUBMITTED|BEFORE_POST|BEFORE_PAYMENT|BEFORE_CLOSE|BEFORE_REOPEN|BEFORE_EXPORT|BEFORE_DISPOSAL|BEFORE_CONFIG_ACTIVATION|MANUAL_START|API_EVENT|SCHEDULED_CHECK
  reapprovalPolicy  Json?     @map("reapproval_policy") // WorkflowReapprovalPolicy is folded in here (array of {fieldPath, changeType, threshold, action, restartFromStep})
  slaProfile        Json?     @map("sla_profile") // default SLA hours per stage when a step doesn't override it
  createdBy         String    @map("created_by")
  approvedBy        String?   @map("approved_by")

  createdAt DateTime @default(now()) @map("created_at")

  tenant     Tenant                @relation(fields: [tenantId], references: [id])
  definition WorkflowDefinition    @relation("DefinitionVersions", fields: [workflowDefinitionId], references: [id])
  steps      WorkflowStepDefinition[]
  instances  WorkflowInstance[]

  @@unique([tenantId, workflowDefinitionId, version])
  @@index([tenantId, workflowDefinitionId, status, effectiveFrom])
}

model WorkflowStepDefinition {
  id                String  @id @default(uuid())
  tenantId          String  @map("tenant_id")
  workflowVersionId String  @map("workflow_version_id")
  stepCode          String  @map("step_code")
  name              String
  stage             Int     @default(0) // steps in the same stage run in parallel; stages run sequentially
  sequence          Int     @default(0)
  executionMode     String  @default("ALL_REQUIRED") @map("execution_mode") // SEQUENTIAL|PARALLEL|ANY_ONE|ALL_REQUIRED|QUORUM|FIRST_RESPONSE|CONDITIONAL
  quorumRequired    Int?    @map("quorum_required") // for QUORUM mode
  approverRuleId    String  @map("approver_rule_id")
  conditionExpression Json? @map("condition_expression") // safe DSL tree (spec sections 21-23) — folds WorkflowCondition in
  slaDurationHours  Int?    @map("sla_duration_hours")
  escalationRuleId  String? @map("escalation_rule_id")
  allowDelegate     Boolean @default(true) @map("allow_delegate")
  allowRequestChange Boolean @default(true) @map("allow_request_change")
  optional          Boolean @default(false)
  blocking          Boolean @default(true)
  rejectionPolicy   String  @default("ANY_REJECTION_REJECTS") @map("rejection_policy") // ANY_REJECTION_REJECTS|MAJORITY_DECIDES|REJECTION_RETURNS_TO_PREVIOUS|REJECTION_REQUESTS_CHANGE

  tenant        Tenant                    @relation(fields: [tenantId], references: [id])
  workflowVersion WorkflowDefinitionVersion @relation(fields: [workflowVersionId], references: [id])
  approverRule  ApproverRule              @relation(fields: [approverRuleId], references: [id])
  escalationRule EscalationRule?          @relation(fields: [escalationRuleId], references: [id])
  stepInstances WorkflowStepInstance[]

  @@unique([workflowVersionId, stepCode])
}

model ApproverRule {
  id             String  @id @default(uuid())
  tenantId       String  @map("tenant_id")
  code           String
  name           String
  ruleType       String  @map("rule_type") // SPECIFIC_USER|ROLE|MANAGER|MANAGER_N_LEVELS|DEPARTMENT_HEAD|COST_CENTER_OWNER|PROJECT_MANAGER|DOCUMENT_OWNER_MANAGER|ORGANIZATION_ROLE|DYNAMIC_QUERY_RULE
  specificUserId String? @map("specific_user_id")
  roleCode       String? @map("role_code")
  managerLevels  Int?    @map("manager_levels") // for MANAGER_N_LEVELS
  fallbackRuleId String? @map("fallback_rule_id") // explicit fallback (spec section 90)

  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  fallbackRule ApproverRule?  @relation("ApproverRuleFallback", fields: [fallbackRuleId], references: [id])
  fallbackFor  ApproverRule[] @relation("ApproverRuleFallback")
  steps        WorkflowStepDefinition[]

  @@unique([tenantId, code])
}

model ApprovalAuthority {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  userId         String?   @map("user_id")
  roleCode       String?   @map("role_code")
  workflowCategory String? @map("workflow_category")
  organizationId String?   @map("organization_id")
  baseCurrencyId String    @map("base_currency_id")
  maxAmount      Decimal   @map("max_amount") @db.Decimal(18, 2)
  effectiveFrom  DateTime  @default(now()) @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, userId])
  @@index([tenantId, roleCode])
}

model WorkflowInstance {
  id                   String    @id @default(uuid())
  tenantId             String    @map("tenant_id")
  organizationId       String    @map("organization_id")
  workflowDefinitionId String    @map("workflow_definition_id")
  workflowVersionId    String    @map("workflow_version_id")
  businessObjectType   String    @map("business_object_type")
  businessObjectId     String    @map("business_object_id")
  requestedAction      String    @map("requested_action")
  status               String    @default("CREATED") // CREATED|PENDING|IN_PROGRESS|WAITING|APPROVED|REJECTED|CHANGE_REQUESTED|CANCELLED|SUPERSEDED|EXPIRED|FAILED
  startedAt            DateTime  @default(now()) @map("started_at")
  completedAt          DateTime? @map("completed_at")
  initiatedBy          String    @map("initiated_by")
  currentStage         Int       @default(0) @map("current_stage")
  snapshotData         Json      @map("snapshot_data") // WorkflowApprovalSnapshot folded in — decision-relevant business data captured at start
  businessVersion       Int      @map("business_version") // the business object's own optimistic-lock version at snapshot time
  executionStatus      String    @default("NOT_EXECUTED") @map("execution_status") // NOT_EXECUTED|EXECUTION_STARTED|EXECUTED|EXECUTION_FAILED
  reapprovalCount      Int       @default(0) @map("reapproval_count")
  supersedesInstanceId String?   @map("supersedes_instance_id")
  cancellationReason   String?   @map("cancellation_reason")
  correlationId        String?   @map("correlation_id") // threads through to Phase 25's own audit correlation

  tenant     Tenant                    @relation(fields: [tenantId], references: [id])
  organization Organization            @relation(fields: [organizationId], references: [id])
  definition WorkflowDefinition        @relation(fields: [workflowDefinitionId], references: [id])
  version    WorkflowDefinitionVersion @relation(fields: [workflowVersionId], references: [id])

  stepInstances WorkflowStepInstance[]
  exceptions    WorkflowException[]
  decisions     ApprovalDecision[]

  @@index([tenantId, organizationId, businessObjectType, businessObjectId])
  @@index([tenantId, status])
}

model WorkflowStepInstance {
  id                  String    @id @default(uuid())
  tenantId            String    @map("tenant_id")
  workflowInstanceId  String    @map("workflow_instance_id")
  stepDefinitionId    String    @map("step_definition_id")
  status              String    @default("NOT_ACTIVE") // NOT_ACTIVE|ACTIVE|WAITING|APPROVED|REJECTED|CHANGE_REQUESTED|SKIPPED|CANCELLED|EXPIRED
  activatedAt         DateTime? @map("activated_at")
  completedAt         DateTime? @map("completed_at")
  deadline            DateTime?
  quorumRequired      Int?      @map("quorum_required")
  approvalsCount      Int       @default(0) @map("approvals_count")
  rejectionsCount     Int       @default(0) @map("rejections_count")
  changeRequestsCount Int       @default(0) @map("change_requests_count")
  version             Int       @default(1) // optimistic lock for concurrency-safe completion (spec section 122)

  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  instance   WorkflowInstance @relation(fields: [workflowInstanceId], references: [id])
  definition WorkflowStepDefinition @relation(fields: [stepDefinitionId], references: [id])

  assignments ApproverAssignment[]
  decisions   ApprovalDecision[]

  @@unique([workflowInstanceId, stepDefinitionId])
  @@index([tenantId, status, deadline])
}

model ApproverAssignment {
  id                String    @id @default(uuid())
  tenantId          String    @map("tenant_id")
  stepInstanceId    String    @map("step_instance_id")
  userId            String    @map("user_id")
  employmentId      String?   @map("employment_id")
  resolvedFromRule  String    @map("resolved_from_rule") // ApproverRule.code, snapshotted (spec section 34)
  assignmentTime    DateTime  @default(now()) @map("assignment_time")
  delegatedFrom     String?   @map("delegated_from")
  status            String    @default("PENDING") // PENDING|APPROVED|REJECTED|CHANGE_REQUESTED|DELEGATED|EXPIRED|CANCELLED|SKIPPED
  responseDeadline  DateTime? @map("response_deadline")

  tenant       Tenant               @relation(fields: [tenantId], references: [id])
  stepInstance WorkflowStepInstance @relation(fields: [stepInstanceId], references: [id])

  @@index([tenantId, userId, status])
  @@index([tenantId, stepInstanceId])
}

model ApprovalDecision {
  id                  String    @id @default(uuid())
  tenantId            String    @map("tenant_id")
  workflowInstanceId  String    @map("workflow_instance_id")
  stepInstanceId      String    @map("step_instance_id")
  approverAssignmentId String?  @map("approver_assignment_id")
  decision            String    // APPROVE|REJECT|REQUEST_CHANGE|ABSTAIN|RETURN_TO_PREVIOUS|ESCALATE
  decidedAt           DateTime  @default(now()) @map("decided_at")
  comment             String?
  reasonCode          String?   @map("reason_code")
  evidenceId          String?   @map("evidence_id") // Phase 25 AuditEvidence.id
  actorUserId         String    @map("actor_user_id")
  delegated           Boolean   @default(false)
  snapshotHash        String?   @map("snapshot_hash")
  idempotencyKey      String?   @map("idempotency_key")

  tenant   Tenant               @relation(fields: [tenantId], references: [id])
  instance WorkflowInstance     @relation(fields: [workflowInstanceId], references: [id])
  step     WorkflowStepInstance @relation(fields: [stepInstanceId], references: [id])

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, workflowInstanceId])
}

model DelegationRule {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  delegatorUserId String   @map("delegator_user_id")
  delegateUserId String    @map("delegate_user_id")
  validFrom      DateTime  @map("valid_from") @db.Date
  validTo        DateTime? @map("valid_to") @db.Date
  workflowCategory String? @map("workflow_category")
  organizationId String?   @map("organization_id")
  maxAmount      Decimal?  @map("max_amount") @db.Decimal(18, 2)
  allowedActions Json?     @map("allowed_actions")
  status         String    @default("ACTIVE") // ACTIVE|REVOKED|EXPIRED

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, delegatorUserId, status])
}

model SegregationRule {
  id                 String    @id @default(uuid())
  tenantId           String    @map("tenant_id")
  actionCategory     String    @map("action_category") // e.g. PAYMENT_APPROVAL, PERIOD_REOPEN
  conflictingRelation String   @map("conflicting_relation") // CREATOR_NOT_APPROVER|APPROVER_NOT_EXECUTOR|EXECUTOR_NOT_RECONCILER|REQUESTER_NOT_FINAL_APPROVER
  scope              String    @default("TENANT") // TENANT|ORGANIZATION
  severity           String    @default("BLOCKING") // INFO|WARNING|ERROR|BLOCKING
  overridePolicy     String    @default("NOT_ALLOWED") @map("override_policy") // NOT_ALLOWED|REQUIRES_SEPARATE_APPROVER_AND_REASON
  effectiveFrom      DateTime  @default(now()) @map("effective_from") @db.Date
  effectiveTo        DateTime? @map("effective_to") @db.Date

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, actionCategory])
}

model EscalationRule {
  id             String  @id @default(uuid())
  tenantId       String  @map("tenant_id")
  code           String
  name           String
  afterHours     Int     @map("after_hours")
  action         String  // REMIND|NOTIFY_MANAGER|ADD_APPROVER|REASSIGN|ESCALATE_TO_ROLE|MARK_BREACHED
  targetRoleCode String? @map("target_role_code")

  tenant Tenant                   @relation(fields: [tenantId], references: [id])
  steps  WorkflowStepDefinition[]

  @@unique([tenantId, code])
}

model WorkflowException {
  id                 String    @id @default(uuid())
  tenantId           String    @map("tenant_id")
  workflowInstanceId String    @map("workflow_instance_id")
  exceptionType      String    @map("exception_type") // APPROVER_NOT_RESOLVED|CIRCULAR_MANAGER_CHAIN|NO_ACTIVE_ROLE_HOLDER|INVALID_DELEGATION|SOD_CONFLICT|SLA_CALCULATION_ERROR|BUSINESS_OBJECT_CHANGED|EXECUTION_GATE_MISMATCH
  severity           String    @default("ERROR") // INFO|WARNING|ERROR|BLOCKING
  message            String
  resolved           Boolean   @default(false)
  resolvedAt         DateTime? @map("resolved_at")
  resolvedBy         String?   @map("resolved_by")

  createdAt DateTime @default(now()) @map("created_at")

  tenant   Tenant           @relation(fields: [tenantId], references: [id])
  instance WorkflowInstance @relation(fields: [workflowInstanceId], references: [id])

  @@index([tenantId, workflowInstanceId, resolved])
}
// ============================================================
// Phase 27 — Create Based On / Document Chain / Provenance Engine
// See docs/DOCUMENT_CHAIN.md
// ============================================================

model DocumentTypeDefinition {
  id                    String  @id @default(uuid())
  tenantId              String  @map("tenant_id")
  code                  String
  module                String
  entityType            String  @map("entity_type")
  lineEntityType        String? @map("line_entity_type")
  supportsCreateBasedOn Boolean @default(true) @map("supports_create_based_on")
  supportsLineProvenance Boolean @default(true) @map("supports_line_provenance")
  active                Boolean @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
}

model DocumentTransformationDefinition {
  id                   String  @id @default(uuid())
  tenantId             String  @map("tenant_id")
  code                 String
  sourceDocumentType   String  @map("source_document_type")
  targetDocumentType   String  @map("target_document_type")
  transformationCategory String @default("QUANTITY_BASED") @map("transformation_category") // QUANTITY_BASED|AMOUNT_BASED|MIXED|BOOLEAN_ENTITLEMENT|SCHEDULE_BASED|REFERENCE_ONLY|REVERSAL|CORRECTION
  ownerModule          String? @map("owner_module")
  active               Boolean @default(true)

  tenant   Tenant                          @relation(fields: [tenantId], references: [id])
  versions DocumentTransformationVersion[]

  @@unique([tenantId, code])
}

model DocumentTransformationVersion {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  transformationId String    @map("transformation_id")
  version          Int
  organizationId   String?   @map("organization_id")
  effectiveFrom    DateTime  @map("effective_from") @db.Date
  effectiveTo      DateTime? @map("effective_to") @db.Date
  status           String    @default("DRAFT") // DRAFT|REVIEW|APPROVED|ACTIVE|RETIRED|CANCELLED
  priority         Int       @default(100)
  // TransformationHeaderMapping/TransformationLineMapping/
  // TransformationEligibilityRule/TransformationConsumptionRule are all
  // folded into this version as governed JSON configuration rather than
  // four separate tables (docs/DOCUMENT_CHAIN.md section A) — each is
  // still independently versioned because it lives on THIS version row.
  headerMapping    Json?     @map("header_mapping") // [{targetField, mappingType, sourceField|constant|lookupKey}]
  lineMapping      Json?     @map("line_mapping") // [{sourceLineType, targetLineType, quantityMapping, amountMapping, splitPolicy, groupingPolicy}]
  eligibilityRules Json?     @map("eligibility_rules") // [{check, params}] — safe DSL, evaluated by TransformationValidationService
  consumptionMetric String   @default("QUANTITY") @map("consumption_metric") // QUANTITY|BASE_QUANTITY|AMOUNT|TRANSACTION_AMOUNT|BASE_AMOUNT|SCHEDULE_QUANTITY|INSTALLMENT_AMOUNT|ENTITLEMENT_COUNT
  commitState      String    @default("ON_POST") @map("commit_state") // ON_SAVE|ON_APPROVAL|ON_POST|ON_EXECUTION|CUSTOM_DOMAIN_STATE
  claimPolicy      String    @default("SOFT_CLAIM") @map("claim_policy") // NONE|SOFT_CLAIM|HARD_CLAIM|CLAIM_WITH_TTL
  claimTtlMinutes  Int?      @map("claim_ttl_minutes")
  tolerancePolicy  Json?     @map("tolerance_policy") // {type: 'NONE'|'PERCENT'|'AMOUNT'|'APPROVAL_REQUIRED', value}
  createdBy        String    @map("created_by")
  approvedBy       String?   @map("approved_by")

  createdAt DateTime @default(now()) @map("created_at")

  tenant          Tenant                            @relation(fields: [tenantId], references: [id])
  transformation  DocumentTransformationDefinition   @relation(fields: [transformationId], references: [id])
  proposals       DocumentCreationProposal[]
  documentLinks   DocumentLink[]
  claims          SourceCreationClaim[]

  @@unique([tenantId, transformationId, version])
  @@index([tenantId, transformationId, status, effectiveFrom])
}

model DocumentCreationProposal {
  id                      String    @id @default(uuid())
  tenantId                String    @map("tenant_id")
  organizationId          String    @map("organization_id")
  transformationVersionId String    @map("transformation_version_id")
  sourceDocumentType      String    @map("source_document_type")
  sourceDocumentIds       Json      @map("source_document_ids") // string[] — one or many (merge)
  generatedAt             DateTime  @default(now()) @map("generated_at")
  generatedBy             String    @map("generated_by")
  sourceSnapshotHash      String    @map("source_snapshot_hash")
  status                  String    @default("GENERATED") // GENERATED|EDITED|ACCEPTED|EXPIRED|STALE|CANCELLED
  expiresAt               DateTime? @map("expires_at")

  tenant         Tenant                        @relation(fields: [tenantId], references: [id])
  organization   Organization                  @relation(fields: [organizationId], references: [id])
  version        DocumentTransformationVersion @relation(fields: [transformationVersionId], references: [id])
  lines          DocumentCreationProposalLine[]

  @@index([tenantId, organizationId, status])
}

model DocumentCreationProposalLine {
  id                 String  @id @default(uuid())
  tenantId           String  @map("tenant_id")
  proposalId         String  @map("proposal_id")
  sourceDocumentType String  @map("source_document_type")
  sourceDocumentId   String  @map("source_document_id")
  sourceLineId       String  @map("source_line_id")
  eligibleQuantity   Decimal @map("eligible_quantity") @db.Decimal(18, 6)
  proposedQuantity   Decimal @map("proposed_quantity") @db.Decimal(18, 6)
  userQuantity       Decimal? @map("user_quantity") @db.Decimal(18, 6)
  metric             String  @default("QUANTITY")
  warnings           Json?

  tenant   Tenant                    @relation(fields: [tenantId], references: [id])
  proposal DocumentCreationProposal  @relation(fields: [proposalId], references: [id])

  @@index([tenantId, proposalId])
}

model SourceCreationClaim {
  id                     String    @id @default(uuid())
  tenantId               String    @map("tenant_id")
  transformationVersionId String   @map("transformation_version_id")
  sourceDocumentType     String    @map("source_document_type")
  sourceDocumentId       String    @map("source_document_id")
  sourceLineId           String?   @map("source_line_id")
  targetProposalId       String?   @map("target_proposal_id")
  targetDraftDocumentType String?  @map("target_draft_document_type")
  targetDraftDocumentId  String?   @map("target_draft_document_id")
  metric                 String    @default("QUANTITY")
  claimedQuantity        Decimal   @map("claimed_quantity") @db.Decimal(18, 6)
  status                 String    @default("ACTIVE") // ACTIVE|COMMITTED|RELEASED|EXPIRED|CANCELLED
  createdBy              String    @map("created_by")
  expiresAt              DateTime? @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant                        @relation(fields: [tenantId], references: [id])
  version DocumentTransformationVersion @relation(fields: [transformationVersionId], references: [id])

  @@index([tenantId, sourceDocumentType, sourceDocumentId, status])
  @@index([tenantId, status, expiresAt])
}

model TransformationException {
  id                 String    @id @default(uuid())
  tenantId           String    @map("tenant_id")
  transformationCode String?   @map("transformation_code")
  sourceDocumentType String?   @map("source_document_type")
  sourceDocumentId   String?   @map("source_document_id")
  exceptionType      String    @map("exception_type") // NO_APPLICABLE_VERSION|SOURCE_NOT_ELIGIBLE|CURRENCY_MISMATCH|MERGE_INCOMPATIBILITY|CLAIM_CONFLICT|SOURCE_STALE|TARGET_VALIDATION_FAILED|CYCLE_DETECTED|DOWNSTREAM_BLOCKER|MAPPING_ERROR
  severity           String    @default("ERROR") // INFO|WARNING|ERROR|BLOCKING
  message            String
  resolved           Boolean   @default(false)
  resolvedAt         DateTime? @map("resolved_at")

  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, sourceDocumentType, sourceDocumentId])
}

model DocumentChainSnapshot {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  sourceDocumentType String   @map("source_document_type")
  sourceDocumentId   String   @map("source_document_id")
  snapshotData       Json     @map("snapshot_data")
  reason             String?
  generatedAt        DateTime @default(now()) @map("generated_at")
  generatedBy        String   @map("generated_by")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, sourceDocumentType, sourceDocumentId])
}
// ============================================================
// Phase 28 — Integration Platform / Connector Framework /
// Import-Export Engine / External Message Processing Layer
// See docs/INTEGRATION_PLATFORM.md
// ============================================================

model IntegrationConnector {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  code     String  // GENERIC_REST | GENERIC_SFTP | GENERIC_WEBHOOK | GENERIC_FILE | BANK_X | MARKETPLACE_Y | ...
  name     String
  family   String  // system/provider family label
  active   Boolean @default(true)

  tenant   Tenant                        @relation(fields: [tenantId], references: [id])
  versions IntegrationConnectorVersion[]
  endpoints IntegrationEndpoint[]

  @@unique([tenantId, code])
}

model IntegrationConnectorVersion {
  id                       String    @id @default(uuid())
  tenantId                 String    @map("tenant_id")
  connectorId              String    @map("connector_id")
  version                  Int
  effectiveFrom            DateTime  @map("effective_from") @db.Date
  effectiveTo              DateTime? @map("effective_to") @db.Date
  supportedContractVersions Json?    @map("supported_contract_versions") // string[] of "CONTRACT_CODE:version"
  implementationVersion    String    @map("implementation_version")
  status                   String    @default("DRAFT") // DRAFT|TESTING|SHADOW|ACTIVE|RETIRED

  createdAt DateTime @default(now()) @map("created_at")

  tenant    Tenant               @relation(fields: [tenantId], references: [id])
  connector IntegrationConnector @relation(fields: [connectorId], references: [id])

  @@unique([tenantId, connectorId, version])
}

model IntegrationCredentialReference {
  id                String    @id @default(uuid())
  tenantId          String    @map("tenant_id")
  code              String
  credentialType    String    @map("credential_type") // API_KEY|OAUTH_CLIENT|OAUTH_TOKEN|BASIC_AUTH|SSH_KEY_REFERENCE|CERTIFICATE_REFERENCE|SIGNING_KEY_REFERENCE
  environment       String    @default("TEST") // TEST|SANDBOX|PRODUCTION
  // The actual secret NEVER lives here (spec sections 10-13) — only an
  // opaque pointer into an external secret manager/vault.
  currentSecretReferenceId String @map("current_secret_reference_id")
  nextSecretReferenceId    String? @map("next_secret_reference_id")
  transitionEffectiveAt    DateTime? @map("transition_effective_at")
  status            String    @default("ACTIVE") // ACTIVE|ROTATING|DISABLED|EXPIRED
  expiresAt         DateTime? @map("expires_at")
  lastRotatedAt     DateTime? @map("last_rotated_at")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant    Tenant                @relation(fields: [tenantId], references: [id])
  endpoints IntegrationEndpoint[]
  aiProviders AIProvider[]

  @@unique([tenantId, code])
}

model IntegrationEndpoint {
  id                     String    @id @default(uuid())
  tenantId               String    @map("tenant_id")
  organizationId         String?   @map("organization_id")
  code                   String
  name                   String
  direction              String    // INBOUND|OUTBOUND|BIDIRECTIONAL
  connectorId            String    @map("connector_id")
  protocol               String    // REST|WEBHOOK|SFTP|FILE_DROP|POLLING|MESSAGE_QUEUE|EDI|MANUAL_UPLOAD
  environment            String    @default("TEST") // TEST|SANDBOX|PRODUCTION
  baseEndpointReference  String?   @map("base_endpoint_reference")
  credentialReferenceId  String?   @map("credential_reference_id")
  enabled                Boolean   @default(true)
  effectiveFrom          DateTime  @default(now()) @map("effective_from") @db.Date
  effectiveTo            DateTime? @map("effective_to") @db.Date
  timeoutPolicy          Json?     @map("timeout_policy") // {connectMs, readMs}
  rateLimitPolicy        Json?     @map("rate_limit_policy") // {perSecond, perMinute, burst}
  retryPolicyId          String?   @map("retry_policy_id")
  status                 String    @default("ACTIVE") // ACTIVE|SUSPENDED|DISABLED

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant     Tenant                          @relation(fields: [tenantId], references: [id])
  connector  IntegrationConnector            @relation(fields: [connectorId], references: [id])
  credential IntegrationCredentialReference? @relation(fields: [credentialReferenceId], references: [id])
  retryPolicy IntegrationRetryPolicy?        @relation(fields: [retryPolicyId], references: [id])
  messages   IntegrationMessage[]
  webhookSubscriptions IntegrationWebhookSubscription[]
  pollingCursors IntegrationPollingCursor[]
  stagingBatches IntegrationStagingBatch[]
  exportJobs IntegrationExportJob[]
  reconciliationRules IntegrationReconciliationRule[]
  healthIssues IntegrationHealthIssue[]

  @@unique([tenantId, code])
}

model IntegrationContract {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  code     String  // SALES_ORDER_IMPORT | CUSTOMER_EXPORT | BANK_STATEMENT_IMPORT | ...
  name     String
  direction String @default("INBOUND") // INBOUND|OUTBOUND
  active   Boolean @default(true)

  tenant   Tenant                       @relation(fields: [tenantId], references: [id])
  versions IntegrationContractVersion[]

  @@unique([tenantId, code])
}

model IntegrationContractVersion {
  id                 String    @id @default(uuid())
  tenantId           String    @map("tenant_id")
  contractId         String    @map("contract_id")
  version            Int
  schema             Json      // JSON-schema-like descriptor: {required: string[], fields: {name: type}}
  effectiveFrom      DateTime  @map("effective_from") @db.Date
  effectiveTo        DateTime? @map("effective_to") @db.Date
  status             String    @default("DRAFT") // DRAFT|ACTIVE|DEPRECATED|RETIRED
  backwardCompatible Boolean   @default(true) @map("backward_compatible")
  deprecatedAt       DateTime? @map("deprecated_at")

  createdAt DateTime @default(now()) @map("created_at")

  tenant   Tenant                @relation(fields: [tenantId], references: [id])
  contract IntegrationContract  @relation(fields: [contractId], references: [id])
  mappingVersions IntegrationMappingVersion[] @relation("SourceContractVersion")
  messages IntegrationMessage[]

  @@unique([tenantId, contractId, version])
}

model IntegrationMappingProfile {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  code     String
  name     String
  connectorId String? @map("connector_id")
  active   Boolean @default(true)

  tenant   Tenant                      @relation(fields: [tenantId], references: [id])
  versions IntegrationMappingVersion[]

  @@unique([tenantId, code])
}

model IntegrationMappingVersion {
  id                       String    @id @default(uuid())
  tenantId                 String    @map("tenant_id")
  mappingProfileId         String    @map("mapping_profile_id")
  version                  Int
  sourceContractVersionId  String    @map("source_contract_version_id")
  targetCanonicalContract  String    @map("target_canonical_contract") // canonical contract code this mapping produces
  // Safe mapping DSL only (spec section 36) — DIRECT/CONSTANT/LOOKUP/
  // FORMAT_CONVERSION/VALUE_MAP/CONDITIONAL/DERIVED_SAFE_EXPRESSION/
  // IGNORE/REQUIRED_MANUAL, reusing TransformationMappingService's own
  // closed primitive set from Phase 27 plus a VALUE_MAP variant of LOOKUP.
  fieldMappings            Json      @map("field_mappings")
  effectiveFrom            DateTime  @map("effective_from") @db.Date
  effectiveTo              DateTime? @map("effective_to") @db.Date
  status                   String    @default("DRAFT") // DRAFT|REVIEW|APPROVED|ACTIVE|RETIRED
  approvedBy               String?   @map("approved_by")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String   @map("created_by")

  tenant                Tenant                     @relation(fields: [tenantId], references: [id])
  mappingProfile        IntegrationMappingProfile  @relation(fields: [mappingProfileId], references: [id])
  sourceContractVersion IntegrationContractVersion @relation("SourceContractVersion", fields: [sourceContractVersionId], references: [id])
  stagingRecords        IntegrationStagingRecord[]

  @@unique([tenantId, mappingProfileId, version])
}

model IntegrationPayloadReference {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  hash        String   // sha256 of raw bytes
  size        Int
  contentType String   @map("content_type")
  location    String   // storage reference/URI — never the secret/PII payload itself in this column
  encrypted   Boolean  @default(false)
  retentionPolicyCode String? @map("retention_policy_code")
  purgeAfter  DateTime? @map("purge_after")

  createdAt DateTime @default(now()) @map("created_at")

  tenant   Tenant                @relation(fields: [tenantId], references: [id])
  messages IntegrationMessage[]

  @@index([tenantId, hash])
}

model IntegrationMessage {
  id                     String    @id @default(uuid())
  tenantId               String    @map("tenant_id")
  organizationId         String?   @map("organization_id")
  endpointId             String    @map("endpoint_id")
  contractVersionId      String    @map("contract_version_id")
  direction              String    // INBOUND|OUTBOUND
  status                 String    @default("RECEIVED") // RECEIVED|VALIDATING|STAGED|PROCESSING|PROCESSED|PARTIALLY_PROCESSED|REJECTED|RETRY_PENDING|DEAD_LETTER|CANCELLED
  sourceSystem           String?   @map("source_system")
  eventType              String?   @map("event_type")
  occurredAt             DateTime? @map("occurred_at") // provider-declared business event time
  receivedAt             DateTime  @default(now()) @map("received_at")
  businessEffectiveDate  DateTime? @map("business_effective_date") @db.Date // spec section 118 — may differ from receivedAt
  originalTimestampRaw   String?   @map("original_timestamp_raw")
  originalTimezoneOffset String?   @map("original_timezone_offset")
  externalCorrelationId  String?   @map("external_correlation_id")
  idempotencyKey         String?   @map("idempotency_key")
  payloadReferenceId     String?   @map("payload_reference_id")
  metadata               Json?
  currencyId             String?   @map("currency_id")
  rejectionReason        String?   @map("rejection_reason")
  dedupResultId          String?   @map("dedup_result_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant          Tenant                       @relation(fields: [tenantId], references: [id])
  endpoint        IntegrationEndpoint          @relation(fields: [endpointId], references: [id])
  contractVersion IntegrationContractVersion   @relation(fields: [contractVersionId], references: [id])
  payloadReference IntegrationPayloadReference? @relation(fields: [payloadReferenceId], references: [id])
  attempts        IntegrationMessageAttempt[]
  stagingRecords  IntegrationStagingRecord[]
  deadLetters     IntegrationDeadLetter[]
  exportItems     IntegrationExportItem[]
  dedupResults    IntegrationDeduplicationResult[]

  @@index([tenantId, endpointId, status])
  @@index([tenantId, externalCorrelationId])
  @@index([tenantId, idempotencyKey])
  @@index([tenantId, receivedAt])
}

model IntegrationMessageAttempt {
  id                 String    @id @default(uuid())
  tenantId           String    @map("tenant_id")
  messageId          String    @map("message_id")
  attemptNumber      Int       @map("attempt_number")
  startedAt          DateTime  @default(now()) @map("started_at")
  completedAt        DateTime? @map("completed_at")
  result             String    // SUCCESS|FAILED|RETRYING
  providerStatus     String?   @map("provider_status")
  errorCode          String?   @map("error_code") // TRANSIENT_NETWORK|RATE_LIMIT|AUTHENTICATION|PROVIDER_5XX|SCHEMA_ERROR|MAPPING_ERROR|BUSINESS_VALIDATION|DUPLICATE|CONFLICT|INTERNAL_ERROR
  errorMessage       String?   @map("error_message")
  retryable          Boolean   @default(false)
  responseReference  String?   @map("response_reference")

  // Message attempts are append-only (spec section 27 — "do not
  // overwrite prior attempts"); no updatedAt/mutation columns.

  tenant  Tenant              @relation(fields: [tenantId], references: [id])
  message IntegrationMessage  @relation(fields: [messageId], references: [id])

  @@index([tenantId, messageId, attemptNumber])
}

model IntegrationStagingBatch {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  endpointId     String   @map("endpoint_id")
  contractCode   String   @map("contract_code")
  sourceReference String? @map("source_reference") // source file/message reference
  recordCount    Int      @default(0) @map("record_count")
  validCount     Int      @default(0) @map("valid_count")
  invalidCount   Int      @default(0) @map("invalid_count")
  duplicateCount Int      @default(0) @map("duplicate_count")
  importedCount  Int      @default(0) @map("imported_count")
  strictAllOrNothing Boolean @default(false) @map("strict_all_or_nothing")
  status         String   @default("OPEN") // OPEN|VALIDATED|COMMITTING|COMMITTED|PARTIALLY_COMMITTED|FAILED|CANCELLED

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant   Tenant                     @relation(fields: [tenantId], references: [id])
  endpoint IntegrationEndpoint        @relation(fields: [endpointId], references: [id])
  records  IntegrationStagingRecord[]

  @@index([tenantId, endpointId, status])
}

model IntegrationStagingRecord {
  id                 String    @id @default(uuid())
  tenantId           String    @map("tenant_id")
  batchId            String    @map("batch_id")
  messageId          String?   @map("message_id")
  sequence           Int
  rawReference       String?   @map("raw_reference")
  canonicalData       Json     @map("canonical_data")
  mappingVersionId   String?   @map("mapping_version_id")
  validationStatus   String    @default("PENDING") @map("validation_status") // PENDING|SCHEMA_VALID|SCHEMA_INVALID
  mappingStatus      String    @default("PENDING") @map("mapping_status") // PENDING|MAPPED|MAPPING_ERROR|REQUIRES_MANUAL
  matchingStatus     String    @default("PENDING") @map("matching_status") // PENDING|MATCHED|UNMATCHED|WAITING_MANUAL|LOW_CONFIDENCE
  importStatus       String    @default("PENDING") @map("import_status") // PENDING|CREATED|UPDATED|SKIPPED|DUPLICATE|REJECTED|FAILED|WAITING_MANUAL
  errorList          Json?     @map("error_list")
  targetEntityType   String?   @map("target_entity_type")
  targetEntityId     String?   @map("target_entity_id")

  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant                     @relation(fields: [tenantId], references: [id])
  batch   IntegrationStagingBatch    @relation(fields: [batchId], references: [id])
  message IntegrationMessage?        @relation(fields: [messageId], references: [id])
  mappingVersion IntegrationMappingVersion? @relation(fields: [mappingVersionId], references: [id])

  @@index([tenantId, batchId, sequence])
  @@index([tenantId, importStatus])
}

model ExternalEntityReference {
  id                 String    @id @default(uuid())
  tenantId           String    @map("tenant_id")
  organizationId     String?   @map("organization_id")
  externalSystem     String    @map("external_system")
  externalEntityType String    @map("external_entity_type")
  externalEntityId   String    @map("external_entity_id")
  internalEntityType String    @map("internal_entity_type")
  internalEntityId   String    @map("internal_entity_id")
  validFrom          DateTime  @default(now()) @map("valid_from") @db.Date
  validTo            DateTime? @map("valid_to") @db.Date
  status             String    @default("ACTIVE") // ACTIVE|SUPERSEDED|REVOKED
  matchConfidence    Decimal?  @map("match_confidence") @db.Decimal(5, 4) // 0..1; null = exact/manual
  matchMethod        String?   @map("match_method") // EXACT_CODE|TAX_ID|EMAIL|BARCODE|IBAN|SUPPLIER_CODE|MANUAL
  createdBy          String?   @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  // spec section 42: unique by tenant + system + entity type + external ID
  // within the active scope (partial-uniqueness on status is enforced in
  // service logic since Prisma cannot express a filtered unique index
  // portably here).
  @@index([tenantId, externalSystem, externalEntityType, externalEntityId])
  @@index([tenantId, internalEntityType, internalEntityId])
}

model IntegrationDeduplicationResult {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  messageId      String   @map("message_id")
  signalType     String   @map("signal_type") // EXTERNAL_DOCUMENT_NUMBER|SUPPLIER_INVOICE_NO|EVENT_HASH|SOURCE_FILE_ROW|BANK_TRANSACTION_ID|RECEIPT_FINGERPRINT
  signalValue    String   @map("signal_value")
  result         String   // UNIQUE|EXACT_DUPLICATE|POSSIBLE_DUPLICATE|SUPERSEDING_VERSION|CONFLICT
  matchedMessageId String? @map("matched_message_id")

  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant             @relation(fields: [tenantId], references: [id])
  message IntegrationMessage @relation(fields: [messageId], references: [id])

  @@index([tenantId, signalType, signalValue])
}

model IntegrationImportJob {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  batchId        String?   @map("batch_id")
  endpointId     String?   @map("endpoint_id")
  mode           String    // CREATE_ONLY|UPDATE_IF_UNPOSTED|UPSERT_MASTER_DATA|SYNC_STATE|REFERENCE_ONLY|COMMAND_EVENT
  strictAllOrNothing Boolean @default(false) @map("strict_all_or_nothing")
  dryRun         Boolean   @default(false) @map("dry_run")
  status         String    @default("QUEUED") // QUEUED|RUNNING|COMPLETED|PARTIALLY_COMPLETED|FAILED|CANCELLED
  createdCount   Int       @default(0) @map("created_count")
  updatedCount   Int       @default(0) @map("updated_count")
  skippedCount   Int       @default(0) @map("skipped_count")
  duplicateCount Int       @default(0) @map("duplicate_count")
  rejectedCount  Int       @default(0) @map("rejected_count")
  failedCount    Int       @default(0) @map("failed_count")
  waitingManualCount Int   @default(0) @map("waiting_manual_count")
  requestedBy    String    @map("requested_by")

  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
}

model IntegrationExportJob {
  id                   String    @id @default(uuid())
  tenantId             String    @map("tenant_id")
  organizationId       String?   @map("organization_id")
  endpointId           String    @map("endpoint_id")
  contractCode         String    @map("contract_code")
  exportType           String    @map("export_type") // FULL|INCREMENTAL|CHANGED_SINCE_CURSOR|EVENT_BASED
  requestedBy          String    @map("requested_by")
  filterScope          Json?     @map("filter_scope")
  status               String    @default("QUEUED") // QUEUED|RUNNING|GENERATED|DELIVERING|DELIVERED|PARTIALLY_DELIVERED|FAILED|CANCELLED
  recordCount          Int       @default(0) @map("record_count")
  asOfSnapshotAt       DateTime? @map("as_of_snapshot_at")
  sourceVersionTag     String?   @map("source_version_tag")
  outputReference      String?   @map("output_reference")
  outputHash           String?   @map("output_hash")
  externalDeliveryStatus String? @map("external_delivery_status")

  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  tenant   Tenant                   @relation(fields: [tenantId], references: [id])
  endpoint IntegrationEndpoint      @relation(fields: [endpointId], references: [id])
  items    IntegrationExportItem[]

  @@index([tenantId, endpointId, status])
}

model IntegrationExportItem {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  exportJobId      String   @map("export_job_id")
  internalEntityType String @map("internal_entity_type")
  internalEntityId  String  @map("internal_entity_id")
  sourceVersion    Int?     @map("source_version")
  status           String   @default("PENDING") // PENDING|DELIVERED|FAILED
  externalObjectId String?  @map("external_object_id")
  externalStatus   String?  @map("external_status")
  outboundMessageId String? @map("outbound_message_id")

  tenant    Tenant                @relation(fields: [tenantId], references: [id])
  exportJob IntegrationExportJob  @relation(fields: [exportJobId], references: [id])
  outboundMessage IntegrationMessage? @relation(fields: [outboundMessageId], references: [id])

  @@index([tenantId, exportJobId])
}

model IntegrationWebhookSubscription {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  endpointId     String   @map("endpoint_id")
  subscriber     String   // outbound subscriber label
  events         Json     // string[] of event types
  targetEndpointReference String @map("target_endpoint_reference")
  secretReferenceId String? @map("secret_reference_id")
  active         Boolean  @default(true)
  retryPolicyId  String?  @map("retry_policy_id")
  contractVersionId String? @map("contract_version_id")

  createdAt DateTime @default(now()) @map("created_at")

  tenant   Tenant              @relation(fields: [tenantId], references: [id])
  endpoint IntegrationEndpoint @relation(fields: [endpointId], references: [id])

  @@index([tenantId, endpointId, active])
}

model IntegrationPollingCursor {
  id                String    @id @default(uuid())
  tenantId          String    @map("tenant_id")
  endpointId        String    @map("endpoint_id")
  resource          String
  lastExternalCursor String?  @map("last_external_cursor")
  lastTimestamp     DateTime? @map("last_timestamp")
  watermark         DateTime? // spec section 82 — includes an overlap window subtracted by the service, never stored pre-subtracted
  lastSuccessfulPollAt DateTime? @map("last_successful_poll_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant              @relation(fields: [tenantId], references: [id])
  endpoint IntegrationEndpoint @relation(fields: [endpointId], references: [id])

  @@unique([tenantId, endpointId, resource])
}

model IntegrationRetryPolicy {
  id                      String  @id @default(uuid())
  tenantId                String  @map("tenant_id")
  code                    String
  maxAttempts             Int     @default(5) @map("max_attempts")
  initialDelaySeconds     Int     @default(30) @map("initial_delay_seconds")
  backoffStrategy         String  @default("EXPONENTIAL") @map("backoff_strategy") // FIXED|EXPONENTIAL
  maxDelaySeconds         Int     @default(3600) @map("max_delay_seconds")
  retryableErrorCategories Json   @map("retryable_error_categories") // string[] of error codes from IntegrationMessageAttempt.errorCode
  jitterPolicy            String  @default("NONE") @map("jitter_policy") // NONE|FULL|EQUAL

  tenant    Tenant                @relation(fields: [tenantId], references: [id])
  endpoints IntegrationEndpoint[]

  @@unique([tenantId, code])
}

model IntegrationDeadLetter {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  messageId      String    @map("message_id")
  failureReason  String    @map("failure_reason")
  attemptCount   Int       @map("attempt_count")
  payloadReference String? @map("payload_reference")
  errorTraceReference String? @map("error_trace_reference")
  assignedOwner  String?   @map("assigned_owner")
  status         String    @default("OPEN") // OPEN|IN_REVIEW|RETRY_REQUESTED|RESOLVED|IGNORED_WITH_REASON
  resolution     String?

  createdAt  DateTime  @default(now()) @map("created_at")
  resolvedAt DateTime? @map("resolved_at")

  tenant  Tenant             @relation(fields: [tenantId], references: [id])
  message IntegrationMessage @relation(fields: [messageId], references: [id])

  @@index([tenantId, status])
}

model IntegrationReconciliationRule {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  endpointId     String    @map("endpoint_id")
  code           String
  sourceMetric   String    @map("source_metric") // e.g. EXTERNAL_ORDER_COUNT, EXTERNAL_ORDER_AMOUNT
  targetMetric   String    @map("target_metric") // e.g. ERP_SALES_ORDER_COUNT
  matchingKeys   Json      @map("matching_keys") // string[]
  tolerance      Decimal   @default(0) @db.Decimal(18, 6)
  status         String    @default("ACTIVE") // ACTIVE|INACTIVE
  effectiveFrom  DateTime  @default(now()) @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date

  tenant   Tenant                      @relation(fields: [tenantId], references: [id])
  endpoint IntegrationEndpoint         @relation(fields: [endpointId], references: [id])
  runs     IntegrationReconciliationRun[]

  @@unique([tenantId, code])
}

model IntegrationReconciliationRun {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  ruleId          String    @map("rule_id")
  periodLabel     String    @map("period_label")
  recordsCompared Int       @default(0) @map("records_compared")
  matched         Int       @default(0)
  missingInternal Int       @default(0) @map("missing_internal")
  missingExternal Int       @default(0) @map("missing_external")
  amountMismatch  Decimal   @default(0) @map("amount_mismatch") @db.Decimal(18, 2)
  status          String    @default("COMPLETED") // RUNNING|COMPLETED|FAILED

  runAt DateTime @default(now()) @map("run_at")

  tenant  Tenant                          @relation(fields: [tenantId], references: [id])
  rule    IntegrationReconciliationRule   @relation(fields: [ruleId], references: [id])
  results IntegrationReconciliationResult[]

  @@index([tenantId, ruleId, runAt])
}

model IntegrationReconciliationResult {
  id            String  @id @default(uuid())
  tenantId      String  @map("tenant_id")
  runId         String  @map("run_id")
  matchKey      String  @map("match_key")
  resultType    String  @map("result_type") // MATCH|INTERNAL_MISSING|EXTERNAL_MISSING|AMOUNT_MISMATCH|STATUS_MISMATCH|DUPLICATE|UNRESOLVED
  externalValue Json?   @map("external_value")
  internalValue Json?   @map("internal_value")
  difference    Decimal? @db.Decimal(18, 2)

  tenant Tenant                        @relation(fields: [tenantId], references: [id])
  run    IntegrationReconciliationRun  @relation(fields: [runId], references: [id])

  @@index([tenantId, runId, resultType])
}

model ExternalSyncState {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  internalEntityType String  @map("internal_entity_type")
  internalEntityId String    @map("internal_entity_id")
  externalSystem   String    @map("external_system")
  externalId       String    @map("external_id")
  internalVersion  Int?      @map("internal_version")
  externalVersionTag String? @map("external_version_tag") // ETag/version/last-modified token
  lastSyncedAt     DateTime? @map("last_synced_at")
  syncStatus       String    @default("SYNCED") @map("sync_status") // SYNCED|PENDING|CONFLICT|ERROR
  conflictStatus   String?   @map("conflict_status") // null|DETECTED|RESOLVED
  conflictResolution String? @map("conflict_resolution") // ERP_WINS|EXTERNAL_WINS|FIELD_OWNERSHIP|MANUAL|MERGE_SAFE_FIELDS

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, internalEntityType, internalEntityId, externalSystem])
  @@index([tenantId, syncStatus])
}

model IntegrationHealthIssue {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  endpointId  String?   @map("endpoint_id")
  issueType   String    @map("issue_type") // ENDPOINT_DISABLED_UNEXPECTEDLY|EXPIRED_CREDENTIAL|AUTH_FAILURES|WEBHOOK_SIGNATURE_FAILURES|POLLING_STALE|RETRY_BACKLOG|DEAD_LETTERS|STAGING_BACKLOG|DUPLICATE_SPIKE|RECONCILIATION_MISMATCH|MAPPING_VERSION_MISSING|CONTRACT_VERSION_UNSUPPORTED|OUTBOUND_DELIVERY_BACKLOG|RATE_LIMIT_SATURATION|CLOCK_SKEW
  severity    String    @default("WARNING") // INFO|WARNING|ERROR|BLOCKING
  message     String
  resolved    Boolean   @default(false)
  detectedAt  DateTime  @default(now()) @map("detected_at")
  resolvedAt  DateTime? @map("resolved_at")

  tenant   Tenant               @relation(fields: [tenantId], references: [id])
  endpoint IntegrationEndpoint? @relation(fields: [endpointId], references: [id])

  @@index([tenantId, resolved, severity])
}
// ============================================================
// Phase 29 — AI Layer / Governed Enterprise AI
// See docs/AI_LAYER.md
// ============================================================

model AIProvider {
  id                    String  @id @default(uuid())
  tenantId              String  @map("tenant_id")
  code                  String
  name                  String
  providerType          String  @map("provider_type") // OPENAI|ANTHROPIC|AZURE_OPENAI|LOCAL|CUSTOM
  endpointReference     String? @map("endpoint_reference")
  credentialReferenceId String? @map("credential_reference_id") // reuses Phase 28's IntegrationCredentialReference — never a second secret store
  enabled               Boolean @default(true)
  dataProcessingPolicy  Json?   @map("data_processing_policy") // {retention, trainingUsage, region}
  dataResidency         String? @map("data_residency")
  status                String  @default("ACTIVE") // ACTIVE|SUSPENDED|DISABLED

  tenant   Tenant             @relation(fields: [tenantId], references: [id])
  credential IntegrationCredentialReference? @relation(fields: [credentialReferenceId], references: [id])
  modelVersions AIModelVersion[]

  @@unique([tenantId, code])
}

model AIModelProfile {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  code     String  // ERP_ASSISTANT_GENERAL | DOCUMENT_CLASSIFICATION | FINANCIAL_ANALYSIS | ANOMALY_EXPLANATION | MATCHING_ASSISTANT | EXTRACTION_MODEL
  name     String
  fallbackProfileId String? @map("fallback_profile_id") // spec section 10 — explicit approved fallback, never hidden switching
  active   Boolean @default(true)

  tenant   Tenant            @relation(fields: [tenantId], references: [id])
  versions AIModelVersion[]

  @@unique([tenantId, code])
}

model AIModelVersion {
  id                     String    @id @default(uuid())
  tenantId               String    @map("tenant_id")
  modelProfileId         String    @map("model_profile_id")
  providerId             String    @map("provider_id")
  externalModelId        String    @map("external_model_id")
  effectiveFrom          DateTime  @map("effective_from") @db.Date
  effectiveTo            DateTime? @map("effective_to") @db.Date
  contextLimitTokens     Int?      @map("context_limit_tokens")
  supportsStructuredOutput Boolean @default(false) @map("supports_structured_output")
  supportsToolUse        Boolean   @default(false) @map("supports_tool_use")
  status                 String    @default("DRAFT") // DRAFT|EVALUATING|ACTIVE|RETIRED|REJECTED
  approvedBy             String?   @map("approved_by")
  evaluationStatus       String    @default("NOT_EVALUATED") @map("evaluation_status") // NOT_EVALUATED|PASSED|FAILED

  createdAt DateTime @default(now()) @map("created_at")

  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  profile  AIModelProfile @relation(fields: [modelProfileId], references: [id])
  provider AIProvider     @relation(fields: [providerId], references: [id])
  interactions AIInteraction[]
  evaluationRuns AIEvaluationRun[]

  @@unique([tenantId, modelProfileId, externalModelId, effectiveFrom])
  @@index([tenantId, modelProfileId, status])
}

model AICapability {
  id        String  @id @default(uuid())
  tenantId  String  @map("tenant_id")
  code      String  // ERP_QA | FINANCIAL_EXPLANATION | KPI_VARIANCE_EXPLANATION | DOCUMENT_SUMMARY | DOCUMENT_MATCHING | DUPLICATE_SUGGESTION | ACCOUNT_MAPPING_SUGGESTION | CASH_COLLECTION_PRIORITY | PROCUREMENT_ANOMALY | INVENTORY_ANOMALY | ACTION_PROPOSAL
  name      String
  riskLevel String  @map("risk_level") // READ_ONLY_LOW|READ_ONLY_SENSITIVE|RECOMMENDATION|ACTION_PROPOSAL|HIGH_RISK_ACTION_PROPOSAL
  requiredPermission String? @map("required_permission")
  enabled   Boolean @default(true) // kill switch (spec section 153)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
}

model AIAssistantDefinition {
  id                String  @id @default(uuid())
  tenantId          String  @map("tenant_id")
  code              String
  allowedCapabilities Json  @map("allowed_capabilities") // string[]
  allowedTools      Json    @map("allowed_tools") // string[]
  retrievalSources  Json    @map("retrieval_sources") // string[]
  modelProfileCode  String  @map("model_profile_code")
  systemPolicyVersion String @map("system_policy_version")
  maximumActionRisk String  @default("LOW") @map("maximum_action_risk") // LOW|MODERATE|HIGH|CRITICAL
  enabled           Boolean @default(true)
  owner             String?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
}

model AIPromptTemplate {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  code     String  // FINANCIAL_VARIANCE_EXPLAIN | MATCH_DOCUMENTS | SUGGEST_ACCOUNT_MAPPING | COLLECTION_RECOMMENDATION | ...
  name     String
  capabilityCode String @map("capability_code")
  active   Boolean @default(true)

  tenant   Tenant             @relation(fields: [tenantId], references: [id])
  versions AIPromptVersion[]

  @@unique([tenantId, code])
}

model AIPromptVersion {
  id                 String    @id @default(uuid())
  tenantId           String    @map("tenant_id")
  promptTemplateId   String    @map("prompt_template_id")
  version            Int
  effectiveFrom      DateTime  @map("effective_from") @db.Date
  effectiveTo        DateTime? @map("effective_to") @db.Date
  instructions       String    // the system/developer prompt body itself — immutable once ACTIVE
  expectedOutputSchema Json?   @map("expected_output_schema")
  allowedTools       Json?     @map("allowed_tools") // string[]
  modelProfileCode   String    @map("model_profile_code")
  riskControls       Json?     @map("risk_controls")
  evaluationThreshold Decimal? @map("evaluation_threshold") @db.Decimal(5, 4)
  status             String    @default("DRAFT") // DRAFT|EVALUATING|ACTIVE|RETIRED|REJECTED
  approvedBy         String?   @map("approved_by")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String   @map("created_by")

  tenant   Tenant           @relation(fields: [tenantId], references: [id])
  template AIPromptTemplate @relation(fields: [promptTemplateId], references: [id])
  interactions AIInteraction[]
  evaluationRuns AIEvaluationRun[]

  @@unique([tenantId, promptTemplateId, version])
}

model AIToolDefinition {
  id             String  @id @default(uuid())
  tenantId       String  @map("tenant_id")
  code           String  // getOpenAR | getInventoryAvailability | getTrialBalance | getDocumentChain | searchDocuments | getKPI | generatePaymentRequestProposal | ...
  name           String
  toolType       String  @map("tool_type") // READ|PROPOSAL|DOMAIN_ACTION — spec section 40's strict separation
  inputSchema    Json    @map("input_schema") // same closed {fields:{name:{type,required}}} shape as Phase 28 IntegrationContractVersion.schema — never a raw-SQL tool
  maxResultSize  Int?    @map("max_result_size")
  requiredCapabilityCode String @map("required_capability_code")
  active         Boolean @default(true)

  tenant   Tenant                       @relation(fields: [tenantId], references: [id])
  policies AIToolPermissionPolicy[]
  invocations AIToolInvocation[]

  @@unique([tenantId, code])
}

model AIToolPermissionPolicy {
  id             String  @id @default(uuid())
  tenantId       String  @map("tenant_id")
  toolId         String  @map("tool_id")
  capabilityCode String  @map("capability_code")
  requiredPermission String @map("required_permission")
  allowedMode    String  @default("READ") @map("allowed_mode") // READ|PROPOSE|EXECUTE
  scopeConstraint Json?  @map("scope_constraint") // {organizationRequired, departmentRequired, ...}

  tenant Tenant           @relation(fields: [tenantId], references: [id])
  tool   AIToolDefinition @relation(fields: [toolId], references: [id])

  @@unique([tenantId, toolId, capabilityCode])
}

model AIRetrievalSource {
  id         String  @id @default(uuid())
  tenantId   String  @map("tenant_id")
  code       String  // GeneralLedgerReadModel | InventoryAvailability | ARAPOpenItems | FinancialReports | ManagementKPIs | DocumentSearch | AuditTimeline | KnowledgeBase | Policies
  name       String
  sourceKind String  @default("STRUCTURED") @map("source_kind") // STRUCTURED|UNSTRUCTURED|HYBRID
  ownerModule String? @map("owner_module")
  active     Boolean @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
}

model AIRetrievalPolicy {
  id                    String  @id @default(uuid())
  tenantId              String  @map("tenant_id")
  code                  String
  allowedSourceCodes    Json    @map("allowed_source_codes") // string[]
  maxAgeMinutes         Int?    @map("max_age_minutes")
  requiredPermission    String? @map("required_permission")
  sensitiveHandling     String  @default("BLOCK") @map("sensitive_handling") // BLOCK|AGGREGATE_ONLY|REDACT|ALLOW
  requireCitations      Boolean @default(true) @map("require_citations")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
}

model AIContextSnapshot {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  organizationId    String?  @map("organization_id")
  userScopeHash     String   @map("user_scope_hash") // hash of the resolved permission/scope set, never the raw permission list re-derivable as sensitive content
  evidenceRefs      Json     @map("evidence_refs") // [{evidenceType, entityType, entityId, asOf, version}]
  semanticModelVersion String? @map("semantic_model_version") // e.g. Phase 24 KPI definition version, Phase 23 report/close version
  reportCloseVersion String? @map("report_close_version")
  builtAt           DateTime @default(now()) @map("built_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  interactions AIInteraction[]

  @@index([tenantId, builtAt])
}

model AIConversation {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  organizationId String?  @map("organization_id")
  userId         String   @map("user_id")
  assistantCode  String   @map("assistant_code")
  title          String?
  startedAt      DateTime @default(now()) @map("started_at")
  status         String   @default("ACTIVE") // ACTIVE|CLOSED

  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  interactions AIInteraction[]

  @@index([tenantId, userId, startedAt])
}

model AIInteraction {
  id                 String    @id @default(uuid())
  tenantId           String    @map("tenant_id")
  organizationId     String?   @map("organization_id")
  conversationId     String?   @map("conversation_id")
  userId             String    @map("user_id")
  capabilityCode     String    @map("capability_code")
  userRequest        String    @map("user_request")
  modelVersionId     String?   @map("model_version_id")
  promptVersionId    String?   @map("prompt_version_id")
  contextSnapshotId  String?   @map("context_snapshot_id")
  startedAt          DateTime  @default(now()) @map("started_at")
  completedAt        DateTime? @map("completed_at")
  status             String    @default("RECEIVED") // RECEIVED|CONTEXT_BUILDING|RUNNING|WAITING_TOOL|COMPLETED|PARTIAL|BLOCKED|FAILED|CANCELLED
  latencyMs          Int?      @map("latency_ms")
  inputTokens        Int?      @map("input_tokens")
  outputTokens       Int?      @map("output_tokens")
  riskLevel          String    @default("LOW") @map("risk_level") // LOW|MODERATE|HIGH|CRITICAL
  finalAnswer        String?   @map("final_answer") // concise business-visible rationale — never hidden chain-of-thought (spec section 97-98)
  blockedReason       String?  @map("blocked_reason")

  tenant           Tenant              @relation(fields: [tenantId], references: [id])
  conversation     AIConversation?     @relation(fields: [conversationId], references: [id])
  modelVersion     AIModelVersion?     @relation(fields: [modelVersionId], references: [id])
  promptVersion    AIPromptVersion?    @relation(fields: [promptVersionId], references: [id])
  contextSnapshot  AIContextSnapshot?  @relation(fields: [contextSnapshotId], references: [id])
  toolInvocations  AIToolInvocation[]
  evidenceRefs     AIEvidenceReference[]
  recommendations  AIRecommendation[]
  actionProposals  AIActionProposal[]
  feedback         AIFeedback[]
  guardrailResults AIGuardrailResult[]
  usageRecords     AIUsageRecord[]

  @@index([tenantId, userId, startedAt])
  @@index([tenantId, capabilityCode, status])
}

model AIToolInvocation {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  interactionId    String    @map("interaction_id")
  toolId           String    @map("tool_id")
  inputHash        String    @map("input_hash")
  input            Json
  permissionScope  Json?     @map("permission_scope")
  startedAt        DateTime  @default(now()) @map("started_at")
  completedAt      DateTime? @map("completed_at")
  resultReference  String?   @map("result_reference")
  success          Boolean   @default(false)
  error            String?
  mutationType     String    @default("NONE") @map("mutation_type") // NONE|PROPOSAL|DOMAIN_ACTION

  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  interaction  AIInteraction    @relation(fields: [interactionId], references: [id])
  tool         AIToolDefinition @relation(fields: [toolId], references: [id])

  @@index([tenantId, interactionId])
}

model AIEvidenceReference {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  interactionId    String?  @map("interaction_id")
  recommendationId String?  @map("recommendation_id")
  actionProposalId String?  @map("action_proposal_id")
  evidenceType     String   @map("evidence_type") // DOCUMENT|DOCUMENT_LINE|REGISTER_BALANCE|GL_ENTRY|REPORT_CELL|KPI|POLICY|CONTRACT|EXTERNAL_SOURCE|AUDIT_EVENT
  entityType       String   @map("entity_type")
  entityId         String   @map("entity_id")
  asOf             DateTime? @map("as_of")
  versionTag       String?  @map("version_tag") // e.g. close version, KPI definition version, report run id
  summary          String?

  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  interaction AIInteraction?  @relation(fields: [interactionId], references: [id])
  recommendation AIRecommendation? @relation(fields: [recommendationId], references: [id])
  actionProposal AIActionProposal? @relation(fields: [actionProposalId], references: [id])

  @@index([tenantId, entityType, entityId])
}

model AIRecommendation {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  organizationId String?   @map("organization_id")
  interactionId  String?   @map("interaction_id")
  category       String    // COLLECTION|PROCUREMENT|INVENTORY|ANOMALY|ACCOUNT_MAPPING|...
  targetEntityType String? @map("target_entity_type")
  targetEntityId String?   @map("target_entity_id")
  recommendation String
  confidenceLevel String   @default("MEDIUM") @map("confidence_level") // LOW|MEDIUM|HIGH
  confidenceScore Decimal? @map("confidence_score") @db.Decimal(5, 4)
  estimatedImpact Json?    @map("estimated_impact")
  status         String    @default("NEW") // NEW|VIEWED|ACCEPTED|REJECTED|DISMISSED|EXPIRED
  expiresAt      DateTime? @map("expires_at")
  modelVersionId String?   @map("model_version_id")
  promptVersionId String?  @map("prompt_version_id")

  createdAt DateTime @default(now()) @map("created_at")

  tenant      Tenant                @relation(fields: [tenantId], references: [id])
  interaction AIInteraction?        @relation(fields: [interactionId], references: [id])
  evidence    AIEvidenceReference[]
  feedback    AIFeedback[]

  @@index([tenantId, status, category])
}

model AIActionProposal {
  id                 String    @id @default(uuid())
  tenantId           String    @map("tenant_id")
  organizationId     String?   @map("organization_id")
  interactionId      String?   @map("interaction_id")
  actionType         String    @map("action_type") // canonical contract code — the SAME code space IntegrationCommandRegistry keys handlers by
  targetDomain       String    @map("target_domain")
  targetEntityType   String?   @map("target_entity_type")
  targetEntityId     String?   @map("target_entity_id")
  proposedCommand    Json      @map("proposed_command") // structured, schema-validated — never free text (spec section 113-114)
  rationale          String
  confidenceLevel    String    @default("MEDIUM") @map("confidence_level")
  confidenceScore    Decimal?  @map("confidence_score") @db.Decimal(5, 4)
  riskLevel          String    @default("MODERATE") @map("risk_level") // LOW|MODERATE|HIGH|CRITICAL
  status             String    @default("DRAFT") // DRAFT|READY_FOR_REVIEW|ACCEPTED|REJECTED|MODIFIED_BY_USER|APPROVAL_REQUIRED|APPROVED|EXECUTING|EXECUTED|FAILED|EXPIRED|CANCELLED|STALE
  expiresAt          DateTime? @map("expires_at")
  proposerModelVersionId String? @map("proposer_model_version_id")
  promptVersionId    String?   @map("prompt_version_id")
  contextSnapshotId  String?   @map("context_snapshot_id")
  workflowInstanceId String?   @map("workflow_instance_id") // Phase 26 — set only once routed for approval
  executedDocumentType String? @map("executed_document_type")
  executedDocumentId String?  @map("executed_document_id")
  idempotencyKey     String?  @map("idempotency_key") // spec section 185 — same interaction retried must never create a second logical proposal

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant      Tenant                     @relation(fields: [tenantId], references: [id])
  interaction AIInteraction?             @relation(fields: [interactionId], references: [id])
  items       AIActionProposalItem[]
  evidence    AIEvidenceReference[]
  feedback    AIFeedback[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, riskLevel])
}

model AIActionProposalItem {
  id               String  @id @default(uuid())
  tenantId         String  @map("tenant_id")
  actionProposalId String  @map("action_proposal_id")
  sourceDocumentType String? @map("source_document_type")
  sourceDocumentId String? @map("source_document_id")
  sourceLineId     String? @map("source_line_id")
  proposedAmount   Decimal? @map("proposed_amount") @db.Decimal(18, 2)
  currencyId       String?  @map("currency_id")
  note             String?

  tenant Tenant           @relation(fields: [tenantId], references: [id])
  proposal AIActionProposal @relation(fields: [actionProposalId], references: [id])

  @@index([tenantId, actionProposalId])
}

model AIFeedback {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  interactionId    String?  @map("interaction_id")
  recommendationId String?  @map("recommendation_id")
  actionProposalId String?  @map("action_proposal_id")
  userId           String   @map("user_id")
  rating           String   // HELPFUL|NOT_HELPFUL|INCORRECT|MISSING_CONTEXT|WRONG_EVIDENCE|UNSAFE_SUGGESTION|ACCEPTED_ACTION|REJECTED_ACTION
  feedbackType     String   @map("feedback_type")
  reason           String?
  correctedResultReference String? @map("corrected_result_reference")

  createdAt DateTime @default(now()) @map("created_at")

  tenant         Tenant             @relation(fields: [tenantId], references: [id])
  interaction    AIInteraction?     @relation(fields: [interactionId], references: [id])
  recommendation AIRecommendation?  @relation(fields: [recommendationId], references: [id])
  actionProposal AIActionProposal?  @relation(fields: [actionProposalId], references: [id])

  @@index([tenantId, rating])
}

model AIEvaluationDataset {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  code     String
  name     String
  category String  // FACTUAL|NUMERICAL|GROUNDING|CITATION|PERMISSION|TOOL_SELECTION|ACTION_SAFETY|INSTRUCTION_FOLLOWING|LATENCY|COST|RED_TEAM|PROMPT_INJECTION
  version  Int     @default(1)

  tenant Tenant                @relation(fields: [tenantId], references: [id])
  cases  AIEvaluationCase[]
  runs   AIEvaluationRun[]

  @@unique([tenantId, code, version])
}

model AIEvaluationCase {
  id                String  @id @default(uuid())
  tenantId          String  @map("tenant_id")
  datasetId         String  @map("dataset_id")
  input             String
  contextFixture    Json?   @map("context_fixture")
  expectedFacts     Json?   @map("expected_facts")
  expectedTools     Json?   @map("expected_tools") // string[]
  forbiddenActions  Json?   @map("forbidden_actions") // string[]
  scoringRules      Json?   @map("scoring_rules")

  tenant  Tenant              @relation(fields: [tenantId], references: [id])
  dataset AIEvaluationDataset @relation(fields: [datasetId], references: [id])
}

model AIEvaluationRun {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  modelVersionId   String?   @map("model_version_id")
  promptVersionId  String?   @map("prompt_version_id")
  toolSetVersion   String?   @map("tool_set_version")
  datasetId        String    @map("dataset_id")
  results          Json      // per-case results
  metrics          Json?     // factualGroundingRate/actionAcceptanceRate/actionCorrectionRate/safetyViolationRate/ungroundedClaimRate/latency/cost — folded here rather than a separate AIQualityMetric table (docs/AI_LAYER.md section D)
  passed           Boolean   @default(false)
  threshold        Decimal?  @db.Decimal(5, 4)
  approvedBy       String?   @map("approved_by")

  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  modelVersion  AIModelVersion?   @relation(fields: [modelVersionId], references: [id])
  promptVersion AIPromptVersion?  @relation(fields: [promptVersionId], references: [id])
  dataset       AIEvaluationDataset @relation(fields: [datasetId], references: [id])

  @@index([tenantId, modelVersionId, passed])
}

model AIGuardrailPolicy {
  id             String  @id @default(uuid())
  tenantId       String  @map("tenant_id")
  code           String
  stage          String  // INPUT|TOOL|OUTPUT|ACTION
  capabilityCode String? @map("capability_code")
  rules          Json    // safe declarative checks — reuses the same [{check,params}] shape as Phase 27 eligibilityRules, never executable script
  active         Boolean @default(true)

  tenant  Tenant               @relation(fields: [tenantId], references: [id])
  results AIGuardrailResult[]

  @@unique([tenantId, code])
}

model AIGuardrailResult {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  interactionId String   @map("interaction_id")
  policyId      String   @map("policy_id")
  stage         String   // INPUT|TOOL|OUTPUT|ACTION
  passed        Boolean
  reason        String?

  createdAt DateTime @default(now()) @map("created_at")

  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  interaction AIInteraction      @relation(fields: [interactionId], references: [id])
  policy      AIGuardrailPolicy  @relation(fields: [policyId], references: [id])

  @@index([tenantId, interactionId, stage])
}

model AIUsageRecord {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  interactionId  String?  @map("interaction_id")
  userId         String?  @map("user_id")
  departmentId   String?  @map("department_id")
  capabilityCode String   @map("capability_code")
  modelVersionId String?  @map("model_version_id")
  inputTokens    Int?     @map("input_tokens")
  outputTokens   Int?     @map("output_tokens")
  estimatedCost  Decimal  @default(0) @map("estimated_cost") @db.Decimal(12, 6)
  toolExecutionCost Decimal @default(0) @map("tool_execution_cost") @db.Decimal(12, 6)

  recordedAt DateTime @default(now()) @map("recorded_at")

  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  interaction AIInteraction?  @relation(fields: [interactionId], references: [id])

  @@index([tenantId, capabilityCode, recordedAt])
}

model AIBatchRun {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  organizationId String?   @map("organization_id")
  code           String    // e.g. DUPLICATE_SUPPLIER_SCAN, MARGIN_ANOMALY_SCAN
  capabilityCode String    @map("capability_code")
  status         String    @default("QUEUED") // QUEUED|RUNNING|COMPLETED|FAILED|CANCELLED
  recordsScanned Int       @default(0) @map("records_scanned")
  recommendationsCreated Int @default(0) @map("recommendations_created")
  requestedBy    String    @map("requested_by")

  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
}

model AIHealthIssue {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  issueType   String    @map("issue_type") // MODEL_UNAVAILABLE|PROVIDER_AUTH_FAILURE|RETRIEVAL_INDEX_STALE|TOOL_SCHEMA_MISMATCH|EXCESSIVE_UNGROUNDED_ANSWERS|EVALUATION_REGRESSION|COST_SPIKE|LATENCY_SPIKE|PERMISSION_FILTER_FAILURE|HIGH_REJECTED_ACTION_RATE|OLD_PROMPT_VERSION_ACTIVE|EVIDENCE_RETRIEVAL_FAILURE|ACTION_PROPOSAL_EXECUTION_FAILURE
  severity    String    @default("WARNING") // INFO|WARNING|ERROR|BLOCKING
  message     String
  resolved    Boolean   @default(false)
  detectedAt  DateTime  @default(now()) @map("detected_at")
  resolvedAt  DateTime? @map("resolved_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, resolved, severity])
}
