  adjustmentType String   @map("adjustment_type") // DEPRECIATION|PREPAID|INVENTORY_COST|PRODUCTION_COST|FX|ACCRUAL|DEFERRAL|TAX|RECLASSIFICATION|CLOSING_ENTRY|RETAINED_EARNINGS
  stepCode       String?  @map("step_code")
  journalEntryId String?  @map("journal_entry_id")
