  phone           String?
  email           String?
  managerPersonId String? @map("manager_person_id")
  active          Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  organization Organization       @relation("OrgBranches", fields: [organizationId], references: [id])
  manager      ResponsiblePerson? @relation(fields: [managerPersonId], references: [id])

  departments             Department[]
  warehouses              Warehouse[]
  cashboxes               Cashbox[]
  defaultForOrganizations Organization[] @relation("OrgDefaultBranch")

  hrStaffingPositions StaffingPosition[]
  hrEmployments       Employment[]
  hrEmployeeAssignments EmployeeAssignment[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
  @@map("branches")
}

/// Hierarchical department within an Organization (section 7/8).
model Department {
  id                 String  @id @default(uuid())
  tenantId           String  @map("tenant_id")
  organizationId     String  @map("organization_id")
  branchId           String? @map("branch_id")
  parentDepartmentId String? @map("parent_department_id")
  code               String
  name               String
  managerPersonId    String? @map("manager_person_id")
  active             Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  organization     Organization       @relation("OrgDepartments", fields: [organizationId], references: [id])
  branch           Branch?            @relation(fields: [branchId], references: [id])
  parentDepartment Department?        @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id])
  children         Department[]       @relation("DepartmentHierarchy")
  manager          ResponsiblePerson? @relation(fields: [managerPersonId], references: [id])
  purchaseRequirements PurchaseRequirement[]
  purchaseInvoiceLines PurchaseInvoiceLine[]
  internalConsumptions InternalConsumption[]
  memberAccess         OrganizationAccess[]

  capitalInvestmentProjects CapitalInvestmentProject[]
  fixedAssets               FixedAsset[]

  hrStaffingPositions StaffingPosition[]
  hrEmployments       Employment[]
  hrEmployeeAssignments EmployeeAssignment[]
  timesheets          Timesheet[]
  costCenters         CostCenter[]

  @@unique([organizationId, code])
  @@index([organizationId, parentDepartmentId])
  @@index([organizationId, active])
  @@map("departments")
}

/// Lightweight, tenant-global responsible-person reference (section 9/10) —
/// NOT the future Phase 17 Employee model. May optionally link to a system
/// User but is never required to.
model ResponsiblePerson {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  displayName String  @map("display_name")
  email       String?
  phone       String?
  userId      String? @map("user_id")
  active      Boolean @default(true)
  notes       String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  version   Int      @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  managedBranches    Branch[]
  managedDepartments Department[]
  managedWarehouses  Warehouse[]
  managedCashboxes   Cashbox[]
  customerRequests   CustomerRequest[]
  purchaseRequirementsRequested PurchaseRequirement[] @relation("PurchaseRequirementRequester")
  purchaseOrdersAsBuyer         PurchaseOrder[]        @relation("PurchaseOrderBuyer")
  counterpartyContractsResponsibleFor CounterpartyContract[]

  capitalInvestmentProjects CapitalInvestmentProject[]
  fixedAssets               FixedAsset[]
  costCenters               CostCenter[]

  @@index([tenantId, active])
  @@map("responsible_persons")
}

/// Structural warehouse master data ONLY (section 11/12) — no stock
/// balances or movements until Phase 10.
model Warehouse {
  id                  String  @id @default(uuid())
  tenantId            String  @map("tenant_id")
  organizationId      String  @map("organization_id")
  branchId            String? @map("branch_id")
  code                String
  name                String
  warehouseType       String  @default("STANDARD") @map("warehouse_type")
  address             String?
  responsiblePersonId String? @map("responsible_person_id")
  allowNegativeStock  Boolean @default(false) @map("allow_negative_stock")
  active              Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  organization Organization       @relation("OrgWarehouses", fields: [organizationId], references: [id])
  branch       Branch?            @relation(fields: [branchId], references: [id])
  responsible  ResponsiblePerson? @relation(fields: [responsiblePersonId], references: [id])

  defaultForOrganizations Organization[]     @relation("OrgDefaultWarehouse")
  salesOrders             SalesOrder[]
  stockReservations       StockReservation[]
  shipmentPlans           ShipmentPlan[]
  shipments               Shipment[]
  salesReturns            SalesReturn[]
  purchaseRequirements         PurchaseRequirement[]
  purchaseRequirementLines     PurchaseRequirementLine[]
  purchaseOrders                PurchaseOrder[]
  purchaseOrderLines            PurchaseOrderLine[]
  purchaseDeliveryScheduleLines PurchaseDeliveryScheduleLine[]
  goodsReceipts                  GoodsReceipt[]
  goodsReceiptLines               GoodsReceiptLine[]
  purchaseInvoiceLines            PurchaseInvoiceLine[]
  purchaseReturns                  PurchaseReturn[]
  locations                              WarehouseLocation[]
  inventoryMovements                       InventoryMovement[]
  transfersAsSource                          WarehouseTransfer[] @relation("TransferSource")
  transfersAsDestination                       WarehouseTransfer[] @relation("TransferDestination")
  internalConsumptions                           InternalConsumption[]
  inventoryAdjustments                             InventoryAdjustment[]
  inventoryStatusTransfers                           InventoryStatusTransfer[]
  currentSerialNumbers                                 SerialNumber[]

  inventoryCostLayers    InventoryCostLayer[]
  inventoryCostMovements InventoryCostMovement[]
  materialIssues         MaterialIssue[]
  productionOrders       ProductionOrder[]
  productionOutputReceipts ProductionOutputReceipt[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
  @@index([organizationId, branchId])
  @@map("warehouses")
}

/// Structural cashbox master data ONLY (section 13) — no cash balances or
/// movements until Phase 15.
/// Cash desk (spec Phase 15 section 4 — "CashDesk") — extends the
/// existing Phase 1 master-data-only Cashbox rather than a duplicate
/// table (spec section 2's own "don't duplicate").
model Cashbox {
  id                  String  @id @default(uuid())
  tenantId            String  @map("tenant_id")
  organizationId      String  @map("organization_id")
  branchId            String? @map("branch_id")
  code                String
  name                String
  currencyId          String  @map("currency_id")
  responsiblePersonId String? @map("responsible_person_id")
  active              Boolean @default(true)

  // Phase 15 treasury/cash-desk policy fields.
  cashDeskType             String  @default("MAIN_CASH") @map("cash_desk_type") // MAIN_CASH|PETTY_CASH|BRANCH_CASH|SALES_CASH|FOREIGN_CURRENCY_CASH|TEMPORARY_CASH
  allowMultiCurrency       Boolean @default(false) @map("allow_multi_currency")
  responsibleDepartmentId  String? @map("responsible_department_id")
  negativeBalancePolicy    String  @default("NEVER") @map("negative_balance_policy") // NEVER|WITH_PERMISSION|ALLOWED_FOR_MIGRATION_ONLY
  requireDailyClose        Boolean @default(true) @map("require_daily_close")
  requireDenominationCount Boolean @default(false) @map("require_denomination_count")
  maxCashLimit             Decimal? @map("max_cash_limit") @db.Decimal(18, 2)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  organization Organization       @relation("OrgCashboxes", fields: [organizationId], references: [id])
  branch       Branch?            @relation(fields: [branchId], references: [id])
  currency     Currency           @relation(fields: [currencyId], references: [id])
  responsible  ResponsiblePerson? @relation(fields: [responsiblePersonId], references: [id])

  defaultForOrganizations Organization[] @relation("OrgDefaultCashbox")

  cashierAssignments   CashierAssignment[]
  cashMovements        CashMovement[]
  settlementPayments   SettlementPayment[]
  cashDeskTransfersOut CashDeskTransfer[] @relation("CashTransferSource")
  cashDeskTransfersIn  CashDeskTransfer[] @relation("CashTransferDestination")
  physicalCounts       CashPhysicalCount[]
  denominationCounts   CashDenominationCount[]
  dailyCloses          CashDailyClose[]
  countAdjustments     CashCountAdjustment[]
  handovers            CashierHandover[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
  @@map("cashboxes")
}

/// Organization bank account MASTER DATA ONLY (section 14/15) — no
/// statements/payments/reconciliation until Phase 14.
model BankAccount {
  id                   String    @id @default(uuid())
  tenantId             String    @map("tenant_id")
  organizationId       String    @map("organization_id")
  bankName             String    @map("bank_name")
  bankCode             String?   @map("bank_code")
  branchName           String?   @map("branch_name")
  accountName          String    @map("account_name")
  iban                 String
  swiftBic             String?   @map("swift_bic")
  currencyId           String    @map("currency_id")
  correspondentAccount String?   @map("correspondent_account")
  accountType          String    @default("CURRENT") @map("account_type")
  isDefault            Boolean   @default(false) @map("is_default")
  active               Boolean   @default(true)
  openedDate           DateTime? @map("opened_date") @db.Date
  closedDate           DateTime? @map("closed_date") @db.Date

  // Phase 14 treasury policy (spec sections 21, 114-115) — per-account,
  // since minimum buffer and overdraft terms are never organization-wide.
  minimumBalance   Decimal? @map("minimum_balance") @db.Decimal(18, 2)
  overdraftAllowed Boolean  @default(false) @map("overdraft_allowed")
  overdraftLimit   Decimal? @map("overdraft_limit") @db.Decimal(18, 2)
  negativeBalancePolicy String @default("BLOCK") @map("negative_balance_policy") // ALLOW|WARNING|BLOCK
  bankPostingMode  String   @default("DOCUMENT_DRIVEN") @map("bank_posting_mode") // DOCUMENT_DRIVEN|STATEMENT_CONFIRMED (spec sections 89-92)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  organization Organization @relation("OrgBankAccounts", fields: [organizationId], references: [id])
  currency     Currency     @relation(fields: [currencyId], references: [id])

  defaultForOrganizations Organization[] @relation("OrgDefaultBankAccount")

  bankCashMovements   BankCashMovement[]
  settlementPayments  SettlementPayment[]
  paymentInstructions PaymentInstruction[]
  paymentCalendarItems PaymentCalendarItem[]
  bankReconciliations BankReconciliation[]
  bankStatements      BankStatement[]
  internalTransfersOut InternalBankTransfer[] @relation("TransferSourceAccount")
  internalTransfersIn  InternalBankTransfer[] @relation("TransferDestinationAccount")
  bankFees            BankFee[]
  fxConversionsSource FXConversion[] @relation("FxSourceAccount")
  fxConversionsDest   FXConversion[] @relation("FxDestinationAccount")
  paymentRequests     PaymentRequest[]

  @@index([organizationId, active])
  @@index([iban])
  @@map("bank_accounts")
}

/// Accounting policy METADATA + effective dating ONLY (section 16-18) — no
/// chart of accounts / journal entries / posting rules until Phase 4.
model AccountingPolicy {
  id                     String    @id @default(uuid())
  tenantId               String    @map("tenant_id")
  organizationId         String    @map("organization_id")
  code                   String
  name                   String
  validFrom              DateTime  @map("valid_from") @db.Date
  validTo                DateTime? @map("valid_to") @db.Date
  status                 String    @default("ACTIVE")
  inventoryCostingMethod String    @default("WEIGHTED_AVERAGE") @map("inventory_costing_method")
  baseCurrencyId         String?   @map("base_currency_id")
  taxProfileId           String?   @map("tax_profile_id")
  settings               Json?
  active                 Boolean   @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  organization Organization @relation("OrgAccountingPolicies", fields: [organizationId], references: [id])
  baseCurrency Currency?    @relation(fields: [baseCurrencyId], references: [id])
  taxProfile   TaxProfile?  @relation(fields: [taxProfileId], references: [id])

  @@unique([organizationId, code, validFrom])
  @@index([organizationId, validFrom, validTo])
  @@map("accounting_policies")
}

/// Organization tax identity/configuration FOUNDATION ONLY (section 19) —
/// no VAT rates / tax calculation / tax posting until Phase 5.
model TaxProfile {
  id                    String    @id @default(uuid())
  tenantId              String    @map("tenant_id")
  organizationId        String    @map("organization_id")
  code                  String
  name                  String
  countryCode           String    @default("AZ") @map("country_code")
  taxId                 String?   @map("tax_id")
  vatRegistered         Boolean   @default(false) @map("vat_registered")
  vatRegistrationDate   DateTime? @map("vat_registration_date") @db.Date
  vatDeregistrationDate DateTime? @map("vat_deregistration_date") @db.Date
  taxRegimeCode         String?   @map("tax_regime_code")
  validFrom             DateTime  @map("valid_from") @db.Date
  validTo               DateTime? @map("valid_to") @db.Date
  active                Boolean   @default(true)
  metadata              Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  version   Int      @default(1)

  organization       Organization       @relation("OrgTaxProfiles", fields: [organizationId], references: [id])
  accountingPolicies AccountingPolicy[]

  @@unique([organizationId, code, validFrom])
  @@index([organizationId, validFrom, validTo])
  @@map("tax_profiles")
}

/// Organization-scoped access grant (section 22): a tenant membership does
/// NOT automatically have access to every organization in the tenant —
/// access must be explicitly granted per organization.
model OrganizationAccess {
  id                 String  @id @default(uuid())
  tenantMembershipId String  @map("tenant_membership_id")
  organizationId     String  @map("organization_id")
  accessLevel        String  @default("FULL") @map("access_level")
  // This membership's home department within this organization — used to
  // auto-fill the department on documents the user creates (e.g. Purchase
  // Requirement) without requiring the user to type their own org chart.
  departmentId       String? @map("department_id")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  membership   TenantMembership @relation(fields: [tenantMembershipId], references: [id])
  organization Organization     @relation(fields: [organizationId], references: [id])
  department   Department?      @relation(fields: [departmentId], references: [id])

  @@unique([tenantMembershipId, organizationId])
  @@index([organizationId])
  @@map("organization_access")
}

enum MembershipStatus {
  ACTIVE
  DISABLED
  INVITED
}

/// Global system user, independent from tenant membership/authorization.
model User {
  id            String           @id @default(uuid())
  email         String           @unique
  passwordHash  String           @map("password_hash")
  displayName   String           @map("display_name")
  status        MembershipStatus @default(ACTIVE)
  locale        String           @default("az-AZ")
  timezone      String?
  isSystemAdmin Boolean          @default(false) @map("is_system_admin")
  lastLoginAt   DateTime?        @map("last_login_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships        TenantMembership[]
  refreshTokens      RefreshToken[]
  responsiblePersons ResponsiblePerson[]
  linkedEmployees    Employee[]

  @@map("users")
}

/// A user's membership inside a single tenant. Authorization (roles) is
/// attached here, never on the global User — a user may have different
/// rights in different tenants.
model TenantMembership {
  id         String           @id @default(uuid())
  tenantId   String           @map("tenant_id")
  userId     String           @map("user_id")
  status     MembershipStatus @default(ACTIVE)
  joinedAt   DateTime         @default(now()) @map("joined_at")
  disabledAt DateTime?        @map("disabled_at")

  tenant             Tenant               @relation(fields: [tenantId], references: [id])
  user               User                 @relation(fields: [userId], references: [id])
  roles              MembershipRole[]
  organizationAccess OrganizationAccess[]

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("tenant_memberships")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

// ----------------------------------------------------------------------------
// 6. ROLE BASED ACCESS CONTROL
// ----------------------------------------------------------------------------

/// Role is tenant-scoped (tenantId null => a system-level role template,
/// e.g. the seeded "Tenant Administrator" role definition source).
model Role {
  id          String  @id @default(uuid())
  tenantId    String? @map("tenant_id")
  code        String
  name        String
  description String?
  isSystem    Boolean @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at")

  tenant      Tenant?          @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  memberships MembershipRole[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("roles")
}

/// Explicit machine-readable permission codes (never hardcoded role-name checks).
model Permission {
  id          String  @id @default(uuid())
  code        String  @unique
  description String?
  module      String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Multiple roles per membership.
model MembershipRole {
  membershipId String @map("membership_id")
  roleId       String @map("role_id")

  membership TenantMembership @relation(fields: [membershipId], references: [id])
  role       Role             @relation(fields: [roleId], references: [id])

  assignedAt DateTime @default(now()) @map("assigned_at")

  @@id([membershipId, roleId])
  @@map("membership_roles")
}

// ----------------------------------------------------------------------------
// 3.4 / 52. ENUMERATION FOUNDATION
// Stable, language-neutral codes for extensible business enumerations.
// Closed, structurally-critical state machines (document/posting/period
// status) additionally use native Prisma enums below for compile-time
// safety; EnumType/EnumValue covers the open-ended, display-facing ones
// (e.g. currency rate type, numbering reset policy) and localized labels.
// ----------------------------------------------------------------------------

model EnumType {
  id          String  @id @default(uuid())
  code        String  @unique
  description String?

  values EnumValue[]

  @@map("enum_types")
}

model EnumValue {
  id         String  @id @default(uuid())
  enumTypeId String  @map("enum_type_id")
  code       String
  sortOrder  Int     @default(0) @map("sort_order")
  active     Boolean @default(true)

  enumType     EnumType               @relation(fields: [enumTypeId], references: [id])
  translations EnumValueTranslation[]

  @@unique([enumTypeId, code])
  @@map("enum_values")
}

model EnumValueTranslation {
  id          String @id @default(uuid())
  enumValueId String @map("enum_value_id")
  locale      String
  label       String

  enumValue EnumValue @relation(fields: [enumValueId], references: [id])

  @@unique([enumValueId, locale])
  @@map("enum_value_translations")
}

// ----------------------------------------------------------------------------
// 17/18. CURRENCY & EXCHANGE RATE FOUNDATION
// ----------------------------------------------------------------------------

/// Global currency master data (ISO 4217). Not tenant-owned: currencies are
/// shared reference data, but a Tenant may additionally register a
/// tenant-specific currency via `TenantCurrencies` if genuinely required.
model Currency {
  id            String  @id @default(uuid())
  code          String  @unique // ISO 4217 alpha code, e.g. AZN
  numericCode   String? @map("numeric_code")
  name          String
  symbol        String?
  decimalPlaces Int     @default(2) @map("decimal_places")
  active        Boolean @default(true)

  tenantsUsingAsBase Tenant[]
  tenantOverrides    Tenant[]       @relation("TenantCurrencies")
  exchangeRatesFrom  ExchangeRate[] @relation("FromCurrency")
  exchangeRatesTo    ExchangeRate[] @relation("ToCurrency")

  organizationsUsingAsBase Organization[]         @relation("OrganizationBaseCurrency")
  cashboxes                Cashbox[]
  bankAccounts             BankAccount[]
  accountingPolicies       AccountingPolicy[]
  counterparties           Counterparty[]
  priceLists               PriceList[]
  salesOrders              SalesOrder[]
  salesInvoices            SalesInvoice[]
  journalEntryLines        JournalEntryLine[]
  accountingMovements      AccountingMovement[]
  customerRequests         CustomerRequest[]
  commercialOffers         CommercialOffer[]
  orderPaymentSchedules    OrderPaymentSchedule[]
  settlementObligations    SettlementObligation[]
  salesReturns             SalesReturn[]
  purchaseOrders                PurchaseOrder[]
  purchaseOrderPaymentSchedules PurchaseOrderPaymentSchedule[]
  counterpartyBankAccounts      CounterpartyBankAccount[]
  counterpartyContracts         CounterpartyContract[]
  counterpartyContractAmendments CounterpartyContractAmendment[]
  counterpartyContractPaymentInstallments CounterpartyContractPaymentInstallment[]
  goodsReceipts                  GoodsReceipt[]
  purchaseInvoices                PurchaseInvoice[]
  supplierPayables                 SupplierPayable[]
  purchaseReturns                  PurchaseReturn[]
  additionalPurchaseCosts          AdditionalPurchaseCost[]
  inventoryCostingPolicies          InventoryCostingPolicy[]
  inventoryCostLayers                InventoryCostLayer[]

  settlementMovements   SettlementMovement[]
  settlementAdvances    SettlementAdvance[]
  settlementPayments    SettlementPayment[]
  debtAdjustments       DebtAdjustment[]
  settlementOffsets     SettlementOffset[]
  settlementReconciliations SettlementReconciliation[]
  paymentRequests       PaymentRequest[]
  internalBankTransfers InternalBankTransfer[]
  bankFees              BankFee[]

  capitalInvestmentProjects CapitalInvestmentProject[]
  fixedAssets               FixedAsset[]
  payrollCompensationAssignments EmployeeCompensationAssignment[]

  fxRevaluationItems     FXRevaluationItem[]
  periodAccruals         PeriodAccrual[]
  deferredRevenueSchedules DeferredRevenueSchedule[]
  financialReportRuns    FinancialReportRun[]
  financialReportCells   FinancialReportCell[]
  budgetVersions         BudgetVersion[]

  @@map("currencies")
}

model ExchangeRate {
  id             String   @id @default(uuid())
  tenantId       String?  @map("tenant_id") // null = system-level shared rate
  currencyId     String   @map("currency_id")
  baseCurrencyId String   @map("base_currency_id")
  effectiveDate  DateTime @map("effective_date") @db.Date
  rate           Decimal  @db.Decimal(24, 10)
  multiplier     Decimal  @default(1) @db.Decimal(18, 6)
  divisor        Decimal  @default(1) @db.Decimal(18, 6)
  rateType       String   @default("OFFICIAL") @map("rate_type")
  source         String?

  createdAt DateTime @default(now()) @map("created_at")

  tenant       Tenant?  @relation(fields: [tenantId], references: [id])
  currency     Currency @relation("FromCurrency", fields: [currencyId], references: [id])
  baseCurrency Currency @relation("ToCurrency", fields: [baseCurrencyId], references: [id])

  @@unique([tenantId, currencyId, baseCurrencyId, effectiveDate, rateType], map: "uq_exchange_rate_scope")
  @@index([tenantId, currencyId, effectiveDate])
  @@map("exchange_rates")
}

// ----------------------------------------------------------------------------
// 15/16. NUMBERING ENGINE
// ----------------------------------------------------------------------------

model NumberSequence {
  id           String  @id @default(uuid())
  tenantId     String  @map("tenant_id")
  code         String
  documentType String  @map("document_type")
  prefix       String  @default("")
  suffix       String? @default("")
  nextNumber   BigInt  @default(1) @map("next_number")
  padding      Int     @default(6)
  resetPolicy  String  @default("NEVER") @map("reset_policy") // NEVER | YEARLY | MONTHLY
  scopeType    String  @default("TENANT_DOCUMENT_TYPE") @map("scope_type")
  currentYear  Int?    @map("current_year")
  currentMonth Int?    @map("current_month")
  active       Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  version   Int      @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
  @@index([tenantId, documentType])
  @@map("number_sequences")
}

// ----------------------------------------------------------------------------
// 20/21/22. ACCOUNTING / BUSINESS PERIOD FOUNDATION
// ----------------------------------------------------------------------------

enum PeriodStatus {
  OPEN
  SOFT_CLOSED
  CLOSED
}

model AccountingPeriod {
  id             String       @id @default(uuid())
  tenantId       String       @map("tenant_id")
  organizationId String?      @map("organization_id")
  year           Int
  month          Int
  startDate      DateTime     @map("start_date") @db.Date
  endDate        DateTime     @map("end_date") @db.Date
  status         PeriodStatus @default(OPEN)
  closedAt       DateTime?    @map("closed_at")
  closedBy       String?      @map("closed_by")
  reopenedAt     DateTime?    @map("reopened_at")
  reopenedBy     String?      @map("reopened_by")
  version        Int          @default(1)

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@unique([tenantId, organizationId, year, month])
  @@index([tenantId, startDate, endDate])
  @@map("accounting_periods")
}

// ----------------------------------------------------------------------------
// 23/24/25. AUDIT INFRASTRUCTURE
// ----------------------------------------------------------------------------

model AuditEvent {
  id             String   @id @default(uuid())
  tenantId       String?  @map("tenant_id") // null only for platform/system-admin events
  eventType      String   @map("event_type")
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  action         String
  userId         String?  @map("user_id")
  timestamp      DateTime @default(now())
  requestId      String?  @map("request_id")
  correlationId  String?  @map("correlation_id")
  ipAddress      String?  @map("ip_address")
  clientMetadata Json?    @map("client_metadata")
  oldValues      Json?    @map("old_values")
  newValues      Json?    @map("new_values")
  metadata       Json?
  reason         String?

  // Phase 25 — Audit / Change History / Traceability / Evidence Platform.
  // All additive/nullable so every pre-existing `audit.record(...)` call
  // site across every prior phase remains valid without modification
  // (docs/AUDIT_TRAIL.md section A).
  organizationId        String?   @map("organization_id")
  eventCategory         String?   @map("event_category") // MASTER_DATA|DOCUMENT|POSTING|ACCOUNTING|REGISTER|WORKFLOW|SECURITY|AUTHENTICATION|ACCESS|CONFIGURATION|IMPORT_EXPORT|INTEGRATION|PERIOD_CLOSE|FINANCIAL_REPORT|PAYROLL|INVENTORY|PRODUCTION|ADMINISTRATION|SYSTEM
  effectiveBusinessDate DateTime? @map("effective_business_date") @db.Date
  actorType             String    @default("USER") @map("actor_type") // USER|SYSTEM|SERVICE_ACCOUNT|API_CLIENT|INTEGRATION|SCHEDULED_JOB|MIGRATION|SUPPORT_ADMIN|AI_AGENT
  actorSnapshot         Json?     @map("actor_snapshot") // {username, roleContext, organizationContext} captured at event time (spec section 15)
  realActorId           String?   @map("real_actor_id") // set only during impersonation — the true actor behind an impersonated session (spec section 90)
  sessionId             String?   @map("session_id")
  sourceType            String    @default("APPLICATION") @map("source_type") // APPLICATION|API|SCHEDULED_JOB|MIGRATION|INTEGRATION
  sourceApplication     String?   @map("source_application")
  causationId           String?   @map("causation_id") // the audit event that CAUSED this one (spec section 18)
  documentType          String?   @map("document_type")
  documentId            String?   @map("document_id")
  operation             String?   // CREATE|UPDATE|POST|UNPOST|REVERSE|CANCEL|APPROVE|REJECT|CLOSE|REOPEN|... (spec section 6)
  severity              String    @default("INFO") @map("severity") // INFO|WARNING|CRITICAL
  success               Boolean   @default(true)
  failureCode           String?   @map("failure_code")
  entityVersionBefore   Int?      @map("entity_version_before")
  entityVersionAfter    Int?      @map("entity_version_after")
  backdated             Boolean   @default(false) // spec section 36 — entered_at != effective date
  integrityHash         String?   @map("integrity_hash") // sha256 over this event's own canonical fields + previousEventHash
  previousEventHash     String?   @map("previous_event_hash") // per-tenant hash chain (spec sections 81-83)

  tenant           Tenant?                @relation(fields: [tenantId], references: [id])
  fieldChanges     AuditFieldChange[]
  evidenceLinks    AuditEvidence[]
  investigationItems AuditInvestigationItem[]

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, timestamp])
  @@index([tenantId, eventCategory, timestamp])
  @@index([tenantId, correlationId])
  @@index([tenantId, causationId])
  @@index([tenantId, documentType, documentId])
  @@index([tenantId, sessionId])
  @@map("audit_events")
}

model AuditFieldChange {
  id                  String  @id @default(uuid())
  tenantId            String? @map("tenant_id")
  auditEventId        String  @map("audit_event_id")
  fieldPath           String  @map("field_path") // e.g. "lines[line_id=abc].quantity" (spec section 9 — stable ids, never index-based)
  changeType          String  @default("ITEM_UPDATED") @map("change_type") // ITEM_ADDED|ITEM_REMOVED|ITEM_UPDATED|ITEM_REORDERED
  oldValue            Json?   @map("old_value")
  newValue            Json?   @map("new_value")
  valueType           String  @default("STRING") @map("value_type")
  isSensitive         Boolean @default(false) @map("is_sensitive")
  redactionPolicy     String? @map("redaction_policy")
  normalizedOldHash   String? @map("normalized_old_hash")
  normalizedNewHash   String? @map("normalized_new_hash")

  tenant     Tenant?    @relation(fields: [tenantId], references: [id])
  auditEvent AuditEvent @relation(fields: [auditEventId], references: [id])

  @@index([tenantId, auditEventId])
  @@map("audit_field_changes")
}

model AuditSession {
  id                     String    @id @default(uuid())
  tenantId               String?   @map("tenant_id")
  userId                 String    @map("user_id")
  loginTime              DateTime  @default(now()) @map("login_time")
  logoutTime             DateTime? @map("logout_time")
  authenticationMethod   String?   @map("authentication_method")
  deviceClient           String?   @map("device_client")
  ipAddress              String?   @map("ip_address")
  userAgent              String?   @map("user_agent")
  application            String?
  impersonationContext   Json?     @map("impersonation_context") // {realActorId, reason} when a support admin impersonates
  elevatedPrivilege      Boolean   @default(false) @map("elevated_privilege")
  status                 String    @default("ACTIVE") // ACTIVE|LOGGED_OUT|REVOKED

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId, userId, loginTime])
  @@map("audit_sessions")
}

model AuditEvidence {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  auditEventId   String?   @map("audit_event_id")
  linkedEntityType String? @map("linked_entity_type") // DOCUMENT|INVESTIGATION|CLOSE_ISSUE|REPORT|CONFIGURATION_CHANGE
  linkedEntityId String?   @map("linked_entity_id")
  evidenceType   String    @default("ATTACHMENT") @map("evidence_type") // ATTACHMENT|SIGNED_DOCUMENT|RECEIPT|INVOICE|APPROVAL_NOTE|EXTERNAL_STATEMENT|BANK_STATEMENT|TAX_FILING_CONFIRMATION
  fileName       String?   @map("file_name")
  mediaType      String?   @map("media_type")
  sizeBytes      Int?      @map("size_bytes")
  fileHash       String    @map("file_hash") // sha256 of file content — spec section 59
  classification String    @default("INTERNAL") // e.g. INTERNAL|CONFIDENTIAL|RESTRICTED
  retentionClass String?   @map("retention_class")
  version        Int       @default(1)
  supersedesEvidenceId String? @map("supersedes_evidence_id") // replacement creates a NEW version (spec section 58) rather than editing this one
  immutable      Boolean   @default(false) // true once used by a FINAL/SIGNED material event (spec section 58)
  uploadedBy     String    @map("uploaded_by")
  uploadedAt     DateTime  @default(now()) @map("uploaded_at")
  source         String?   // where the file came from, e.g. "USER_UPLOAD"|"BANK_STATEMENT_IMPORT"

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  auditEvent AuditEvent? @relation(fields: [auditEventId], references: [id])

  @@index([tenantId, linkedEntityType, linkedEntityId])
  @@map("audit_evidence")
}

model AuditInvestigation {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  title        String
  description  String?
  category     String?
  severity     String    @default("MEDIUM") // LOW|MEDIUM|HIGH|CRITICAL
  openedBy     String    @map("opened_by")
  openedAt     DateTime  @default(now()) @map("opened_at")
  assignedTo   String?   @map("assigned_to")
  status       String    @default("OPEN") // OPEN|IN_REVIEW|EVIDENCE_COLLECTION|ESCALATED|RESOLVED|CLOSED
  legalHoldId  String?   @map("legal_hold_id")
  conclusion   String?
  closedAt     DateTime? @map("closed_at")

  tenant     Tenant                    @relation(fields: [tenantId], references: [id])
  legalHold  AuditLegalHold?           @relation(fields: [legalHoldId], references: [id])
  items      AuditInvestigationItem[]

  @@index([tenantId, status])
}

model AuditInvestigationItem {
  id               String  @id @default(uuid())
  tenantId         String  @map("tenant_id")
  investigationId  String  @map("investigation_id")
  itemType         String  @map("item_type") // AUDIT_EVENT|DOCUMENT|MOVEMENT|USER|SESSION|REPORT|EVIDENCE
  auditEventId     String? @map("audit_event_id")
  referenceType    String? @map("reference_type")
  referenceId      String? @map("reference_id")
  note             String?
  addedBy          String  @map("added_by")

  createdAt DateTime @default(now()) @map("created_at")

  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  investigation AuditInvestigation @relation(fields: [investigationId], references: [id])
  auditEvent   AuditEvent?        @relation(fields: [auditEventId], references: [id])

  @@index([tenantId, investigationId])
}

model AuditRetentionPolicy {
  id                 String    @id @default(uuid())
  tenantId           String    @map("tenant_id")
  eventCategory      String?   @map("event_category")
  jurisdiction       String?
  organizationId     String?   @map("organization_id")
  retentionPeriodDays Int      @map("retention_period_days")
  archivePolicy      String    @default("ARCHIVE") @map("archive_policy") // ARCHIVE|ANONYMIZE|PURGE
  legalHoldBehavior  String    @default("BLOCK_PURGE") @map("legal_hold_behavior")
  purgeBehavior      String    @default("NEVER_AUTO") @map("purge_behavior") // NEVER_AUTO|POLICY_DRIVEN
  effectiveFrom      DateTime  @default(now()) @map("effective_from") @db.Date
  effectiveTo        DateTime? @map("effective_to") @db.Date

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, eventCategory])
}

model AuditLegalHold {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  scope         Json // {userId?, customerId?, documentType?, documentId?, period?, organizationId?, investigationId?, dateFrom?, dateTo?, eventCategory?} (spec section 95)
  reason        String
  openedBy      String    @map("opened_by")
  openedAt      DateTime  @default(now()) @map("opened_at")
  expiresAt     DateTime? @map("expires_at")
  status        String    @default("ACTIVE") // ACTIVE|RELEASED
  legalReference String?  @map("legal_reference")
  notes         String?
  releasedBy    String?   @map("released_by")
  releasedAt    DateTime? @map("released_at")

  tenant         Tenant               @relation(fields: [tenantId], references: [id])
  investigations AuditInvestigation[]

  @@index([tenantId, status])
}

model AuditIntegrityCheckpoint {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  scope            String   @default("TENANT") // TENANT|CATEGORY|HIGH_ASSURANCE
  period           String // e.g. YYYY-MM-DD or YYYY-MM
  firstEventId     String?  @map("first_event_id")
  lastEventId      String?  @map("last_event_id")
  eventCount       Int      @map("event_count")
  rootHash         String   @map("root_hash")
  generatedAt      DateTime @default(now()) @map("generated_at")
  verificationStatus String @default("VALID") @map("verification_status") // VALID|INVALID|NOT_VERIFIED

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, scope, period])
}

model AuditExportPackage {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  title          String
  filterCriteria Json     @map("filter_criteria")
  eventCount     Int      @map("event_count")
  redacted       Boolean  @default(false)
  packageHash    String   @map("package_hash")
  payload        Json // the frozen bundle: events + diffs + evidence refs + lineage + integrity proof
  generatedBy    String   @map("generated_by")
  generatedAt    DateTime @default(now()) @map("generated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, generatedAt])
}

// ----------------------------------------------------------------------------
// 26/27/28/29. DOCUMENT RELATIONSHIP FOUNDATION / CREATE BASED ON / REVERSAL
// ----------------------------------------------------------------------------

model DocumentLink {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  sourceDocumentType String   @map("source_document_type")
  sourceDocumentId   String   @map("source_document_id")
  targetDocumentType String   @map("target_document_type")
  targetDocumentId   String   @map("target_document_id")
  relationType       String   @map("relation_type") // CREATED_BASED_ON | RELATED | REVERSAL_OF | CORRECTION_OF | DERIVED_FROM | REFERENCES | FULFILLS | SETTLES | CORRECTS | REPLACES | SPLIT_FROM | MERGED_FROM | GENERATED_BY_SYSTEM (Phase 27, docs/DOCUMENT_CHAIN.md section A — superset added additively; existing 4 values keep their exact meaning for every pre-existing CreateBasedOnService call site)
  createdAt          DateTime @default(now()) @map("created_at")
  createdBy          String?  @map("created_by")
  metadata           Json?
  // --- Phase 27 additions (all nullable — the Phase 0 CreateBasedOnService
  // insert path is untouched and never populates any of these) ---
  transformationVersionId String? @map("transformation_version_id")
  status                  String  @default("ACTIVE") @map("status") // ACTIVE|SUPERSEDED|REVERSED
  correlationId           String? @map("correlation_id")

  tenant  Tenant                         @relation(fields: [tenantId], references: [id])
  version DocumentTransformationVersion? @relation(fields: [transformationVersionId], references: [id])
  lineLinks DocumentLineLink[] @relation("DocumentLinkLineLinks")

  @@index([tenantId, sourceDocumentType, sourceDocumentId])
  @@index([tenantId, targetDocumentType, targetDocumentId])
  @@index([tenantId, relationType])
  @@map("document_links")
}

// ----------------------------------------------------------------------------
// 32/33. CONFIGURATION / SETTINGS (scoped + effective-dated)
// ----------------------------------------------------------------------------

enum SettingScope {
  SYSTEM
  TENANT
  ORGANIZATION
}

/// Effective-dated, scoped settings. Resolution picks the row whose scope
/// matches and whose [validFrom, validTo) window contains the business date
/// in question (see SettingsService.resolve()).
model Setting {
  id        String       @id @default(uuid())
  scope     SettingScope
  scopeId   String?      @map("scope_id") // null for SYSTEM scope
  key       String
  value     Json
  validFrom DateTime     @default(dbgenerated("'1970-01-01'")) @map("valid_from") @db.Date
  validTo   DateTime?    @map("valid_to") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant Tenant? @relation(fields: [scopeId], references: [id], map: "settings_tenant_scope_fkey")

  @@index([scope, scopeId, key, validFrom])
  @@map("settings")
}

// ----------------------------------------------------------------------------
// 36. IDEMPOTENCY FOUNDATION
// ----------------------------------------------------------------------------

model IdempotencyKey {
  id           String  @id @default(uuid())
  tenantId     String? @map("tenant_id")
  key          String
  operation    String
  requestHash  String  @map("request_hash")
  status       String  @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED | FAILED
  resultRef    String? @map("result_ref")
  responseBody Json?   @map("response_body")

  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime? @map("expires_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key, operation])
  @@map("idempotency_keys")
}

// ----------------------------------------------------------------------------
// 3.3 / 64. REGISTER FOUNDATION (contracts only — no business registers yet)
// A generic movement table used solely by the demo posting handler to prove
// the posting framework end to end. Real business registers (Stock,
// Settlement, Accounting, Payroll...) will define their own strongly-typed
// tables in later phases and reuse this same recorder/ownership shape.
// ----------------------------------------------------------------------------

model RegisterMovement {
  id                   String   @id @default(uuid())
  tenantId             String   @map("tenant_id")
  registerCode         String   @map("register_code")
  recorderDocumentType String   @map("recorder_document_type")
  recorderDocumentId   String   @map("recorder_document_id")
  recorderLineId       String?  @map("recorder_line_id")
  businessDate         DateTime @map("business_date") @db.Date
  postingTimestamp     DateTime @default(now()) @map("posting_timestamp")
  sequence             BigInt
  movementType         String?  @map("movement_type")
  dimensions           Json?
  resources            Json?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, recorderDocumentType, recorderDocumentId])
  @@index([tenantId, registerCode, businessDate])
  @@map("register_movements")
}

// ----------------------------------------------------------------------------
// 8/9/10/58. DOCUMENT BASE MODEL — DEMO/REFERENCE DOCUMENT
//
// FoundationTestDocument is the ONLY concrete document table in Phase 0.
// It exists purely to exercise the framework (save/post/unpost/numbering/
// audit/period-guard/document-links) end to end. It must not be treated as
// a production business feature. Every field below mirrors the reusable
// BaseDocument contract defined in `src/document-framework/base-document.ts`
// — later phases copy this same field set into their own concrete tables
// rather than inheriting from a single generic "documents" table.
// ----------------------------------------------------------------------------

enum DocumentStatus {
  DRAFT
  ACTIVE
  CANCELLED
  DELETION_MARKED
}

enum PostingStatus {
  NOT_POSTED
  POSTED
  POSTING_FAILED
}

// ----------------------------------------------------------------------------
// Approval workflow MVP (scoped subset of the eventual Phase 26 engine) —
// see docs/APPROVALS.md. approvalStatus is a THIRD axis independent of
// DocumentStatus/PostingStatus: approving a document never posts it, and
// posting is gated on approvalStatus for document types that opt in.
// ----------------------------------------------------------------------------

enum ApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum ApprovalStepStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

enum ApprovalStepType {
  PROCUREMENT_OFFICER
  DEPARTMENT_HEAD
  DIRECTOR
  FINANCE
  ACCOUNTING
  WAREHOUSE_SUPERVISOR
}

/// One row per required approval on a given document instance. documentType +
/// documentId is a polymorphic reference (same convention as RegisterMovement
/// / document-framework), not a real FK, since it spans unrelated tables.
model ApprovalStep {
  id           String             @id @default(uuid())
  tenantId     String             @map("tenant_id")
  documentType String             @map("document_type")
  documentId   String             @map("document_id")
  sequence     Int                @default(0)
  stepType     ApprovalStepType   @map("step_type")
  status       ApprovalStepStatus @default(PENDING)
  approvedBy   String?            @map("approved_by")
  approvedAt   DateTime?          @map("approved_at")
  comment      String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, documentType, documentId, sequence])
  @@map("approval_steps")
}

model FoundationTestDocument {
  id             String         @id @default(uuid())
  tenantId       String         @map("tenant_id")
  organizationId String?        @map("organization_id")
  documentType   String         @default("FOUNDATION_TEST_DOCUMENT") @map("document_type")
  number         String?
  documentDate   DateTime       @map("document_date") @db.Date
  postingDate    DateTime?      @map("posting_date") @db.Date
  status         DocumentStatus @default(DRAFT)
  postingStatus  PostingStatus  @default(NOT_POSTED) @map("posting_status")
  currencyId     String?        @map("currency_id")
  exchangeRate   Decimal?       @map("exchange_rate") @db.Decimal(24, 10)
  amount         Decimal        @default(0) @db.Decimal(18, 2)
  description    String?

  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by")
  postedAt     DateTime? @map("posted_at")
  postedBy     String?   @map("posted_by")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelledBy  String?   @map("cancelled_by")
  deletionMark Boolean   @default(false) @map("deletion_mark")
  version      Int       @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, number])
  @@index([tenantId, documentDate])
  @@index([tenantId, status])
  @@map("foundation_test_documents")
}

// ----------------------------------------------------------------------------
// PHASE 2 — PRODUCT/NOMENCLATURE MASTER DATA
//
// Foundation for product catalog management: units of measure, product
// categories (hierarchical), and products. This is master data only —
// no inventory movements, pricing, or stock balances yet (those belong
// to later phases). Products are organization-scoped following the Phase 1
// pattern: a product belongs to exactly one organization.
// ----------------------------------------------------------------------------

/// Unit of Measure — tenant-level shared resource (section 79).
/// Basic measurement units (kg, piece, liter, meter, etc.) that products
/// reference. No conversion factors yet (Phase 3+).
model UnitOfMeasure {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  code        String
  name        String
  symbol      String? // kg, pcs, L, m
  unitType    String  @default("QUANTITY") @map("unit_type") // QUANTITY | WEIGHT | VOLUME | LENGTH | AREA | TIME
  description String?
  active      Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  tenant               Tenant                @relation(fields: [tenantId], references: [id])
  products             Product[]
  conversionsFrom      UnitConversion[]      @relation("ConversionFromUnit")
  conversionsTo        UnitConversion[]      @relation("ConversionToUnit")
  productPrices        ProductPrice[]        @relation("ProductPriceUnit")
  salesOrderLines      SalesOrderLine[]      @relation("SalesOrderLineUnit")
  salesInvoiceLines    SalesInvoiceLine[]    @relation("SalesInvoiceLineUnit")
  journalEntryLines    JournalEntryLine[]
  accountingMovements  AccountingMovement[]
  customerRequestLines CustomerRequestLine[] @relation("CustomerRequestLineUnit")
  commercialOfferLines CommercialOfferLine[] @relation("CommercialOfferLineUnit")
  shipmentLines        ShipmentLine[]        @relation("ShipmentLineUnit")
  salesReturnLines     SalesReturnLine[]     @relation("SalesReturnLineUnit")
  purchaseRequirementLines PurchaseRequirementLine[] @relation("PurchaseRequirementLineUnit")
  purchaseOrderLines       PurchaseOrderLine[]       @relation("PurchaseOrderLineUnit")
  counterpartyContractLines CounterpartyContractLine[]
  supplierProductCodes     SupplierProductCode[]     @relation("SupplierProductCodeUnit")
  goodsReceiptLines        GoodsReceiptLine[]        @relation("GoodsReceiptLineUnit")
  purchaseInvoiceLines     PurchaseInvoiceLine[]     @relation("PurchaseInvoiceLineUnit")
  purchaseReturnLines      PurchaseReturnLine[]      @relation("PurchaseReturnLineUnit")
  inventoryMovements            InventoryMovement[]            @relation("InventoryMovementUnit")
  warehouseTransferLines          WarehouseTransferLine[]          @relation("WarehouseTransferLineUnit")
  internalConsumptionLines          InternalConsumptionLine[]          @relation("InternalConsumptionLineUnit")
  inventoryAdjustmentLines            InventoryAdjustmentLine[]            @relation("InventoryAdjustmentLineUnit")
  inventoryStatusTransferLines          InventoryStatusTransferLine[]          @relation("InventoryStatusTransferLineUnit")

  @@unique([tenantId, code])
  @@index([tenantId, active])
  @@map("units_of_measure")
}

/// Product Category — hierarchical classification (section 80).
/// Organization-scoped category tree (parent-child relationships).
/// Cycles are validated at the service layer.
model ProductCategory {
  id               String  @id @default(uuid())
  tenantId         String  @map("tenant_id")
  organizationId   String  @map("organization_id")
  parentCategoryId String? @map("parent_category_id")
  code             String
  name             String
  description      String?
  active           Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  organization    Organization      @relation(fields: [organizationId], references: [id])
  parentCategory  ProductCategory?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id])
  childCategories ProductCategory[] @relation("CategoryHierarchy")
  products        Product[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
  @@index([organizationId, parentCategoryId])
  @@map("product_categories")
}

enum ProductType {
  GOODS // Physical goods (inventory tracked)
  SERVICE // Services (no inventory)
  WORK // Work/labor
  SET // Product set/bundle (Phase 3+)
}

/// Product — organization-scoped product master data (section 81-84).
/// Master data only: no stock balances, no pricing, no supplier/customer
/// references yet (those are Phase 3+). A product's identity must stay
/// stable once transactional documents reference it: deactivate rather
/// than repurpose.
model Product {
  id             String      @id @default(uuid())
  tenantId       String      @map("tenant_id")
  organizationId String      @map("organization_id")
  categoryId     String?     @map("category_id")
  code           String
  name           String
  fullName       String?     @map("full_name")
  productType    ProductType @default(GOODS) @map("product_type")
  baseUnitId     String      @map("base_unit_id") // primary UOM
  description    String?
  sku            String? // Stock Keeping Unit
  barcode        String?
  manufacturer   String?
  brand          String?
  model          String?
  weight         Decimal?    @db.Decimal(18, 6)
  weightUnitId   String?     @map("weight_unit_id")
  volume         Decimal?    @db.Decimal(18, 6)
  volumeUnitId   String?     @map("volume_unit_id")

  // Inventory tracking flags (Phase 10 uses these)
  trackInventory     Boolean @default(true) @map("track_inventory")
  allowNegativeStock Boolean @default(false) @map("allow_negative_stock")

  // Phase 10 — batch/serial tracking mode: NONE|OPTIONAL|REQUIRED
  batchTrackingMode  String   @default("NONE") @map("batch_tracking_mode")
  serialTrackingMode String   @default("NONE") @map("serial_tracking_mode")
  minimumStock       Decimal? @map("minimum_stock") @db.Decimal(18, 6)
  maximumStock       Decimal? @map("maximum_stock") @db.Decimal(18, 6)
  reorderPoint       Decimal? @map("reorder_point") @db.Decimal(18, 6)
  safetyStock        Decimal? @map("safety_stock") @db.Decimal(18, 6)

  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  tenant               Tenant                @relation(fields: [tenantId], references: [id])
  organization         Organization          @relation(fields: [organizationId], references: [id])
  category             ProductCategory?      @relation(fields: [categoryId], references: [id])
  baseUnit             UnitOfMeasure         @relation(fields: [baseUnitId], references: [id])
  prices               ProductPrice[]
  salesOrderLines      SalesOrderLine[]
  salesInvoiceLines    SalesInvoiceLine[]
  taxProfiles          ProductTaxProfile[]
  customerRequestLines CustomerRequestLine[]
  commercialOfferLines CommercialOfferLine[]
  stockReservations    StockReservation[]
  shipmentLines        ShipmentLine[]
  salesReturnLines     SalesReturnLine[]
  purchaseRequirementLines PurchaseRequirementLine[]
  purchaseOrderLines       PurchaseOrderLine[]
  counterpartyContractLines CounterpartyContractLine[]
  supplierProductCodes     SupplierProductCode[]
  goodsReceiptLines         GoodsReceiptLine[]
  purchaseInvoiceLines      PurchaseInvoiceLine[]
  purchaseReturnLines       PurchaseReturnLine[]
  batches                        Batch[]
  serialNumbers                   SerialNumber[]
  inventoryMovements               InventoryMovement[]
  warehouseTransferLines             WarehouseTransferLine[]
  internalConsumptionLines            InternalConsumptionLine[]
  inventoryAdjustmentLines              InventoryAdjustmentLine[]
  inventoryStatusTransferLines            InventoryStatusTransferLine[]

  inventoryCostLayers          InventoryCostLayer[]
  inventoryCostMovements        InventoryCostMovement[]
  inventoryCostAdjustmentLines   InventoryCostAdjustmentLine[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
  @@index([organizationId, categoryId])
  @@index([tenantId, sku])
  @@index([tenantId, barcode])
  @@map("products")
}

// ----------------------------------------------------------------------------
// PHASE 3 — COUNTERPARTY MASTER DATA + PRICING
//
// Foundation for customer/supplier management and pricing: unit conversions,
// counterparties (customers, suppliers, both), contact persons, addresses,
// price lists, and product prices. This is master data only — no sales orders,
// purchase orders, invoices, or payments yet (those belong to Phase 4+).
// ----------------------------------------------------------------------------

/// Unit Conversion — defines conversion factors between units (section 85).
/// Example: 1 kg = 1000 g, 1 box = 12 pieces
/// Conversions are tenant-scoped since measurement standards are standardized
/// at the tenant level.
model UnitConversion {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  fromUnitId  String  @map("from_unit_id")
  toUnitId    String  @map("to_unit_id")
  factor      Decimal @db.Decimal(18, 6) // fromUnit * factor = toUnit
  description String?
  active      Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  fromUnit UnitOfMeasure @relation("ConversionFromUnit", fields: [fromUnitId], references: [id])
  toUnit   UnitOfMeasure @relation("ConversionToUnit", fields: [toUnitId], references: [id])

  @@unique([tenantId, fromUnitId, toUnitId])
  @@index([tenantId, active])
  @@map("unit_conversions")
}

enum CounterpartyType {
  CUSTOMER // Sells to
  SUPPLIER // Buys from
  BOTH // Both customer and supplier
}

/// Counterparty — organization-scoped customer/supplier master data (section 86-89).
/// A counterparty can be a customer, supplier, or both. This is master data only:
/// no invoices, orders, or payment history yet (Phase 4+).
model Counterparty {
  id                 String           @id @default(uuid())
  tenantId           String           @map("tenant_id")
  organizationId     String           @map("organization_id")
  counterpartyType   CounterpartyType @map("counterparty_type")
  code               String
  name               String
  fullLegalName      String?          @map("full_legal_name")
  taxId              String?          @map("tax_id")
  registrationNumber String?          @map("registration_number")
  phone              String?
  email              String?
  website            String?
  paymentTerms       Int?             @map("payment_terms") // days
  creditLimit        Decimal?         @map("credit_limit") @db.Decimal(18, 2)
  currencyId         String?          @map("currency_id")
  notes              String?
  active             Boolean          @default(true)

  // "Kontragentlər" module (residency/VAT/approval workflow) — see
  // docs/COUNTERPARTY_MANAGEMENT.md. `taxId` here is always the LOCAL VÖEN
  // (residents only, uniquely enforced per organization below);
  // non-residents use `foreignTaxId` instead — never both required.
  residencyStatus String  @default("RESIDENT") @map("residency_status") // RESIDENT|NON_RESIDENT
  vatPayer        Boolean @default(false) @map("vat_payer")
  countryCode     String? @map("country_code") // ISO-3166 alpha-2, e.g. AZ
  foreignTaxId    String? @map("foreign_tax_id") // non-resident: foreign tax/registration number

  // DRAFT|PENDING_APPROVAL|APPROVED|ACTIVE|EXPIRED|CANCELLED (spec section 9)
  status      String    @default("DRAFT")
  approvedBy  String?   @map("approved_by")
  approvedAt  DateTime? @map("approved_at")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  tenant                Tenant                  @relation(fields: [tenantId], references: [id])
  organization          Organization            @relation(fields: [organizationId], references: [id])
  currency              Currency?               @relation(fields: [currencyId], references: [id])
  addresses             CounterpartyAddress[]
  contacts              CounterpartyContact[]
  bankAccounts          CounterpartyBankAccount[]
  contracts             CounterpartyContract[]
  priceLists            PriceList[]
  salesOrders           SalesOrder[]
  salesInvoices         SalesInvoice[]
  taxProfile            CounterpartyTaxProfile?
  customerRequests      CustomerRequest[]
  commercialOffers      CommercialOffer[]
  shipments             Shipment[]
  settlementObligations SettlementObligation[]
  salesReturns          SalesReturn[]
  purchaseOrders                    PurchaseOrder[]
  supplierProductCodes              SupplierProductCode[]
  preferredForRequirementLines      PurchaseRequirementLine[] @relation("PreferredSupplierForRequirementLine")
  goodsReceipts                     GoodsReceipt[]
  purchaseInvoices                  PurchaseInvoice[]
  supplierPayables                  SupplierPayable[]
  purchaseReturns                   PurchaseReturn[]
  additionalPurchaseCosts           AdditionalPurchaseCost[]
  inventoryMovementsAsOwner               InventoryMovement[]

  settlementMovements   SettlementMovement[]
  settlementAllocations SettlementAllocation[]
  settlementAdvances    SettlementAdvance[]
  settlementPayments    SettlementPayment[]
  debtAdjustments       DebtAdjustment[]
  settlementOffsets     SettlementOffset[]
  settlementReconciliations SettlementReconciliation[]
  paymentRequests       PaymentRequest[]

  fixedAssetDisposals FixedAssetDisposal[]

  @@unique([organizationId, code])
  @@unique([organizationId, taxId])
  @@index([organizationId, active])
  @@index([organizationId, counterpartyType])
  @@index([organizationId, status])
  @@index([tenantId, taxId])
  @@map("counterparties")
}

enum AddressType {
  LEGAL // Legal/registered address
  ACTUAL // Actual/physical address (Faktiki ünvan)
  SHIPPING // Shipping address
  BILLING // Billing address
  OTHER // Other
}

/// Counterparty Address — delivery/billing addresses for counterparties.
model CounterpartyAddress {
  id             String      @id @default(uuid())
  tenantId       String      @map("tenant_id")
  counterpartyId String      @map("counterparty_id")
  addressType    AddressType @map("address_type")
  addressLine1   String      @map("address_line1")
  addressLine2   String?     @map("address_line2")
  city           String
  stateProvince  String?     @map("state_province")
  postalCode     String?     @map("postal_code")
  countryCode    String      @default("AZ") @map("country_code")
  isDefault      Boolean     @default(false) @map("is_default")
  active         Boolean     @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  counterparty Counterparty @relation(fields: [counterpartyId], references: [id])

  @@index([counterpartyId, active])
  @@index([counterpartyId, isDefault])
  @@map("counterparty_addresses")
}

/// Counterparty Contact — contact persons for counterparties.
model CounterpartyContact {
  id             String  @id @default(uuid())
  tenantId       String  @map("tenant_id")
  counterpartyId String  @map("counterparty_id")
  firstName      String  @map("first_name")
  lastName       String  @map("last_name")
  position       String?
  department     String? // Şöbə/departament (free text — a contact may belong to a department outside this tenant's own org chart)
  phone          String? // primary contact number
  mobile         String? // alternative contact number
  email          String?
  isPrimary      Boolean @default(false) @map("is_primary")
  notes          String?
  active         Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  counterparty Counterparty @relation(fields: [counterpartyId], references: [id])

  @@index([counterpartyId, active])
  @@index([counterpartyId, isPrimary])
  @@map("counterparty_contacts")
}

enum PriceListType {
  SALE // Sales price list
  PURCHASE // Purchase price list
}

/// Price List — organization-scoped pricing rules (section 90-92).
/// A price list defines prices for products, optionally for specific
/// counterparties, categories, or date ranges. Effective-dated.
model PriceList {
  id             String        @id @default(uuid())
  tenantId       String        @map("tenant_id")
  organizationId String        @map("organization_id")
  priceListType  PriceListType @map("price_list_type")
  code           String
  name           String
  description    String?
  currencyId     String        @map("currency_id")
  validFrom      DateTime      @map("valid_from") @db.Date
  validTo        DateTime?     @map("valid_to") @db.Date
  counterpartyId String?       @map("counterparty_id") // null = applies to all
  priority       Int           @default(0) // higher priority wins
  includesTax    Boolean       @default(false) @map("includes_tax")
  active         Boolean       @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  organization Organization   @relation(fields: [organizationId], references: [id])
  currency     Currency       @relation(fields: [currencyId], references: [id])
  counterparty Counterparty?  @relation(fields: [counterpartyId], references: [id])
  prices       ProductPrice[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
  @@index([organizationId, priceListType, validFrom, validTo])
  @@index([organizationId, counterpartyId])
  @@map("price_lists")
}

/// Product Price — individual product prices within a price list.
model ProductPrice {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  priceListId String   @map("price_list_id")
  productId   String   @map("product_id")
  unitId      String   @map("unit_id") // can be different from product's base unit
  price       Decimal  @db.Decimal(18, 6)
  minQuantity Decimal  @default(1) @map("min_quantity") @db.Decimal(18, 6)
  maxQuantity Decimal? @map("max_quantity") @db.Decimal(18, 6)
  active      Boolean  @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  priceList PriceList     @relation(fields: [priceListId], references: [id])
  product   Product       @relation(fields: [productId], references: [id])
  unit      UnitOfMeasure @relation("ProductPriceUnit", fields: [unitId], references: [id])

  @@unique([priceListId, productId, unitId, minQuantity])
  @@index([priceListId, active])
  @@index([productId, active])
  @@map("product_prices")
}

// ----------------------------------------------------------------------------
// PHASE 4 — SALES DOCUMENTS (ORDERS + INVOICES)
//
// First real business documents on the DocumentFramework: SalesOrder and
// SalesInvoice with line items. Header field set mirrors BaseDocumentFields
// (same shape as FoundationTestDocument) plus counterparty, currency, and
// totals snapshotted at save time. Prices snapshot resolvePrice() output at
// save — posting never re-resolves prices.
// ----------------------------------------------------------------------------

/// Sales Order — customer order document (DRAFT -> POSTED reserves nothing
/// yet; stock reservation is a later phase concern).
model SalesOrder {
  id               String         @id @default(uuid())
  tenantId         String         @map("tenant_id")
  organizationId   String         @map("organization_id")
  counterpartyId   String         @map("counterparty_id")
  documentType     String         @default("SALES_ORDER") @map("document_type")
  number           String?
  documentDate     DateTime       @map("document_date") @db.Date
  postingDate      DateTime?      @map("posting_date") @db.Date
  status           DocumentStatus @default(DRAFT)
  postingStatus    PostingStatus  @default(NOT_POSTED) @map("posting_status")
  currencyId       String?        @map("currency_id")
  exchangeRate     Decimal?       @map("exchange_rate") @db.Decimal(24, 10)
  subtotal         Decimal        @default(0) @db.Decimal(18, 2)
  taxTotal         Decimal        @default(0) @map("tax_total") @db.Decimal(18, 2)
  grandTotal       Decimal        @default(0) @map("grand_total") @db.Decimal(18, 2)
  priceIncludesTax Boolean        @default(false) @map("price_includes_tax")
  description      String?

  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by")
  postedAt     DateTime? @map("posted_at")
  postedBy     String?   @map("posted_by")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelledBy  String?   @map("cancelled_by")
  deletionMark Boolean   @default(false) @map("deletion_mark")
  version      Int       @default(1)

  // Phase 6 — Sales Pre-Order & Order Management: SalesOrder serves as this
  // spec's CustomerOrder (it already has no accounting consequence, which
  // is exactly what CustomerOrder requires — see docs/SALES_PREORDER.md
  // for the full mapping rationale rather than a duplicate table).
  // `postingStatus = POSTED` IS the CONFIRMED state (spec section 22's
  // ConfirmCustomerOrder command reuses the existing document-framework
  // post command, with SalesOrderPostingHandler.validateForPosting
  // carrying the Phase 6 confirmation checks).
  fulfillmentStatus     String    @default("NOT_STARTED") @map("fulfillment_status")
  reservationStatus     String    @default("NOT_RESERVED") @map("reservation_status")
  orderPaymentStatus    String    @default("NOT_PAID") @map("order_payment_status")
  creditStatus          String    @default("NOT_CHECKED") @map("credit_status")
  approvalStatus        String    @default("NOT_REQUIRED") @map("approval_status")
  salesChannel          String?   @map("sales_channel")
  priority              String    @default("NORMAL")
  externalReference     String?   @map("external_reference")
  requestedDeliveryDate DateTime? @map("requested_delivery_date") @db.Date
  promisedDeliveryDate  DateTime? @map("promised_delivery_date") @db.Date
  warehouseId           String?   @map("warehouse_id")
  shipmentPaymentPolicy String    @default("NO_RESTRICTION") @map("shipment_payment_policy")
  sourceOfferId         String?   @map("source_offer_id")

  tenant          Tenant                 @relation(fields: [tenantId], references: [id])
  organization    Organization           @relation(fields: [organizationId], references: [id])
  counterparty    Counterparty           @relation(fields: [counterpartyId], references: [id])
  currency        Currency?              @relation(fields: [currencyId], references: [id])
  warehouse       Warehouse?             @relation(fields: [warehouseId], references: [id])
  sourceOffer     CommercialOffer?       @relation(fields: [sourceOfferId], references: [id])
  lines           SalesOrderLine[]
  holds           OrderHold[]
  paymentSchedule OrderPaymentSchedule[]
  shipments       Shipment[]
  ShipmentPlan    ShipmentPlan[]

  @@unique([tenantId, number])
  @@index([tenantId, documentDate])
  @@index([tenantId, status])
  @@index([organizationId, counterpartyId])
  @@index([organizationId, fulfillmentStatus])
  @@index([organizationId, creditStatus])
  @@map("sales_orders")
}

model SalesOrderLine {
  id               String  @id @default(uuid())
  tenantId         String  @map("tenant_id")
  salesOrderId     String  @map("sales_order_id")
  position         Int     @default(0)
  productId        String  @map("product_id")
  unitId           String  @map("unit_id")
  quantity         Decimal @db.Decimal(18, 6)
  price            Decimal @db.Decimal(18, 6)
  lineTotal        Decimal @map("line_total") @db.Decimal(18, 2)
  taxRate          Decimal @default(0) @map("tax_rate") @db.Decimal(18, 2)
  taxAmount        Decimal @default(0) @map("tax_amount") @db.Decimal(18, 2)
  lineTotalWithTax Decimal @default(0) @map("line_total_with_tax") @db.Decimal(18, 2)
  priceListId      String? @map("price_list_id")
  productPriceId   String? @map("product_price_id")
  description      String?

  // Phase 6 additions (spec sections 15, 26-27, 40, 94)
  cancelledQuantity Decimal @default(0) @map("cancelled_quantity") @db.Decimal(18, 6)
  reservationPolicy String  @default("TRY_RESERVE") @map("reservation_policy")
  fulfillmentPolicy String  @default("ALLOW_PARTIAL") @map("fulfillment_policy")
  isService         Boolean @default(false) @map("is_service")
  warehouseId       String? @map("warehouse_id")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  tenant           Tenant             @relation(fields: [tenantId], references: [id])
  salesOrder       SalesOrder         @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product          Product            @relation(fields: [productId], references: [id])
  unit             UnitOfMeasure      @relation("SalesOrderLineUnit", fields: [unitId], references: [id])
  ShipmentPlanLine ShipmentPlanLine[]

  @@index([salesOrderId, position])
  @@index([tenantId, productId])
  @@map("sales_order_lines")
}

/// Sales Invoice — billing document, creatable standalone or based on a
/// SalesOrder (CreateBasedOn SALES_ORDER => SALES_INVOICE).
model SalesInvoice {
  id               String         @id @default(uuid())
  tenantId         String         @map("tenant_id")
  organizationId   String         @map("organization_id")
  counterpartyId   String         @map("counterparty_id")
  documentType     String         @default("SALES_INVOICE") @map("document_type")
  number           String?
  documentDate     DateTime       @map("document_date") @db.Date
  postingDate      DateTime?      @map("posting_date") @db.Date
  status           DocumentStatus @default(DRAFT)
  postingStatus    PostingStatus  @default(NOT_POSTED) @map("posting_status")
  currencyId       String?        @map("currency_id")
  exchangeRate     Decimal?       @map("exchange_rate") @db.Decimal(24, 10)
  subtotal         Decimal        @default(0) @db.Decimal(18, 2)
  taxTotal         Decimal        @default(0) @map("tax_total") @db.Decimal(18, 2)
  grandTotal       Decimal        @default(0) @map("grand_total") @db.Decimal(18, 2)
  priceIncludesTax Boolean        @default(false) @map("price_includes_tax")
  description      String?

  // Phase 7 additions (spec sections 19-20, 40, 42)
  taxPointDate     DateTime? @map("tax_point_date") @db.Date
  sourceShipmentId String?   @map("source_shipment_id")
  amountDue        Decimal   @default(0) @map("amount_due") @db.Decimal(18, 2)
  settlementStatus String    @default("UNPAID") @map("settlement_status")

  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by")
  postedAt     DateTime? @map("posted_at")
  postedBy     String?   @map("posted_by")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelledBy  String?   @map("cancelled_by")
  deletionMark Boolean   @default(false) @map("deletion_mark")
  version      Int       @default(1)

  tenant         Tenant             @relation(fields: [tenantId], references: [id])
  organization   Organization       @relation(fields: [organizationId], references: [id])
  counterparty   Counterparty       @relation(fields: [counterpartyId], references: [id])
  currency       Currency?          @relation(fields: [currencyId], references: [id])
  sourceShipment Shipment?          @relation(fields: [sourceShipmentId], references: [id])
  lines          SalesInvoiceLine[]
  returns        SalesReturn[]

  @@unique([tenantId, number])
  @@index([tenantId, documentDate])
  @@index([tenantId, status])
  @@index([organizationId, counterpartyId])
  @@map("sales_invoices")
}

model SalesInvoiceLine {
  id                   String  @id @default(uuid())
  tenantId             String  @map("tenant_id")
  salesInvoiceId       String  @map("sales_invoice_id")
  position             Int     @default(0)
  productId            String  @map("product_id")
  unitId               String  @map("unit_id")
  quantity             Decimal @db.Decimal(18, 6)
  price                Decimal @db.Decimal(18, 6)
  lineTotal            Decimal @map("line_total") @db.Decimal(18, 2)
  taxRate              Decimal @default(0) @map("tax_rate") @db.Decimal(18, 2)
  taxAmount            Decimal @default(0) @map("tax_amount") @db.Decimal(18, 2)
  lineTotalWithTax     Decimal @default(0) @map("line_total_with_tax") @db.Decimal(18, 2)
  priceListId          String? @map("price_list_id")
  productPriceId       String? @map("product_price_id")
  sourceOrderLineId    String? @map("source_order_line_id")
  sourceShipmentLineId String? @map("source_shipment_line_id")
  description          String?

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  salesInvoice SalesInvoice  @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  product      Product       @relation(fields: [productId], references: [id])
  unit         UnitOfMeasure @relation("SalesInvoiceLineUnit", fields: [unitId], references: [id])

  @@index([salesInvoiceId, position])
  @@index([tenantId, productId])
  @@map("sales_invoice_lines")
}

// ============================================================================
// ACCOUNTING CORE — CHART OF ACCOUNTS & DOUBLE-ENTRY POSTING ENGINE
// (docx spec "Phase 4 — Accounting Core & Azerbaijan Chart of Accounts";
// named by content rather than a phase number here because this repo's own
// Phase 4 already means Sales Documents. See docs/ACCOUNTING_CORE.md.)
//
// Architecture: Business Document -> Posting Handler -> AccountingPostingBatch
// -> AccountingPostingEngine -> JournalEntry -> AccountingMovement -> GL.
// AccountingMovement is the only source of truth for balances — never a
// cached account.balance column (spec section 4).
// ============================================================================

/// System template (tenantId=null) vs a tenant's own adopted chart
/// (tenantId set) — spec section 7. Sections/Groups always hang off the
/// system template only (shared classification metadata); Accounts hang
/// off the tenant's adopted chart so each tenant can extend its own copy
/// without ever touching the template.
model ChartOfAccounts {
  id               String    @id @default(uuid())
  tenantId         String?   @map("tenant_id") // null = system template
  code             String
  name             String
  countryCode      String    @default("AZ") @map("country_code")
  localizationCode String    @default("AZ_STANDARD_COA") @map("localization_code")
  versionCode      String    @default("1.0") @map("version_code")
  validFrom        DateTime  @default(now()) @map("valid_from") @db.Date
  validTo          DateTime? @map("valid_to") @db.Date
  systemTemplate   Boolean   @default(false) @map("system_template")
  active           Boolean   @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  version   Int      @default(1)

  tenant         Tenant?                     @relation(fields: [tenantId], references: [id])
  sections       FinancialStatementSection[]
  accounts       Account[]
  Organization   Organization?               @relation(fields: [organizationId], references: [id])
  organizationId String?

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("charts_of_accounts")
}

/// Top-level reporting node (spec section 9) — never posting_allowed.
model FinancialStatementSection {
  id                String  @id @default(uuid())
  chartOfAccountsId String  @map("chart_of_accounts_id")
  code              String
  name              String
  sequence          Int     @default(0)
  statementType     String  @default("BALANCE_SHEET") @map("statement_type") // BALANCE_SHEET | INCOME_STATEMENT
  active            Boolean @default(true)

  chart    ChartOfAccounts           @relation(fields: [chartOfAccountsId], references: [id])
  groups   FinancialStatementGroup[]
  accounts Account[]

  @@unique([chartOfAccountsId, code])
  @@map("financial_statement_sections")
}

/// Second-level reporting node (spec section 10) — never posting_allowed.
model FinancialStatementGroup {
  id        String  @id @default(uuid())
  sectionId String  @map("section_id")
  code      String
  name      String
  sequence  Int     @default(0)
  active    Boolean @default(true)

  section  FinancialStatementSection @relation(fields: [sectionId], references: [id])
  accounts Account[]

  @@unique([sectionId, code])
  @@map("financial_statement_groups")
}

enum AccountClass {
  ASSET
  CONTRA_ASSET
  LIABILITY
  CONTRA_LIABILITY
  EQUITY
  CONTRA_EQUITY
  REVENUE
  CONTRA_REVENUE
  EXPENSE
  PROFIT_LOSS
  TAX_EXPENSE
  OFF_BALANCE
}

enum NormalBalance {
  DEBIT
  CREDIT
  BOTH
}

/// A posting-eligible or purely-structural ledger account (spec sections
/// 21-24, 79-82). Code is always a STRING (section 79) — 414-1, 205.01 etc
/// are valid and hierarchy is explicit via parentAccountId, never inferred
/// from code length/prefix (section 152).
model Account {
  id                          String        @id @default(uuid())
  tenantId                    String?       @map("tenant_id") // null = system template account (see ChartOfAccounts)
  organizationId              String?       @map("organization_id") // null = shared across the tenant's organizations
  chartOfAccountsId           String        @map("chart_of_accounts_id")
  parentAccountId             String?       @map("parent_account_id")
  financialStatementSectionId String?       @map("financial_statement_section_id")
  financialStatementGroupId   String?       @map("financial_statement_group_id")
  code                        String
  name                        String
  description                 String?
  accountClass                AccountClass  @map("account_class")
  normalBalance               NormalBalance @map("normal_balance")
  postingAllowed              Boolean       @default(true) @map("posting_allowed")
  offBalance                  Boolean       @default(false) @map("off_balance")
  currencyTracking            Boolean       @default(false) @map("currency_tracking")
  quantityTracking            Boolean       @default(false) @map("quantity_tracking")
  systemAccount               Boolean       @default(false) @map("system_account")
  customizable                Boolean       @default(true)
  active                      Boolean       @default(true)
  validFrom                   DateTime      @default(now()) @map("valid_from") @db.Date
  validTo                     DateTime?     @map("valid_to") @db.Date
  // Seed provenance (spec section 77) so upgrades never clobber org edits.
  sourceTemplate              String?       @default("AZ_STANDARD_COA") @map("source_template")
  templateVersion             String?       @map("template_version")
  systemSeed                  Boolean       @default(false) @map("system_seed")
  // Phase 23 semantic tags (spec section 16) — e.g. CASH, TRADE_RECEIVABLE,
  // INVENTORY, FIXED_ASSET, TRADE_PAYABLE, REVENUE, COST_OF_SALES,
  // PAYROLL_EXPENSE, TAX_PAYABLE — used by ACCOUNT_TAG report mappings.
  reportingTags               String[]      @default([]) @map("reporting_tags")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  tenant       Tenant?                    @relation(fields: [tenantId], references: [id])
  organization Organization?              @relation(fields: [organizationId], references: [id])
  chart        ChartOfAccounts            @relation(fields: [chartOfAccountsId], references: [id])
  parent       Account?                   @relation("AccountHierarchy", fields: [parentAccountId], references: [id])
  children     Account[]                  @relation("AccountHierarchy")
  section      FinancialStatementSection? @relation(fields: [financialStatementSectionId], references: [id])
  group        FinancialStatementGroup?   @relation(fields: [financialStatementGroupId], references: [id])

  dimensionRules      AccountDimensionRule[]
  accountingMappings  AccountingMapping[]
  journalEntryLines   JournalEntryLine[]
  accountingMovements AccountingMovement[]
  purchaseInvoiceLines PurchaseInvoiceLine[]
  internalConsumptionLines InternalConsumptionLine[]
  financialReportMappings FinancialReportMapping[]

  @@unique([tenantId, chartOfAccountsId, code])
  @@index([tenantId, active])
  @@index([tenantId, parentAccountId])
  @@map("accounts")
}

/// Subconto definition (spec sections 25-26). Kept tenant-nullable (null =
/// system-defined, shared) following the ExchangeRate precedent elsewhere
/// in this schema for shared-vs-tenant rows.
model AccountingDimensionDefinition {
  id                  String  @id @default(uuid())
  tenantId            String? @map("tenant_id") // null = system-defined, shared
  code                String
  name                String
  valueType           String  @default("REFERENCE") @map("value_type") // REFERENCE | TEXT | NUMBER
  referenceEntityType String? @map("reference_entity_type") // e.g. PARTNER, WAREHOUSE, PRODUCT ...
  active              Boolean @default(true)
  systemDefined       Boolean @default(true) @map("system_defined")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  dimensionRules        AccountDimensionRule[]
  journalLineDimensions JournalLineDimension[]
  movementDimensions    AccountingMovementDimension[]

  @@unique([tenantId, code])
  @@map("accounting_dimension_definitions")
}

/// Which dimensions an Account requires/allows (spec section 27), kept
/// effective-dated so a rule added later never invalidates historical
/// entries (spec section 82).
model AccountDimensionRule {
  id                    String    @id @default(uuid())
  accountId             String    @map("account_id")
  dimensionDefinitionId String    @map("dimension_definition_id")
  required              Boolean   @default(true)
  sequence              Int       @default(0)
  balanceTracking       Boolean   @default(true) @map("balance_tracking")
  turnoverTracking      Boolean   @default(true) @map("turnover_tracking")
  quantityTracking      Boolean   @default(false) @map("quantity_tracking")
  validFrom             DateTime  @default(now()) @map("valid_from") @db.Date
  validTo               DateTime? @map("valid_to") @db.Date
  active                Boolean   @default(true)

  account   Account                       @relation(fields: [accountId], references: [id])
  dimension AccountingDimensionDefinition @relation(fields: [dimensionDefinitionId], references: [id])

  @@unique([accountId, dimensionDefinitionId, validFrom])
  @@map("account_dimension_rules")
}

/// Semantic mapping key -> Account (spec sections 39-43). Business modules
/// resolve e.g. "SALES_REVENUE" through here — never a literal account code
/// in code. organizationId=null means a tenant-wide default; a matching
/// organization-specific row takes precedence (see AccountingMappingService).
model AccountingMapping {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  organizationId String?   @map("organization_id")
  mappingKey     String    @map("mapping_key")
  accountId      String    @map("account_id")
  validFrom      DateTime  @default(now()) @map("valid_from") @db.Date
  validTo        DateTime? @map("valid_to") @db.Date
  priority       Int       @default(0)
  active         Boolean   @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  version   Int      @default(1)

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
  account      Account       @relation(fields: [accountId], references: [id])

  @@index([tenantId, organizationId, mappingKey, validFrom])
  @@map("accounting_mappings")
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  REVERSED
}

/// The accounting document/operation header (spec section 31). Status is
/// never edited directly by API (section 31) — only through post/unpost/
/// reverse commands on JournalEntryService / AccountingPostingEngine.
model JournalEntry {
  id                 String             @id @default(uuid())
  tenantId           String             @map("tenant_id")
  organizationId     String             @map("organization_id")
  journalNumber      String             @map("journal_number")
  businessDate       DateTime           @map("business_date") @db.Date
  postingDate        DateTime           @map("posting_date") @db.Date
  sourceDocumentType String?            @map("source_document_type")
  sourceDocumentId   String?            @map("source_document_id")
  operationType      String             @default("MANUAL") @map("operation_type") // MANUAL | OPENING_BALANCE | SYSTEM_DOCUMENT | REVERSAL | PERIOD_CLOSE
  generatedBy        String             @default("MANUAL_OPERATION") @map("generated_by")
  description        String?
  status             JournalEntryStatus @default(DRAFT)
  isManual           Boolean            @default(true) @map("is_manual")
  isOpeningBalance   Boolean            @default(false) @map("is_opening_balance")
  isReversal         Boolean            @default(false) @map("is_reversal")
  reversalOfEntryId  String?            @map("reversal_of_entry_id")
  generation         Int                @default(1)

  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  String?   @map("created_by")
  postedAt   DateTime? @map("posted_at")
  postedBy   String?   @map("posted_by")
  reversedAt DateTime? @map("reversed_at")
  reversedBy String?   @map("reversed_by")
  version    Int       @default(1)

  tenant            Tenant         @relation(fields: [tenantId], references: [id])
  organization      Organization   @relation(fields: [organizationId], references: [id])
  reversalOf        JournalEntry?  @relation("JournalEntryReversal", fields: [reversalOfEntryId], references: [id])
  reversedByEntries JournalEntry[] @relation("JournalEntryReversal")

  lines     JournalEntryLine[]
  movements AccountingMovement[]

  @@unique([tenantId, journalNumber])
  @@index([tenantId, organizationId, businessDate])
  @@index([tenantId, sourceDocumentType, sourceDocumentId])
  @@map("journal_entries")
}

enum EntrySide {
  DEBIT
  CREDIT
}

/// One debit-or-credit line of a JournalEntry (spec section 32) — a single
/// `side` + one positive amount, never separate debit/credit columns
/// (section 32 preference).
model JournalEntryLine {
  id                    String    @id @default(uuid())
  journalEntryId        String    @map("journal_entry_id")
  sequence              Int       @default(0)
  accountId             String    @map("account_id")
  side                  EntrySide
  amountBase            Decimal   @map("amount_base") @db.Decimal(20, 4)
  transactionCurrencyId String?   @map("transaction_currency_id")
  amountTransaction     Decimal?  @map("amount_transaction") @db.Decimal(20, 4)
  exchangeRate          Decimal?  @map("exchange_rate") @db.Decimal(20, 10)
  quantity              Decimal?  @db.Decimal(20, 6)
  quantityUnitId        String?   @map("quantity_unit_id")
  description           String?
  sourceDocumentLineId  String?   @map("source_document_line_id")

  createdAt DateTime @default(now()) @map("created_at")

  journalEntry JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account        @relation(fields: [accountId], references: [id])
  currency     Currency?      @relation(fields: [transactionCurrencyId], references: [id])
  quantityUnit UnitOfMeasure? @relation(fields: [quantityUnitId], references: [id])

  dimensions JournalLineDimension[]

  @@index([journalEntryId, sequence])
  @@index([accountId])
  @@map("journal_entry_lines")
}

/// Dimension value attached to a (still-mutable, pre-posting) journal line
/// (spec section 33). One dimension type per line, enforced by the unique
/// constraint.
model JournalLineDimension {
  id                    String  @id @default(uuid())
  journalLineId         String  @map("journal_line_id")
  dimensionDefinitionId String  @map("dimension_definition_id")
  referenceType         String  @map("reference_type")
  referenceId           String  @map("reference_id")
  scalarValue           String? @map("scalar_value")

  createdAt DateTime @default(now()) @map("created_at")

  line      JournalEntryLine              @relation(fields: [journalLineId], references: [id], onDelete: Cascade)
  dimension AccountingDimensionDefinition @relation(fields: [dimensionDefinitionId], references: [id])

  @@unique([journalLineId, dimensionDefinitionId])
  @@map("journal_line_dimensions")
}

/// Immutable posted register row (spec sections 34-36) — the single
/// authoritative source for every balance/turnover query. Never UPDATEd
/// once written; corrections only ever add new movements (reversal) or
/// happen via unpost+repost while the period is open.
model AccountingMovement {
  id                    String    @id @default(uuid())
  tenantId              String    @map("tenant_id")
  organizationId        String    @map("organization_id")
  journalEntryId        String    @map("journal_entry_id")
  journalLineId         String    @map("journal_line_id")
  sourceDocumentType    String?   @map("source_document_type")
  sourceDocumentId      String?   @map("source_document_id")
  sourceDocumentLineId  String?   @map("source_document_line_id")
  accountId             String    @map("account_id")
  side                  EntrySide
  businessDate          DateTime  @map("business_date") @db.Date
  postingTimestamp      DateTime  @default(now()) @map("posting_timestamp")
  // Native DB sequence (not app-computed) so deterministic ordering holds
  // under concurrent posting without a hand-rolled counter (spec section 65).
  postingSequence       BigInt    @default(autoincrement()) @map("posting_sequence")
  amountBase            Decimal   @map("amount_base") @db.Decimal(20, 4)
  transactionCurrencyId String?   @map("transaction_currency_id")
  amountTransaction     Decimal?  @map("amount_transaction") @db.Decimal(20, 4)
  exchangeRate          Decimal?  @map("exchange_rate") @db.Decimal(20, 10)
  quantity              Decimal?  @db.Decimal(20, 6)
  quantityUnitId        String?   @map("quantity_unit_id")
  reversalOfMovementId  String?   @map("reversal_of_movement_id")

  createdAt DateTime @default(now()) @map("created_at")

  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  organization        Organization         @relation(fields: [organizationId], references: [id])
  journalEntry        JournalEntry         @relation(fields: [journalEntryId], references: [id])
  account             Account              @relation(fields: [accountId], references: [id])
  currency            Currency?            @relation(fields: [transactionCurrencyId], references: [id])
  quantityUnit        UnitOfMeasure?       @relation(fields: [quantityUnitId], references: [id])
  reversalOf          AccountingMovement?  @relation("MovementReversal", fields: [reversalOfMovementId], references: [id])
  reversedByMovements AccountingMovement[] @relation("MovementReversal")

  dimensions AccountingMovementDimension[]

  @@index([tenantId, organizationId, businessDate])
  @@index([organizationId, accountId, businessDate])
  @@index([journalEntryId])
  @@index([tenantId, sourceDocumentType, sourceDocumentId])
  @@index([accountId, businessDate])
  @@map("accounting_movements")
}

/// Dimension value frozen onto a posted movement at posting time (spec
/// section 35) — deliberately separate from JournalLineDimension so the
/// posted register stays historically reproducible even if the (still
/// mutable, pre-posting) journal line dimensions were later changed via
/// unpost/repost.
model AccountingMovementDimension {
  id                    String  @id @default(uuid())
  accountingMovementId  String  @map("accounting_movement_id")
  dimensionDefinitionId String  @map("dimension_definition_id")
  referenceType         String  @map("reference_type")
  referenceId           String  @map("reference_id")
  scalarValue           String? @map("scalar_value")

  createdAt DateTime @default(now()) @map("created_at")

  movement  AccountingMovement            @relation(fields: [accountingMovementId], references: [id], onDelete: Cascade)
  dimension AccountingDimensionDefinition @relation(fields: [dimensionDefinitionId], references: [id])

  @@unique([accountingMovementId, dimensionDefinitionId])
  @@index([dimensionDefinitionId, referenceId])
  @@map("accounting_movement_dimensions")
}

/// Posting-generation history (spec section 92) — one row per post/repost
/// attempt for a source document, independent of the generic AuditEvent
/// stream so "what posting generations exist for this document" is a
/// direct query rather than an AuditEvent scan.
model PostingRun {
  id                 String    @id @default(uuid())
  tenantId           String    @map("tenant_id")
  organizationId     String    @map("organization_id")
  sourceDocumentType String    @map("source_document_type")
  sourceDocumentId   String    @map("source_document_id")
  generation         Int
  startedAt          DateTime  @default(now()) @map("started_at")
  completedAt        DateTime? @map("completed_at")
  status             String    @default("RUNNING") // RUNNING | SUCCEEDED | FAILED
  actor              String?
  correlationId      String?   @map("correlation_id")
  failureCode        String?   @map("failure_code")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([tenantId, sourceDocumentType, sourceDocumentId, generation])
  @@index([tenantId, sourceDocumentType, sourceDocumentId])
  @@map("posting_runs")
}

// ============================================================================
// TAX ENGINE — VERSION-AWARE, EFFECTIVE-DATED TAX RULES ENGINE
// (docx spec "Phase 5 — Tax Engine & Azerbaijan Localization Engine".)
//
// Architecture: TaxContext -> TaxRuleResolver -> TaxCalculationResult ->
// TaxRegisterService (writes TaxMovement) -> caller merges the returned
// AccountingPostingLine[] into its own AccountingPostingEngine.postBatch
// call so Tax Register + GL post atomically in ONE transaction (spec
// section 5/67) — the Tax Engine itself never writes AccountingMovement.
//
// TaxType/TaxRate/TaxRule/TaxCategory/TaxCode/TaxExemption/TaxLegalSource
// are modeled as SHARED system rows (tenantId=null) rather than per-tenant
// clones, unlike Accounting Core's Account — this is genuinely universal
// Azerbaijan tax law, not tenant-customizable data (spec section 146:
// "legal standard VAT rate may be system-defined"). Only TaxRegistration,
// ProductTaxProfile, CounterpartyTaxProfile and TaxMovement are
// tenant/organization data.
// ============================================================================

model TaxLegalSource {
  id              String    @id @default(uuid())
  jurisdiction    String    @default("AZ")
  sourceType      String // TAX_CODE | AMENDING_LAW | PRESIDENTIAL_DECREE | CABINET_RULE | TAX_AUTHORITY_GUIDANCE
  title           String
  sourceUrl       String    @map("source_url")
  lawNumber       String?   @map("law_number")
  adoptionDate    DateTime? @map("adoption_date") @db.Date
  publicationDate DateTime? @map("publication_date") @db.Date
  effectiveFrom   DateTime? @map("effective_from") @db.Date
  effectiveTo     DateTime? @map("effective_to") @db.Date
  sourceVersion   String    @default("1.0") @map("source_version")
  status          String    @default("ACTIVE") // ACTIVE | REPEALED | SUPERSEDED | DRAFT
  notes           String?

  createdAt DateTime @default(now()) @map("created_at")

  taxRates TaxRate[]
  taxRules TaxRule[]

  @@map("tax_legal_sources")
}

model TaxType {
  id          String  @id @default(uuid())
  code        String  @unique // VAT | CORPORATE_INCOME_TAX | ... (spec section 12)
  name        String
  description String?
  active      Boolean @default(true)

  taxRates      TaxRate[]
  taxRules      TaxRule[]
  taxCodes      TaxCode[]
  taxExemptions TaxExemption[]

  @@map("tax_types")
}

/// Distinct from TaxCode (spec section 90): a classification products/
/// transactions are tagged with; TaxRule + business date resolves the
/// actual treatment/rate for a given category.
model TaxCategory {
  id          String  @id @default(uuid())
  code        String  @unique // STANDARD_VAT | ZERO_RATED_EXPORT | VAT_EXEMPT | OUT_OF_SCOPE | ...
  name        String
  description String?
  active      Boolean @default(true)

  productProfiles ProductTaxProfile[]

  @@map("tax_categories")
}

/// Reporting/classification code, separate from TaxCategory (spec section 90).
model TaxCode {
  id          String    @id @default(uuid())
  taxTypeId   String    @map("tax_type_id")
  code        String
  name        String
  description String?
  validFrom   DateTime  @default(now()) @map("valid_from") @db.Date
  validTo     DateTime? @map("valid_to") @db.Date
  active      Boolean   @default(true)

  taxType TaxType @relation(fields: [taxTypeId], references: [id])

  @@unique([taxTypeId, code])
  @@map("tax_codes")
}

enum TaxRateType {
  STANDARD
  ZERO
  EXEMPT
  OUT_OF_SCOPE
  SPECIAL
}

model TaxRate {
  id                    String      @id @default(uuid())
  taxTypeId             String      @map("tax_type_id")
  jurisdiction          String      @default("AZ")
  code                  String
  rate                  Decimal     @db.Decimal(9, 4) // percentage, e.g. 18.0000
  rateType              TaxRateType @map("rate_type")
  effectiveFrom         DateTime    @map("effective_from") @db.Date
  effectiveTo           DateTime?   @map("effective_to") @db.Date
  legalSourceId         String?     @map("legal_source_id")
  legalArticleReference String?     @map("legal_article_reference")
  status                String      @default("ACTIVE") // ACTIVE | FUTURE_EFFECTIVE | EXPIRED | REPEALED | SUPERSEDED
  systemDefined         Boolean     @default(true) @map("system_defined")

  createdAt DateTime @default(now()) @map("created_at")
  version   Int      @default(1)

  taxType     TaxType         @relation(fields: [taxTypeId], references: [id])
  legalSource TaxLegalSource? @relation(fields: [legalSourceId], references: [id])
  taxRules    TaxRule[]

  @@unique([taxTypeId, jurisdiction, code, effectiveFrom])
  @@index([taxTypeId, jurisdiction, effectiveFrom])
  @@map("tax_rates")
}

enum TaxTreatment {
  STANDARD_RATE
  ZERO_RATED
  EXEMPT
  OUT_OF_SCOPE
  REVERSE_CHARGE
  SPECIAL_RATE
}

enum TaxRuleStatus {
  DRAFT
  REVIEWED
  APPROVED
  ACTIVE
  FUTURE_EFFECTIVE
  EXPIRED
  REPEALED
  SUPERSEDED
  INACTIVE
}

/// The first-class legal rule (spec section 6-9). Never destructively
/// edited when law changes — a new law-effective period always means a
/// NEW row, never mutating an existing one's dates/treatment in place
/// (spec section 8).
model TaxRule {
  id                       String        @id @default(uuid())
  tenantId                 String?       @map("tenant_id") // null = system localization rule
  localizationCode         String        @default("AZ_TAX") @map("localization_code")
  taxTypeId                String        @map("tax_type_id")
  code                     String
  name                     String
  description              String?
  ruleCategory             String        @map("rule_category") // STANDARD | ZERO_RATE | EXEMPT | OUT_OF_SCOPE | REVERSE_CHARGE
  effectiveFrom            DateTime      @map("effective_from") @db.Date
  effectiveTo              DateTime?     @map("effective_to") @db.Date
  status                   TaxRuleStatus @default(ACTIVE)
  priority                 Int           @default(0)
  legalSourceId            String?       @map("legal_source_id")
  legalArticleReference    String?       @map("legal_article_reference")
  legalSubarticleReference String?       @map("legal_subarticle_reference")
  calculationMethod        String        @default("PERCENTAGE_OF_BASE") @map("calculation_method")
  rateId                   String?       @map("rate_id")
  treatment                TaxTreatment
  exemptionCode            String?       @map("exemption_code")
  // Structured condition predicates (spec section 91 — never free-form
  // executable code): all populated fields must match the TaxContext for
  // this rule to be a candidate. Null/omitted means "matches any".
  conditionOperationType   String?       @map("condition_operation_type") // SALE | PURCHASE | null=any
  conditionTaxCategoryCode String?       @map("condition_tax_category_code")
  conditionTaxpayerSide    String?       @map("condition_taxpayer_side") // SELLER | BUYER | SELF_ASSESSED
  systemDefined            Boolean       @default(true) @map("system_defined")
  active                   Boolean       @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  version   Int      @default(1)

  tenant      Tenant?         @relation(fields: [tenantId], references: [id])
  taxType     TaxType         @relation(fields: [taxTypeId], references: [id])
  rate        TaxRate?        @relation(fields: [rateId], references: [id])
  legalSource TaxLegalSource? @relation(fields: [legalSourceId], references: [id])

  @@index([taxTypeId, localizationCode, effectiveFrom])
  @@index([tenantId])
  @@map("tax_rules")
}

model TaxExemption {
  id               String    @id @default(uuid())
  taxTypeId        String    @map("tax_type_id")
  code             String
  name             String
  description      String?
  legalSourceId    String?   @map("legal_source_id")
  articleReference String?   @map("article_reference")
  validFrom        DateTime  @default(now()) @map("valid_from") @db.Date
  validTo          DateTime? @map("valid_to") @db.Date
  status           String    @default("ACTIVE")

  taxType TaxType @relation(fields: [taxTypeId], references: [id])

  @@unique([taxTypeId, code])
  @@map("tax_exemptions")
}

/// Organization tax registration (spec sections 21-23) — effective-dated,
/// never a single boolean flag.
model TaxRegistration {
  id                 String    @id @default(uuid())
  tenantId           String    @map("tenant_id")
  organizationId     String    @map("organization_id")
  taxType            String    @map("tax_type") // TaxType.code
  registrationNumber String?   @map("registration_number")
  jurisdiction       String    @default("AZ")
  validFrom          DateTime  @map("valid_from") @db.Date
  validTo            DateTime? @map("valid_to") @db.Date
  status             String    @default("REGISTERED") // REGISTERED | NOT_REGISTERED | SUSPENDED
  legalBasis         String?   @map("legal_basis")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  version   Int      @default(1)

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([tenantId, organizationId, taxType, validFrom])
  @@map("tax_registrations")
}

/// Product tax classification (spec section 19) — effective-dated, never a
/// permanent single category on Product itself.
model ProductTaxProfile {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  productId      String    @map("product_id")
  organizationId String?   @map("organization_id")
  taxCategoryId  String    @map("tax_category_id")
  jurisdiction   String    @default("AZ")
  validFrom      DateTime  @default(now()) @map("valid_from") @db.Date
  validTo        DateTime? @map("valid_to") @db.Date
  active         Boolean   @default(true)

  createdAt DateTime @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  product      Product       @relation(fields: [productId], references: [id])
  taxCategory  TaxCategory   @relation(fields: [taxCategoryId], references: [id])
  Organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([productId, validFrom])
  @@map("product_tax_profiles")
}

/// Counterparty tax context (spec section 20) — deliberately minimal,
/// referencing Counterparty rather than duplicating its legal-identity
/// fields (taxId already lives on Counterparty from Phase 3).
model CounterpartyTaxProfile {
  id                String    @id @default(uuid())
  tenantId          String    @map("tenant_id")
  counterpartyId    String    @unique @map("counterparty_id")
  residency         String    @default("RESIDENT") // RESIDENT | NON_RESIDENT
  vatRegistered     Boolean   @default(false) @map("vat_registered")
  vatRegisteredFrom DateTime? @map("vat_registered_from") @db.Date
  specialTaxStatus  String?   @map("special_tax_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  counterparty Counterparty @relation(fields: [counterpartyId], references: [id])

  @@map("counterparty_tax_profiles")
}

enum TaxMovementDirection {
  OUTPUT
  INPUT
}

/// The Tax Register (spec sections 64-66) — an operational register
/// distinct from the GL, immutable once posted. `journalEntryId` gives the
/// mandatory drilldown (spec section 108): summary -> TaxMovement ->
/// source document -> Journal Entry.
model TaxMovement {
  id                   String               @id @default(uuid())
  tenantId             String               @map("tenant_id")
  organizationId       String               @map("organization_id")
  taxType              String               @map("tax_type")
  taxCode              String?              @map("tax_code")
  taxTreatment         TaxTreatment         @map("tax_treatment")
  sourceDocumentType   String?              @map("source_document_type")
  sourceDocumentId     String?              @map("source_document_id")
  sourceLineId         String?              @map("source_line_id")
  taxPointDate         DateTime             @map("tax_point_date") @db.Date
  reportingPeriod      String               @map("reporting_period") // "YYYY-MM"
  taxableBase          Decimal              @map("taxable_base") @db.Decimal(20, 4)
  taxAmount            Decimal              @map("tax_amount") @db.Decimal(20, 4)
  recoverableAmount    Decimal              @default(0) @map("recoverable_amount") @db.Decimal(20, 4)
  nonrecoverableAmount Decimal              @default(0) @map("nonrecoverable_amount") @db.Decimal(20, 4)
  currencyId           String?              @map("currency_id")
  baseCurrencyAmount   Decimal?             @map("base_currency_amount") @db.Decimal(20, 4)
  direction            TaxMovementDirection
  taxRuleId            String               @map("tax_rule_id")
  taxRateId            String?              @map("tax_rate_id")
  postingGeneration    Int                  @default(1) @map("posting_generation")
  journalEntryId       String?              @map("journal_entry_id")
  reversalOfMovementId String?              @map("reversal_of_movement_id")

  createdAt DateTime @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([tenantId, organizationId, taxPointDate])
  @@index([organizationId, taxType, reportingPeriod])
  @@index([tenantId, sourceDocumentType, sourceDocumentId])
  @@index([taxRuleId])
  @@map("tax_movements")
}

// ============================================================================
// SALES PRE-ORDER & ORDER MANAGEMENT (docx spec Phase 6)
//
// Request -> Offer -> (Sales)Order -> Reservation / Payment Schedule ->
// Shipment Plan. None of these create accounting consequences — no
// JournalEntry, no AccountingMovement, no TaxMovement — see
// docs/SALES_PREORDER.md. SalesOrder itself (Phase 0-4's existing model)
// plays the role of this spec's "CustomerOrder": its own extension above
// adds the multi-axis status fields this phase requires.
//
// Simplification disclosed in docs/SALES_PREORDER.md: the spec's
// Partner/Contract/Agreement/PriceType concepts are NOT modeled as
// separate entities here — Phase 3 as actually built stops at
// Counterparty + PriceList, and this phase reuses those directly rather
// than inventing parallel entities the rest of the codebase doesn't have.
// ============================================================================

model CustomerRequest {
  id                    String    @id @default(uuid())
  tenantId              String    @map("tenant_id")
  organizationId        String    @map("organization_id")
  documentType          String    @default("CUSTOMER_REQUEST") @map("document_type")
  number                String?
  documentDate          DateTime  @map("document_date") @db.Date
  counterpartyId        String    @map("counterparty_id")
  currencyId            String?   @map("currency_id")
  requestedDeliveryDate DateTime? @map("requested_delivery_date") @db.Date
  salesManagerId        String?   @map("sales_manager_id")
  sourceChannel         String?   @map("source_channel")
  status                String    @default("DRAFT")
  description           String?
  externalReference     String?   @map("external_reference")

  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String?   @map("created_by")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  updatedBy   String?   @map("updated_by")
  cancelledAt DateTime? @map("cancelled_at")
  cancelledBy String?   @map("cancelled_by")
  version     Int       @default(1)

  tenant       Tenant                @relation(fields: [tenantId], references: [id])
  organization Organization          @relation(fields: [organizationId], references: [id])
  counterparty Counterparty          @relation(fields: [counterpartyId], references: [id])
  currency     Currency?             @relation(fields: [currencyId], references: [id])
  salesManager ResponsiblePerson?    @relation(fields: [salesManagerId], references: [id])
  lines        CustomerRequestLine[]
  offers       CommercialOffer[]

  @@unique([tenantId, number])
  @@index([tenantId, documentDate])
  @@index([organizationId, counterpartyId])
  @@index([organizationId, status])
  @@map("customer_requests")
}

model CustomerRequestLine {
  id                    String    @id @default(uuid())
  tenantId              String    @map("tenant_id")
  customerRequestId     String    @map("customer_request_id")
  position              Int       @default(0)
  productId             String    @map("product_id")
  unitId                String    @map("unit_id")
  quantity              Decimal   @db.Decimal(18, 6)
  requestedPrice        Decimal?  @map("requested_price") @db.Decimal(18, 6)
  requestedDeliveryDate DateTime? @map("requested_delivery_date") @db.Date
  notes                 String?

  createdAt DateTime @default(now()) @map("created_at")

  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  customerRequest CustomerRequest @relation(fields: [customerRequestId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id])
  unit            UnitOfMeasure   @relation("CustomerRequestLineUnit", fields: [unitId], references: [id])

  @@index([customerRequestId, position])
  @@map("customer_request_lines")
}

model CommercialOffer {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  organizationId   String    @map("organization_id")
  documentType     String    @default("COMMERCIAL_OFFER") @map("document_type")
  number           String?
  documentDate     DateTime  @map("document_date") @db.Date
  validUntil       DateTime? @map("valid_until") @db.Date
  counterpartyId   String    @map("counterparty_id")
  currencyId       String?   @map("currency_id")
  priceIncludesTax Boolean   @default(false) @map("price_includes_tax")
  status           String    @default("DRAFT")
  subtotal         Decimal   @default(0) @db.Decimal(18, 2)
  taxTotal         Decimal   @default(0) @map("tax_total") @db.Decimal(18, 2)
  grandTotal       Decimal   @default(0) @map("grand_total") @db.Decimal(18, 2)
  description      String?
  sourceRequestId  String?   @map("source_request_id")

  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String?   @map("created_by")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  updatedBy   String?   @map("updated_by")
  sentAt      DateTime? @map("sent_at")
  acceptedAt  DateTime? @map("accepted_at")
  rejectedAt  DateTime? @map("rejected_at")
  cancelledAt DateTime? @map("cancelled_at")
  version     Int       @default(1)

  tenant        Tenant                @relation(fields: [tenantId], references: [id])
  organization  Organization          @relation(fields: [organizationId], references: [id])
  counterparty  Counterparty          @relation(fields: [counterpartyId], references: [id])
  currency      Currency?             @relation(fields: [currencyId], references: [id])
  sourceRequest CustomerRequest?      @relation(fields: [sourceRequestId], references: [id])
  lines         CommercialOfferLine[]
  ordersCreated SalesOrder[]

  @@unique([tenantId, number])
  @@index([tenantId, documentDate])
  @@index([organizationId, counterpartyId])
  @@index([organizationId, status])
  @@map("commercial_offers")
}

model CommercialOfferLine {
  id                   String    @id @default(uuid())
  tenantId             String    @map("tenant_id")
  commercialOfferId    String    @map("commercial_offer_id")
  position             Int       @default(0)
  productId            String    @map("product_id")
  unitId               String    @map("unit_id")
  quantity             Decimal   @db.Decimal(18, 6)
  price                Decimal   @db.Decimal(18, 6)
  discountPercent      Decimal?  @map("discount_percent") @db.Decimal(9, 4)
  discountAmount       Decimal?  @map("discount_amount") @db.Decimal(18, 2)
  lineTotal            Decimal   @map("line_total") @db.Decimal(18, 2)
  taxRate              Decimal   @default(0) @map("tax_rate") @db.Decimal(18, 2)
  taxAmount            Decimal   @default(0) @map("tax_amount") @db.Decimal(18, 2)
  lineTotalWithTax     Decimal   @default(0) @map("line_total_with_tax") @db.Decimal(18, 2)
  priceListId          String?   @map("price_list_id")
  productPriceId       String?   @map("product_price_id")
  expectedDeliveryDate DateTime? @map("expected_delivery_date") @db.Date
  description          String?

  createdAt DateTime @default(now()) @map("created_at")
  version   Int      @default(1)

  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  commercialOffer CommercialOffer @relation(fields: [commercialOfferId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id])
  unit            UnitOfMeasure   @relation("CommercialOfferLineUnit", fields: [unitId], references: [id])

  @@index([commercialOfferId, position])
  @@map("commercial_offer_lines")
}

/// Generic line-level execution link (spec sections 29-30, 128) — how much
/// of one document's line has flowed into another. Used today for
/// Offer->Order line provenance; Phase 7 reuses this same table for
/// Order->Shipment without any schema change here.
model DocumentLineLink {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  sourceDocumentType String   @map("source_document_type")
  sourceDocumentId   String   @map("source_document_id")
  sourceLineId       String   @map("source_line_id")
  targetDocumentType String   @map("target_document_type")
  targetDocumentId   String   @map("target_document_id")
  targetLineId       String   @map("target_line_id")
  quantity           Decimal  @db.Decimal(18, 6)
  amount             Decimal? @db.Decimal(18, 2)
  relationType       String   @map("relation_type")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  // --- Phase 27 additions (all nullable/defaulted — every pre-existing
  // insert across Offer->Order/Order->Shipment/Shipment->Invoice/
  // GoodsReceipt->PurchaseInvoice/etc. keeps compiling and behaving
  // exactly as before; docs/DOCUMENT_CHAIN.md section B). Rather than
  // introduce a parallel "SourceConsumptionMovement" ledger, Phase 27's
  // governed consumption engine (SourceConsumptionService) reads and
  // writes THIS same table — it is already the codebase's one true
  // line-level provenance/consumption ledger (every existing
  // `remainingXxx()` helper already sums `documentLineLink.quantity`).
  documentLinkId     String?  @map("document_link_id")
  movementType       String   @default("CONSUME") @map("movement_type") // CONSUME|RELEASE|ADJUST|REVERSE
  metric             String   @default("QUANTITY") @map("metric") // QUANTITY|BASE_QUANTITY|AMOUNT|TRANSACTION_AMOUNT|BASE_AMOUNT|SCHEDULE_QUANTITY|INSTALLMENT_AMOUNT|ENTITLEMENT_COUNT
  reversalOfLineLinkId String? @map("reversal_of_line_link_id")
  idempotencyKey     String?  @map("idempotency_key")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  documentLink DocumentLink? @relation("DocumentLinkLineLinks", fields: [documentLinkId], references: [id])

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, sourceDocumentType, sourceDocumentId, sourceLineId])
  @@index([tenantId, targetDocumentType, targetDocumentId])
  @@index([tenantId, documentLinkId])
  @@map("document_line_links")
}

/// A planning/commitment object — NOT inventory issue (spec sections 37-42).
/// No StockMovement, no physical quantity change. availableQuantity in
/// this build is a placeholder (see docs/SALES_PREORDER.md) since no
/// Inventory module (Phase 10) exists yet to source real physical stock.
model StockReservation {
  id                 String    @id @default(uuid())
  tenantId           String    @map("tenant_id")
  organizationId     String    @map("organization_id")
  sourceDocumentType String    @map("source_document_type")
  sourceDocumentId   String    @map("source_document_id")
  sourceLineId       String    @map("source_line_id")
  productId          String    @map("product_id")
  warehouseId        String    @map("warehouse_id")
  batchId            String?   @map("batch_id") // Phase 10 — optional; batch allocation may happen later at shipment time (spec section 49)
  quantity           Decimal   @db.Decimal(18, 6)
  status             String    @default("ACTIVE")
  reservationDate    DateTime  @default(now()) @map("reservation_date")
  validUntil         DateTime? @map("valid_until")

  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  String?   @map("created_by")
  releasedAt DateTime? @map("released_at")
  releasedBy String?   @map("released_by")
  version    Int       @default(1)

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id])
  batch        Batch?       @relation(fields: [batchId], references: [id])

  @@index([tenantId, organizationId, productId, warehouseId, status])
  @@index([tenantId, sourceDocumentType, sourceDocumentId, sourceLineId])
  @@map("stock_reservations")
}

model ShipmentPlan {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  organizationId  String   @map("organization_id")
  salesOrderId    String   @map("sales_order_id")
  plannedDate     DateTime @map("planned_date") @db.Date
  warehouseId     String?  @map("warehouse_id")
  deliveryAddress String?  @map("delivery_address")
  carrier         String?
  status          String   @default("DRAFT")
  notes           String?

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  organization Organization       @relation(fields: [organizationId], references: [id])
  salesOrder   SalesOrder         @relation(fields: [salesOrderId], references: [id])
  warehouse    Warehouse?         @relation(fields: [warehouseId], references: [id])
  lines        ShipmentPlanLine[]

  @@index([tenantId, salesOrderId])
  @@map("shipment_plans")
}

model ShipmentPlanLine {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  shipmentPlanId   String    @map("shipment_plan_id")
  salesOrderLineId String    @map("sales_order_line_id")
  plannedQuantity  Decimal   @map("planned_quantity") @db.Decimal(18, 6)
  warehouseId      String?   @map("warehouse_id")
  plannedDate      DateTime? @map("planned_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at")

  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  shipmentPlan   ShipmentPlan   @relation(fields: [shipmentPlanId], references: [id], onDelete: Cascade)
  salesOrderLine SalesOrderLine @relation(fields: [salesOrderLineId], references: [id])

  @@index([shipmentPlanId])
  @@index([salesOrderLineId])
  @@map("shipment_plan_lines")
}

model OrderPaymentSchedule {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  salesOrderId String   @map("sales_order_id")
  sequence     Int      @default(0)
  dueDate      DateTime @map("due_date") @db.Date
  percentage   Decimal? @db.Decimal(9, 4)
  amount       Decimal  @db.Decimal(18, 2)
  currencyId   String?  @map("currency_id")
  scheduleType String   @default("INSTALLMENT") @map("schedule_type")
  status       String   @default("PLANNED")

  createdAt DateTime @default(now()) @map("created_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  currency   Currency?  @relation(fields: [currencyId], references: [id])

  @@index([salesOrderId, sequence])
  @@map("order_payment_schedules")
}

/// Structured hold (spec sections 85-87) rather than encoding the reason
/// only in a comment. Multiple holds may coexist; the order is actionable
/// only once every ACTIVE hold is RELEASED.
model OrderHold {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  salesOrderId String    @map("sales_order_id")
  holdType     String    @map("hold_type") // CREDIT | CUSTOMER_REQUEST | STOCK | MANUAL | APPROVAL
  reason       String?
  status       String    @default("ACTIVE")
  placedAt     DateTime  @default(now()) @map("placed_at")
  placedBy     String?   @map("placed_by")
  releasedAt   DateTime? @map("released_at")
  releasedBy   String?   @map("released_by")

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@index([salesOrderId, status])
  @@map("order_holds")
}

// ============================================================================
// SALES EXECUTION (docx spec Phase 7)
//
// Shipment (physical execution) is kept structurally distinct from
// SalesInvoice (commercial/legal/accounting event) — spec section 2. Both
// use DocumentLineLink (Phase 6) for line-level execution tracking:
// ORDER_TO_SHIPMENT, SHIPMENT_TO_INVOICE, ORDER_TO_INVOICE. Inventory
// movement reuses Phase 0's RegisterMovement (registerCode
// 'INVENTORY_REGISTER') rather than a parallel stock ledger — a real,
// quantity-only register (no valuation — that's Phase 11's job). See
// docs/SALES_EXECUTION.md for the full disclosed simplifications
// (Inventory/Costing/AR are stub-level interfaces, per the spec's own
// explicit sanction for phases that don't exist yet).
// ============================================================================

model Shipment {
  id                      String         @id @default(uuid())
  tenantId                String         @map("tenant_id")
  organizationId          String         @map("organization_id")
  documentType            String         @default("SHIPMENT") @map("document_type")
  number                  String?
  documentDate            DateTime       @map("document_date") @db.Date
  postingDate             DateTime?      @map("posting_date") @db.Date
  customerOrderId         String?        @map("customer_order_id")
  counterpartyId          String         @map("counterparty_id")
  warehouseId             String         @map("warehouse_id")
  deliveryAddressSnapshot String?        @map("delivery_address_snapshot")
  deliveryMethod          String?        @map("delivery_method")
  carrier                 String?
  status                  DocumentStatus @default(DRAFT)
  postingStatus           PostingStatus  @default(NOT_POSTED) @map("posting_status")
  description             String?

  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by")
  postedAt     DateTime? @map("posted_at")
  postedBy     String?   @map("posted_by")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelledBy  String?   @map("cancelled_by")
  deletionMark Boolean   @default(false) @map("deletion_mark")
  version      Int       @default(1)

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  organization  Organization   @relation(fields: [organizationId], references: [id])
  counterparty  Counterparty   @relation(fields: [counterpartyId], references: [id])
  customerOrder SalesOrder?    @relation(fields: [customerOrderId], references: [id])
  warehouse     Warehouse      @relation(fields: [warehouseId], references: [id])
  lines         ShipmentLine[]
  SalesInvoice  SalesInvoice[]

  @@unique([tenantId, number])
  @@index([tenantId, documentDate])
  @@index([organizationId, customerOrderId])
  @@map("shipments")
}

model ShipmentLine {
  id                String  @id @default(uuid())
  tenantId          String  @map("tenant_id")
  shipmentId        String  @map("shipment_id")
  position          Int     @default(0)
  sourceOrderLineId String? @map("source_order_line_id")
  productId         String  @map("product_id")
  unitId            String  @map("unit_id")
  quantity          Decimal @db.Decimal(18, 6)
  warehouseId       String? @map("warehouse_id")
  batchId           String? @map("batch_id") // Phase 10 — batch picked for this line, when tracked
  notes             String?

  createdAt DateTime @default(now()) @map("created_at")
  version   Int      @default(1)

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  shipment Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id])
  unit     UnitOfMeasure @relation("ShipmentLineUnit", fields: [unitId], references: [id])
  batch    Batch?        @relation(fields: [batchId], references: [id])

  @@index([shipmentId, position])
  @@map("shipment_lines")
}

/// AR contract for Phase 13 (spec sections 40-41, 71-72) — a clean
/// receivable obligation, not a full AR register (no payment allocation,
/// no aging). `status` stays NOT_PAID forever in this build (spec
/// explicitly forbids fabricating PARTIALLY_PAID/PAID without a real
/// settlement module).
/// Customer receivable open item (spec Phase 13 sections 6-7, 12).
/// `status` now REAL (Phase 13 turns this on) — see
/// `docs/SETTLEMENT.md` for how `allocatedAmount`/`remainingAmount` are
/// kept in sync by `OpenItemService` from `SettlementMovement`/
/// `SettlementAllocation` (this row is a rebuildable PROJECTION, spec
/// section 6, never the authoritative source itself).
model SettlementObligation {
  id                 String    @id @default(uuid())
  tenantId           String    @map("tenant_id")
  organizationId     String    @map("organization_id")
  counterpartyId     String    @map("counterparty_id")
  contractId         String?   @map("contract_id")
  sourceDocumentType String    @map("source_document_type")
  sourceDocumentId   String    @map("source_document_id")
  sourceDocumentLineId String? @map("source_document_line_id") // set for an installment/payment-schedule-line open item (spec section 15)
  currencyId         String?   @map("currency_id")
  amountDue          Decimal   @map("amount_due") @db.Decimal(18, 2) // original amount, transaction currency
  baseCurrencyAmount Decimal?  @map("base_currency_amount") @db.Decimal(18, 2) // historical, frozen at creation (spec section 61)
  exchangeRate       Decimal?  @map("exchange_rate") @db.Decimal(24, 10)
  allocatedAmount    Decimal   @default(0) @map("allocated_amount") @db.Decimal(18, 2)
  remainingAmount    Decimal?  @map("remaining_amount") @db.Decimal(18, 2)
  disputedAmount     Decimal   @default(0) @map("disputed_amount") @db.Decimal(18, 2)
  blockedForPayment  Boolean   @default(false) @map("blocked_for_payment")
  collectionStatus   String?   @map("collection_status") // NORMAL|REMINDER_SENT|PROMISE_TO_PAY|DISPUTED|LEGAL|COLLECTION_AGENCY|WRITTEN_OFF
  dueDate            DateTime? @map("due_date") @db.Date
  status             String    @default("OPEN") // OPEN|PARTIALLY_SETTLED|SETTLED|DISPUTED|ON_HOLD|WRITTEN_OFF|CANCELLED — OVERDUE is always computed live, never stored (spec section 7)

  createdAt DateTime @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  counterparty Counterparty @relation(fields: [counterpartyId], references: [id])
  currency     Currency?    @relation(fields: [currencyId], references: [id])

  @@index([tenantId, sourceDocumentType, sourceDocumentId])
  @@index([organizationId, counterpartyId, status])
  @@index([organizationId, dueDate])
  @@map("settlement_obligations")
}

model SalesReturn {
  id                     String         @id @default(uuid())
  tenantId               String         @map("tenant_id")
  organizationId         String         @map("organization_id")
  documentType           String         @default("SALES_RETURN") @map("document_type")
  number                 String?
  documentDate           DateTime       @map("document_date") @db.Date
  postingDate            DateTime?      @map("posting_date") @db.Date
  originalSalesInvoiceId String?        @map("original_sales_invoice_id")
  counterpartyId         String         @map("counterparty_id")
  warehouseId            String?        @map("warehouse_id")
  currencyId             String?        @map("currency_id")
  returnType             String         @default("PHYSICAL_RETURN") @map("return_type")
  reasonCode             String?        @map("reason_code")
  status                 DocumentStatus @default(DRAFT)
  postingStatus          PostingStatus  @default(NOT_POSTED) @map("posting_status")
  subtotal               Decimal        @default(0) @db.Decimal(18, 2)
  taxTotal               Decimal        @default(0) @map("tax_total") @db.Decimal(18, 2)
  grandTotal             Decimal        @default(0) @map("grand_total") @db.Decimal(18, 2)
  description            String?

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")
  postedAt  DateTime? @map("posted_at")
  postedBy  String?   @map("posted_by")
  version   Int       @default(1)

  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  organization    Organization      @relation(fields: [organizationId], references: [id])
  counterparty    Counterparty      @relation(fields: [counterpartyId], references: [id])
  currency        Currency?         @relation(fields: [currencyId], references: [id])
  originalInvoice SalesInvoice?     @relation(fields: [originalSalesInvoiceId], references: [id])
  lines           SalesReturnLine[]
  Warehouse       Warehouse?        @relation(fields: [warehouseId], references: [id])

  @@unique([tenantId, number])
  @@index([tenantId, documentDate])
  @@index([organizationId, originalSalesInvoiceId])
  @@map("sales_returns")
}

model SalesReturnLine {
  id                  String  @id @default(uuid())
  tenantId            String  @map("tenant_id")
  salesReturnId       String  @map("sales_return_id")
  position            Int     @default(0)
  sourceInvoiceLineId String? @map("source_invoice_line_id")
  productId           String  @map("product_id")
  unitId              String  @map("unit_id")
  quantity            Decimal @db.Decimal(18, 6)
  originalUnitPrice   Decimal @map("original_unit_price") @db.Decimal(18, 6)
  returnNet           Decimal @default(0) @map("return_net") @db.Decimal(18, 2)
  returnTax           Decimal @default(0) @map("return_tax") @db.Decimal(18, 2)
  returnGross         Decimal @default(0) @map("return_gross") @db.Decimal(18, 2)
  batchId             String? @map("batch_id") // Phase 10
  reason              String?

  createdAt DateTime @default(now()) @map("created_at")

  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  salesReturn SalesReturn   @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  product     Product       @relation(fields: [productId], references: [id])
  unit        UnitOfMeasure @relation("SalesReturnLineUnit", fields: [unitId], references: [id])
  batch       Batch?        @relation(fields: [batchId], references: [id])

  @@index([salesReturnId, position])
  @@map("sales_return_lines")
}

// ============================================================================
// PROCUREMENT & PURCHASE ORDER MANAGEMENT (docx spec Phase 8)
//
// Planning/commitment layer only (spec sections 94-97): PurchaseRequirement
// captures demand, PurchaseOrder captures supplier commitment, Expected
// Supply is computed live from confirmed PurchaseOrderLines + delivery
// schedule (no persisted "ExpectedReceipt" table — see
// docs/PROCUREMENT.md). None of this creates a GL posting, AP liability,
// physical stock, or a TaxMovement — Goods Receipt/Purchase Invoice
// (Phase 9) do. PurchaseOrder reuses the DocumentStatus/PostingStatus
// pattern SalesOrder established in Phase 6: postingStatus=POSTED IS the
// CONFIRMED commercial-commitment state (PurchaseOrderPostingHandler),
// through the same generic /documents/PURCHASE_ORDER/:id/post|unpost|cancel
// commands — no parallel confirmation state machine.
// ============================================================================

model PurchaseRequirement {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  organizationId String    @map("organization_id")
  documentType   String    @default("PURCHASE_REQUIREMENT") @map("document_type")
  number         String?
  documentDate   DateTime  @map("document_date") @db.Date
  status         String    @default("DRAFT") // DRAFT|OPEN|PARTIALLY_ORDERED|FULLY_ORDERED|CANCELLED|CLOSED
  approvalStatus ApprovalStatus @default(PENDING) @map("approval_status")
  warehouseId    String?   @map("warehouse_id")
  departmentId   String?   @map("department_id")
  requesterId    String?   @map("requester_id") // ResponsiblePerson (spec section 79)
  // Snapshot of the creating user's display name at creation time — auto-
  // filled from the logged-in user, never re-derived later (same
  // never-let-it-drift convention as a Sales Order's price snapshot).
  createdByName  String?   @map("created_by_name")
  requiredByDate DateTime? @map("required_by_date") @db.Date
  priority       String    @default("NORMAL")
  description    String?

  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String?   @map("created_by")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  updatedBy   String?   @map("updated_by")
  cancelledAt DateTime? @map("cancelled_at")
  cancelledBy String?   @map("cancelled_by")
  version     Int       @default(1)

  tenant       Tenant                    @relation(fields: [tenantId], references: [id])
  organization Organization              @relation(fields: [organizationId], references: [id])
  warehouse    Warehouse?                @relation(fields: [warehouseId], references: [id])
  department   Department?               @relation(fields: [departmentId], references: [id])
  requester    ResponsiblePerson?        @relation("PurchaseRequirementRequester", fields: [requesterId], references: [id])
  lines        PurchaseRequirementLine[]

  @@unique([tenantId, number])
  @@index([organizationId, status])
  @@index([organizationId, warehouseId])
  @@index([organizationId, requiredByDate])
  @@map("purchase_requirements")
}

model PurchaseRequirementLine {
  id                    String    @id @default(uuid())
  tenantId              String    @map("tenant_id")
  purchaseRequirementId String    @map("purchase_requirement_id")
  position              Int       @default(0)
  productId             String    @map("product_id")
  unitId                String    @map("unit_id")
  quantity              Decimal   @db.Decimal(18, 6)
  cancelledQuantity     Decimal   @default(0) @map("cancelled_quantity") @db.Decimal(18, 6)
  requiredByDate        DateTime? @map("required_by_date") @db.Date
  warehouseId           String?   @map("warehouse_id")
  // Demand source (spec sections 9-11, 72-76): a manually-entered line has
  // no source; a line derived from a SalesOrder (this build's CustomerOrder,
  // see docs/SALES_PREORDER.md) carries it here for pegging/traceability.
  sourceDocumentType  String? @map("source_document_type")
  sourceDocumentId    String? @map("source_document_id")
  sourceLineId        String? @map("source_line_id")
  preferredSupplierId String? @map("preferred_supplier_id")
  description         String?

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  tenant              Tenant              @relation(fields: [tenantId], references: [id])
  purchaseRequirement PurchaseRequirement @relation(fields: [purchaseRequirementId], references: [id], onDelete: Cascade)
  product             Product             @relation(fields: [productId], references: [id])
  unit                UnitOfMeasure       @relation("PurchaseRequirementLineUnit", fields: [unitId], references: [id])
  warehouse           Warehouse?          @relation(fields: [warehouseId], references: [id])
  preferredSupplier   Counterparty?       @relation("PreferredSupplierForRequirementLine", fields: [preferredSupplierId], references: [id])

  @@index([purchaseRequirementId, position])
  @@index([tenantId, productId])
  @@index([tenantId, sourceDocumentType, sourceDocumentId, sourceLineId])
  @@map("purchase_requirement_lines")
}

model PurchaseOrder {
  id               String         @id @default(uuid())
  tenantId         String         @map("tenant_id")
  organizationId   String         @map("organization_id")
  counterpartyId   String         @map("counterparty_id") // supplier
  documentType     String         @default("PURCHASE_ORDER") @map("document_type")
  number           String?
  documentDate     DateTime       @map("document_date") @db.Date
  postingDate      DateTime?      @map("posting_date") @db.Date
  status           DocumentStatus @default(DRAFT)
  postingStatus    PostingStatus  @default(NOT_POSTED) @map("posting_status")
  approvalStatus   ApprovalStatus @default(NOT_REQUIRED) @map("approval_status")
  currencyId       String?        @map("currency_id")
  exchangeRate     Decimal?       @map("exchange_rate") @db.Decimal(24, 10)
  subtotal         Decimal        @default(0) @db.Decimal(18, 2)
  taxTotal         Decimal        @default(0) @map("tax_total") @db.Decimal(18, 2)
  grandTotal       Decimal        @default(0) @map("grand_total") @db.Decimal(18, 2)
  priceIncludesTax Boolean        @default(false) @map("price_includes_tax")
  description      String?

  warehouseId          String?   @map("warehouse_id") // destination default (spec section 62)
  expectedDeliveryDate DateTime? @map("expected_delivery_date") @db.Date
  supplierReference    String?   @map("supplier_reference") // supplier's own acknowledgement number (spec section 81)
  purchaseChannel      String?   @map("purchase_channel") // LOCAL|IMPORT|FRAME_CONTRACT|SPOT_PURCHASE|OTHER
  buyerId              String?   @map("buyer_id") // ResponsiblePerson (spec section 79)
  // Existing framework/master contract this order draws against (distinct
  // from CounterpartyContract.sourcePurchaseOrderId, which is the reverse
  // link for a contract CREATED FROM a specific PO). Used for contract
  // spend-limit control — see CounterpartyContract.limitAmount.
  contractId           String?   @map("contract_id")

  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by")
  postedAt     DateTime? @map("posted_at")
  postedBy     String?   @map("posted_by")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelledBy  String?   @map("cancelled_by")
  deletionMark Boolean   @default(false) @map("deletion_mark")
  version      Int       @default(1)

  tenant          Tenant                         @relation(fields: [tenantId], references: [id])
  organization    Organization                   @relation(fields: [organizationId], references: [id])
  counterparty    Counterparty                   @relation(fields: [counterpartyId], references: [id])
  currency        Currency?                      @relation(fields: [currencyId], references: [id])
  warehouse       Warehouse?                     @relation(fields: [warehouseId], references: [id])
  buyer           ResponsiblePerson?             @relation("PurchaseOrderBuyer", fields: [buyerId], references: [id])
  lines           PurchaseOrderLine[]
  holds           PurchaseOrderHold[]
  paymentSchedule PurchaseOrderPaymentSchedule[]

  @@unique([tenantId, number])
  @@index([organizationId, counterpartyId, status])
  @@index([organizationId, expectedDeliveryDate])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id                   String    @id @default(uuid())
  tenantId             String    @map("tenant_id")
  purchaseOrderId      String    @map("purchase_order_id")
  position             Int       @default(0)
  productId            String    @map("product_id")
  unitId               String    @map("unit_id")
  quantity             Decimal   @db.Decimal(18, 6)
  cancelledQuantity    Decimal   @default(0) @map("cancelled_quantity") @db.Decimal(18, 6)
  // Nullable: a line created from a Purchase Requirement with no resolvable
  // purchase price is allowed to save as an incomplete DRAFT line (spec:
  // "boş qiymətlə də yaradılıb Qaralama statusunda yadda saxlanıla bilsin")
  // — PurchaseOrderPostingHandler is what actually blocks confirmation
  // while any line still has a null price, never document create/update.
  price                Decimal?  @db.Decimal(18, 6)
  lineTotal            Decimal   @default(0) @map("line_total") @db.Decimal(18, 2)
  taxRate              Decimal   @default(0) @map("tax_rate") @db.Decimal(18, 2)
  taxAmount            Decimal   @default(0) @map("tax_amount") @db.Decimal(18, 2)
  lineTotalWithTax     Decimal   @default(0) @map("line_total_with_tax") @db.Decimal(18, 2)
  priceListId          String?   @map("price_list_id")
  productPriceId       String?   @map("product_price_id")
  isService            Boolean   @default(false) @map("is_service")
  warehouseId          String?   @map("warehouse_id") // line-level destination override (spec sections 62-63)
  expectedDeliveryDate DateTime? @map("expected_delivery_date") @db.Date
  supplierProductCode  String?   @map("supplier_product_code") // snapshot at order time (spec section 130)
  requirementLineId    String?   @map("requirement_line_id") // direct source — mirrors ShipmentLine.sourceOrderLineId
  description          String?

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  tenant           Tenant                         @relation(fields: [tenantId], references: [id])
  purchaseOrder    PurchaseOrder                  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product          Product                        @relation(fields: [productId], references: [id])
  unit             UnitOfMeasure                  @relation("PurchaseOrderLineUnit", fields: [unitId], references: [id])
  warehouse        Warehouse?                     @relation(fields: [warehouseId], references: [id])
  deliverySchedule PurchaseDeliveryScheduleLine[]

  @@index([purchaseOrderId, position])
  @@index([tenantId, productId])
  @@index([tenantId, requirementLineId])
  @@map("purchase_order_lines")
}

/// Split-date delivery within one PO line (spec sections 60-61, 63): "100
/// units, 50 Monday / 50 next month" — Expected Supply reads this when
/// present instead of representing the whole line quantity at one date.
model PurchaseDeliveryScheduleLine {
  id                  String   @id @default(uuid())
  tenantId            String   @map("tenant_id")
  purchaseOrderLineId String   @map("purchase_order_line_id")
  plannedDate         DateTime @map("planned_date") @db.Date
  quantity            Decimal  @db.Decimal(18, 6)
  warehouseId         String?  @map("warehouse_id") // multi-warehouse allocation (spec section 63)

  createdAt DateTime @default(now()) @map("created_at")

  tenant            Tenant            @relation(fields: [tenantId], references: [id])
  purchaseOrderLine PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Cascade)
  warehouse         Warehouse?        @relation(fields: [warehouseId], references: [id])

  @@index([purchaseOrderLineId, plannedDate])
  @@map("purchase_delivery_schedule_lines")
}

/// Structured hold (spec section 83) — never encoded only in a comment.
/// Mirrors OrderHold (Phase 6): multiple holds may coexist, the PO is only
/// confirmable once every ACTIVE hold is RELEASED.
model PurchaseOrderHold {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  purchaseOrderId String    @map("purchase_order_id")
  holdType        String    @map("hold_type") // APPROVAL|SUPPLIER|PRICE|BUDGET|MANUAL|COMPLIANCE
  reason          String?
  status          String    @default("ACTIVE")
  placedAt        DateTime  @default(now()) @map("placed_at")
  placedBy        String?   @map("placed_by")
  releasedAt      DateTime? @map("released_at")
  releasedBy      String?   @map("released_by")

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId, status])
  @@map("purchase_order_holds")
}

/// Planned obligation only (spec sections 70, 85-86, 119) — visible to a
/// future Treasury Payment Calendar (Phase 14), never a Bank Payment.
/// Mirrors OrderPaymentSchedule (Phase 6) with an added `basis` label.
model PurchaseOrderPaymentSchedule {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  purchaseOrderId String   @map("purchase_order_id")
  sequence        Int      @default(0)
  dueDate         DateTime @map("due_date") @db.Date
  basis           String   @default("AFTER_RECEIPT") @map("basis") // ADVANCE|AFTER_RECEIPT|AFTER_INVOICE
  percentage      Decimal? @db.Decimal(9, 4)
  amount          Decimal  @db.Decimal(18, 2)
  currencyId      String?  @map("currency_id")
  status          String   @default("PLANNED")

  createdAt DateTime @default(now()) @map("created_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  currency      Currency?     @relation(fields: [currencyId], references: [id])

  @@index([purchaseOrderId, sequence])
  @@map("purchase_order_payment_schedules")
}

/// Supplier-specific product mapping (spec sections 45-50, 55-57, 108).
/// Distinct external code plus MOQ/order-multiple/lead-time metadata per
/// supplier: "different suppliers may use the same external code" is why
/// the code uniqueness is scoped to (organization, supplier), and a second
/// uniqueness on (organization, supplier, product) keeps exactly one
/// active mapping per supplier+product pair — no cross-supplier ambiguity.
model SupplierProductCode {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  organizationId String   @map("organization_id")
  counterpartyId String   @map("counterparty_id") // supplier
  productId      String   @map("product_id")
  supplierCode   String   @map("supplier_code")
  supplierUnitId String?  @map("supplier_unit_id")
  moq            Decimal? @map("moq") @db.Decimal(18, 6)
  orderMultiple  Decimal? @map("order_multiple") @db.Decimal(18, 6)
  leadTimeDays   Int?     @map("lead_time_days")
  active         Boolean  @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  organization Organization   @relation(fields: [organizationId], references: [id])
  counterparty Counterparty   @relation(fields: [counterpartyId], references: [id])
  product      Product        @relation(fields: [productId], references: [id])
  supplierUnit UnitOfMeasure? @relation("SupplierProductCodeUnit", fields: [supplierUnitId], references: [id])

  @@unique([organizationId, counterpartyId, productId])
  @@index([organizationId, counterpartyId, supplierCode])
  @@map("supplier_product_codes")
}

/// Demand-supply pegging (spec sections 73-77) — planning linkage only,
/// NEVER a physical reservation (do not confuse with StockReservation,
/// spec section 75). Generic demand_type/supply_type strings rather than
/// typed FKs, exactly as the spec's suggested field list, since either
/// side may later be any document type (made-to-order procurement, spec
/// section 76, pegs a SalesOrderLine demand to a PurchaseOrderLine supply
/// today; production requirements, Phase 21, are a future demand type).
model SupplyPeg {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  demandType   String   @map("demand_type")
  demandId     String   @map("demand_id")
  demandLineId String   @map("demand_line_id")
  supplyType   String   @map("supply_type")
  supplyId     String   @map("supply_id")
  supplyLineId String   @map("supply_line_id")
  quantity     Decimal  @db.Decimal(18, 6)
  status       String   @default("ACTIVE") // ACTIVE|REMOVED
  createdAt    DateTime @default(now()) @map("created_at")
  createdBy    String?  @map("created_by")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, demandType, demandId, demandLineId])
  @@index([tenantId, supplyType, supplyId, supplyLineId])
  @@map("supply_pegs")
}

// ============================================================================
// PURCHASE / GOODS RECEIPT / INVOICE / RETURN (docx spec Phase 9)
//
// Executes against a confirmed PurchaseOrder (Phase 8's "Supplier Order")
// exactly the way Sales Execution (Phase 7) executes against a confirmed
// SalesOrder: GoodsReceipt is the physical event (real inventory
// movement), PurchaseInvoice is the commercial/legal/tax event (real
// input VAT + Accounts Payable), kept structurally distinct — spec
// section 1's alternative flows (receipt-first, invoice-first, no order
// at all) are all supported because DocumentLineLink makes every source
// reference OPTIONAL, never a required chain. See docs/PURCHASE_EXECUTION.md
// for the accounting model (Model A: Goods Receipt posts a GRNI clearing
// liability; Purchase Invoice clears it) and disclosed simplifications
// (no batch/serial tracking, no approval workflow, no payment/advance
// engine — Phase 13/14 boundary, matching spec section 56).
// ============================================================================

/// Physical receipt of goods from a supplier (spec sections 3-5). Reuses
/// InventoryLedgerService (Phase 7) for the same quantity-only
/// INVENTORY_REGISTER RECEIPT movement a Purchase Return later reverses
/// with ISSUE — one physical stock ledger for the whole platform, not a
/// parallel purchase-side one.
model GoodsReceipt {
  id             String         @id @default(uuid())
  tenantId       String         @map("tenant_id")
  organizationId String         @map("organization_id")
  warehouseId    String         @map("warehouse_id")
  counterpartyId String         @map("counterparty_id") // supplier
  supplierOrderId String?       @map("supplier_order_id") // Phase 8 PurchaseOrder
  documentType   String         @default("GOODS_RECEIPT") @map("document_type")
  number         String?
  documentDate   DateTime       @map("document_date") @db.Date
  postingDate    DateTime?      @map("posting_date") @db.Date
  status         DocumentStatus @default(DRAFT)
  postingStatus  PostingStatus  @default(NOT_POSTED) @map("posting_status")
  approvalStatus ApprovalStatus @default(NOT_REQUIRED) @map("approval_status")
  currencyId     String?        @map("currency_id")
  exchangeRate   Decimal?       @map("exchange_rate") @db.Decimal(24, 10)

  operationType         String    @default("PURCHASE_FROM_SUPPLIER") @map("operation_type")
  supplierDocumentNumber String?  @map("supplier_document_number")
  supplierDocumentDate   DateTime? @map("supplier_document_date") @db.Date
  externalReference      String?  @map("external_reference")
  description            String?

  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by")
  postedAt     DateTime? @map("posted_at")
  postedBy     String?   @map("posted_by")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelledBy  String?   @map("cancelled_by")
  deletionMark Boolean   @default(false) @map("deletion_mark")
  version      Int       @default(1)

  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  organization Organization       @relation(fields: [organizationId], references: [id])
  warehouse    Warehouse          @relation(fields: [warehouseId], references: [id])
  counterparty Counterparty       @relation(fields: [counterpartyId], references: [id])
  currency     Currency?          @relation(fields: [currencyId], references: [id])
  lines        GoodsReceiptLine[]
  purchaseReturns PurchaseReturn[]

  @@unique([tenantId, number])
  @@index([organizationId, counterpartyId, status])
  @@index([organizationId, supplierOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id                  String    @id @default(uuid())
  tenantId            String    @map("tenant_id")
  goodsReceiptId      String    @map("goods_receipt_id")
  position            Int       @default(0)
  productId           String    @map("product_id")
  unitId              String    @map("unit_id")
  quantity            Decimal   @db.Decimal(18, 6)
  warehouseId         String?   @map("warehouse_id") // line-level override
  price               Decimal   @default(0) @db.Decimal(18, 6) // informational — GRNI clearing value + later price-variance comparison
  lineTotal           Decimal   @default(0) @map("line_total") @db.Decimal(18, 2)
  supplierOrderLineId String?   @map("supplier_order_line_id") // direct FK, mirrors ShipmentLine.sourceOrderLineId
  countryOfOrigin     String?   @map("country_of_origin")
  customsDeclaration  String?   @map("customs_declaration")
  expiryDate          DateTime? @map("expiry_date") @db.Date
  batchId             String?   @map("batch_id") // Phase 10 — batch captured/created at receipt
  description         String?
  // Requester's own justification for receiving more than the PO line's
  // remaining quantity, captured at save time — distinct from
  // ApprovalStep.comment, which is the WAREHOUSE_SUPERVISOR approver's own
  // comment at decision time (a different person, a later moment).
  overReceiptReason   String?   @map("over_receipt_reason")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  goodsReceipt GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])
  unit         UnitOfMeasure @relation("GoodsReceiptLineUnit", fields: [unitId], references: [id])
  warehouse    Warehouse?   @relation(fields: [warehouseId], references: [id])
  batch        Batch?       @relation(fields: [batchId], references: [id])
  additionalCostLines AdditionalPurchaseCostLine[]

  @@index([goodsReceiptId, position])
  @@index([tenantId, productId])
  @@index([tenantId, supplierOrderLineId])
  @@map("goods_receipt_lines")
}

/// Commercial/legal/tax event (spec sections 6-9). Real input VAT via
/// TaxRegisterService and a real Accounts Payable consequence — the
/// purchase-side mirror of SalesInvoice. `supplierInvoiceNumber`
/// uniqueness (organization+supplier scoped) is the duplicate-invoice
/// control (spec section 36); Postgres treats NULLs as distinct so an
/// invoice without one never collides.
model PurchaseInvoice {
  id                    String         @id @default(uuid())
  tenantId              String         @map("tenant_id")
  organizationId        String         @map("organization_id")
  counterpartyId        String         @map("counterparty_id")
  documentType          String         @default("PURCHASE_INVOICE") @map("document_type")
  number                String?
  documentDate          DateTime       @map("document_date") @db.Date
  postingDate           DateTime?      @map("posting_date") @db.Date
  dueDate               DateTime?      @map("due_date") @db.Date
  status                DocumentStatus @default(DRAFT)
  postingStatus         PostingStatus  @default(NOT_POSTED) @map("posting_status")
  approvalStatus        ApprovalStatus @default(NOT_REQUIRED) @map("approval_status")
  currencyId            String?        @map("currency_id")
  exchangeRate          Decimal?       @map("exchange_rate") @db.Decimal(24, 10)
  supplierInvoiceNumber String?        @map("supplier_invoice_number")
  supplierInvoiceDate   DateTime?      @map("supplier_invoice_date") @db.Date
  supplierOrderId       String?        @map("supplier_order_id")
  goodsReceiptId        String?        @map("goods_receipt_id") // primary/first linked receipt, convenience only — lines may span several
  priceIncludesTax      Boolean        @default(false) @map("price_includes_tax")
  taxPointDate          DateTime?      @map("tax_point_date") @db.Date
  subtotal              Decimal        @default(0) @db.Decimal(18, 2)
  taxTotal              Decimal        @default(0) @map("tax_total") @db.Decimal(18, 2)
  grandTotal            Decimal        @default(0) @map("grand_total") @db.Decimal(18, 2)
  amountDue             Decimal        @default(0) @map("amount_due") @db.Decimal(18, 2) // frozen gross total at posting — feeds SupplierPayable
  description            String?

  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by")
  postedAt     DateTime? @map("posted_at")
  postedBy     String?   @map("posted_by")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelledBy  String?   @map("cancelled_by")
  deletionMark Boolean   @default(false) @map("deletion_mark")
  version      Int       @default(1)

  tenant       Tenant                @relation(fields: [tenantId], references: [id])
  organization Organization          @relation(fields: [organizationId], references: [id])
  counterparty Counterparty          @relation(fields: [counterpartyId], references: [id])
  currency     Currency?             @relation(fields: [currencyId], references: [id])
  lines        PurchaseInvoiceLine[]
  purchaseReturns PurchaseReturn[]
  matchingResults PurchaseMatchingResult[]

  @@unique([organizationId, counterpartyId, supplierInvoiceNumber])
  @@index([tenantId, number])
  @@index([organizationId, counterpartyId, status])
  @@index([organizationId, goodsReceiptId])
  @@index([organizationId, supplierOrderId])
  @@index([organizationId, dueDate])
  @@map("purchase_invoices")
}

model PurchaseInvoiceLine {
  id                  String  @id @default(uuid())
  tenantId            String  @map("tenant_id")
  purchaseInvoiceId   String  @map("purchase_invoice_id")
  position            Int     @default(0)
  lineType            String  @default("INVENTORY") @map("line_type") // INVENTORY|SERVICE|EXPENSE|FIXED_ASSET|PREPAYMENT|OTHER
  productId           String? @map("product_id")
  unitId              String? @map("unit_id")
  quantity            Decimal @default(1) @db.Decimal(18, 6)
  price               Decimal @db.Decimal(18, 6)
  discountAmount      Decimal @default(0) @map("discount_amount") @db.Decimal(18, 2)
  lineTotal           Decimal @map("line_total") @db.Decimal(18, 2)
  taxRate             Decimal @default(0) @map("tax_rate") @db.Decimal(18, 2)
  taxAmount           Decimal @default(0) @map("tax_amount") @db.Decimal(18, 2)
  lineTotalWithTax    Decimal @default(0) @map("line_total_with_tax") @db.Decimal(18, 2)
  warehouseId         String? @map("warehouse_id")
  expenseAccountId    String? @map("expense_account_id") // explicit override for EXPENSE/FIXED_ASSET/PREPAYMENT lines
  departmentId        String? @map("department_id")
  goodsReceiptLineId  String? @map("goods_receipt_line_id")
  supplierOrderLineId String? @map("supplier_order_line_id")
  description         String?

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  purchaseInvoice PurchaseInvoice  @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  product         Product?         @relation(fields: [productId], references: [id])
  unit            UnitOfMeasure?   @relation("PurchaseInvoiceLineUnit", fields: [unitId], references: [id])
  warehouse       Warehouse?       @relation(fields: [warehouseId], references: [id])
  expenseAccount  Account?         @relation(fields: [expenseAccountId], references: [id])
  department      Department?      @relation(fields: [departmentId], references: [id])

  @@index([purchaseInvoiceId, position])
  @@index([tenantId, productId])
  @@index([tenantId, goodsReceiptLineId])
  @@index([tenantId, supplierOrderLineId])
  @@map("purchase_invoice_lines")
}

/// Accounts Payable contract (spec sections 10, 17-18) — the purchase-side
/// mirror of SettlementObligation, kept as its own table (rather than
/// reused) since AP and AR reporting should never need a
/// sourceDocumentType filter to stay apart. `paidAmount` stays 0 and
/// `status` stays OPEN forever in this build (no Payment/Advance engine —
/// Phase 13/14 boundary, spec section 56): OVERDUE is computed live by
/// SupplierSettlementService from `dueDate`, never stored, so it can
/// never drift stale.
/// Supplier payable open item (spec Phase 13 sections 6-7, 13) — the AP
/// mirror of `SettlementObligation`, kept a separate table for the same
/// reason as before (AR/AP reporting should never need a
/// counterpartyRole filter to stay apart).
model SupplierPayable {
  id                 String    @id @default(uuid())
  tenantId           String    @map("tenant_id")
  organizationId     String    @map("organization_id")
  counterpartyId     String    @map("counterparty_id")
  contractId         String?   @map("contract_id")
  sourceDocumentType String    @default("PURCHASE_INVOICE") @map("source_document_type")
  sourceDocumentId   String    @map("source_document_id")
  sourceDocumentLineId String? @map("source_document_line_id")
  currencyId         String?   @map("currency_id")
  invoiceAmount      Decimal   @map("invoice_amount") @db.Decimal(18, 2)
  baseCurrencyAmount Decimal?  @map("base_currency_amount") @db.Decimal(18, 2)
  exchangeRate       Decimal?  @map("exchange_rate") @db.Decimal(24, 10)
  paidAmount         Decimal   @default(0) @map("paid_amount") @db.Decimal(18, 2) // = allocatedAmount (kept name for backward compatibility)
  remainingAmount    Decimal?  @map("remaining_amount") @db.Decimal(18, 2)
  disputedAmount     Decimal   @default(0) @map("disputed_amount") @db.Decimal(18, 2)
  paymentHold        Boolean   @default(false) @map("payment_hold")
  paymentPriority    Int?      @map("payment_priority")
  dueDate            DateTime? @map("due_date") @db.Date
  status             String    @default("OPEN") // OPEN|PARTIALLY_SETTLED|SETTLED|DISPUTED|ON_HOLD|WRITTEN_OFF|CANCELLED

  createdAt DateTime @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  counterparty Counterparty @relation(fields: [counterpartyId], references: [id])
  currency     Currency?    @relation(fields: [currencyId], references: [id])

  @@index([tenantId, sourceDocumentType, sourceDocumentId])
  @@index([organizationId, counterpartyId, status])
  @@index([organizationId, dueDate])
  @@map("supplier_payables")
}

/// Return of goods to a supplier (spec sections 14-16) — against a
/// GoodsReceipt, a PurchaseInvoice, or neither (manual reference).
/// Mirrors SalesReturn's structure exactly (prorated historical tax when
/// linked to a posted invoice line, contra GL, inventory ISSUE).
model PurchaseReturn {
  id                      String         @id @default(uuid())
  tenantId                String         @map("tenant_id")
  organizationId          String         @map("organization_id")
  documentType            String         @default("PURCHASE_RETURN") @map("document_type")
  number                  String?
  documentDate            DateTime       @map("document_date") @db.Date
  postingDate             DateTime?      @map("posting_date") @db.Date
  originalGoodsReceiptId  String?        @map("original_goods_receipt_id")
  originalPurchaseInvoiceId String?      @map("original_purchase_invoice_id")
  counterpartyId          String         @map("counterparty_id")
  warehouseId             String?        @map("warehouse_id")
  currencyId               String?       @map("currency_id")
  returnReason            String?        @map("return_reason") // DAMAGED|WRONG_ITEM|QUALITY_ISSUE|EXCESS_DELIVERY|EXPIRED|CONTRACT_CANCELLATION|OTHER
  status                  DocumentStatus @default(DRAFT)
  postingStatus            PostingStatus @default(NOT_POSTED) @map("posting_status")
  subtotal                Decimal        @default(0) @db.Decimal(18, 2)
  taxTotal                Decimal        @default(0) @map("tax_total") @db.Decimal(18, 2)
  grandTotal              Decimal        @default(0) @map("grand_total") @db.Decimal(18, 2)
  description              String?

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")
  postedAt  DateTime? @map("posted_at")
  postedBy  String?   @map("posted_by")
  version   Int       @default(1)

  tenant                Tenant               @relation(fields: [tenantId], references: [id])
  organization          Organization         @relation(fields: [organizationId], references: [id])
  counterparty           Counterparty        @relation(fields: [counterpartyId], references: [id])
  currency               Currency?           @relation(fields: [currencyId], references: [id])
  warehouse               Warehouse?          @relation(fields: [warehouseId], references: [id])
  originalGoodsReceipt    GoodsReceipt?       @relation(fields: [originalGoodsReceiptId], references: [id])
  originalPurchaseInvoice PurchaseInvoice?    @relation(fields: [originalPurchaseInvoiceId], references: [id])
  lines                   PurchaseReturnLine[]

  @@unique([tenantId, number])
  @@index([tenantId, documentDate])
  @@index([organizationId, originalGoodsReceiptId])
  @@index([organizationId, originalPurchaseInvoiceId])
  @@map("purchase_returns")
}

model PurchaseReturnLine {
  id                  String  @id @default(uuid())
  tenantId            String  @map("tenant_id")
  purchaseReturnId    String  @map("purchase_return_id")
  position            Int     @default(0)
  sourceReceiptLineId String? @map("source_receipt_line_id")
  sourceInvoiceLineId String? @map("source_invoice_line_id")
  productId           String  @map("product_id")
  unitId              String  @map("unit_id")
  quantity            Decimal @db.Decimal(18, 6)
  originalUnitPrice   Decimal @map("original_unit_price") @db.Decimal(18, 6)
  returnNet           Decimal @default(0) @map("return_net") @db.Decimal(18, 2)
  returnTax           Decimal @default(0) @map("return_tax") @db.Decimal(18, 2)
  returnGross         Decimal @default(0) @map("return_gross") @db.Decimal(18, 2)
  batchId             String? @map("batch_id") // Phase 10
  reason              String?

  createdAt DateTime @default(now()) @map("created_at")

  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  purchaseReturn PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id])
  unit           UnitOfMeasure  @relation("PurchaseReturnLineUnit", fields: [unitId], references: [id])
  batch          Batch?         @relation(fields: [batchId], references: [id])

  @@index([purchaseReturnId, position])
  @@map("purchase_return_lines")
}

/// Additional purchase cost (spec sections 12-13) — transport, customs,
/// insurance, etc. — allocated across GoodsReceiptLines it targets.
/// Capitalized-to-inventory model only in this build (Model A-equivalent
/// simplification — see docs/PURCHASE_EXECUTION.md): always posts
/// Dr Inventory / Cr Supplier Payable, never the expense-recognition
/// alternative the spec also allows.
model AdditionalPurchaseCost {
  id                String         @id @default(uuid())
  tenantId          String         @map("tenant_id")
  organizationId    String         @map("organization_id")
  counterpartyId    String         @map("counterparty_id") // the cost supplier (may differ from the goods supplier)
  documentType      String         @default("ADDITIONAL_PURCHASE_COST") @map("document_type")
  number            String?
  documentDate      DateTime       @map("document_date") @db.Date
  postingDate       DateTime?      @map("posting_date") @db.Date
  status            DocumentStatus @default(DRAFT)
  postingStatus     PostingStatus  @default(NOT_POSTED) @map("posting_status")
  currencyId        String?        @map("currency_id")
  costType          String         @default("OTHER") @map("cost_type") // TRANSPORT|CUSTOMS|INSURANCE|LOADING|BROKER|FREIGHT|HANDLING|CERTIFICATION|OTHER
  allocationMethod  String         @default("BY_VALUE") @map("allocation_method") // BY_QUANTITY|BY_WEIGHT|BY_VOLUME|BY_VALUE|EQUALLY|MANUAL
  totalCost         Decimal        @db.Decimal(18, 2)
  taxRate           Decimal        @default(0) @map("tax_rate") @db.Decimal(18, 2)
  taxAmount         Decimal        @default(0) @map("tax_amount") @db.Decimal(18, 2)
  description       String?

  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by")
  postedAt     DateTime? @map("posted_at")
  postedBy     String?   @map("posted_by")
  version      Int       @default(1)

  tenant       Tenant                        @relation(fields: [tenantId], references: [id])
  organization Organization                  @relation(fields: [organizationId], references: [id])
  counterparty Counterparty                  @relation(fields: [counterpartyId], references: [id])
  currency     Currency?                     @relation(fields: [currencyId], references: [id])
  targetLines  AdditionalPurchaseCostLine[]
  allocations  PurchaseCostAllocation[]

  @@unique([tenantId, number])
  @@index([organizationId, counterpartyId, status])
  @@map("additional_purchase_costs")
}

/// The GoodsReceiptLines one AdditionalPurchaseCost allocates across.
model AdditionalPurchaseCostLine {
  id                       String   @id @default(uuid())
  tenantId                 String   @map("tenant_id")
  additionalPurchaseCostId String   @map("additional_purchase_cost_id")
  goodsReceiptLineId       String   @map("goods_receipt_line_id")
  manualCoefficient        Decimal? @map("manual_coefficient") @db.Decimal(18, 6) // used only when allocationMethod = MANUAL

  createdAt DateTime @default(now()) @map("created_at")

  tenant                 Tenant                 @relation(fields: [tenantId], references: [id])
  additionalPurchaseCost AdditionalPurchaseCost @relation(fields: [additionalPurchaseCostId], references: [id], onDelete: Cascade)
  goodsReceiptLine       GoodsReceiptLine       @relation(fields: [goodsReceiptLineId], references: [id])

  @@index([additionalPurchaseCostId])
  @@map("additional_purchase_cost_lines")
}

/// Computed allocation result, written at posting time (spec section 12:
/// "Allocation nəticəsi inventory costing layer-a ötürülməlidir" — this IS
/// that handoff row; Phase 11 Costing reads it, no recalculation here).
model PurchaseCostAllocation {
  id                       String  @id @default(uuid())
  tenantId                 String  @map("tenant_id")
  additionalPurchaseCostId String  @map("additional_purchase_cost_id")
  goodsReceiptLineId       String  @map("goods_receipt_line_id")
  productId                String  @map("product_id")
  allocatedAmount          Decimal @map("allocated_amount") @db.Decimal(18, 2)

  createdAt DateTime @default(now()) @map("created_at")

  tenant                 Tenant                 @relation(fields: [tenantId], references: [id])
  additionalPurchaseCost AdditionalPurchaseCost @relation(fields: [additionalPurchaseCostId], references: [id], onDelete: Cascade)

  @@index([additionalPurchaseCostId])
  @@index([tenantId, goodsReceiptLineId])
  @@map("purchase_cost_allocations")
}

/// Three-way matching snapshot (spec sections 8, 39.5, 55) — computed live
/// by PurchaseMatchingService and persisted here only when explicitly
/// requested (POST .../check-matching), never automatically on every
/// posting — matching is a review aid, not a posting gate, in this build
/// (spec's own tolerance/approval configuration is deferred, see docs).
model PurchaseMatchingResult {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  purchaseInvoiceId String   @map("purchase_invoice_id")
  overallStatus     String   @map("overall_status") // MATCHED|QUANTITY_MISMATCH|PRICE_MISMATCH|OVER_INVOICED|RECEIPT_MISSING|ORDER_MISSING|MANUAL_REVIEW_REQUIRED
  details           Json
  computedAt        DateTime @default(now()) @map("computed_at")
  computedBy        String?  @map("computed_by")

  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  purchaseInvoice PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId, purchaseInvoiceId])
  @@map("purchase_matching_results")
}

// ============================================================================
// WAREHOUSE / STOCK ENGINE (docx spec Phase 10)
//
// The single Stock Truth Engine every other module reads from — never a
// mutable `product.stockQuantity` or `warehouse.inventoryValue` field.
// `InventoryMovement` is the immutable source of truth (spec section 4's
// "Layer 1"); every balance (physical/reserved/available/expected/in
// transit/projected) is computed live from it and from the existing
// StockReservation register (Phase 6) — see StockAvailabilityService.
// Quantity is SIGNED (+ = IN, - = OUT, spec section 3's explicit choice)
// so every balance is a plain SUM(quantity). `stockStatus` folds the
// spec's separate "quality status" and "inventory status" dimensions into
// one column (AVAILABLE/QUARANTINE/QUALITY_CONTROL/REJECTED/DAMAGED/
// BLOCKED/IN_TRANSIT/EXPIRED) — a disclosed simplification, see
// docs/WAREHOUSE_INVENTORY.md. In-transit stock (spec section 10) is
// modeled as this same stockStatus at the DESTINATION warehouse rather
// than a separate "transit" pseudo-warehouse — no new concept needed.
// ============================================================================

model WarehouseLocation {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  warehouseId      String   @map("warehouse_id")
  parentLocationId String?  @map("parent_location_id")
  code             String
  name             String
  locationType     String   @default("BIN") @map("location_type")
  active           Boolean  @default(true)
  allowReceipt     Boolean  @default(true) @map("allow_receipt")
  allowIssue       Boolean  @default(true) @map("allow_issue")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  version   Int      @default(1)

  tenant    Tenant              @relation(fields: [tenantId], references: [id])
  warehouse Warehouse           @relation(fields: [warehouseId], references: [id])
  parent    WarehouseLocation?  @relation("LocationHierarchy", fields: [parentLocationId], references: [id])
  children  WarehouseLocation[] @relation("LocationHierarchy")

  movements                   InventoryMovement[]
  transferSourceLines         WarehouseTransferLine[] @relation("TransferSourceLocation")
  transferDestinationLines    WarehouseTransferLine[] @relation("TransferDestinationLocation")
  currentSerialNumbers        SerialNumber[]

  @@unique([warehouseId, code])
  @@map("warehouse_locations")
}

/// Product batch/lot (spec sections 19-20). `sourceReceiptId` is a soft
/// reference (plain string, not a hard FK) — same convention as
/// `ShipmentLine.sourceOrderLineId` elsewhere in this codebase.
model Batch {
  id                  String    @id @default(uuid())
  tenantId            String    @map("tenant_id")
  organizationId      String    @map("organization_id")
  productId           String    @map("product_id")
  batchNumber         String    @map("batch_number")
  manufactureDate     DateTime? @map("manufacture_date") @db.Date
  expiryDate          DateTime? @map("expiry_date") @db.Date
  supplierBatchNumber String?   @map("supplier_batch_number")
  countryOfOrigin     String?   @map("country_of_origin")
  sourceReceiptId     String?   @map("source_receipt_id")
  status              String    @default("ACTIVE")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])

  movements                   InventoryMovement[]
  reservations                StockReservation[]
  goodsReceiptLines            GoodsReceiptLine[]
  shipmentLines                 ShipmentLine[]
  salesReturnLines               SalesReturnLine[]
  purchaseReturnLines             PurchaseReturnLine[]
  warehouseTransferLines           WarehouseTransferLine[]
  internalConsumptionLines          InternalConsumptionLine[]
  inventoryAdjustmentLines            InventoryAdjustmentLine[]
  inventoryStatusTransferLines          InventoryStatusTransferLine[]

  inventoryCostLayers    InventoryCostLayer[]
  inventoryCostMovements InventoryCostMovement[]

  @@unique([organizationId, productId, batchNumber])
  @@map("batches")
}

/// Serial-tracked unit (spec sections 21-23). Uniqueness is
/// `(organization, product, serialNumber)` — the spec's stated default
/// ("product + serial number unique"), not globally unique. Full history
/// per serial (spec section 23) is simply every `InventoryMovement` row
/// with this `serialId`, ordered by date — no separate history table.
model SerialNumber {
  id                 String  @id @default(uuid())
  tenantId           String  @map("tenant_id")
  organizationId     String  @map("organization_id")
  productId          String  @map("product_id")
  serialNumber       String  @map("serial_number")
  status             String  @default("AVAILABLE")
  currentWarehouseId String? @map("current_warehouse_id")
  currentLocationId  String? @map("current_location_id")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  version   Int      @default(1)

  tenant           Tenant             @relation(fields: [tenantId], references: [id])
  organization     Organization       @relation(fields: [organizationId], references: [id])
  product          Product            @relation(fields: [productId], references: [id])
  currentWarehouse Warehouse?         @relation(fields: [currentWarehouseId], references: [id])
  currentLocation  WarehouseLocation? @relation(fields: [currentLocationId], references: [id])
  movements        InventoryMovement[]
  lineCaptures     DocumentLineSerial[]

  @@unique([organizationId, productId, serialNumber])
  @@index([tenantId, status])
  @@map("serial_numbers")
}

/// THE immutable inventory movement register — every quantity balance in
/// the platform is `SUM(quantity)` over a filtered slice of this table
/// (spec sections 3-4, 35). Never updated after creation; unpost deletes
/// the rows a document's own posting wrote (same convention as
/// `RegisterMovement` everywhere else in this codebase) rather than
/// writing a reversal row — see docs/WAREHOUSE_INVENTORY.md for why that
/// stays consistent with the rest of the platform instead of adopting the
/// spec's optional "reversal document" alternative (section 39).
model InventoryMovement {
  id                  String   @id @default(uuid())
  tenantId            String   @map("tenant_id")
  organizationId      String   @map("organization_id")
  warehouseId         String   @map("warehouse_id")
  locationId          String?  @map("location_id")
  productId           String   @map("product_id")
  unitId              String   @map("unit_id")
  batchId             String?  @map("batch_id")
  serialId            String?  @map("serial_id")
  ownershipType       String   @default("OWN") @map("ownership_type")
  ownerCounterpartyId String?  @map("owner_counterparty_id")
  stockStatus         String   @default("AVAILABLE") @map("stock_status")
  movementType        String   @map("movement_type")
  quantity            Decimal  @db.Decimal(18, 6) // signed: + IN, - OUT
  baseQuantity        Decimal  @map("base_quantity") @db.Decimal(18, 6) // signed, base unit

  effectiveDate         DateTime @map("effective_date") @db.Date
  registrarDocumentType String   @map("registrar_document_type")
  registrarDocumentId   String   @map("registrar_document_id")
  registrarLineId       String?  @map("registrar_line_id")

  // Phase 11 Costing handoff (spec sections 51-52) — never authoritative here.
  provisionalCost Decimal? @map("provisional_cost") @db.Decimal(18, 6)
  costingStatus   String?  @map("costing_status")
  journalEntryId  String?  @map("journal_entry_id")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  organization      Organization       @relation(fields: [organizationId], references: [id])
  warehouse         Warehouse          @relation(fields: [warehouseId], references: [id])
  location          WarehouseLocation? @relation(fields: [locationId], references: [id])
  product           Product            @relation(fields: [productId], references: [id])
  unit              UnitOfMeasure      @relation("InventoryMovementUnit", fields: [unitId], references: [id])
  batch             Batch?             @relation(fields: [batchId], references: [id])
  serial            SerialNumber?      @relation(fields: [serialId], references: [id])
  ownerCounterparty Counterparty?      @relation(fields: [ownerCounterpartyId], references: [id])

  @@index([tenantId, organizationId, warehouseId, productId, effectiveDate])
  @@index([tenantId, batchId])
  @@index([tenantId, serialId])
  @@index([tenantId, registrarDocumentType, registrarDocumentId])
  @@index([tenantId, productId, stockStatus])
  @@map("inventory_movements")
}

/// Warehouse-to-warehouse (or, when `transferType = INTERNAL_LOCATION_
/// TRANSFER`, location-to-location within one warehouse — spec section
/// 13 folded in here rather than a separate document, since it is
/// structurally the same header/lines shape with source = destination
/// warehouse) transfer (spec sections 11-13). `transferStatus` carries
/// the fine-grained SHIPPED/PARTIALLY_RECEIVED/RECEIVED progression
/// alongside the generic `postingStatus` — `postingStatus = POSTED` IS
/// "shipped" (source decreases, destination goes IN_TRANSIT); `receive`
/// is a bespoke partial-capable command, not the generic unpost.
model WarehouseTransfer {
  id                     String         @id @default(uuid())
  tenantId               String         @map("tenant_id")
  organizationId         String         @map("organization_id")
  sourceWarehouseId      String         @map("source_warehouse_id")
  destinationWarehouseId String         @map("destination_warehouse_id")
  transferType           String         @default("INSTANT") @map("transfer_type") // INSTANT|TWO_STEP|INTERNAL_LOCATION_TRANSFER
  documentType           String         @default("WAREHOUSE_TRANSFER") @map("document_type")
  number                 String?
  documentDate           DateTime       @map("document_date") @db.Date
  postingDate            DateTime?      @map("posting_date") @db.Date
  expectedArrivalDate    DateTime?      @map("expected_arrival_date") @db.Date
  status                 DocumentStatus @default(DRAFT)
  postingStatus          PostingStatus  @default(NOT_POSTED) @map("posting_status")
  transferStatus         String         @default("DRAFT") @map("transfer_status") // DRAFT|SHIPPED|PARTIALLY_RECEIVED|RECEIVED|CANCELLED
  description            String?

  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by")
  postedAt     DateTime? @map("posted_at")
  postedBy     String?   @map("posted_by")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelledBy  String?   @map("cancelled_by")
  deletionMark Boolean   @default(false) @map("deletion_mark")
  version      Int       @default(1)

  tenant               Tenant                  @relation(fields: [tenantId], references: [id])
  organization         Organization            @relation(fields: [organizationId], references: [id])
  sourceWarehouse      Warehouse               @relation("TransferSource", fields: [sourceWarehouseId], references: [id])
  destinationWarehouse Warehouse               @relation("TransferDestination", fields: [destinationWarehouseId], references: [id])
  lines                WarehouseTransferLine[]

  @@unique([tenantId, number])
  @@index([organizationId, status])
  @@index([organizationId, transferStatus])
  @@map("warehouse_transfers")
}

model WarehouseTransferLine {
  id                    String  @id @default(uuid())
  tenantId              String  @map("tenant_id")
  warehouseTransferId   String  @map("warehouse_transfer_id")
  position              Int     @default(0)
  productId             String  @map("product_id")
  unitId                String  @map("unit_id")
  quantity              Decimal @db.Decimal(18, 6)
  receivedQuantity      Decimal @default(0) @map("received_quantity") @db.Decimal(18, 6)
  batchId               String? @map("batch_id")
  sourceLocationId      String? @map("source_location_id")
  destinationLocationId String? @map("destination_location_id")
  description           String?

  createdAt DateTime @default(now()) @map("created_at")

  tenant              Tenant             @relation(fields: [tenantId], references: [id])
  warehouseTransfer   WarehouseTransfer  @relation(fields: [warehouseTransferId], references: [id], onDelete: Cascade)
  product             Product            @relation(fields: [productId], references: [id])
  unit                UnitOfMeasure      @relation("WarehouseTransferLineUnit", fields: [unitId], references: [id])
  batch               Batch?             @relation(fields: [batchId], references: [id])
  sourceLocation      WarehouseLocation? @relation("TransferSourceLocation", fields: [sourceLocationId], references: [id])
  destinationLocation WarehouseLocation? @relation("TransferDestinationLocation", fields: [destinationLocationId], references: [id])

  @@index([warehouseTransferId, position])
  @@map("warehouse_transfer_lines")
}

/// Non-sale stock consumption (spec sections 16, 16) — office/marketing/
/// maintenance/project use. Posts a real OUT movement plus, when the
/// tenant's mapping resolves one, `Dr Expense (per line, or department-
/// scoped) / Cr Inventory` — never hard-coded accounts.
model InternalConsumption {
  id             String         @id @default(uuid())
  tenantId       String         @map("tenant_id")
  organizationId String         @map("organization_id")
  warehouseId    String         @map("warehouse_id")
  departmentId   String?        @map("department_id")
  documentType   String         @default("INTERNAL_CONSUMPTION") @map("document_type")
  number         String?
  documentDate   DateTime       @map("document_date") @db.Date
  postingDate    DateTime?      @map("posting_date") @db.Date
  operationType  String         @default("OFFICE_CONSUMPTION") @map("operation_type")
  status         DocumentStatus @default(DRAFT)
  postingStatus  PostingStatus  @default(NOT_POSTED) @map("posting_status")
  description    String?

  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by")
  postedAt     DateTime? @map("posted_at")
  postedBy     String?   @map("posted_by")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelledBy  String?   @map("cancelled_by")
  deletionMark Boolean   @default(false) @map("deletion_mark")
  version      Int       @default(1)

  tenant       Tenant                     @relation(fields: [tenantId], references: [id])
  organization Organization               @relation(fields: [organizationId], references: [id])
  warehouse    Warehouse                  @relation(fields: [warehouseId], references: [id])
  department   Department?                @relation(fields: [departmentId], references: [id])
  lines        InternalConsumptionLine[]

  @@unique([tenantId, number])
  @@map("internal_consumptions")
}

model InternalConsumptionLine {
  id                    String  @id @default(uuid())
  tenantId              String  @map("tenant_id")
  internalConsumptionId String  @map("internal_consumption_id")
  position              Int     @default(0)
  productId             String  @map("product_id")
  unitId                String  @map("unit_id")
  quantity              Decimal @db.Decimal(18, 6)
  batchId               String? @map("batch_id")
  purpose               String?
  expenseAccountId      String? @map("expense_account_id")
  description           String?

  createdAt DateTime @default(now()) @map("created_at")

  tenant              Tenant              @relation(fields: [tenantId], references: [id])
  internalConsumption InternalConsumption @relation(fields: [internalConsumptionId], references: [id], onDelete: Cascade)
  product             Product             @relation(fields: [productId], references: [id])
  unit                UnitOfMeasure       @relation("InternalConsumptionLineUnit", fields: [unitId], references: [id])
  batch               Batch?              @relation(fields: [batchId], references: [id])
  expenseAccount      Account?            @relation(fields: [expenseAccountId], references: [id])

  @@index([internalConsumptionId, position])
  @@map("internal_consumption_lines")
}

/// Write-off, surplus/shortage, and opening balances (spec sections 17,
/// 42, 77) consolidated into ONE document type — a disclosed
/// simplification of the spec's three separate concepts. `adjustmentType`
/// picks the sign (WRITE_OFF/OPENING_BALANCE = OUT.. actually IN for
/// opening; see service) and the movement type
/// (WRITE_OFF/INVENTORY_SURPLUS/INVENTORY_SHORTAGE/OPENING_BALANCE)
/// written to `InventoryMovement`; line `quantity` is always entered
/// positive.
model InventoryAdjustment {
  id             String         @id @default(uuid())
  tenantId       String         @map("tenant_id")
  organizationId String         @map("organization_id")
  warehouseId    String         @map("warehouse_id")
  documentType   String         @default("INVENTORY_ADJUSTMENT") @map("document_type")
  number         String?
  documentDate   DateTime       @map("document_date") @db.Date
  postingDate    DateTime?      @map("posting_date") @db.Date
  adjustmentType String         @map("adjustment_type") // WRITE_OFF|SURPLUS|OPENING_BALANCE
  reasonCode     String?        @map("reason_code") // DAMAGE|EXPIRY|LOSS|THEFT|OBSOLETE|QUALITY_FAILURE|NATURAL_LOSS|MANAGEMENT_DECISION|OTHER
  sourceInventoryCountSessionId String? @map("source_inventory_count_session_id") // Phase 12 traceability — set when generated from a count session's variance decisions
  status         DocumentStatus @default(DRAFT)
  postingStatus  PostingStatus  @default(NOT_POSTED) @map("posting_status")
  description    String?

  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by")
  postedAt     DateTime? @map("posted_at")
  postedBy     String?   @map("posted_by")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelledBy  String?   @map("cancelled_by")
  deletionMark Boolean   @default(false) @map("deletion_mark")
  version      Int       @default(1)

  tenant       Tenant                    @relation(fields: [tenantId], references: [id])
  organization Organization              @relation(fields: [organizationId], references: [id])
  warehouse    Warehouse                 @relation(fields: [warehouseId], references: [id])
  lines        InventoryAdjustmentLine[]

  @@unique([tenantId, number])
  @@map("inventory_adjustments")
}

model InventoryAdjustmentLine {
  id                    String   @id @default(uuid())
  tenantId              String   @map("tenant_id")
  inventoryAdjustmentId String   @map("inventory_adjustment_id")
  position              Int      @default(0)
  productId             String   @map("product_id")
  unitId                String   @map("unit_id")
  quantity              Decimal  @db.Decimal(18, 6) // always positive — sign derives from the header's adjustmentType
  batchId               String?  @map("batch_id")
  stockStatus           String   @default("AVAILABLE") @map("stock_status")
  costReference         Decimal? @map("cost_reference") @db.Decimal(18, 2)
  description           String?

  createdAt DateTime @default(now()) @map("created_at")

  tenant              Tenant              @relation(fields: [tenantId], references: [id])
  inventoryAdjustment InventoryAdjustment @relation(fields: [inventoryAdjustmentId], references: [id], onDelete: Cascade)
  product             Product             @relation(fields: [productId], references: [id])
  unit                UnitOfMeasure       @relation("InventoryAdjustmentLineUnit", fields: [unitId], references: [id])
  batch               Batch?              @relation(fields: [batchId], references: [id])

  @@index([inventoryAdjustmentId, position])
  @@map("inventory_adjustment_lines")
}

/// Stock status re-tagging (spec section 26) — e.g. Available -> Quarantine.
/// Quantity never leaves the warehouse; only `stockStatus` changes, via a
/// STATUS_CHANGE_OUT/STATUS_CHANGE_IN movement pair at the same warehouse.
model InventoryStatusTransfer {
  id             String         @id @default(uuid())
  tenantId       String         @map("tenant_id")
  organizationId String         @map("organization_id")
  warehouseId    String         @map("warehouse_id")
  documentType   String         @default("INVENTORY_STATUS_TRANSFER") @map("document_type")
  number         String?
  documentDate   DateTime       @map("document_date") @db.Date
  postingDate    DateTime?      @map("posting_date") @db.Date
  status         DocumentStatus @default(DRAFT)
  postingStatus  PostingStatus  @default(NOT_POSTED) @map("posting_status")
  description    String?

  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by")
  postedAt     DateTime? @map("posted_at")
  postedBy     String?   @map("posted_by")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelledBy  String?   @map("cancelled_by")
  deletionMark Boolean   @default(false) @map("deletion_mark")
  version      Int       @default(1)

  tenant       Tenant                         @relation(fields: [tenantId], references: [id])
  organization Organization                   @relation(fields: [organizationId], references: [id])
  warehouse    Warehouse                      @relation(fields: [warehouseId], references: [id])
  lines        InventoryStatusTransferLine[]

  @@unique([tenantId, number])
  @@map("inventory_status_transfers")
}

model InventoryStatusTransferLine {
  id                         String  @id @default(uuid())
  tenantId                   String  @map("tenant_id")
  inventoryStatusTransferId  String  @map("inventory_status_transfer_id")
  position                   Int     @default(0)
  productId                  String  @map("product_id")
  unitId                     String  @map("unit_id")
  quantity                   Decimal @db.Decimal(18, 6)
  batchId                    String? @map("batch_id")
  fromStatus                 String  @map("from_status")
  toStatus                   String  @map("to_status")
  description                String?

  createdAt DateTime @default(now()) @map("created_at")

  tenant                  Tenant                   @relation(fields: [tenantId], references: [id])
  inventoryStatusTransfer InventoryStatusTransfer  @relation(fields: [inventoryStatusTransferId], references: [id], onDelete: Cascade)
  product                 Product                  @relation(fields: [productId], references: [id])
  unit                    UnitOfMeasure            @relation("InventoryStatusTransferLineUnit", fields: [unitId], references: [id])
  batch                   Batch?                   @relation(fields: [batchId], references: [id])

  @@index([inventoryStatusTransferId, position])
  @@map("inventory_status_transfer_lines")
}

/// Serial numbers captured on ONE document line, for any of the four
/// document types that can carry them (GOODS_RECEIPT/SHIPMENT/
/// SALES_RETURN/PURCHASE_RETURN) — a single reusable table instead of a
/// bespoke join table per line type (same soft-reference convention as
/// `ShipmentLine.sourceOrderLineId`). `serialNumber` is captured at
/// document CREATE time (before any stock exists); `serialId` is filled
/// in at POSTING time once the posting handler has resolved/created (for
/// a receipt) or validated (for an issue/return) the real `SerialNumber`
/// row — see docs/WAREHOUSE_INVENTORY.md "Batch/serial capture".
model DocumentLineSerial {
  id           String  @id @default(uuid())
  tenantId     String  @map("tenant_id")
  documentType String  @map("document_type")
  lineId       String  @map("line_id")
  position     Int     @default(0)
  serialNumber String  @map("serial_number")
  serialId     String? @map("serial_id")

  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  serial SerialNumber? @relation(fields: [serialId], references: [id])

  @@index([tenantId, documentType, lineId])
  @@map("document_line_serials")
}

// =============================================================================
// Kontragentlər (Counterparty CRM extension) — bank accounts, contracts,
// contract amendments, and document attachments. See
// docs/COUNTERPARTY_MANAGEMENT.md.
// =============================================================================

/// A counterparty's OWN bank account (their payment details for us to pay
/// into, or receive from) — distinct from `BankAccount` (this tenant's own
/// organization's accounts, Phase 1). Multiple accounts allowed; exactly
/// the accounts marked `isPrimary` are "the" default for a given currency
/// scope — enforced one-primary-overall for simplicity (a counterparty
/// picks one main account regardless of currency; disclosed simplification
/// in docs/COUNTERPARTY_MANAGEMENT.md).
model CounterpartyBankAccount {
  id                   String   @id @default(uuid())
  tenantId             String   @map("tenant_id")
  counterpartyId       String   @map("counterparty_id")
  bankName             String   @map("bank_name")
  bankTaxId            String?  @map("bank_tax_id")
  bankCode             String?  @map("bank_code")
  bankAddress          String?  @map("bank_address")
  accountNumber        String   @map("account_number")
  iban                 String?
  swiftBic             String?  @map("swift_bic")
  correspondentAccount String?  @map("correspondent_account")
  currencyId           String?  @map("currency_id")
  branchName           String?  @map("branch_name") // the counterparty's own bank branch (free text)
  isPrimary            Boolean  @default(false) @map("is_primary")
  notes                String?
  active               Boolean  @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  counterparty Counterparty @relation(fields: [counterpartyId], references: [id])
  currency     Currency?    @relation(fields: [currencyId], references: [id])

  @@index([counterpartyId, active])
  @@index([counterpartyId, isPrimary])
  @@map("counterparty_bank_accounts")
}

/// Contract with a counterparty (spec section 5). Plain CRUD + a bespoke
/// approval gate (never document-framework: no GL, no posting) — mirrors
/// PurchaseRequirement's own non-posting shape.
model CounterpartyContract {
  id             String  @id @default(uuid())
  tenantId       String  @map("tenant_id")
  organizationId String  @map("organization_id")
  counterpartyId String  @map("counterparty_id")
  number         String
  subject        String
  contractType   String? @map("contract_type")
  signedDate     DateTime? @map("signed_date") @db.Date
  startDate      DateTime? @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  amount         Decimal?  @db.Decimal(18, 2)
  currencyId     String?   @map("currency_id")
  paymentTerms   String?   @map("payment_terms") // "qalan ödənişin şərtləri" — free text (e.g. "NET 30")
  responsiblePersonId String? @map("responsible_person_id")
  notes          String?

  // -- Commercial / delivery terms (spec section 10) ------------------------
  hasAdvance              Boolean  @default(false) @map("has_advance")
  advancePercent          Decimal? @map("advance_percent") @db.Decimal(5, 2)
  // Auto-computed as grandTotal * advancePercent/100 whenever the total or
  // percent changes — UNLESS `advanceAmountManual` is true, meaning a user
  // with the right permission overrode it explicitly (see
  // CounterpartyContractService.setAdvance); the override itself is only
  // ever recorded in the audit trail (oldValues/newValues), never a second
  // schema column, matching how every other history requirement in this
  // module is satisfied.
  advanceAmount           Decimal? @map("advance_amount") @db.Decimal(18, 2)
  advanceAmountManual     Boolean  @default(false) @map("advance_amount_manual")
  remainingPaymentDueDays Int?     @map("remaining_payment_due_days")
  deliveryDate            DateTime? @map("delivery_date") @db.Date
  deliveryTermDays        Int?     @map("delivery_term_days")
  deliveryAddress         String?  @map("delivery_address")
  deliveryTerms           String?  @map("delivery_terms")
  warrantyPeriod          String?  @map("warranty_period")
  penaltyTerms            String?  @map("penalty_terms")
  otherTerms              String?  @map("other_terms")

  // -- Nomenclature lines + live totals (spec sections 11-13) ---------------
  priceIncludesTax        Boolean  @default(false) @map("price_includes_tax")
  sourcePurchaseOrderId   String?  @map("source_purchase_order_id")
  // Set whenever a line is added/edited/removed by hand after being pulled
  // from the source PO — the frontend warns before a "change source PO"
  // resync discards lines while this is true. Reset to false by every
  // (re)pull from a PO (create-from-PO, change-source-PO).
  linesDirty              Boolean  @default(false) @map("lines_dirty")
  subtotal                Decimal? @db.Decimal(18, 2) // pre-tax, post-discount sum of all lines
  totalDiscount           Decimal? @map("total_discount") @db.Decimal(18, 2)
  totalTax                Decimal? @map("total_tax") @db.Decimal(18, 2)
  remainingPayableAmount  Decimal? @map("remaining_payable_amount") @db.Decimal(18, 2) // amount - advanceAmount

  // Overall spend limit across every PurchaseOrder referencing this
  // contract (PurchaseOrder.contractId) — null means no limit. Policy
  // governs what happens when a new/edited order would push the running
  // total over limitAmount: WARN (allowed, flagged only), BLOCK (rejected),
  // APPROVAL (an extra FINANCE approval step is required — see
  // PurchaseOrderApprovalPlanProvider).
  limitAmount Decimal? @map("limit_amount") @db.Decimal(18, 2)
  limitPolicy String   @default("WARN") @map("limit_policy") // WARN|BLOCK|APPROVAL

  // DRAFT|PENDING_APPROVAL|APPROVED|ACTIVE|EXPIRED|CANCELLED
  status     String    @default("DRAFT")
  approvedBy String?   @map("approved_by")
  approvedAt DateTime? @map("approved_at")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  tenant              Tenant                         @relation(fields: [tenantId], references: [id])
  organization        Organization                   @relation(fields: [organizationId], references: [id])
  counterparty        Counterparty                   @relation(fields: [counterpartyId], references: [id])
  currency            Currency?                      @relation(fields: [currencyId], references: [id])
  responsiblePerson   ResponsiblePerson?              @relation(fields: [responsiblePersonId], references: [id])
  amendments          CounterpartyContractAmendment[]
  lines               CounterpartyContractLine[]
  paymentInstallments CounterpartyContractPaymentInstallment[]

  @@unique([counterpartyId, number])
  @@index([organizationId, status])
  @@index([sourcePurchaseOrderId])
  @@map("counterparty_contracts")
}

/// One nomenclature line on a contract (spec sections 11-13) — either
/// copied from a confirmed PurchaseOrderLine (`sourceOrderLineId` set) or
/// entered directly. Every monetary field below is DERIVED — never typed
/// by hand — and recomputed by CounterpartyContractService whenever
/// quantity/price/discount/tax inputs change (spec section 13's
/// recalculation rule).
model CounterpartyContractLine {
  id               String  @id @default(uuid())
  tenantId         String  @map("tenant_id")
  contractId       String  @map("contract_id")
  position         Int     @default(0)
  productId        String  @map("product_id")
  description      String?
  quantity         Decimal @db.Decimal(18, 6)
  unitId           String  @map("unit_id")
  unitPrice        Decimal @map("unit_price") @db.Decimal(18, 6)
  discountPercent  Decimal @default(0) @map("discount_percent") @db.Decimal(9, 4)
  discountAmount   Decimal @default(0) @map("discount_amount") @db.Decimal(18, 2)
  lineAmount       Decimal @default(0) @map("line_amount") @db.Decimal(18, 2) // quantity * unitPrice
  taxBase          Decimal @default(0) @map("tax_base") @db.Decimal(18, 2) // lineAmount - discountAmount
  taxCategoryCode  String? @map("tax_category_code")
  taxRatePercent   Decimal? @map("tax_rate_percent") @db.Decimal(9, 4)
  taxAmount        Decimal? @map("tax_amount") @db.Decimal(18, 2)
  lineTotal        Decimal? @map("line_total") @db.Decimal(18, 2) // taxBase + taxAmount
  // Set instead of taxRatePercent/taxAmount when TaxRuleResolverService
  // found no matching rule — the line still saves (DRAFT stays editable),
  // but the contract cannot approve while any line carries this.
  taxCalculationError String? @map("tax_calculation_error")
  sourceOrderLineId   String? @map("source_order_line_id") // PurchaseOrderLine — soft reference
  // Snapshot of the source PO line's own tax, captured once at creation —
  // compared against the live-recalculated tax above every time the
  // counterparty's tax status (or another tax-point field) changes so a
  // divergence can be surfaced to the user and kept in history (spec
  // section: "ƏDV-də fərq yarandıqda istifadəçiyə xəbərdarlıq göstərilsin").
  sourcePoTaxRatePercent Decimal? @map("source_po_tax_rate_percent") @db.Decimal(9, 4)
  sourcePoTaxAmount      Decimal? @map("source_po_tax_amount") @db.Decimal(18, 2)
  taxMismatch            Boolean  @default(false) @map("tax_mismatch")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  tenant   Tenant               @relation(fields: [tenantId], references: [id])
  contract CounterpartyContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  product  Product              @relation(fields: [productId], references: [id])
  unit     UnitOfMeasure        @relation(fields: [unitId], references: [id])

  @@index([contractId, position])
  @@index([tenantId, sourceOrderLineId])
  @@map("counterparty_contract_lines")
}

/// Payment schedule installment ("Ödəniş qrafiki", spec section 10) —
/// same shape as PurchaseOrderPaymentSchedule for consistency across the
/// codebase's two payment-schedule concepts.
model CounterpartyContractPaymentInstallment {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  contractId String   @map("contract_id")
  sequence   Int      @default(0)
  dueDate    DateTime @map("due_date") @db.Date
  basis      String   @default("AFTER_DELIVERY") // ADVANCE|AFTER_DELIVERY|AFTER_INVOICE
  percentage Decimal? @db.Decimal(9, 4)
  amount     Decimal  @db.Decimal(18, 2)
  currencyId String?  @map("currency_id")
  status     String   @default("PLANNED")

  createdAt DateTime @default(now()) @map("created_at")

  tenant   Tenant               @relation(fields: [tenantId], references: [id])
  contract CounterpartyContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  currency Currency?            @relation(fields: [currencyId], references: [id])

  @@index([contractId, sequence])
  @@map("counterparty_contract_payment_installments")
}

/// Amendment ("əlavə") to a CounterpartyContract (spec section 6) — always
/// belongs to exactly one parent contract; number is unique within that
/// contract (not globally).
model CounterpartyContractAmendment {
  id                String    @id @default(uuid())
  tenantId          String    @map("tenant_id")
  contractId        String    @map("contract_id")
  number            String
  subject           String
  amendmentDate     DateTime? @map("amendment_date") @db.Date
  effectiveDate     DateTime? @map("effective_date") @db.Date
  endDate           DateTime? @map("end_date") @db.Date
  newAmount         Decimal?  @map("new_amount") @db.Decimal(18, 2)
  currencyId        String?   @map("currency_id")
  changeDescription String?   @map("change_description")
  notes             String?

  // DRAFT|PENDING_APPROVAL|APPROVED|ACTIVE|EXPIRED|CANCELLED
  status     String    @default("DRAFT")
  approvedBy String?   @map("approved_by")
  approvedAt DateTime? @map("approved_at")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  tenant   Tenant               @relation(fields: [tenantId], references: [id])
  contract CounterpartyContract @relation(fields: [contractId], references: [id])
  currency Currency?            @relation(fields: [currencyId], references: [id])

  @@unique([contractId, number])
  @@map("counterparty_contract_amendments")
}

/// File attached directly to a CounterpartyContract or a
/// CounterpartyContractAmendment (spec section 7) — `ownerType` +
/// `ownerId` is a soft reference (same convention as
/// `DocumentLineSerial`/`ShipmentLine.sourceOrderLineId`) rather than two
/// nullable FK columns, since a document belongs to exactly one of the two
/// owner kinds. The file itself lives on local disk under a per-tenant
/// upload root; this row is its metadata + an opaque `storageKey` used to
/// resolve the path (never trust a client-supplied path).
model CounterpartyDocument {
  id             String @id @default(uuid())
  tenantId       String @map("tenant_id")
  organizationId String @map("organization_id")
  ownerType      String @map("owner_type") // CONTRACT | CONTRACT_AMENDMENT
  ownerId        String @map("owner_id")

  fileName        String  @map("file_name")
  fileType        String  @map("file_type") // MIME type
  fileSize        Int     @map("file_size") // bytes
  storageKey      String  @map("storage_key")
  documentVersion Int     @default(1) @map("document_version")
  notes           String?
  active          Boolean @default(true) // soft-delete

  uploadedBy String   @map("uploaded_by")
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, ownerType, ownerId, active])
  @@map("counterparty_documents")
}

// =============================================================================
// PHASE 11 — INVENTORY COSTING / MAYA DƏYƏRİ ENGINE
//
// Quantity/value separation (spec section 1): Phase 10's InventoryMovement
// stays the sole quantity source-of-truth; nothing here mutates it or adds
// an "average_cost" field to Product/Warehouse. This subledger answers
// "what are those units worth" as its own append-mostly register, keyed by
// InventoryCostingDimensionService's `costingKey` (spec section 5) rather
// than always mirroring Phase 10's own warehouse/batch dimensions.
//
// Disclosed simplifications (this build, not the spec's own limitation):
//   - No InventoryCostBalanceSnapshot / period-opening-state acceleration
//     (spec sections 106-108) — recalculation always walks movements from
//     the earliest affected date forward; correct, not yet optimized for
//     millions of rows (spec section 105's own priority: "correctness
//     performance-dan öndədir").
//   - No SPECIFIC_IDENTIFICATION/STANDARD_COST/MOVING_AVERAGE-as-a-third-
//     method, no consignment ownership-transfer costing event, no
//     free-goods special allocation, no InventoryOpeningCostBalance
//     migration path, no CostingAccountingPostingBatch wrapper (the
//     existing AccountingPostingEngine batch already gives Dr=Cr and a
//     JournalEntry to trace to) — all named in spec section 137 as
//     interface/data-readiness obligations rather than full builds here.
// =============================================================================

/// Effective-dated costing configuration (spec section 4) — costing method
/// changes take a NEW row with a later `effectiveFrom` rather than mutating
/// this one in place (spec sections 99-100: a method change never silently
/// reinterprets history). `InventoryCostingPolicyService.resolve` picks the
/// row whose [effectiveFrom, effectiveTo) window covers a given date.
model InventoryCostingPolicy {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  organizationId String    @map("organization_id")
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date

  costingMethod       String  @default("FIFO") @map("costing_method") // FIFO|WEIGHTED_AVERAGE
  averageMethod        String  @default("MOVING_AVERAGE") @map("average_method") // MOVING_AVERAGE|PERIODIC_WEIGHTED_AVERAGE — read only when costingMethod=WEIGHTED_AVERAGE
  valuationCurrencyId  String? @map("valuation_currency_id")

  includePurchaseAdditionalCosts Boolean @default(true) @map("include_purchase_additional_costs")
  includeCustomsCost             Boolean @default(true) @map("include_customs_cost")
  includeFreight                 Boolean @default(true) @map("include_freight")
  allowProvisionalCost           Boolean @default(true) @map("allow_provisional_cost")
  allowNegativeQuantityCosting   Boolean @default(true) @map("allow_negative_quantity_costing")
  negativeStockCostPolicy        String  @default("LAST_KNOWN_COST") @map("negative_stock_cost_policy") // LAST_KNOWN_COST|CURRENT_AVERAGE|STANDARD_COST|ZERO_PENDING|BLOCK_COSTING
  recalculateBackdatedDocuments  Boolean @default(true) @map("recalculate_backdated_documents")

  costByWarehouse      Boolean @default(true) @map("cost_by_warehouse")
  costByCharacteristic Boolean @default(false) @map("cost_by_characteristic")
  costByBatch          Boolean @default(false) @map("cost_by_batch")

  roundingPolicy String @default("LINE_LEVEL_2DP") @map("rounding_policy")
  status         String @default("ACTIVE") // DRAFT|ACTIVE|SUPERSEDED
  version        Int    @default(1)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  tenant            Tenant       @relation(fields: [tenantId], references: [id])
  organization      Organization @relation(fields: [organizationId], references: [id])
  valuationCurrency Currency?    @relation(fields: [valuationCurrencyId], references: [id])

  @@index([tenantId, organizationId, effectiveFrom])
  @@map("inventory_costing_policies")
}

/// FIFO cost layer (spec sections 8-10, 73) — one row per incoming
/// financial-inventory movement (a GoodsReceipt line, a purchase return
/// reversal, etc). Immutable identity (`originalQuantity`/`originalUnitCost`
/// never change); `remainingQuantity`/`currentUnitCost`/`currentRemainingValue`
/// are the only fields consumption and cost adjustments update, so the
/// original receipt cost is always still visible (spec section 73).
model InventoryCostLayer {
  id             String  @id @default(uuid())
  tenantId       String  @map("tenant_id")
  organizationId String  @map("organization_id")
  costingKey     String  @map("costing_key")
  productId      String  @map("product_id")
  warehouseId    String? @map("warehouse_id")
  batchId        String? @map("batch_id")

  sourceDocumentType    String  @map("source_document_type")
  sourceDocumentId      String  @map("source_document_id")
  sourceDocumentLineId  String? @map("source_document_line_id")
  sourceMovementId      String? @map("source_movement_id") // InventoryMovement.id this layer was opened from

  receiptDate            DateTime @map("receipt_date") @db.Date
  postingSequence        BigInt   @default(autoincrement()) @map("posting_sequence") // deterministic FIFO tie-breaker (spec section 10)
  originalQuantity       Decimal  @map("original_quantity") @db.Decimal(18, 6)
  remainingQuantity      Decimal  @map("remaining_quantity") @db.Decimal(18, 6)
  originalUnitCost       Decimal  @map("original_unit_cost") @db.Decimal(18, 6)
  currentUnitCost        Decimal  @map("current_unit_cost") @db.Decimal(18, 6)
  originalTotalCost      Decimal  @map("original_total_cost") @db.Decimal(18, 2)
  currentRemainingValue  Decimal  @map("current_remaining_value") @db.Decimal(18, 2)
  currencyId             String? @map("currency_id")

  status String @default("OPEN") @map("status") // OPEN|PARTIALLY_CONSUMED|CLOSED|ADJUSTED|REVERSED

  createdAt DateTime @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])
  warehouse    Warehouse?   @relation(fields: [warehouseId], references: [id])
  batch        Batch?       @relation(fields: [batchId], references: [id])
  currency     Currency?    @relation(fields: [currencyId], references: [id])

  consumptions    InventoryCostConsumption[]
  components      InventoryCostComponent[]
  adjustmentLines InventoryCostAdjustmentLine[]

  @@index([tenantId, costingKey, status, receiptDate, postingSequence])
  @@index([tenantId, sourceDocumentType, sourceDocumentId])
  @@map("inventory_cost_layers")
}

/// FIFO consumption mapping (spec section 11) — traceability from an
/// outgoing movement back to the exact layer(s) it drew from. One row per
/// (outgoing movement, layer) pair; a shipment of 150 against two layers
/// produces two rows.
model InventoryCostConsumption {
  id               String  @id @default(uuid())
  tenantId         String  @map("tenant_id")
  costLayerId      String  @map("cost_layer_id")
  outgoingMovementId     String  @map("outgoing_movement_id") // InventoryMovement.id
  outgoingDocumentType   String  @map("outgoing_document_type")
  outgoingDocumentId     String  @map("outgoing_document_id")
  outgoingDocumentLineId String? @map("outgoing_document_line_id")

  consumedQuantity Decimal @map("consumed_quantity") @db.Decimal(18, 6)
  unitCost         Decimal @map("unit_cost") @db.Decimal(18, 6)
  consumedCost     Decimal @map("consumed_cost") @db.Decimal(18, 2)
  calculationRunId String? @map("calculation_run_id")
  reversed         Boolean @default(false) // set true instead of deleted when a recalculation supersedes it (spec section 92 — old vs new visible)

  createdAt DateTime @default(now()) @map("created_at")

  tenant    Tenant             @relation(fields: [tenantId], references: [id])
  costLayer InventoryCostLayer @relation(fields: [costLayerId], references: [id])

  @@index([tenantId, outgoingDocumentType, outgoingDocumentId])
  @@index([tenantId, outgoingDocumentLineId])
  @@index([costLayerId])
  @@map("inventory_cost_consumptions")
}

/// Cost component traceability (spec section 23) — one row per cost
/// element folded into a layer's current unit cost (base purchase price,
/// then each capitalized AdditionalPurchaseCost allocation, then any
/// manual InventoryCostAdjustment). `PurchaseCostAllocation` (Phase 9)
/// stays the allocation-calculation record; this is the costing-side
/// ledger of what actually landed on the layer, in order.
model InventoryCostComponent {
  id                 String  @id @default(uuid())
  tenantId           String  @map("tenant_id")
  costLayerId        String  @map("cost_layer_id")
  componentType      String  @map("component_type") // PURCHASE_PRICE|FREIGHT|CUSTOMS|INSURANCE|BROKER|HANDLING|CERTIFICATION|OTHER|ADJUSTMENT
  sourceDocumentType String? @map("source_document_type")
  sourceDocumentId   String? @map("source_document_id")
  amount             Decimal @db.Decimal(18, 2) // in this layer's currency
  baseCurrencyAmount Decimal @map("base_currency_amount") @db.Decimal(18, 2)

  createdAt DateTime @default(now()) @map("created_at")

  tenant    Tenant             @relation(fields: [tenantId], references: [id])
  costLayer InventoryCostLayer @relation(fields: [costLayerId], references: [id], onDelete: Cascade)

  @@index([costLayerId])
  @@map("inventory_cost_components")
}

/// Costing register (spec section 6) — one row per InventoryMovement this
/// engine has priced, RECEIPT or ISSUE. The authoritative "what did this
/// movement cost" record; `InventoryValuationService`/`CostingReportingService`
/// aggregate from here rather than re-deriving from layers each time.
model InventoryCostMovement {
  id             String  @id @default(uuid())
  tenantId       String  @map("tenant_id")
  organizationId String  @map("organization_id")
  costingKey     String  @map("costing_key")
  warehouseId    String? @map("warehouse_id")
  productId      String  @map("product_id")
  batchId        String? @map("batch_id")
  ownershipType  String  @default("OWN") @map("ownership_type")

  sourceMovementId     String  @map("source_movement_id") // InventoryMovement.id
  sourceDocumentType   String  @map("source_document_type")
  sourceDocumentId     String  @map("source_document_id")
  sourceDocumentLineId String? @map("source_document_line_id")

  effectiveDate DateTime @map("effective_date") @db.Date
  postingDate   DateTime @map("posting_date") @db.Date
  movementType  String   @map("movement_type") // RECEIPT|ISSUE|ADJUSTMENT|TRANSFER_OUT|TRANSFER_IN
  quantity      Decimal  @db.Decimal(18, 6) // signed: + IN, - OUT
  unitCost      Decimal  @map("unit_cost") @db.Decimal(18, 6)
  totalCost     Decimal  @map("total_cost") @db.Decimal(18, 2)
  provisional   Boolean  @default(false)
  finalCost     Decimal? @map("final_cost") @db.Decimal(18, 2)

  valuationCurrencyId String? @map("valuation_currency_id")
  costStatus          String  @default("FINAL") @map("cost_status") // UNCALCULATED|PROVISIONAL|FINAL|RECALCULATION_REQUIRED|ERROR
  calculationRunId    String? @map("calculation_run_id")

  createdAt DateTime @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])
  warehouse    Warehouse?   @relation(fields: [warehouseId], references: [id])
  batch        Batch?       @relation(fields: [batchId], references: [id])

  @@index([tenantId, costingKey, effectiveDate])
  @@index([tenantId, sourceDocumentType, sourceDocumentId])
  @@index([tenantId, sourceMovementId])
  @@index([tenantId, costStatus])
  @@map("inventory_cost_movements")
}

/// Calculation run (spec sections 49, 92) — every provisional/backdated/
/// finalize/full-rebuild pass gets one row, so "what changed and why" is
/// always answerable. `InventoryCostConsumption.calculationRunId` and
/// `InventoryCostMovement.calculationRunId` tag which run produced them.
model InventoryCostCalculationRun {
  id             String  @id @default(uuid())
  tenantId       String  @map("tenant_id")
  organizationId String  @map("organization_id")
  period         String? // YYYY-MM, set for PERIOD_CLOSE runs

  calculationType String @map("calculation_type") // INCREMENTAL|BACKDATED_RECALCULATION|PERIOD_CLOSE|FULL_REBUILD|DIAGNOSTIC
  method          String? // FIFO|WEIGHTED_AVERAGE — the policy in effect when the run started
  status          String @default("RUNNING") // RUNNING|COMPLETED|FAILED
  sourceTrigger   String? @map("source_trigger") // e.g. "GoodsReceipt:<id>", "manual", "period-finalize"

  movementCount  Int @default(0) @map("movement_count")
  adjustmentCount Int @default(0) @map("adjustment_count")
  errorCount     Int @default(0) @map("error_count")

  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")
  initiatedBy String?   @map("initiated_by")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([tenantId, organizationId, calculationType, startedAt])
  @@map("inventory_cost_calculation_runs")
}

/// Recalculation queue (spec section 47) — a backdated or cost-changing
/// event enqueues one entry naming the earliest affected date; the
/// recalculation engine consumes it and never re-walks full history.
model InventoryCostRecalculationQueueEntry {
  id             String  @id @default(uuid())
  tenantId       String  @map("tenant_id")
  organizationId String  @map("organization_id")
  costingKey     String  @map("costing_key")

  earliestAffectedDate DateTime @map("earliest_affected_date") @db.Date
  reason               String
  sourceDocumentType   String?  @map("source_document_type")
  sourceDocumentId     String?  @map("source_document_id")
  status               String   @default("PENDING") // PENDING|PROCESSING|COMPLETED|FAILED
  calculationRunId     String?  @map("calculation_run_id")

  createdAt   DateTime  @default(now()) @map("created_at")
  processedAt DateTime? @map("processed_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([tenantId, status, costingKey])
  @@map("inventory_cost_recalculation_queue")
}

/// Costing error register (spec sections 55-56) — never silently
/// swallowed (spec section 138): a costing operation that cannot produce
/// an authoritative cost records one of these instead of guessing.
model InventoryCostingError {
  id               String  @id @default(uuid())
  tenantId         String  @map("tenant_id")
  organizationId   String  @map("organization_id")
  calculationRunId String? @map("calculation_run_id")
  productId        String? @map("product_id")
  costingKey       String? @map("costing_key")
  movementId       String? @map("movement_id")
  documentType     String? @map("document_type")
  documentId       String? @map("document_id")

  errorCode   String @map("error_code") // MISSING_SOURCE_PRICE|MISSING_EXCHANGE_RATE|NO_ELIGIBLE_FIFO_LAYER|NEGATIVE_INVENTORY_INCONSISTENCY|INVALID_ALLOCATION|BROKEN_SOURCE_LINK|IMPOSSIBLE_LAYER_BALANCE|ROUNDING_IMBALANCE|ACCOUNTING_DIMENSION_MISSING
  description String
  severity    String @default("ERROR") // INFO|WARNING|ERROR|BLOCKING
  blocking    Boolean @default(false)

  resolved   Boolean   @default(false)
  resolvedBy String?   @map("resolved_by")
  resolvedAt DateTime? @map("resolved_at")

  createdAt DateTime @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([tenantId, organizationId, resolved, severity])
  @@index([tenantId, calculationRunId])
  @@map("inventory_costing_errors")
}

/// Costing period status (spec sections 58-60) — mirrors Phase 4's
/// accounting Period but tracks costing finalization specifically, since
/// "GL period closed" and "inventory costing finalized" are two different
/// gates Phase 22's Month Close will check independently (spec section 60).
model InventoryCostingPeriod {
  id             String @id @default(uuid())
  tenantId       String @map("tenant_id")
  organizationId String @map("organization_id")
  period         String // YYYY-MM

  status String @default("OPEN") // OPEN|PROVISIONAL|CALCULATING|FINALIZED|REOPENED|ERROR

  provisionalCalculatedAt DateTime? @map("provisional_calculated_at")
  finalCalculatedAt       DateTime? @map("final_calculated_at")
  finalizedBy             String?   @map("finalized_by")
  calculationRunId        String?   @map("calculation_run_id")
  reopenedAt              DateTime? @map("reopened_at")
  reopenedBy              String?   @map("reopened_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([tenantId, organizationId, period])
  @@map("inventory_costing_periods")
}

/// Manual/late-cost adjustment document (spec sections 44-45) — a real
/// DocumentFramework document type (draft/post/unpost via the generic
/// /documents/INVENTORY_COST_ADJUSTMENT/... endpoints) so late invoice
/// differences, landed-cost corrections, and authorized manual overrides
/// all go through the same save/post/audit lifecycle as every other
/// document in this codebase, instead of a bespoke admin-only mutation.
model InventoryCostAdjustment {
  id             String         @id @default(uuid())
  tenantId       String         @map("tenant_id")
  organizationId String         @map("organization_id")
  documentType   String         @default("INVENTORY_COST_ADJUSTMENT") @map("document_type")
  number         String?
  documentDate   DateTime       @map("document_date") @db.Date
  postingDate    DateTime?      @map("posting_date") @db.Date
  reason         String // LATE_INVOICE_DIFFERENCE|SUPPLIER_PRICE_CORRECTION|LANDED_COST_CORRECTION|MANUAL_AUTHORIZED|MIGRATION_CORRECTION|SYSTEM_RECALCULATION
  sourceDocumentType String? @map("source_document_type")
  sourceDocumentId   String? @map("source_document_id")
  status         DocumentStatus @default(DRAFT)
  postingStatus  PostingStatus  @default(NOT_POSTED) @map("posting_status")
  comment        String?

  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String?   @map("created_by")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  updatedBy   String?   @map("updated_by")
  postedAt    DateTime? @map("posted_at")
  postedBy    String?   @map("posted_by")
  cancelledAt DateTime? @map("cancelled_at")
  cancelledBy String?   @map("cancelled_by")
  deletionMark Boolean  @default(false) @map("deletion_mark")
  version     Int       @default(1)

  tenant       Tenant                        @relation(fields: [tenantId], references: [id])
  organization Organization                  @relation(fields: [organizationId], references: [id])
  lines        InventoryCostAdjustmentLine[]

  @@unique([tenantId, number])
  @@index([tenantId, documentDate])
  @@map("inventory_cost_adjustments")
}

model InventoryCostAdjustmentLine {
  id                String  @id @default(uuid())
  tenantId          String  @map("tenant_id")
  adjustmentId      String  @map("adjustment_id")
  position          Int     @default(0)
  productId         String  @map("product_id")
  costingKey        String  @map("costing_key")
  costLayerId       String? @map("cost_layer_id") // nullable — a weighted-average adjustment has no single layer
  quantityReference Decimal? @map("quantity_reference") @db.Decimal(18, 6)
  oldUnitCost       Decimal? @map("old_unit_cost") @db.Decimal(18, 6)
  adjustmentAmount  Decimal  @map("adjustment_amount") @db.Decimal(18, 2) // signed
  newUnitCost       Decimal? @map("new_unit_cost") @db.Decimal(18, 6)
  warehouseId       String? @map("warehouse_id")
  notes             String?

  createdAt DateTime @default(now()) @map("created_at")

  tenant     Tenant                  @relation(fields: [tenantId], references: [id])
  adjustment InventoryCostAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  product    Product                 @relation(fields: [productId], references: [id])
  costLayer  InventoryCostLayer?     @relation(fields: [costLayerId], references: [id])

  @@index([adjustmentId, position])
  @@map("inventory_cost_adjustment_lines")
}

// =============================================================================
// PHASE 12 — INVENTORY COUNT / İNVENTARİZASİYA / STOCKTAKING
//
// A full reconciliation ENGINE (spec section 5), not one document:
// Plan -> Scope -> Snapshot -> Freeze -> Session -> Sheets/Tasks -> Blind
// Count -> Recount -> Variance -> Investigation -> Decision -> Costing ->
// Approval -> Posting (reuses Phase 10's own InventoryAdjustment, WRITE_OFF/
// SURPLUS adjustmentType) -> Reconciliation -> Close.
//
// Disclosed simplifications (this build):
//   - No separate InventoryCountEntryVersion / InventoryCountTeam tables —
//     entry correction history is a same-shaped new InventoryCountEntry row
//     chained via `supersedesEntryId` (never overwritten in place, spec
//     section 29/79's own requirement, just without a second parallel
//     table), and a count team is the session's own free-text
//     `teamMembersJson` rather than a normalized roster table.
//   - Cross-module references (productId, warehouseId, locationId, batchId,
//     serialId, characteristicId) are soft string references (this
//     codebase's own convention — see CounterpartyDocument's ownerId/
//     ownerType) rather than hard Prisma relations, since this module's own
//     bulk snapshot/variance queries never need to join through them at the
//     database level.
// =============================================================================

model InventoryCountPlan {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  organizationId String    @map("organization_id")
  branchId       String?   @map("branch_id")
  number         String?
  planDate       DateTime  @map("plan_date") @db.Date
  plannedStartAt DateTime? @map("planned_start_at")
  plannedEndAt   DateTime? @map("planned_end_at")

  countType String @default("FULL") @map("count_type") // FULL|PARTIAL|CYCLE|ANNUAL|AD_HOC|INVESTIGATION|RECOUNT
  reason    String?

  responsibleUserId String? @map("responsible_user_id")
  countManagerId    String? @map("count_manager_id")

  status String @default("DRAFT") // DRAFT|READY|ACTIVE|COMPLETED|CANCELLED

  blindCountEnabled Boolean @default(false) @map("blind_count_enabled")
  freezePolicy      String  @default("SOFT_FREEZE") @map("freeze_policy") // HARD_FREEZE|SOFT_FREEZE|NO_FREEZE_WITH_MOVEMENT_TRACKING
  recountPolicy     String  @default("RECOUNT_ABOVE_VALUE_THRESHOLD") @map("recount_policy") // NO_RECOUNT|RECOUNT_ALL_VARIANCES|RECOUNT_ABOVE_QUANTITY_THRESHOLD|RECOUNT_ABOVE_VALUE_THRESHOLD|RECOUNT_PERCENTAGE|MANUAL_SELECTION
  recountQuantityThreshold Decimal? @map("recount_quantity_threshold") @db.Decimal(18, 6)
  recountValueThreshold    Decimal? @map("recount_value_threshold") @db.Decimal(18, 2)
  recountPercentageThreshold Decimal? @map("recount_percentage_threshold") @db.Decimal(9, 4)

  comment String?

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  tenant       Tenant                @relation(fields: [tenantId], references: [id])
  organization Organization          @relation(fields: [organizationId], references: [id])
  scopes       InventoryCountScope[]
  sessions     InventoryCountSession[]

  @@unique([tenantId, number])
  @@index([tenantId, organizationId, status])
  @@map("inventory_count_plans")
}

/// Scope filter row (spec sections 5-6) — a plan can carry several,
/// each an INCLUDE or EXCLUDE rule; a null dimension column means "any
/// value" for that dimension. Immutable once the plan's first session
/// leaves DRAFT (spec section 6) — enforced in `InventoryCountScopeService`,
/// not at the schema level.
model InventoryCountScope {
  id     String @id @default(uuid())
  tenantId String @map("tenant_id")
  planId String @map("plan_id")

  warehouseId        String? @map("warehouse_id")
  locationId         String? @map("location_id")
  includeSubtree     Boolean @default(false) @map("include_subtree")
  productId          String? @map("product_id")
  productGroupId     String? @map("product_group_id")
  productCategoryId  String? @map("product_category_id")
  characteristicId   String? @map("characteristic_id")
  batchId            String? @map("batch_id")
  serialId           String? @map("serial_id")
  ownershipType      String? @map("ownership_type")
  qualityStatus      String? @map("quality_status")

  rule String @default("INCLUDE") // INCLUDE|EXCLUDE

  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant             @relation(fields: [tenantId], references: [id])
  plan   InventoryCountPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@map("inventory_count_scopes")
}

model InventoryCountSession {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  organizationId String   @map("organization_id")
  planId         String   @map("plan_id")
  sessionNumber  String?  @map("session_number")

  status String @default("DRAFT") // DRAFT|READY|SNAPSHOT_CREATED|COUNTING|RECOUNT_REQUIRED|UNDER_REVIEW|PENDING_APPROVAL|APPROVED|POSTED|RECONCILED|CLOSED|CANCELLED

  startedAt      DateTime? @map("started_at")
  snapshotAt     DateTime? @map("snapshot_at")
  countCutoffAt  DateTime? @map("count_cutoff_at")
  completedAt    DateTime? @map("completed_at")
  startedBy      String?   @map("started_by")
  completedBy    String?   @map("completed_by")

  freezePolicy                 String  @map("freeze_policy")
  blindCount                   Boolean @default(false) @map("blind_count")
  fullBlindCount                Boolean @default(false) @map("full_blind_count") // spec section 19 — counter doesn't even see the expected item list
  accountingQuantityVisibility String  @default("HIDDEN") @map("accounting_quantity_visibility") // HIDDEN|VISIBLE
  cutoffMode                   String  @default("GLOBAL_SNAPSHOT_CUTOFF") @map("cutoff_mode") // GLOBAL_SNAPSHOT_CUTOFF|TASK_COMPLETION_CUTOFF|LOCATION_COUNT_TIMESTAMP

  snapshotVersion       Int    @default(0) @map("snapshot_version")
  reconciliationStatus  String @default("NOT_STARTED") @map("reconciliation_status") // NOT_STARTED|IN_PROGRESS|DIFFERENCES_FOUND|ADJUSTMENTS_PENDING|BALANCED|ERROR|CLOSED
  teamMembersJson       String? @map("team_members_json")

  financialYear    String?  @map("financial_year")
  yearEndCount     Boolean  @default(false) @map("year_end_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  version   Int      @default(1)

  tenant        Tenant                       @relation(fields: [tenantId], references: [id])
  organization  Organization                 @relation(fields: [organizationId], references: [id])
  plan          InventoryCountPlan           @relation(fields: [planId], references: [id])
  snapshotLines InventoryCountSnapshotLine[]
  sheets        InventoryCountSheet[]
  entries       InventoryCountEntry[]
  recounts      InventoryRecount[]
  variances     InventoryVariance[]
  reconciliation InventoryCountReconciliation?

  @@unique([tenantId, sessionNumber])
  @@index([tenantId, organizationId, status])
  @@index([tenantId, planId])
  @@map("inventory_count_sessions")
}

/// Authoritative stock snapshot (spec sections 8-10) — bulk-generated from
/// Phase 10's `InventoryMovement` register in one grouped query (never
/// per-row, spec section 102), immutable once written. Doubles as the
/// "expected scope line" list count sheets are generated from. Also
/// carries Phase 11 valuation (`unitCost`/`stockValue`) at snapshot time
/// when available — informational, never authoritative for later
/// variance costing (spec section 34's own "value alınmalı Phase 11-dən"
/// still means AT VARIANCE TIME, not frozen here).
model InventoryCountSnapshotLine {
  id              String @id @default(uuid())
  tenantId        String @map("tenant_id")
  sessionId       String @map("session_id")
  snapshotVersion Int    @map("snapshot_version")

  organizationId   String  @map("organization_id")
  warehouseId      String  @map("warehouse_id")
  locationId       String? @map("location_id")
  productId        String  @map("product_id")
  characteristicId String? @map("characteristic_id")
  batchId          String? @map("batch_id")
  serialId         String? @map("serial_id")
  ownershipType    String  @default("OWN") @map("ownership_type")
  qualityStatus    String  @default("AVAILABLE") @map("quality_status") // maps to Phase 10 stockStatus

  accountingQuantity Decimal  @map("accounting_quantity") @db.Decimal(18, 6)
  baseQuantity       Decimal  @map("base_quantity") @db.Decimal(18, 6)
  unitCost           Decimal? @map("unit_cost") @db.Decimal(18, 6)
  stockValue         Decimal? @map("stock_value") @db.Decimal(18, 2)
  costingStatus      String?  @map("costing_status")

  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant                @relation(fields: [tenantId], references: [id])
  session InventoryCountSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, snapshotVersion])
  @@index([tenantId, sessionId, warehouseId, productId])
  @@map("inventory_count_snapshot_lines")
}

model InventoryCountSheet {
  id            String  @id @default(uuid())
  tenantId      String  @map("tenant_id")
  sessionId     String  @map("session_id")
  sheetNumber   String? @map("sheet_number")
  warehouseId   String  @map("warehouse_id")
  locationScope String? @map("location_scope")

  assignedUserId String? @map("assigned_user_id")
  status         String  @default("GENERATED") // GENERATED|IN_PROGRESS|COMPLETED|CANCELLED

  generatedAt DateTime  @default(now()) @map("generated_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  blindCount  Boolean @default(false) @map("blind_count")
  sequence    Int     @default(0)
  barcodeMode Boolean @default(false) @map("barcode_mode")
  comment     String?

  tenant  Tenant                @relation(fields: [tenantId], references: [id])
  session InventoryCountSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tasks   InventoryCountTask[]
  entries InventoryCountEntry[]

  @@index([sessionId, sequence])
  @@map("inventory_count_sheets")
}

model InventoryCountTask {
  id             String  @id @default(uuid())
  tenantId       String  @map("tenant_id")
  sheetId        String  @map("sheet_id")
  locationId     String? @map("location_id")
  assignedUserId String? @map("assigned_user_id")

  startAt  DateTime? @map("start_at")
  finishAt DateTime? @map("finish_at")
  status   String    @default("PENDING") // PENDING|IN_PROGRESS|COMPLETED
  progress Decimal   @default(0) @db.Decimal(5, 2)

  tenant Tenant              @relation(fields: [tenantId], references: [id])
  sheet  InventoryCountSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  @@index([sheetId])
  @@map("inventory_count_tasks")
}

/// Physical count entry (spec sections 21-29). Never edited in place —
/// a correction inserts a NEW row with `entryVersion` incremented and
/// `supersedesEntryId` pointing at the one it replaces (spec section 79:
/// "Completed count entries physical delete edilməməlidir"). The
/// "current" reading for a (session, product, dims) key is the row with
/// the highest `entryVersion` in that chain that isn't itself superseded.
model InventoryCountEntry {
  id        String  @id @default(uuid())
  tenantId  String  @map("tenant_id")
  sessionId String  @map("session_id")
  sheetId   String  @map("sheet_id")
  taskId    String? @map("task_id")

  warehouseId      String  @map("warehouse_id")
  locationId       String? @map("location_id")
  productId        String  @map("product_id")
  characteristicId String? @map("characteristic_id")
  batchId          String? @map("batch_id")
  serialId         String? @map("serial_id")
  unitId           String  @map("unit_id")

  countedQuantity Decimal  @map("counted_quantity") @db.Decimal(18, 6) // in the counter's own unit
  baseQuantity    Decimal  @map("base_quantity") @db.Decimal(18, 6) // converted, frozen conversion factor (spec section 22)
  countedAt       DateTime @map("counted_at")
  countedBy       String   @map("counted_by")

  entryMethod          String  @default("MANUAL") @map("entry_method") // MANUAL|BARCODE|IMPORT|MOBILE|API|SYSTEM_RECOUNT
  barcode              String?
  notes                String?
  evidenceAttachmentId String? @map("evidence_attachment_id")

  entryVersion       Int     @default(1) @map("entry_version")
  supersedesEntryId  String? @map("supersedes_entry_id")
  supersededReason   String? @map("superseded_reason")
  clientEntryId      String? @map("client_entry_id") // offline/mobile sync idempotency (spec section 81)

  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant                @relation(fields: [tenantId], references: [id])
  session InventoryCountSession @relation(fields: [sessionId], references: [id])
  sheet   InventoryCountSheet   @relation(fields: [sheetId], references: [id])

  @@unique([tenantId, sessionId, clientEntryId])
  @@index([sessionId, warehouseId, productId, batchId, serialId])
  @@index([sheetId])
  @@map("inventory_count_entries")
}

/// Recount (spec sections 37-41) — independent of `InventoryCountEntry`'s
/// own versioning chain: a recount is a NEW counting act (often by a
/// different person), not a correction of a typo. The original entry it
/// targets is never overwritten.
model InventoryRecount {
  id               String  @id @default(uuid())
  tenantId         String  @map("tenant_id")
  sessionId        String  @map("session_id")
  varianceId       String? @map("variance_id")
  originalEntryId  String? @map("original_entry_id")
  recountNumber    Int     @default(1) @map("recount_number")

  assignedUserId String?   @map("assigned_user_id")
  startedAt      DateTime? @map("started_at")
  completedAt    DateTime? @map("completed_at")

  physicalQuantity Decimal? @map("physical_quantity") @db.Decimal(18, 6)
  reason           String?
  resultStatus     String   @default("PENDING") @map("result_status") // PENDING|COMPLETED|CONFIRMED

  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant                @relation(fields: [tenantId], references: [id])
  session InventoryCountSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId, varianceId])
  @@map("inventory_recounts")
}

/// Variance (spec sections 31-36) — one row per dimension combination,
/// NEVER netted across batch/location/etc (spec section 33/135: a
/// product-level net-zero must not hide a batch A -10 / batch B +10
/// discrepancy).
model InventoryVariance {
  id        String @id @default(uuid())
  tenantId  String @map("tenant_id")
  sessionId String @map("session_id")

  warehouseId      String  @map("warehouse_id")
  locationId       String? @map("location_id")
  productId        String  @map("product_id")
  characteristicId String? @map("characteristic_id")
  batchId          String? @map("batch_id")
  serialId         String? @map("serial_id")
  ownershipType    String  @default("OWN") @map("ownership_type")
  qualityStatus    String  @default("AVAILABLE") @map("quality_status")

  accountingQuantity         Decimal  @map("accounting_quantity") @db.Decimal(18, 6)
  adjustedAccountingQuantity Decimal  @map("adjusted_accounting_quantity") @db.Decimal(18, 6)
  physicalQuantity           Decimal? @map("physical_quantity") @db.Decimal(18, 6)
  quantityDifference         Decimal  @map("quantity_difference") @db.Decimal(18, 6)

  varianceType String @map("variance_type") // MATCH|SURPLUS|SHORTAGE|LOCATION_MISMATCH|BATCH_MISMATCH|SERIAL_MISSING|SERIAL_UNEXPECTED|OWNERSHIP_MISMATCH|QUALITY_STATUS_MISMATCH|UNKNOWN_PRODUCT|UNCOUNTED_ITEM

  unitCost        Decimal? @map("unit_cost") @db.Decimal(18, 6)
  valueDifference Decimal? @map("value_difference") @db.Decimal(18, 2)

  severity         String @default("NORMAL") // NORMAL|WARNING|CRITICAL
  resolutionStatus String @default("OPEN") @map("resolution_status") // OPEN|RECOUNT_REQUIRED|UNDER_INVESTIGATION|EXPLAINED|APPROVED|REJECTED|POSTED
  reasonCode       String? @map("reason_code")
  investigationNotes String? @map("investigation_notes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant                     @relation(fields: [tenantId], references: [id])
  session  InventoryCountSession      @relation(fields: [sessionId], references: [id])
  decision InventoryVarianceDecision?

  @@index([sessionId, varianceType, resolutionStatus])
  @@index([tenantId, sessionId, productId])
  @@map("inventory_variances")
}

model InventoryVarianceDecision {
  id         String @id @default(uuid())
  tenantId   String @map("tenant_id")
  varianceId String @unique @map("variance_id")

  finalPhysicalQty    Decimal @map("final_physical_qty") @db.Decimal(18, 6)
  acceptedDifference  Decimal @map("accepted_difference") @db.Decimal(18, 6)
  resolutionType      String  @map("resolution_type") // ADJUST_STOCK|LOCATION_TRANSFER|STATUS_TRANSFER|BATCH_CORRECTION|SERIAL_CORRECTION|NO_ADJUSTMENT|SOURCE_DOCUMENT_CORRECTION|WRITE_OFF|SURPLUS_RECOGNITION
  reasonCode          String? @map("reason_code")
  approvedCost        Decimal? @map("approved_cost") @db.Decimal(18, 6)
  responsibleEmployeeId String? @map("responsible_employee_id")
  recoverableAmount   Decimal? @map("recoverable_amount") @db.Decimal(18, 2)
  recoveryStatus      String?  @map("recovery_status")

  approver   String?
  approvedAt DateTime? @map("approved_at")
  comment    String?

  adjustmentDocumentId String? @map("adjustment_document_id")

  createdAt DateTime @default(now()) @map("created_at")

  tenant   Tenant            @relation(fields: [tenantId], references: [id])
  variance InventoryVariance @relation(fields: [varianceId], references: [id])

  @@map("inventory_variance_decisions")
}

model InventoryCountReconciliation {
  id        String @id @default(uuid())
  tenantId  String @map("tenant_id")
  sessionId String @unique @map("session_id")

  snapshotTotalQty       Decimal @default(0) @map("snapshot_total_qty") @db.Decimal(18, 6)
  adjustedAccountingQty  Decimal @default(0) @map("adjusted_accounting_qty") @db.Decimal(18, 6)
  physicalQty            Decimal @default(0) @map("physical_qty") @db.Decimal(18, 6)
  surplusQty             Decimal @default(0) @map("surplus_qty") @db.Decimal(18, 6)
  shortageQty            Decimal @default(0) @map("shortage_qty") @db.Decimal(18, 6)
  locationMismatchQty    Decimal @default(0) @map("location_mismatch_qty") @db.Decimal(18, 6)
  totalSurplusValue      Decimal @default(0) @map("total_surplus_value") @db.Decimal(18, 2)
  totalShortageValue     Decimal @default(0) @map("total_shortage_value") @db.Decimal(18, 2)
  netValueDifference     Decimal @default(0) @map("net_value_difference") @db.Decimal(18, 2)
  adjustmentDocumentCount Int    @default(0) @map("adjustment_document_count")
  unresolvedVarianceCount Int    @default(0) @map("unresolved_variance_count")

  status       String    @default("NOT_STARTED") // NOT_STARTED|IN_PROGRESS|DIFFERENCES_FOUND|ADJUSTMENTS_PENDING|BALANCED|ERROR|CLOSED
  reconciledAt DateTime? @map("reconciled_at")
  reconciledBy String?   @map("reconciled_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant                @relation(fields: [tenantId], references: [id])
  session InventoryCountSession @relation(fields: [sessionId], references: [id])

  @@map("inventory_count_reconciliations")
}

// =============================================================================
// PHASE 13 — AR / AP / COUNTERPARTY SETTLEMENT ENGINE
//
// Core separation (spec section 3): commercial document (SalesInvoice) vs
// settlement obligation (SettlementObligation/SupplierPayable, extended
// above with real open-item fields) vs payment (SettlementPayment) vs
// allocation (SettlementAllocation, the link) vs accounting entry (Phase 4
// JournalEntry) — never merged into one entity.
//
// Disclosed simplifications (this build):
//   - `SettlementPayment` is a minimal, bank/cash-agnostic payment
//     document (spec section 84's own "Phase 13 payment adapter
//     interfaces" boundary) — Phase 14 (bank) / Phase 15 (cash) are
//     expected to supersede or wrap it with real treasury execution.
//   - Only `BY_DOCUMENT` settlement dimension mode has real allocation
//     behavior; `BY_CONTRACT`/`BY_ORDER`/`BY_AGREEMENT`/
//     `BY_PAYMENT_SCHEDULE`/`GENERAL_BALANCE` are stored on
//     `SettlementPolicy` but resolve to the same BY_DOCUMENT open-item
//     behavior underneath (spec section 8's other modes are an extension
//     point, not fully built here).
//   - Credit notes/debit notes are NOT separate document types — folded
//     into the one universal `DebtAdjustment` via `operationType`
//     (RECEIVABLE_DECREASE ~ credit note, RECEIVABLE_INCREASE ~ debit
//     note), the same consolidation this codebase already applied to
//     Phase 10's InventoryAdjustment (WRITE_OFF/SURPLUS/OPENING_BALANCE).
//   - No persisted `settlement_reconciliation_lines`/
//     `settlement_balance_snapshots`/`settlement_disputes` tables —
//     reconciliation statement lines and health issues are computed live
//     from `SettlementMovement` (same "rebuildable projection, not stored
//     history" pattern already used for costing health in Phase 11/12);
//     dispute state lives on the open item's own `disputedAmount`/
//     `collectionStatus` fields.
// =============================================================================

/// Effective-dated settlement configuration (spec section 8) per
/// organization + counterparty (+ optional contract override).
model SettlementPolicy {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  organizationId String    @map("organization_id")
  counterpartyId String?   @map("counterparty_id") // null = organization-wide default
  contractId     String?   @map("contract_id")
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date

  settlementDimensionType String @default("BY_DOCUMENT") @map("settlement_dimension_type") // BY_DOCUMENT|BY_CONTRACT|BY_ORDER|BY_AGREEMENT|BY_PAYMENT_SCHEDULE|GENERAL_BALANCE
  autoAllocationStrategy  String @default("FIFO_BY_DUE_DATE") @map("auto_allocation_strategy") // FIFO_BY_DUE_DATE|FIFO_BY_DOCUMENT_DATE|OLDEST_OVERDUE_FIRST|EXACT_AMOUNT_MATCH|CONTRACT_FIRST|PAYMENT_REFERENCE_MATCH|MANUAL_ONLY
  allowCrossContractOffset Boolean @default(false) @map("allow_cross_contract_offset")
  allowCrossCurrencySettlement Boolean @default(false) @map("allow_cross_currency_settlement")
  overdueCreditBlockPolicy String @default("WARNING") @map("overdue_credit_block_policy") // NONE|WARNING|BLOCK|APPROVAL_REQUIRED
  smallBalanceWriteOffTolerance Decimal? @map("small_balance_write_off_tolerance") @db.Decimal(18, 2)

  status String @default("ACTIVE") // ACTIVE|SUPERSEDED

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([tenantId, organizationId, counterpartyId, effectiveFrom])
  @@map("settlement_policies")
}

/// Central immutable register (spec section 4) — the ONLY authoritative
/// source of AR/AP balances; `SettlementObligation`/`SupplierPayable`
/// (open items) and any future balance projection are rebuildable from
/// this table, never the reverse.
model SettlementMovement {
  id             String  @id @default(uuid())
  tenantId       String  @map("tenant_id")
  organizationId String  @map("organization_id")
  branchId       String? @map("branch_id")

  partnerId         String? @map("partner_id")
  counterpartyId    String  @map("counterparty_id")
  counterpartyRole  String  @map("counterparty_role") // CUSTOMER|SUPPLIER
  contractId        String? @map("contract_id")
  agreementId       String? @map("agreement_id")

  settlementDimensionType String  @default("BY_DOCUMENT") @map("settlement_dimension_type")
  settlementDocumentType  String? @map("settlement_document_type") // the open-item "bucket" this movement affects
  settlementDocumentId    String? @map("settlement_document_id")
  settlementDocumentLineId String? @map("settlement_document_line_id")

  currencyId            String   @map("currency_id")
  dueDate               DateTime? @map("due_date") @db.Date
  paymentScheduleLineId String?  @map("payment_schedule_line_id")

  debitAmount               Decimal @default(0) @map("debit_amount") @db.Decimal(18, 2) // base currency
  creditAmount              Decimal @default(0) @map("credit_amount") @db.Decimal(18, 2) // base currency
  transactionCurrencyAmount Decimal @map("transaction_currency_amount") @db.Decimal(18, 2) // signed
  baseCurrencyAmount        Decimal @map("base_currency_amount") @db.Decimal(18, 2) // signed

  movementType String @map("movement_type") // RECEIVABLE_CREATE|RECEIVABLE_REDUCE|PAYABLE_CREATE|PAYABLE_REDUCE|CUSTOMER_ADVANCE_CREATE|CUSTOMER_ADVANCE_APPLY|SUPPLIER_ADVANCE_CREATE|SUPPLIER_ADVANCE_APPLY|CREDIT_NOTE|DEBIT_NOTE|OFFSET|WRITE_OFF|FX_ADJUSTMENT|RECLASSIFICATION|OPENING_BALANCE

  sourceDocumentType   String  @map("source_document_type")
  sourceDocumentId     String  @map("source_document_id")
  sourceDocumentLineId String? @map("source_document_line_id")

  effectiveDate DateTime @map("effective_date") @db.Date
  postingDate   DateTime @map("posting_date") @db.Date
  postingVersion Int     @default(1) @map("posting_version")

  reversed           Boolean @default(false)
  reversalOfMovementId String? @map("reversal_of_movement_id")

  createdAt DateTime @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  counterparty Counterparty @relation(fields: [counterpartyId], references: [id])
  currency     Currency     @relation(fields: [currencyId], references: [id])

  @@index([tenantId, organizationId, counterpartyId, counterpartyRole])
  @@index([tenantId, settlementDocumentType, settlementDocumentId])
  @@index([tenantId, sourceDocumentType, sourceDocumentId])
  @@index([tenantId, effectiveDate])
  @@map("settlement_movements")
}

/// Payment allocation (spec sections 16-17) — the link between a payment
/// and the open item(s)/advance(s) it settles. Never edited in place;
/// reversed via `status='REVERSED'` + `reversedAt`, original row kept
/// (spec section 33).
model SettlementAllocation {
  id             String @id @default(uuid())
  tenantId       String @map("tenant_id")
  organizationId String @map("organization_id")

  paymentDocumentType String  @map("payment_document_type")
  paymentDocumentId   String  @map("payment_document_id")
  paymentLineId       String? @map("payment_line_id")

  counterpartyId String  @map("counterparty_id")
  contractId     String? @map("contract_id")

  sourceOpenItemType String  @map("source_open_item_type") // SETTLEMENT_OBLIGATION|SUPPLIER_PAYABLE|CUSTOMER_ADVANCE|SUPPLIER_ADVANCE
  sourceOpenItemId   String  @map("source_open_item_id")
  paymentScheduleLineId String? @map("payment_schedule_line_id")

  allocationDate        DateTime @map("allocation_date") @db.Date
  paymentCurrencyId     String   @map("payment_currency_id")
  settlementCurrencyId  String   @map("settlement_currency_id")
  paymentAmount         Decimal  @map("payment_amount") @db.Decimal(18, 2)
  settlementAmount      Decimal  @map("settlement_amount") @db.Decimal(18, 2)
  baseCurrencyAmount    Decimal  @map("base_currency_amount") @db.Decimal(18, 2)
  exchangeRate          Decimal? @map("exchange_rate") @db.Decimal(24, 10)
  realizedFxAmount      Decimal  @default(0) @map("realized_fx_amount") @db.Decimal(18, 2) // spec sections 54-56

  allocationType String @default("MANUAL") @map("allocation_type") // MANUAL|AUTOMATIC|ADVANCE_APPLICATION|OFFSET|RETURN|CREDIT_NOTE|DEBT_ADJUSTMENT|SYSTEM_RECONCILIATION
  status         String @default("ACTIVE") // ACTIVE|REVERSED

  createdBy  String?
  createdAt  DateTime  @default(now()) @map("created_at")
  reversedAt DateTime? @map("reversed_at")
  reversedBy String?   @map("reversed_by")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  counterparty Counterparty @relation(fields: [counterpartyId], references: [id])

  @@index([tenantId, sourceOpenItemType, sourceOpenItemId])
  @@index([tenantId, paymentDocumentType, paymentDocumentId])
  @@index([tenantId, counterpartyId, status])
  @@map("settlement_allocations")
}

/// Customer/supplier advance pool (spec sections 22-27) — a payment
/// received/made with no invoice to settle against yet.
model SettlementAdvance {
  id               String  @id @default(uuid())
  tenantId         String  @map("tenant_id")
  organizationId   String  @map("organization_id")
  counterpartyId   String  @map("counterparty_id")
  counterpartyRole String  @map("counterparty_role") // CUSTOMER|SUPPLIER
  contractId       String? @map("contract_id")

  sourceDocumentType String @map("source_document_type") // SETTLEMENT_PAYMENT
  sourceDocumentId   String @map("source_document_id")

  currencyId         String  @map("currency_id")
  originalAmount     Decimal @map("original_amount") @db.Decimal(18, 2)
  baseCurrencyAmount Decimal @map("base_currency_amount") @db.Decimal(18, 2)
  appliedAmount      Decimal @default(0) @map("applied_amount") @db.Decimal(18, 2)
  remainingAmount    Decimal @map("remaining_amount") @db.Decimal(18, 2)

  status String @default("OPEN") // OPEN|PARTIALLY_APPLIED|FULLY_APPLIED|REFUNDED|CANCELLED

  createdAt DateTime @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  counterparty Counterparty @relation(fields: [counterpartyId], references: [id])
  currency     Currency     @relation(fields: [currencyId], references: [id])

  @@index([tenantId, organizationId, counterpartyId, counterpartyRole, status])
  @@map("settlement_advances")
}

/// Minimal, bank/cash-agnostic payment document (spec section 84-85's own
/// "payment adapter interface" boundary) — a real DocumentFramework
/// document type so it goes through the standard save/post/audit
/// lifecycle; Phase 14 (bank)/15 (cash) are expected to supersede or wrap
/// this with real treasury execution.
model SettlementPayment {
  id             String         @id @default(uuid())
  tenantId       String         @map("tenant_id")
  organizationId String         @map("organization_id")
  documentType   String         @default("SETTLEMENT_PAYMENT") @map("document_type")
  number         String?
  documentDate   DateTime       @map("document_date") @db.Date
  postingDate    DateTime?      @map("posting_date") @db.Date

  direction        String  @map("direction") // INCOMING|OUTGOING
  counterpartyId   String? @map("counterparty_id") // nullable (spec Phase 14 section 70 — tax/fee/payroll/loan payments carry no counterparty)
  counterpartyRole String? @map("counterparty_role") // CUSTOMER|SUPPLIER
  contractId       String? @map("contract_id")
  currencyId       String  @map("currency_id")
  amount           Decimal @db.Decimal(18, 2)
  exchangeRate     Decimal? @map("exchange_rate") @db.Decimal(24, 10)
  reference        String?

  // Phase 14 bank/treasury fields — this document doubles as the spec's
  // own "OutgoingBankPayment"/"IncomingBankPayment" (disclosed extension
  // of the Phase 13 payment-adapter placeholder rather than a duplicate
  // table, see docs/TREASURY.md).
  bankAccountId         String?   @map("bank_account_id")
  operationType         String?   @map("operation_type") // SUPPLIER_PAYMENT|SUPPLIER_ADVANCE|TAX_PAYMENT|PAYROLL_PAYMENT|LOAN_REPAYMENT|OTHER|CUSTOMER_PAYMENT|CUSTOMER_ADVANCE|LOAN_RECEIPT|REFUND_FROM_SUPPLIER|INTEREST_INCOME|OTHER
  paymentRequestId      String?   @map("payment_request_id")
  paymentInstructionId  String?   @map("payment_instruction_id")
  executionDate         DateTime? @map("execution_date") @db.Date
  bankReference         String?   @map("bank_reference")
  externalTransactionId String?   @map("external_transaction_id")
  matchStatus           String    @default("UNMATCHED") @map("match_status") // UNMATCHED|SUGGESTED|MATCHED|MANUALLY_MATCHED|AUTO_MATCHED|EXCEPTION

  // Phase 15 cash fields — this SAME document also doubles as the spec's
  // own "CashReceiptOrder"/"CashExpenseOrder" (spec section 9/11) when
  // `cashDeskId` is set instead of `bankAccountId` (never both — spec
  // section 2's "don't duplicate" the payment-allocation-carrying
  // document type a third time). `employeeId` covers EMPLOYEE_ADVANCE/
  // EMPLOYEE_ADVANCE_RETURN operation types, which never touch
  // `counterpartyId` (spec section 27 — accountable persons are their
  // OWN settlement dimension, see `AccountablePersonMovement`).
  cashDeskId String? @map("cash_desk_id")
  cashierId  String? @map("cashier_id")
  employeeId String? @map("employee_id")

  status        DocumentStatus @default(DRAFT)
  postingStatus PostingStatus  @default(NOT_POSTED) @map("posting_status")

  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by")
  postedAt     DateTime? @map("posted_at")
  postedBy     String?   @map("posted_by")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelledBy  String?   @map("cancelled_by")
  deletionMark Boolean   @default(false) @map("deletion_mark")
  version      Int       @default(1)

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  organization Organization  @relation(fields: [organizationId], references: [id])
  counterparty Counterparty? @relation(fields: [counterpartyId], references: [id])
  currency     Currency      @relation(fields: [currencyId], references: [id])
  bankAccount  BankAccount?  @relation(fields: [bankAccountId], references: [id])
  cashDesk     Cashbox?      @relation(fields: [cashDeskId], references: [id])

  bankTransactionMatches BankTransactionMatch[]

  @@unique([tenantId, number])
  @@index([tenantId, organizationId, counterpartyId])
  @@index([tenantId, bankAccountId])
  @@index([tenantId, externalTransactionId])
  @@map("settlement_payments")
}

/// Universal settlement correction document (spec section 40) — folds
/// credit note, debit note, write-off, reclassification, and transfer
/// into one document type via `operationType` (same consolidation
/// convention as Phase 10's InventoryAdjustment).
model DebtAdjustment {
  id             String         @id @default(uuid())
  tenantId       String         @map("tenant_id")
  organizationId String         @map("organization_id")
  documentType   String         @default("DEBT_ADJUSTMENT") @map("document_type")
  number         String?
  documentDate   DateTime       @map("document_date") @db.Date
  postingDate    DateTime?      @map("posting_date") @db.Date

  counterpartyId   String  @map("counterparty_id")
  counterpartyRole String  @map("counterparty_role") // CUSTOMER|SUPPLIER
  contractId       String? @map("contract_id")

  operationType String  @map("operation_type") // RECEIVABLE_INCREASE|RECEIVABLE_DECREASE|PAYABLE_INCREASE|PAYABLE_DECREASE|DEBT_WRITE_OFF|CREDIT_RECLASSIFICATION|CONTRACT_TRANSFER|COUNTERPARTY_TRANSFER|OFFSET|OTHER
  reasonCode    String? @map("reason_code")

  targetOpenItemType   String? @map("target_open_item_type") // SETTLEMENT_OBLIGATION|SUPPLIER_PAYABLE — which open item this adjusts/writes off, when applicable
  targetOpenItemId     String? @map("target_open_item_id")
  targetContractId     String? @map("target_contract_id") // CONTRACT_TRANSFER destination
  targetCounterpartyId String? @map("target_counterparty_id") // COUNTERPARTY_TRANSFER destination — blocked by default (spec section 97)

  currencyId String  @map("currency_id")
  amount     Decimal @db.Decimal(18, 2)

  status        DocumentStatus @default(DRAFT)
  postingStatus PostingStatus  @default(NOT_POSTED) @map("posting_status")
  description   String?

  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by")
  postedAt     DateTime? @map("posted_at")
  postedBy     String?   @map("posted_by")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelledBy  String?   @map("cancelled_by")
  deletionMark Boolean   @default(false) @map("deletion_mark")
  version      Int       @default(1)

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  counterparty Counterparty @relation(fields: [counterpartyId], references: [id])
  currency     Currency     @relation(fields: [currencyId], references: [id])

  @@unique([tenantId, number])
  @@index([tenantId, organizationId, counterpartyId])
  @@map("debt_adjustments")
}

/// Offset/netting document (spec sections 41-44) — a real document type
/// since it pairs receivable and payable open items of the SAME
/// counterparty (cross-counterparty blocked by default, spec section 43).
model SettlementOffset {
  id             String         @id @default(uuid())
  tenantId       String         @map("tenant_id")
  organizationId String         @map("organization_id")
  documentType   String         @default("SETTLEMENT_OFFSET") @map("document_type")
  number         String?
  documentDate   DateTime       @map("document_date") @db.Date
  postingDate    DateTime?      @map("posting_date") @db.Date

  counterpartyId String  @map("counterparty_id")
  amount         Decimal @db.Decimal(18, 2)
  currencyId     String  @map("currency_id")
  reason         String?

  status        DocumentStatus @default(DRAFT)
  postingStatus PostingStatus  @default(NOT_POSTED) @map("posting_status")

  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by")
  postedAt     DateTime? @map("posted_at")
  postedBy     String?   @map("posted_by")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelledBy  String?   @map("cancelled_by")
  deletionMark Boolean   @default(false) @map("deletion_mark")
  version      Int       @default(1)

  tenant       Tenant                 @relation(fields: [tenantId], references: [id])
  organization Organization           @relation(fields: [organizationId], references: [id])
  counterparty Counterparty           @relation(fields: [counterpartyId], references: [id])
  currency     Currency               @relation(fields: [currencyId], references: [id])
  lines        SettlementOffsetLine[]

  @@unique([tenantId, number])
  @@map("settlement_offsets")
}

model SettlementOffsetLine {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  offsetId String @map("offset_id")
  position Int    @default(0)

  side           String  @map("side") // RECEIVABLE|PAYABLE
  openItemType   String  @map("open_item_type") // SETTLEMENT_OBLIGATION|SUPPLIER_PAYABLE
  openItemId     String  @map("open_item_id")
  amount         Decimal @db.Decimal(18, 2)

  tenant Tenant           @relation(fields: [tenantId], references: [id])
  offset SettlementOffset @relation(fields: [offsetId], references: [id], onDelete: Cascade)

  @@index([offsetId, position])
  @@map("settlement_offset_lines")
}

/// Counterparty reconciliation statement (spec sections 62-67) — lines
/// are computed live from `SettlementMovement` (see file header), never
/// persisted separately.
model SettlementReconciliation {
  id             String  @id @default(uuid())
  tenantId       String  @map("tenant_id")
  organizationId String  @map("organization_id")
  counterpartyId String  @map("counterparty_id")
  contractId     String? @map("contract_id")

  periodStart DateTime @map("period_start") @db.Date
  periodEnd   DateTime @map("period_end") @db.Date
  currencyId  String   @map("currency_id")

  openingBalance Decimal @default(0) @map("opening_balance") @db.Decimal(18, 2)
  debitTurnover  Decimal @default(0) @map("debit_turnover") @db.Decimal(18, 2)
  creditTurnover Decimal @default(0) @map("credit_turnover") @db.Decimal(18, 2)
  closingBalance Decimal @default(0) @map("closing_balance") @db.Decimal(18, 2)

  status                 String    @default("DRAFT") // DRAFT|GENERATED|SENT|COUNTERPARTY_CONFIRMED|DIFFERENCE_FOUND|ADJUSTMENT_REQUIRED|RECONCILED|CANCELLED
  confirmedByUs          Boolean   @default(false) @map("confirmed_by_us")
  confirmedByCounterparty Boolean  @default(false) @map("confirmed_by_counterparty")
  theirBalance           Decimal?  @map("their_balance") @db.Decimal(18, 2)
  differenceReason       String?   @map("difference_reason")
  signedDate             DateTime? @map("signed_date") @db.Date
  notes                  String?

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  counterparty Counterparty @relation(fields: [counterpartyId], references: [id])
  currency     Currency     @relation(fields: [currencyId], references: [id])

  @@index([tenantId, organizationId, counterpartyId])
  @@map("settlement_reconciliations")
}

// =============================================================================
// PHASE 14 — BANK / TREASURY / PUL AXINLARININ İDARƏ EDİLMƏSİ
//
// Three strictly separate layers (spec sections 1, 26, 182):
//   Layer 1 — Treasury Plan: PaymentRequest/PaymentApproval/PaymentCalendarItem
//     — never touches bank balance or AR/AP.
//   Layer 2 — Bank Reality: SettlementPayment (extended, spec section 26's
//     own OutgoingBankPayment/IncomingBankPayment), BankCashMovement
//     (immutable register), BankStatement/Line, BankTransactionMatch,
//     BankReconciliation, InternalBankTransfer, BankFee, FXConversion.
//   Layer 3 — Settlement Allocation: Phase 13's own OpenItemService/
//     PaymentAllocationService — never duplicated here (spec section 67).
//
// Disclosed simplifications (this build):
//   - No PaymentRequestLine/CashFlowForecast/BankReconciliationItem/
//     TreasuryForecastVersion tables — a payment request is single-amount
//     (spec's own examples are all single-amount); cash flow forecast and
//     reconciliation line detail are computed live from
//     PaymentCalendarItem/BankCashMovement (same "rebuildable projection"
//     pattern already used for costing/settlement health).
//   - Bank statement import supports a generic normalized-row shape only
//     (no concrete CSV/MT940/CAMT.053 parser) — `BankStatementImportService`
//     takes already-normalized lines; format-specific adapters are Phase
//     28's own boundary (spec section 147).
//   - `bank_posting_mode` is read but only `DOCUMENT_DRIVEN` is fully
//     implemented; `STATEMENT_CONFIRMED` is a stored, honored config value
//     without a distinct posting path in this pass.
// =============================================================================

/// Layer 1 (spec sections 4-13) — an internal ask to pay, never a bank
/// movement. `paidAmount`/`status` are recomputed from actual
/// `SettlementPayment` rows referencing this request, never set manually
/// (spec section 7).
model PaymentRequest {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  organizationId String    @map("organization_id")
  branchId       String?   @map("branch_id")
  number         String?
  requestDate    DateTime  @map("request_date") @db.Date
  requestedPaymentDate DateTime? @map("requested_payment_date") @db.Date

  paymentPriority String  @default("NORMAL") @map("payment_priority") // CRITICAL|HIGH|NORMAL|LOW
  paymentCategory String  @default("SUPPLIER") @map("payment_category") // SUPPLIER|PAYROLL|TAX|RENT|LOAN|CAPEX|OPEX|DIVIDEND|INTERNAL_TRANSFER|OTHER
  counterpartyId  String? @map("counterparty_id")
  contractId      String? @map("contract_id")
  bankAccountId   String? @map("bank_account_id") // preferred source account, optional

  currencyId      String  @map("currency_id")
  requestedAmount Decimal @map("requested_amount") @db.Decimal(18, 2)
  approvedAmount  Decimal @default(0) @map("approved_amount") @db.Decimal(18, 2)
  paidAmount      Decimal @default(0) @map("paid_amount") @db.Decimal(18, 2)

  paymentPurpose     String?
  sourceDocumentType String? @map("source_document_type")
  sourceDocumentId   String? @map("source_document_id")
  sourceOpenItemId   String? @map("source_open_item_id")

  requestedBy       String? @map("requested_by")
  responsibleUserId String? @map("responsible_user_id")

  status         String @default("DRAFT") // DRAFT|SUBMITTED|PENDING_APPROVAL|APPROVED|PARTIALLY_APPROVED|REJECTED|PLANNED|PARTIALLY_PAID|PAID|CANCELLED|EXPIRED
  approvalStatus String @default("NOT_REQUIRED") @map("approval_status") // NOT_REQUIRED|PENDING|APPROVED|PARTIALLY_APPROVED|REJECTED|CANCELLED
  treasuryStatus String @default("UNPLANNED") @map("treasury_status") // UNPLANNED|PLANNED|EXECUTING|COMPLETE

  comment String?

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  organization Organization  @relation(fields: [organizationId], references: [id])
  counterparty Counterparty? @relation(fields: [counterpartyId], references: [id])
  currency     Currency      @relation(fields: [currencyId], references: [id])
  bankAccount  BankAccount?  @relation(fields: [bankAccountId], references: [id])

  approvals    PaymentApproval[]
  calendarItems PaymentCalendarItem[]
  instructions PaymentInstruction[]

  @@unique([tenantId, number])
  @@index([tenantId, organizationId, status])
  @@map("payment_requests")
}

/// Immutable approval history (spec sections 11-13) — one row per
/// approval decision, never overwritten.
model PaymentApproval {
  id               String @id @default(uuid())
  tenantId         String @map("tenant_id")
  paymentRequestId String @map("payment_request_id")

  approverUserId String  @map("approver_user_id")
  approvedAmount Decimal? @map("approved_amount") @db.Decimal(18, 2)
  decision       String  @map("decision") // APPROVED|PARTIALLY_APPROVED|REJECTED
  level          Int     @default(1)
  comment        String?

  decidedAt DateTime @default(now()) @map("decided_at")

  tenant  Tenant         @relation(fields: [tenantId], references: [id])
  request PaymentRequest @relation(fields: [paymentRequestId], references: [id])

  @@index([paymentRequestId])
  @@map("payment_approvals")
}

/// Layer 1 projection (spec sections 14-17) — one row per planned
/// inflow/outflow; `executedAmount`/`remainingAmount` update as actual
/// `SettlementPayment`s post, but the original `plannedAmount` is never
/// overwritten (spec section 74/938 — "Original planned item audit üçün
/// itməməlidir").
model PaymentCalendarItem {
  id             String  @id @default(uuid())
  tenantId       String  @map("tenant_id")
  organizationId String  @map("organization_id")
  bankAccountId  String? @map("bank_account_id")

  itemDate           DateTime @map("item_date") @db.Date
  cashFlowDirection  String   @map("cash_flow_direction") // INFLOW|OUTFLOW
  category           String
  sourceType         String?  @map("source_type")
  sourceId           String?  @map("source_id")
  paymentRequestId   String?  @map("payment_request_id")
  counterpartyId     String?  @map("counterparty_id")

  currencyId  String  @map("currency_id")
  amount      Decimal @db.Decimal(18, 2)
  baseAmount  Decimal @map("base_amount") @db.Decimal(18, 2)
  probability String  @default("CONFIRMED") @map("probability") // CONFIRMED|HIGH|MEDIUM|LOW
  priority    String  @default("NORMAL")

  approved  Boolean @default(false)
  committed Boolean @default(false)

  executedAmount  Decimal @default(0) @map("executed_amount") @db.Decimal(18, 2)
  remainingAmount Decimal @map("remaining_amount") @db.Decimal(18, 2)

  createdAt DateTime @default(now()) @map("created_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  organization   Organization    @relation(fields: [organizationId], references: [id])
  bankAccount    BankAccount?    @relation(fields: [bankAccountId], references: [id])
  paymentRequest PaymentRequest? @relation(fields: [paymentRequestId], references: [id])

  @@index([tenantId, organizationId, itemDate])
  @@index([tenantId, bankAccountId, itemDate])
  @@map("payment_calendar_items")
}

/// Layer 1->2 bridge (spec sections 23-25) — the internal representation
/// of a bank order, still NOT bank execution (spec section 25).
model PaymentInstruction {
  id               String  @id @default(uuid())
  tenantId         String  @map("tenant_id")
  organizationId   String  @map("organization_id")
  paymentRequestId String  @map("payment_request_id")
  bankAccountId    String  @map("bank_account_id")

  beneficiaryName        String? @map("beneficiary_name")
  beneficiaryBankDetails String? @map("beneficiary_bank_details")
  currencyId             String  @map("currency_id")
  amount                 Decimal @db.Decimal(18, 2)
  executionDate          DateTime? @map("execution_date") @db.Date
  purpose                String?
  bankReference          String? @map("bank_reference")

  status String @default("DRAFT") // DRAFT|READY|SENT_TO_BANK|ACCEPTED_BY_BANK|REJECTED_BY_BANK|EXECUTED|CANCELLED

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  organization Organization   @relation(fields: [organizationId], references: [id])
  request      PaymentRequest @relation(fields: [paymentRequestId], references: [id])
  bankAccount  BankAccount    @relation(fields: [bankAccountId], references: [id])

  @@index([tenantId, paymentRequestId])
  @@map("payment_instructions")
}

/// Layer 2 (spec section 30) — the immutable "actual cash movement"
/// register, deliberately separate from Phase 13's settlement register
/// (spec section 1: "loosely coupled, tam traceable"). Written by
/// SettlementPayment (bank leg), InternalBankTransfer, BankFee, and
/// FXConversion posting — never any other write path.
model BankCashMovement {
  id             String  @id @default(uuid())
  tenantId       String  @map("tenant_id")
  organizationId String  @map("organization_id")
  bankAccountId  String  @map("bank_account_id")
  currencyId     String  @map("currency_id")

  direction  String  @map("direction") // INFLOW|OUTFLOW
  amount     Decimal @db.Decimal(18, 2) // transaction currency, unsigned
  baseAmount Decimal @map("base_amount") @db.Decimal(18, 2)

  sourceDocumentType String  @map("source_document_type")
  sourceDocumentId   String  @map("source_document_id")
  bankStatementLineId String? @map("bank_statement_line_id")

  transactionDate DateTime @map("transaction_date") @db.Date
  valueDate       DateTime? @map("value_date") @db.Date
  effectiveDate   DateTime @map("effective_date") @db.Date

  reversed Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  bankAccount  BankAccount  @relation(fields: [bankAccountId], references: [id])

  @@index([tenantId, bankAccountId, effectiveDate])
  @@index([tenantId, sourceDocumentType, sourceDocumentId])
  @@map("bank_cash_movements")
}

model BankStatement {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  organizationId String   @map("organization_id")
  bankAccountId  String   @map("bank_account_id")

  statementNumber String?  @map("statement_number")
  statementDate   DateTime @map("statement_date") @db.Date
  periodStart     DateTime @map("period_start") @db.Date
  periodEnd       DateTime @map("period_end") @db.Date

  openingBalance Decimal @map("opening_balance") @db.Decimal(18, 2)
  totalDebits    Decimal @default(0) @map("total_debits") @db.Decimal(18, 2)
  totalCredits   Decimal @default(0) @map("total_credits") @db.Decimal(18, 2)
  closingBalance Decimal @map("closing_balance") @db.Decimal(18, 2)
  currencyId     String  @map("currency_id")

  importSource       String  @default("MANUAL") @map("import_source") // MANUAL|CSV|EXCEL|MT940|CAMT053|API
  externalStatementId String? @map("external_statement_id")
  rawPayload          String? @map("raw_payload") // spec section 37 — original import preserved for audit

  status       String    @default("IMPORTED") // IMPORTED|IN_PROGRESS|RECONCILED
  importedAt   DateTime  @default(now()) @map("imported_at")
  importedBy   String?   @map("imported_by")
  reconciledAt DateTime? @map("reconciled_at")

  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  organization Organization       @relation(fields: [organizationId], references: [id])
  bankAccount  BankAccount        @relation(fields: [bankAccountId], references: [id])
  lines        BankStatementLine[]
  reconciliations BankReconciliation[]

  @@unique([tenantId, bankAccountId, externalStatementId])
  @@index([tenantId, bankAccountId, periodStart, periodEnd])
  @@map("bank_statements")
}

model BankStatementLine {
  id          String @id @default(uuid())
  tenantId    String @map("tenant_id")
  statementId String @map("statement_id")
  lineNumber  Int    @default(0) @map("line_number")

  transactionDate DateTime  @map("transaction_date") @db.Date
  valueDate       DateTime? @map("value_date") @db.Date
  bookingDate     DateTime? @map("booking_date") @db.Date

  externalTransactionId String? @map("external_transaction_id")
  bankReference         String? @map("bank_reference")
  direction             String  @map("direction") // CREDIT|DEBIT (bank perspective, spec section 35)
  amount                Decimal @db.Decimal(18, 2)
  currencyId            String  @map("currency_id")
  baseAmount            Decimal? @map("base_amount") @db.Decimal(18, 2)

  counterpartyName   String? @map("counterparty_name")
  counterpartyAccount String? @map("counterparty_account")
  counterpartyTaxId  String? @map("counterparty_tax_id")
  description        String?
  bankOperationCode  String? @map("bank_operation_code")

  matchStatus         String  @default("UNMATCHED") @map("match_status") // UNMATCHED|SUGGESTED|PARTIALLY_MATCHED|MATCHED|MANUALLY_MATCHED|AUTO_MATCHED|EXCEPTION
  matchedDocumentType String? @map("matched_document_type")
  matchedDocumentId   String? @map("matched_document_id")
  reconciliationStatus String @default("UNRECONCILED") @map("reconciliation_status")

  createdAt DateTime @default(now()) @map("created_at")

  tenant    Tenant                 @relation(fields: [tenantId], references: [id])
  statement BankStatement          @relation(fields: [statementId], references: [id], onDelete: Cascade)
  matches   BankTransactionMatch[]

  @@unique([tenantId, statementId, externalTransactionId])
  @@index([statementId, lineNumber])
  @@index([tenantId, matchStatus])
  @@map("bank_statement_lines")
}

/// Matching link (spec sections 39-47) — one row per (statement line,
/// ERP transaction) pair, so one-to-many/many-to-one composite matches
/// are representable, not just 1:1.
model BankTransactionMatch {
  id                  String  @id @default(uuid())
  tenantId            String  @map("tenant_id")
  statementLineId     String  @map("statement_line_id")
  matchedDocumentType String  @map("matched_document_type") // SETTLEMENT_PAYMENT|PAYMENT_INSTRUCTION|INTERNAL_BANK_TRANSFER|BANK_FEE|FX_CONVERSION
  matchedDocumentId   String  @map("matched_document_id")
  settlementPaymentId String? @map("settlement_payment_id")

  matchedAmount Decimal @map("matched_amount") @db.Decimal(18, 2)
  matchScore    Decimal? @map("match_score") @db.Decimal(5, 2) // 0-100
  matchMethod   String  @default("MANUAL") @map("match_method") // MANUAL|AUTO|SUGGESTED

  status     String    @default("ACTIVE") // ACTIVE|REVERSED
  matchedBy  String?   @map("matched_by")
  matchedAt  DateTime  @default(now()) @map("matched_at")
  reversedAt DateTime? @map("reversed_at")

  tenant           Tenant              @relation(fields: [tenantId], references: [id])
  statementLine    BankStatementLine   @relation(fields: [statementLineId], references: [id])
  settlementPayment SettlementPayment? @relation(fields: [settlementPaymentId], references: [id])

  @@index([tenantId, statementLineId])
  @@index([tenantId, matchedDocumentType, matchedDocumentId])
  @@map("bank_transaction_matches")
}

model BankReconciliation {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  organizationId String   @map("organization_id")
  bankAccountId  String   @map("bank_account_id")
  statementId    String   @map("statement_id")

  periodStart DateTime @map("period_start") @db.Date
  periodEnd   DateTime @map("period_end") @db.Date

  bookOpeningBalance      Decimal @map("book_opening_balance") @db.Decimal(18, 2)
  bankOpeningBalance      Decimal @map("bank_opening_balance") @db.Decimal(18, 2)
  bookMovementsTotal      Decimal @default(0) @map("book_movements_total") @db.Decimal(18, 2)
  bankMovementsTotal      Decimal @default(0) @map("bank_movements_total") @db.Decimal(18, 2)
  unmatchedBookItemsCount Int     @default(0) @map("unmatched_book_items_count")
  unmatchedBankItemsCount Int     @default(0) @map("unmatched_bank_items_count")
  adjustedBookBalance     Decimal @default(0) @map("adjusted_book_balance") @db.Decimal(18, 2)
  statementClosingBalance Decimal @map("statement_closing_balance") @db.Decimal(18, 2)
  difference              Decimal @default(0) @db.Decimal(18, 2)

  status       String    @default("DRAFT") // DRAFT|IN_PROGRESS|DIFFERENCE_FOUND|READY_TO_CLOSE|RECONCILED|CLOSED|REOPENED
  closedAt     DateTime? @map("closed_at")
  closedBy     String?   @map("closed_by")
  reopenedAt   DateTime? @map("reopened_at")
  reopenedBy   String?   @map("reopened_by")
  reopenReason String?   @map("reopen_reason")

  createdAt DateTime @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  organization Organization  @relation(fields: [organizationId], references: [id])
  bankAccount  BankAccount   @relation(fields: [bankAccountId], references: [id])
  statement    BankStatement @relation(fields: [statementId], references: [id])

  @@index([tenantId, bankAccountId, periodEnd])
  @@map("bank_reconciliations")
}

/// Two-sided transfer (spec sections 57-60) — INSTANT (same-day, both
/// legs post together) or two-step with an explicit in-transit window.
model InternalBankTransfer {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  organizationId String   @map("organization_id")
  documentType   String   @default("INTERNAL_BANK_TRANSFER") @map("document_type")
  number         String?
  documentDate   DateTime @map("document_date") @db.Date
  postingDate    DateTime? @map("posting_date") @db.Date

  sourceBankAccountId      String  @map("source_bank_account_id")
  destinationBankAccountId String  @map("destination_bank_account_id")
  currencyId               String  @map("currency_id")
  amount                   Decimal @db.Decimal(18, 2)
  feeAmount                Decimal @default(0) @map("fee_amount") @db.Decimal(18, 2)
  transferMode             String  @default("INSTANT") @map("transfer_mode") // INSTANT|TWO_STEP
  creditedDate             DateTime? @map("credited_date") @db.Date // TWO_STEP only

  transferState String @default("INITIATED") @map("transfer_state") // INITIATED|DEBITED|IN_TRANSIT|CREDITED|RECONCILED

  status        DocumentStatus @default(DRAFT)
  postingStatus PostingStatus  @default(NOT_POSTED) @map("posting_status")

  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by")
  postedAt     DateTime? @map("posted_at")
  postedBy     String?   @map("posted_by")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelledBy  String?   @map("cancelled_by")
  deletionMark Boolean   @default(false) @map("deletion_mark")
  version      Int       @default(1)

  tenant            Tenant       @relation(fields: [tenantId], references: [id])
  organization      Organization @relation(fields: [organizationId], references: [id])
  sourceAccount      BankAccount @relation("TransferSourceAccount", fields: [sourceBankAccountId], references: [id])
  destinationAccount BankAccount @relation("TransferDestinationAccount", fields: [destinationBankAccountId], references: [id])
  currency           Currency    @relation(fields: [currencyId], references: [id])

  @@unique([tenantId, number])
  @@map("internal_bank_transfers")
}

model BankFee {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  organizationId String   @map("organization_id")
  documentType   String   @default("BANK_FEE") @map("document_type")
  number         String?
  bankAccountId  String   @map("bank_account_id")
  feeDate        DateTime @map("fee_date") @db.Date
  postingDate    DateTime? @map("posting_date") @db.Date

  feeType    String  @default("OTHER") @map("fee_type") // MONTHLY_SERVICE|TRANSFER_FEE|SWIFT_FEE|CARD_FEE|OTHER
  currencyId String  @map("currency_id")
  amount     Decimal @db.Decimal(18, 2)
  taxAmount  Decimal @default(0) @map("tax_amount") @db.Decimal(18, 2)
  statementLineId String? @map("statement_line_id")

  status        DocumentStatus @default(DRAFT)
  postingStatus PostingStatus  @default(NOT_POSTED) @map("posting_status")

  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by")
  postedAt     DateTime? @map("posted_at")
  postedBy     String?   @map("posted_by")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelledBy  String?   @map("cancelled_by")
  deletionMark Boolean   @default(false) @map("deletion_mark")
  version      Int       @default(1)

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  bankAccount  BankAccount  @relation(fields: [bankAccountId], references: [id])
  currency     Currency     @relation(fields: [currencyId], references: [id])

  @@unique([tenantId, number])
  @@map("bank_fees")
}

/// Treasury FX (spec sections 61-63, 119) — bank-to-bank currency
/// exchange, DELIBERATELY separate from Phase 13's settlement FX
/// (invoice/payment realized gain-loss). Never creates a customer/
/// supplier settlement consequence.
model FXConversion {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  organizationId String   @map("organization_id")
  documentType   String   @default("FX_CONVERSION") @map("document_type")
  number         String?
  conversionDate DateTime @map("conversion_date") @db.Date
  postingDate    DateTime? @map("posting_date") @db.Date

  sourceBankAccountId      String  @map("source_bank_account_id")
  destinationBankAccountId String  @map("destination_bank_account_id")
  sourceCurrencyId         String  @map("source_currency_id")
  sourceAmount             Decimal @map("source_amount") @db.Decimal(18, 2)
  destinationCurrencyId    String  @map("destination_currency_id")
  destinationAmount        Decimal @map("destination_amount") @db.Decimal(18, 2)
  tradeRate                Decimal @map("trade_rate") @db.Decimal(24, 10)
  officialRate             Decimal? @map("official_rate") @db.Decimal(24, 10)
  bankFeeAmount            Decimal @default(0) @map("bank_fee_amount") @db.Decimal(18, 2)
  bankReference            String? @map("bank_reference")

  status        DocumentStatus @default(DRAFT)
  postingStatus PostingStatus  @default(NOT_POSTED) @map("posting_status")

  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by")
  postedAt     DateTime? @map("posted_at")
  postedBy     String?   @map("posted_by")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelledBy  String?   @map("cancelled_by")
  deletionMark Boolean   @default(false) @map("deletion_mark")
  version      Int       @default(1)

  tenant            Tenant       @relation(fields: [tenantId], references: [id])
  organization      Organization @relation(fields: [organizationId], references: [id])
  sourceAccount      BankAccount @relation("FxSourceAccount", fields: [sourceBankAccountId], references: [id])
  destinationAccount BankAccount @relation("FxDestinationAccount", fields: [destinationBankAccountId], references: [id])

  @@unique([tenantId, number])
  @@map("fx_conversions")
}

/// Basic (non-workflow-engine) approval rule (spec sections 11-13) —
/// evaluated in ascending `minAmount` order; the first rule whose
/// [minAmount, maxAmount) window contains the request's amount (and whose
/// `category` matches, when set) wins. Full delegation/escalation is
/// Phase 26's own boundary (spec section 181) — this is deliberately just
/// a threshold ladder.
model TreasuryApprovalRule {
  id             String  @id @default(uuid())
  tenantId       String  @map("tenant_id")
  organizationId String  @map("organization_id")
  paymentCategory String? @map("payment_category") // null = applies to every category
  minAmount      Decimal @map("min_amount") @db.Decimal(18, 2)
  maxAmount      Decimal? @map("max_amount") @db.Decimal(18, 2) // null = unbounded
  requiredPermissionCodes String @map("required_permission_codes") // comma-separated — ALL required (spec's "+" examples)
  approvalLevel  Int     @default(1) @map("approval_level")
  active         Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([tenantId, organizationId, active, minAmount])
  @@map("treasury_approval_rules")
}

// =============================================================================
// PHASE 15 — CASH / KASSA / NAĞD PUL UÇOTU
//
// Mirrors Phase 14's own architecture almost exactly (spec sections 1-3):
// `SettlementPayment` (extended again, this time with `cashDeskId`/
// `cashierId`/`employeeId`) IS the CashReceiptOrder/CashExpenseOrder — a
// third disclosed extension of the same Phase 13 payment-adapter
// placeholder, never a duplicate table. `CashMovement` is Cash's own Layer
// 2 register, exactly parallel to `BankCashMovement`, deliberately
// separate from both Settlement (Layer 3) and Treasury's bank register.
//
// Disclosed simplifications (this build):
//   - Accountable persons (employee advances, spec sections 27-32) get
//     their OWN lightweight register (`AccountablePersonMovement`) rather
//     than being forced through Phase 13's counterparty-shaped
//     Obligation/Advance tables — spec section 27 itself calls this out
//     as its own settlement dimension, not a Customer/Supplier reuse.
//   - No persisted `AccountablePersonBalance` projection table — issued/
//     reported/returned/outstanding are computed live from
//     `AccountablePersonMovement` (same rebuildable-projection pattern
//     used everywhere else in this codebase).
//   - `CashCountAdjustment` is one document type dispatched by `type`
//     (CASH_SURPLUS/CASH_SHORTAGE/DOCUMENT_CORRECTION/CASHIER_RECEIVABLE/
//     OTHER), the same consolidation convention as Phase 10's
//     InventoryAdjustment / Phase 13's DebtAdjustment.
// =============================================================================

model CashierAssignment {
  id         String    @id @default(uuid())
  tenantId   String    @map("tenant_id")
  cashDeskId String    @map("cash_desk_id")
  userId     String    @map("user_id")
  validFrom  DateTime  @map("valid_from") @db.Date
  validTo    DateTime? @map("valid_to") @db.Date
  status     String    @default("ACTIVE") // ACTIVE|ENDED|SUSPENDED

  openingHandoverDocumentId String? @map("opening_handover_document_id")
  closingHandoverDocumentId String? @map("closing_handover_document_id")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  cashDesk Cashbox @relation(fields: [cashDeskId], references: [id])

  @@index([tenantId, cashDeskId, status])
  @@index([tenantId, userId, status])
  @@map("cashier_assignments")
}

/// Cash's own Layer 2 immutable register (spec section 14) — deliberately
/// separate from `BankCashMovement` (never the same table, spec section
/// 119's own "Bunları eyni entity-də birləşdirmə").
model CashMovement {
  id             String  @id @default(uuid())
  tenantId       String  @map("tenant_id")
  organizationId String  @map("organization_id")
  branchId       String? @map("branch_id")
  cashDeskId     String  @map("cash_desk_id")
  cashierId      String? @map("cashier_id")
  currencyId     String  @map("currency_id")

  direction  String  @map("direction") // INFLOW|OUTFLOW
  amount     Decimal @db.Decimal(18, 2)
  baseAmount Decimal @map("base_amount") @db.Decimal(18, 2)

  sourceDocumentType String  @map("source_document_type")
  sourceDocumentId   String  @map("source_document_id")

  effectiveDate DateTime @map("effective_date") @db.Date
  postingDate   DateTime @map("posting_date") @db.Date
  postingVersion Int     @default(1) @map("posting_version")
  reversed      Boolean  @default(false)

  createdAt DateTime @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  cashDesk     Cashbox      @relation(fields: [cashDeskId], references: [id])

  @@index([tenantId, cashDeskId, currencyId, effectiveDate])
  @@index([tenantId, sourceDocumentType, sourceDocumentId])
  @@map("cash_movements")
}

/// Accountable person (employee advance) register (spec sections 27-32) —
/// its own settlement dimension, never forced through the
/// counterparty-shaped `SettlementObligation`/`SettlementAdvance`.
model AccountablePersonMovement {
  id             String  @id @default(uuid())
  tenantId       String  @map("tenant_id")
  organizationId String  @map("organization_id")
  employeeId     String  @map("employee_id")
  currencyId     String  @map("currency_id")

  movementType String  @map("movement_type") // ISSUE|RETURN|EXPENSE_REPORTED|OVERSPEND_REIMBURSEMENT
  amount       Decimal @db.Decimal(18, 2) // signed: + increases outstanding (ISSUE, OVERSPEND), - decreases (RETURN, EXPENSE_REPORTED)

  sourceDocumentType String  @map("source_document_type")
  sourceDocumentId   String  @map("source_document_id")
  advanceMovementId  String? @map("advance_movement_id") // links a RETURN/EXPENSE_REPORTED back to its originating ISSUE

  effectiveDate DateTime @map("effective_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([tenantId, organizationId, employeeId])
  @@index([tenantId, sourceDocumentType, sourceDocumentId])
  @@map("accountable_person_movements")
}

/// Cash desk transfer (spec sections 33-37) — the cash-side mirror of
/// `InternalBankTransfer`; never a customer/supplier settlement.
model CashDeskTransfer {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  organizationId String   @map("organization_id")
  documentType   String   @default("CASH_DESK_TRANSFER") @map("document_type")
  number         String?
  documentDate   DateTime @map("document_date") @db.Date
  postingDate    DateTime? @map("posting_date") @db.Date

  sourceCashDeskId      String  @map("source_cash_desk_id")
  destinationCashDeskId String  @map("destination_cash_desk_id")
  currencyId            String  @map("currency_id")
  amount                Decimal @db.Decimal(18, 2)
  transferMode          String  @default("INSTANT") @map("transfer_mode") // INSTANT|TWO_STEP
  receivedAmount        Decimal @default(0) @map("received_amount") @db.Decimal(18, 2)

  transferState String @default("DRAFT") @map("transfer_state") // DRAFT|RELEASED|IN_TRANSIT|PARTIALLY_RECEIVED|RECEIVED|CANCELLED

  status        DocumentStatus @default(DRAFT)
  postingStatus PostingStatus  @default(NOT_POSTED) @map("posting_status")

  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by")
  postedAt     DateTime? @map("posted_at")
  postedBy     String?   @map("posted_by")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelledBy  String?   @map("cancelled_by")
  deletionMark Boolean   @default(false) @map("deletion_mark")
  version      Int       @default(1)

  tenant             Tenant       @relation(fields: [tenantId], references: [id])
  organization       Organization @relation(fields: [organizationId], references: [id])
  sourceCashDesk      Cashbox     @relation("CashTransferSource", fields: [sourceCashDeskId], references: [id])
  destinationCashDesk Cashbox     @relation("CashTransferDestination", fields: [destinationCashDeskId], references: [id])

  @@unique([tenantId, number])
  @@map("cash_desk_transfers")
}

model CashPhysicalCount {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  cashDeskId String   @map("cash_desk_id")
  cashierId  String?  @map("cashier_id")
  currencyId String   @map("currency_id")

  countTimestamp DateTime @default(now()) @map("count_timestamp")
  bookBalance    Decimal  @map("book_balance") @db.Decimal(18, 2)
  physicalBalance Decimal @map("physical_balance") @db.Decimal(18, 2)
  difference     Decimal  @db.Decimal(18, 2)
  countMethod    String   @default("DENOMINATION") @map("count_method") // DENOMINATION|MANUAL_TOTAL
  blind          Boolean  @default(false)

  status     String    @default("COMPLETED") // DRAFT|COMPLETED|APPROVED
  approvedBy String?   @map("approved_by")
  approvedAt DateTime? @map("approved_at")
  notes      String?

  createdAt DateTime @default(now()) @map("created_at")

  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  cashDesk Cashbox @relation(fields: [cashDeskId], references: [id])

  denominationCount CashDenominationCount?

  @@index([tenantId, cashDeskId, countTimestamp])
  @@map("cash_physical_counts")
}

model CurrencyDenomination {
  id         String  @id @default(uuid())
  tenantId   String  @map("tenant_id")
  currencyId String  @map("currency_id")
  value      Decimal @db.Decimal(18, 2)
  active     Boolean @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, currencyId, value])
  @@map("currency_denominations")
}

model CashDenominationCount {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  cashDeskId     String   @map("cash_desk_id")
  currencyId     String   @map("currency_id")
  countDate      DateTime @map("count_date") @db.Date
  countedBy      String?  @map("counted_by")
  physicalCountId String? @unique @map("physical_count_id")
  status         String   @default("COMPLETED")

  createdAt DateTime @default(now()) @map("created_at")

  tenant        Tenant                     @relation(fields: [tenantId], references: [id])
  cashDesk      Cashbox                    @relation(fields: [cashDeskId], references: [id])
  physicalCount CashPhysicalCount?         @relation(fields: [physicalCountId], references: [id])
  lines         CashDenominationCountLine[]

  @@map("cash_denomination_counts")
}

model CashDenominationCountLine {
  id      String  @id @default(uuid())
  tenantId String @map("tenant_id")
  countId String  @map("count_id")
  denominationValue Decimal @map("denomination_value") @db.Decimal(18, 2)
  quantity          Int     @default(0)
  totalAmount       Decimal @map("total_amount") @db.Decimal(18, 2)

  tenant Tenant                 @relation(fields: [tenantId], references: [id])
  count  CashDenominationCount  @relation(fields: [countId], references: [id], onDelete: Cascade)

  @@index([countId])
  @@map("cash_denomination_count_lines")
}

model CashDailyClose {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  cashDeskId String   @map("cash_desk_id")
  businessDate DateTime @map("business_date") @db.Date
  cashierId  String?  @map("cashier_id")
  currencyId String   @map("currency_id")

  openingBookBalance Decimal @map("opening_book_balance") @db.Decimal(18, 2)
  totalReceipts      Decimal @default(0) @map("total_receipts") @db.Decimal(18, 2)
  totalExpenses      Decimal @default(0) @map("total_expenses") @db.Decimal(18, 2)
  closingBookBalance Decimal @map("closing_book_balance") @db.Decimal(18, 2)
  physicalCountId    String? @map("physical_count_id")
  difference         Decimal @default(0) @db.Decimal(18, 2)

  status       String    @default("OPEN") // OPEN|COUNT_REQUIRED|DIFFERENCE_FOUND|PENDING_APPROVAL|CLOSED|REOPENED
  closedAt     DateTime? @map("closed_at")
  closedBy     String?   @map("closed_by")
  reopenedAt   DateTime? @map("reopened_at")
  reopenedBy   String?   @map("reopened_by")
  reopenReason String?   @map("reopen_reason")

  createdAt DateTime @default(now()) @map("created_at")

  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  cashDesk Cashbox @relation(fields: [cashDeskId], references: [id])

  @@unique([tenantId, cashDeskId, businessDate, currencyId])
  @@map("cash_daily_closes")
}

/// Universal cash difference document (spec sections 56-58) — one
/// document type dispatched by `adjustmentType`.
model CashCountAdjustment {
  id         String         @id @default(uuid())
  tenantId   String         @map("tenant_id")
  organizationId String     @map("organization_id")
  documentType String       @default("CASH_COUNT_ADJUSTMENT") @map("document_type")
  number     String?
  cashDeskId String         @map("cash_desk_id")
  physicalCountId String?   @map("physical_count_id")
  adjustmentType  String    @map("adjustment_type") // CASH_SURPLUS|CASH_SHORTAGE|DOCUMENT_CORRECTION|CASHIER_RECEIVABLE|OTHER
  reasonCode String?        @map("reason_code")
  employeeId String?        @map("employee_id") // set for CASHIER_RECEIVABLE
  currencyId String         @map("currency_id")
  amount     Decimal        @db.Decimal(18, 2)
  documentDate DateTime     @map("document_date") @db.Date
  postingDate  DateTime?    @map("posting_date") @db.Date

  status        DocumentStatus @default(DRAFT)
  postingStatus PostingStatus  @default(NOT_POSTED) @map("posting_status")

  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by")
  postedAt     DateTime? @map("posted_at")
  postedBy     String?   @map("posted_by")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelledBy  String?   @map("cancelled_by")
  deletionMark Boolean   @default(false) @map("deletion_mark")
  version      Int       @default(1)

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  cashDesk     Cashbox      @relation(fields: [cashDeskId], references: [id])

  @@unique([tenantId, number])
  @@map("cash_count_adjustments")
}

model CashierHandover {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  cashDeskId String   @map("cash_desk_id")
  outgoingCashierId String @map("outgoing_cashier_id")
  incomingCashierId String @map("incoming_cashier_id")
  handoverAt DateTime @default(now()) @map("handover_at")

  bookBalance     Decimal @map("book_balance") @db.Decimal(18, 2)
  physicalBalance Decimal @map("physical_balance") @db.Decimal(18, 2)
  difference      Decimal @default(0) @db.Decimal(18, 2)
  denominationCountId String? @map("denomination_count_id")

  status String  @default("PENDING") // PENDING|DIFFERENCE_PENDING|COMPLETED|CANCELLED
  notes  String?

  createdAt DateTime @default(now()) @map("created_at")

  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  cashDesk Cashbox @relation(fields: [cashDeskId], references: [id])

  @@index([tenantId, cashDeskId, handoverAt])
  @@map("cashier_handovers")
}

// ============================================================
// PHASE 16 — FIXED ASSETS / ƏSAS VƏSAİTLƏR (docx spec Phase 16)
// See docs/FIXED_ASSETS.md for the disclosed-simplifications list.
// Financial totals on FixedAsset (initialCost/accumulatedDepreciation/
// impairmentBalance/revaluationBalance/carryingAmount) are PROJECTIONS
// maintained alongside FixedAssetMovement — the movement register is the
// authoritative source, same "rebuildable projection" convention as every
// other subledger in this codebase.
// ============================================================

model FixedAssetCategory {
  id             String  @id @default(uuid())
  tenantId       String  @map("tenant_id")
  organizationId String  @map("organization_id")
  code           String
  name           String

  defaultUsefulLifeMonths  Int?     @map("default_useful_life_months")
  defaultDepreciationMethod String  @default("STRAIGHT_LINE") @map("default_depreciation_method")
  defaultResidualValue     Decimal  @default(0) @map("default_residual_value") @db.Decimal(18, 2)
  capitalizationThreshold  Decimal? @map("capitalization_threshold") @db.Decimal(18, 2)
  accountingMappingProfile String?  @map("accounting_mapping_profile")
  taxCategory              String?  @map("tax_category")
  componentizationAllowed  Boolean  @default(false) @map("componentization_allowed")
  revaluationModel         String   @default("COST_MODEL") @map("revaluation_model") // COST_MODEL|REVALUATION_MODEL
  active                   Boolean  @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  version   Int      @default(1)

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  acquisitionCandidates FixedAssetAcquisitionCandidate[]
  assets                FixedAsset[]

  @@unique([organizationId, code])
  @@map("fixed_asset_categories")
}

model CapitalInvestmentProject {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  organizationId String   @map("organization_id")
  code           String
  name           String
  projectType    String   @default("CONSTRUCTION") @map("project_type") // CONSTRUCTION|ASSEMBLY|OTHER
  startDate      DateTime @map("start_date") @db.Date
  plannedCompletionDate DateTime? @map("planned_completion_date") @db.Date

  departmentId        String? @map("department_id")
  responsiblePersonId String? @map("responsible_person_id")
  locationId          String? @map("location_id") // soft reference — no Location master model yet, see docs/FIXED_ASSETS.md
  currencyId          String  @map("currency_id")

  status           String @default("PLANNED") // PLANNED|ACTIVE|SUSPENDED|READY_FOR_CAPITALIZATION|CAPITALIZED|CANCELLED
  targetAssetCount Int?   @map("target_asset_count")
  comment          String?

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  version   Int      @default(1)

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  organization      Organization       @relation(fields: [organizationId], references: [id])
  department        Department?        @relation(fields: [departmentId], references: [id])
  responsiblePerson ResponsiblePerson? @relation(fields: [responsiblePersonId], references: [id])
  currency          Currency           @relation(fields: [currencyId], references: [id])

  costLines       CapitalInvestmentCostLine[]
  candidates      FixedAssetAcquisitionCandidate[]
  assets          FixedAsset[]
  capitalizations FixedAssetCapitalization[]

  @@unique([organizationId, code])
  @@index([tenantId, organizationId, status])
  @@map("capital_investment_projects")
}

model CapitalInvestmentCostLine {
  id                   String   @id @default(uuid())
  tenantId             String   @map("tenant_id")
  projectId            String   @map("project_id")
  costComponent        String   @map("cost_component") // PURCHASE_PRICE|CONSTRUCTION|INSTALLATION|FREIGHT|CUSTOMS|ENGINEERING|PROFESSIONAL_FEES|TESTING|LABOR|BORROWING_COST|OTHER
  sourceDocumentType   String   @map("source_document_type")
  sourceDocumentId     String   @map("source_document_id")
  candidateId          String?  @map("candidate_id")
  currencyId           String   @map("currency_id")
  amount               Decimal  @db.Decimal(18, 2)
  baseAmount           Decimal  @map("base_amount") @db.Decimal(18, 2)
  capitalizable        Boolean  @default(true)
  capitalizedToAssetId String?  @map("capitalized_to_asset_id")
  effectiveDate        DateTime @map("effective_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant             Tenant                          @relation(fields: [tenantId], references: [id])
  project            CapitalInvestmentProject        @relation(fields: [projectId], references: [id])
  candidate          FixedAssetAcquisitionCandidate? @relation(fields: [candidateId], references: [id])
  capitalizedToAsset FixedAsset?                     @relation(fields: [capitalizedToAssetId], references: [id])

  @@index([tenantId, projectId])
  @@index([tenantId, capitalizable, capitalizedToAssetId])
  @@map("capital_investment_cost_lines")
}

model FixedAssetAcquisitionCandidate {
  id             String  @id @default(uuid())
  tenantId       String  @map("tenant_id")
  organizationId String  @map("organization_id")

  sourceDocumentType   String  @map("source_document_type")
  sourceDocumentId     String  @map("source_document_id")
  sourceDocumentLineId String? @map("source_document_line_id")
  supplierId           String? @map("supplier_id")
  productId            String? @map("product_id")
  description          String?
  quantity             Decimal @default(1) @db.Decimal(18, 4)
  currencyId           String  @map("currency_id")
  transactionAmount    Decimal @map("transaction_amount") @db.Decimal(18, 2)
  baseAmount           Decimal @map("base_amount") @db.Decimal(18, 2)
  taxAmount            Decimal @default(0) @map("tax_amount") @db.Decimal(18, 2)
  capitalizableAmount  Decimal @default(0) @map("capitalizable_amount") @db.Decimal(18, 2)
  candidateType        String  @map("candidate_type") // PURCHASE|CONSTRUCTION|INTERNAL_CREATION|INVENTORY_TRANSFER|OPENING_MIGRATION|MANUAL
  categoryId           String? @map("category_id")

  status               String  @default("NEW") // NEW|UNDER_REVIEW|CAPITALIZABLE|EXPENSE|ASSIGNED_TO_CIP|ASSIGNED_TO_ASSET|CAPITALIZED|CANCELLED
  assignedCipProjectId String? @map("assigned_cip_project_id")
  assignedAssetId      String? @map("assigned_asset_id")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant       Tenant                      @relation(fields: [tenantId], references: [id])
  organization Organization                @relation(fields: [organizationId], references: [id])
  category     FixedAssetCategory?         @relation(fields: [categoryId], references: [id])
  cipProject   CapitalInvestmentProject?   @relation(fields: [assignedCipProjectId], references: [id])
  asset        FixedAsset?                 @relation(fields: [assignedAssetId], references: [id])
  costLines    CapitalInvestmentCostLine[]

  @@index([tenantId, organizationId, status])
  @@index([tenantId, sourceDocumentType, sourceDocumentId])
  @@map("fixed_asset_acquisition_candidates")
}

model FixedAsset {
  id             String @id @default(uuid())
  tenantId       String @map("tenant_id")
  organizationId String @map("organization_id")
  assetNumber    String? @map("asset_number")
  inventoryNumber String? @map("inventory_number")
  name           String
  description    String?
  categoryId     String  @map("category_id")
  parentAssetId  String? @map("parent_asset_id")
  componentGroupId String? @map("component_group_id")
  cipProjectId   String? @map("cip_project_id")

  acquisitionDate       DateTime  @map("acquisition_date") @db.Date
  acceptanceDate        DateTime? @map("acceptance_date") @db.Date
  commissioningDate     DateTime? @map("commissioning_date") @db.Date
  depreciationStartDate DateTime? @map("depreciation_start_date") @db.Date
  disposalDate          DateTime? @map("disposal_date") @db.Date

  locationId          String? @map("location_id") // soft reference — see docs/FIXED_ASSETS.md
  departmentId        String? @map("department_id")
  responsiblePersonId String? @map("responsible_person_id")

  status        String  @default("ACQUISITION") // see docs/FIXED_ASSETS.md FixedAssetStatus list
  ownershipType String  @default("OWNED") @map("ownership_type") // OWNED|LEASED|RENTED
  serialNumber  String? @map("serial_number")
  manufacturer  String?
  model         String?
  barcode       String?

  usefulLifeMonths          Int?     @map("useful_life_months")
  remainingUsefulLifeMonths Int?     @map("remaining_useful_life_months")
  depreciationMethod        String   @default("STRAIGHT_LINE") @map("depreciation_method")
  residualValue             Decimal  @default(0) @map("residual_value") @db.Decimal(18, 2)
  depreciationRate          Decimal? @map("depreciation_rate") @db.Decimal(9, 6)
  depreciationStartRule     String   @default("FIRST_DAY_NEXT_MONTH") @map("depreciation_start_rule") // FROM_COMMISSIONING_DATE|NEXT_DAY|NEXT_MONTH|FIRST_DAY_NEXT_MONTH
  depreciationEligible      Boolean  @default(true) @map("depreciation_eligible") // false while SUSPENDED with PAUSE_DEPRECIATION policy

  currencyId              String  @map("currency_id")
  initialCost             Decimal @default(0) @map("initial_cost") @db.Decimal(18, 2)
  accumulatedDepreciation Decimal @default(0) @map("accumulated_depreciation") @db.Decimal(18, 2)
  impairmentBalance       Decimal @default(0) @map("impairment_balance") @db.Decimal(18, 2)
  revaluationBalance      Decimal @default(0) @map("revaluation_balance") @db.Decimal(18, 2)
  carryingAmount          Decimal @default(0) @map("carrying_amount") @db.Decimal(18, 2)

  taxBookReference String? @map("tax_book_reference")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  tenant            Tenant                    @relation(fields: [tenantId], references: [id])
  organization      Organization              @relation(fields: [organizationId], references: [id])
  category          FixedAssetCategory        @relation(fields: [categoryId], references: [id])
  parentAsset       FixedAsset?               @relation("AssetComponents", fields: [parentAssetId], references: [id])
  components        FixedAsset[]              @relation("AssetComponents")
  cipProject        CapitalInvestmentProject? @relation(fields: [cipProjectId], references: [id])
  department        Department?               @relation(fields: [departmentId], references: [id])
  responsiblePerson ResponsiblePerson?        @relation(fields: [responsiblePersonId], references: [id])
  currency          Currency                  @relation(fields: [currencyId], references: [id])

  acquisitionCandidates FixedAssetAcquisitionCandidate[]
  capitalizedCostLines  CapitalInvestmentCostLine[]
  movements             FixedAssetMovement[]
  transfers             FixedAssetTransfer[]
  modernizations        FixedAssetModernization[]
  impairments           FixedAssetImpairment[]
  revaluations          FixedAssetRevaluation[]
  suspensions           FixedAssetSuspension[]
  disposals             FixedAssetDisposal[]
  depreciationEntries   FixedAssetDepreciationEntry[]
  inventoryLines        FixedAssetInventoryLine[]
  openingBalance        FixedAssetOpeningBalance?

  @@index([organizationId, inventoryNumber])
  @@index([organizationId, status])
  @@index([organizationId, categoryId])
  @@index([organizationId, departmentId])
  @@index([organizationId, responsiblePersonId])
  @@map("fixed_assets")
}

/// Central immutable subledger (spec section 25) — the ONLY authoritative
/// source for cost/depreciation/impairment/revaluation balances (spec
/// section 26). FixedAsset's own totals are a maintained projection.
model FixedAssetMovement {
  id             String @id @default(uuid())
  tenantId       String @map("tenant_id")
  organizationId String @map("organization_id")
  assetId        String @map("asset_id")
  valuationBook  String @default("ACCOUNTING_BOOK") @map("valuation_book") // ACCOUNTING_BOOK|TAX_BOOK|MANAGEMENT_BOOK — only ACCOUNTING_BOOK is computed in this build, see docs/FIXED_ASSETS.md
  movementType   String @map("movement_type") // INITIAL_RECOGNITION|CAPITALIZATION|DEPRECIATION|DEPRECIATION_REVERSAL|MODERNIZATION|IMPAIRMENT|IMPAIRMENT_REVERSAL|REVALUATION_INCREASE|REVALUATION_DECREASE|PARTIAL_DISPOSAL|FULL_DISPOSAL|WRITE_OFF|TRANSFER|OPENING_BALANCE

  costIncrease         Decimal @default(0) @map("cost_increase") @db.Decimal(18, 2)
  costDecrease         Decimal @default(0) @map("cost_decrease") @db.Decimal(18, 2)
  depreciationIncrease Decimal @default(0) @map("depreciation_increase") @db.Decimal(18, 2)
  depreciationDecrease Decimal @default(0) @map("depreciation_decrease") @db.Decimal(18, 2)
  impairmentIncrease   Decimal @default(0) @map("impairment_increase") @db.Decimal(18, 2)
  impairmentDecrease   Decimal @default(0) @map("impairment_decrease") @db.Decimal(18, 2)
  revaluationIncrease  Decimal @default(0) @map("revaluation_increase") @db.Decimal(18, 2)
  revaluationDecrease  Decimal @default(0) @map("revaluation_decrease") @db.Decimal(18, 2)

  sourceDocumentType String   @map("source_document_type")
  sourceDocumentId   String   @map("source_document_id")
  effectiveDate      DateTime @map("effective_date") @db.Date
  reversed           Boolean  @default(false)

  createdAt DateTime @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  asset        FixedAsset   @relation(fields: [assetId], references: [id])

  @@index([tenantId, assetId, valuationBook])
  @@index([tenantId, sourceDocumentType, sourceDocumentId])
  @@map("fixed_asset_movements")
}

/// Universal capitalization document (spec sections 88-90) — creates the
/// FixedAsset row(s) and posts INITIAL_RECOGNITION. Sourced EITHER from a
/// CapitalInvestmentProject (`cipProjectId` set — Dr Fixed Asset / Cr CIP)
/// OR directly from acquisition candidates (`cipProjectId` null — Dr Fixed
/// Asset / Cr AP/source, spec section 89's "direct capitalization").
model FixedAssetCapitalization {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  organizationId String   @map("organization_id")
  documentType   String   @default("FIXED_ASSET_CAPITALIZATION") @map("document_type")
  number         String?
  documentDate   DateTime @map("document_date") @db.Date
  postingDate    DateTime? @map("posting_date") @db.Date

  cipProjectId String? @map("cip_project_id")
  assetId      String  @map("asset_id") // the FixedAsset created by this event (created in DRAFT alongside this document)
  currencyId   String  @map("currency_id")
  amount       Decimal @db.Decimal(18, 2)

  status        DocumentStatus @default(DRAFT)
  postingStatus PostingStatus  @default(NOT_POSTED) @map("posting_status")

  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by")
  postedAt     DateTime? @map("posted_at")
  postedBy     String?   @map("posted_by")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelledBy  String?   @map("cancelled_by")
  deletionMark Boolean   @default(false) @map("deletion_mark")
  version      Int       @default(1)

  tenant       Tenant                    @relation(fields: [tenantId], references: [id])
  organization Organization              @relation(fields: [organizationId], references: [id])
  cipProject   CapitalInvestmentProject? @relation(fields: [cipProjectId], references: [id])

  @@unique([tenantId, number])
  @@map("fixed_asset_capitalizations")
}

model FixedAssetTransfer {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  organizationId String   @map("organization_id")
  documentType   String   @default("FIXED_ASSET_TRANSFER") @map("document_type")
  number         String?
  documentDate   DateTime @map("document_date") @db.Date
  postingDate    DateTime? @map("posting_date") @db.Date

  assetId String @map("asset_id")

  fromDepartmentId String? @map("from_department_id")
  toDepartmentId   String? @map("to_department_id")
  fromLocationId   String? @map("from_location_id")
  toLocationId     String? @map("to_location_id")
  fromResponsiblePersonId String? @map("from_responsible_person_id")
  toResponsiblePersonId   String? @map("to_responsible_person_id")
  reason String?

  status        DocumentStatus @default(DRAFT)
  postingStatus PostingStatus  @default(NOT_POSTED) @map("posting_status")

  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by")
  postedAt     DateTime? @map("posted_at")
  postedBy     String?   @map("posted_by")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelledBy  String?   @map("cancelled_by")
  deletionMark Boolean   @default(false) @map("deletion_mark")
  version      Int       @default(1)

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  asset        FixedAsset   @relation(fields: [assetId], references: [id])

  @@unique([tenantId, number])
  @@map("fixed_asset_transfers")
}

model FixedAssetModernization {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  organizationId String   @map("organization_id")
  documentType   String   @default("FIXED_ASSET_MODERNIZATION") @map("document_type")
  number         String?
  documentDate   DateTime @map("document_date") @db.Date
  postingDate    DateTime? @map("posting_date") @db.Date

  assetId              String  @map("asset_id")
  modernizationType    String  @default("CAPITAL_IMPROVEMENT") @map("modernization_type") // CAPITAL_IMPROVEMENT|RECONSTRUCTION|UPGRADE
  sourceDocumentType   String? @map("source_document_type")
  sourceDocumentId     String? @map("source_document_id")
  currencyId           String  @map("currency_id")
  amount               Decimal @db.Decimal(18, 2)
  newUsefulLifeMonths  Int?    @map("new_useful_life_months")
  newResidualValue     Decimal? @map("new_residual_value") @db.Decimal(18, 2)
  description          String?

  status        DocumentStatus @default(DRAFT)
  postingStatus PostingStatus  @default(NOT_POSTED) @map("posting_status")

  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by")
  postedAt     DateTime? @map("posted_at")
  postedBy     String?   @map("posted_by")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelledBy  String?   @map("cancelled_by")
  deletionMark Boolean   @default(false) @map("deletion_mark")
  version      Int       @default(1)

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  asset        FixedAsset   @relation(fields: [assetId], references: [id])

  @@unique([tenantId, number])
  @@map("fixed_asset_modernizations")
}

model FixedAssetImpairment {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  organizationId String   @map("organization_id")
  documentType   String   @default("FIXED_ASSET_IMPAIRMENT") @map("document_type")
  number         String?
  documentDate   DateTime @map("document_date") @db.Date
  postingDate    DateTime? @map("posting_date") @db.Date

  assetId               String  @map("asset_id")
  carryingAmountBefore  Decimal @map("carrying_amount_before") @db.Decimal(18, 2)
  recoverableAmount     Decimal @map("recoverable_amount") @db.Decimal(18, 2)
  impairmentAmount      Decimal @map("impairment_amount") @db.Decimal(18, 2)
  reason                String?
  valuationSource       String? @map("valuation_source")
  reversal              Boolean @default(false) // true = IMPAIRMENT_REVERSAL instead of IMPAIRMENT

  status        DocumentStatus @default(DRAFT)
  postingStatus PostingStatus  @default(NOT_POSTED) @map("posting_status")

  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by")
  postedAt     DateTime? @map("posted_at")
  postedBy     String?   @map("posted_by")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelledBy  String?   @map("cancelled_by")
  deletionMark Boolean   @default(false) @map("deletion_mark")
  version      Int       @default(1)

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  asset        FixedAsset   @relation(fields: [assetId], references: [id])

  @@unique([tenantId, number])
  @@map("fixed_asset_impairments")
}

model FixedAssetRevaluation {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  organizationId String   @map("organization_id")
  documentType   String   @default("FIXED_ASSET_REVALUATION") @map("document_type")
  number         String?
  documentDate   DateTime @map("document_date") @db.Date
  postingDate    DateTime? @map("posting_date") @db.Date

  assetId              String  @map("asset_id")
  oldCarryingAmount    Decimal @map("old_carrying_amount") @db.Decimal(18, 2)
  revaluedAmount       Decimal @map("revalued_amount") @db.Decimal(18, 2)
  valuationSource      String? @map("valuation_source")
  reason               String?

  status        DocumentStatus @default(DRAFT)
  postingStatus PostingStatus  @default(NOT_POSTED) @map("posting_status")

  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by")
  postedAt     DateTime? @map("posted_at")
  postedBy     String?   @map("posted_by")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelledBy  String?   @map("cancelled_by")
  deletionMark Boolean   @default(false) @map("deletion_mark")
  version      Int       @default(1)

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  asset        FixedAsset   @relation(fields: [assetId], references: [id])

  @@unique([tenantId, number])
  @@map("fixed_asset_revaluations")
}

model FixedAssetSuspension {
  id         String    @id @default(uuid())
  tenantId   String    @map("tenant_id")
  assetId    String    @map("asset_id")
  startDate  DateTime  @map("start_date") @db.Date
  endDate    DateTime? @map("end_date") @db.Date
  reason     String?
  depreciationPolicy String @default("PAUSE_DEPRECIATION") @map("depreciation_policy") // CONTINUE_DEPRECIATION|PAUSE_DEPRECIATION
  status     String    @default("ACTIVE") // ACTIVE|ENDED

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant Tenant     @relation(fields: [tenantId], references: [id])
  asset  FixedAsset @relation(fields: [assetId], references: [id])

  @@index([tenantId, assetId, status])
  @@map("fixed_asset_suspensions")
}

model FixedAssetDisposal {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  organizationId String   @map("organization_id")
  documentType   String   @default("FIXED_ASSET_DISPOSAL") @map("document_type")
  number         String?
  documentDate   DateTime @map("document_date") @db.Date
  postingDate    DateTime? @map("posting_date") @db.Date

  assetId       String  @map("asset_id")
  disposalType  String  @map("disposal_type") // SALE|WRITE_OFF|SCRAP|DONATION|LOSS|THEFT|TRANSFER_OUT|PARTIAL_DISPOSAL|COMPONENT_REPLACEMENT
  disposalShare Decimal @default(1) @map("disposal_share") @db.Decimal(9, 6) // 1 = full disposal; <1 = proportional partial disposal (spec section 72 PROPORTIONAL_COST)
  proceeds      Decimal? @db.Decimal(18, 2)
  buyerCounterpartyId String? @map("buyer_counterparty_id")
  salesInvoiceId      String? @map("sales_invoice_id") // soft reference, spec section 68 "link to Sales Invoice, don't duplicate"
  disposalCosts Decimal @default(0) @map("disposal_costs") @db.Decimal(18, 2)
  currencyId    String  @map("currency_id")
  reason        String?

  // Computed at post time and stored for audit/reporting — NOT the
  // authoritative source (FixedAssetMovement is).
  grossCostRemoved         Decimal? @map("gross_cost_removed") @db.Decimal(18, 2)
  accumulatedDepreciationRemoved Decimal? @map("accumulated_depreciation_removed") @db.Decimal(18, 2)
  carryingAmountAtDisposal Decimal? @map("carrying_amount_at_disposal") @db.Decimal(18, 2)
  gainLoss                 Decimal? @map("gain_loss") @db.Decimal(18, 2)

  status        DocumentStatus @default(DRAFT)
  postingStatus PostingStatus  @default(NOT_POSTED) @map("posting_status")

  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by")
  postedAt     DateTime? @map("posted_at")
  postedBy     String?   @map("posted_by")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelledBy  String?   @map("cancelled_by")
  deletionMark Boolean   @default(false) @map("deletion_mark")
  version      Int       @default(1)

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  organization Organization  @relation(fields: [organizationId], references: [id])
  asset        FixedAsset    @relation(fields: [assetId], references: [id])
  buyer        Counterparty? @relation(fields: [buyerCounterpartyId], references: [id])

  @@unique([tenantId, number])
  @@map("fixed_asset_disposals")
}

model FixedAssetDepreciationRun {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  organizationId String   @map("organization_id")
  period         DateTime @db.Date // first day of the period month
  valuationBook  String   @default("ACCOUNTING_BOOK") @map("valuation_book")
  runType        String   @default("PERIODIC") @map("run_type") // PREVIEW|PERIODIC|RECALCULATION|FINAL_CLOSE
  status         String   @default("DRAFT") @map("status") // DRAFT|CALCULATED|POSTED|ERROR
  startedAt      DateTime? @map("started_at")
  completedAt    DateTime? @map("completed_at")
  initiatedBy    String?  @map("initiated_by")
  assetCount     Int      @default(0) @map("asset_count")
  calculatedAmount Decimal @default(0) @map("calculated_amount") @db.Decimal(18, 2)
  postingBatchId String?  @map("posting_batch_id")

  createdAt DateTime @default(now()) @map("created_at")

  tenant       Tenant                         @relation(fields: [tenantId], references: [id])
  organization Organization                   @relation(fields: [organizationId], references: [id])
  entries      FixedAssetDepreciationEntry[]

  @@unique([tenantId, organizationId, period, valuationBook, runType])
  @@map("fixed_asset_depreciation_runs")
}

model FixedAssetDepreciationEntry {
  id        String @id @default(uuid())
  tenantId  String @map("tenant_id")
  runId     String @map("run_id")
  assetId   String @map("asset_id")

  openingNbv          Decimal @map("opening_nbv") @db.Decimal(18, 2)
  depreciationAmount  Decimal @map("depreciation_amount") @db.Decimal(18, 2)
  closingNbv          Decimal @map("closing_nbv") @db.Decimal(18, 2)
  errorCode           String? @map("error_code") // see docs/FIXED_ASSETS.md DEPRECIATION_ERROR list
  posted              Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant                    @relation(fields: [tenantId], references: [id])
  run    FixedAssetDepreciationRun @relation(fields: [runId], references: [id])
  asset  FixedAsset                @relation(fields: [assetId], references: [id])

  @@unique([runId, assetId])
  @@index([tenantId, assetId])
  @@map("fixed_asset_depreciation_entries")
}

model FixedAssetInventoryCount {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  organizationId String   @map("organization_id")
  countDate      DateTime @map("count_date") @db.Date
  scopeDepartmentId String? @map("scope_department_id")
  scopeCategoryId   String? @map("scope_category_id")
  status         String   @default("IN_PROGRESS") // IN_PROGRESS|COMPLETED|CANCELLED
  notes          String?

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant       Tenant                     @relation(fields: [tenantId], references: [id])
  organization Organization               @relation(fields: [organizationId], references: [id])
  lines        FixedAssetInventoryLine[]

  @@index([tenantId, organizationId, status])
  @@map("fixed_asset_inventory_counts")
}

model FixedAssetInventoryLine {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  countId  String @map("count_id")
  assetId  String? @map("asset_id") // null for UNREGISTERED_ASSET

  expectedLocationId String? @map("expected_location_id")
  foundLocationId     String? @map("found_location_id")
  expectedResponsiblePersonId String? @map("expected_responsible_person_id")
  foundResponsiblePersonId    String? @map("found_responsible_person_id")
  result   String  @map("result") // FOUND|MISSING|WRONG_LOCATION|WRONG_RESPONSIBLE_PERSON|DAMAGED|UNREGISTERED_ASSET
  condition String? // for DAMAGED
  description String? // for UNREGISTERED_ASSET
  notes    String?

  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant                    @relation(fields: [tenantId], references: [id])
  count  FixedAssetInventoryCount  @relation(fields: [countId], references: [id])
  asset  FixedAsset?               @relation(fields: [assetId], references: [id])

  @@index([tenantId, countId])
  @@map("fixed_asset_inventory_lines")
}

model FixedAssetOpeningBalance {
  id       String   @id @default(uuid())
  tenantId String   @map("tenant_id")
  assetId  String   @unique @map("asset_id")
  openingDate            DateTime @map("opening_date") @db.Date
  originalCost           Decimal  @map("original_cost") @db.Decimal(18, 2)
  accumulatedDepreciation Decimal @default(0) @map("accumulated_depreciation") @db.Decimal(18, 2)
  impairment             Decimal  @default(0) @db.Decimal(18, 2)
  revaluation            Decimal  @default(0) @db.Decimal(18, 2)
  remainingUsefulLifeMonths Int?  @map("remaining_useful_life_months")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant Tenant     @relation(fields: [tenantId], references: [id])
  asset  FixedAsset @relation(fields: [assetId], references: [id])

  @@map("fixed_asset_opening_balances")
}

// ============================================================
// PHASE 17 — HR CORE / KADR UÇOTU (docx spec Phase 17)
// See docs/HR_CORE.md for the disclosed-simplifications list. HR
// "posting" (spec section 65) never creates a GL movement — Hire/
// Transfer/Termination documents route through the shared
// DocumentFramework purely for its status/version/audit lifecycle;
// their posting handlers always return null from buildAccountingBatch.
// ============================================================

model PhysicalPerson {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  middleName     String?   @map("middle_name")
  fullName       String    @map("full_name")
  gender         String?
  birthDate      DateTime? @map("birth_date") @db.Date
  nationality    String?
  personalId     String?   @map("personal_id") // national ID / tax ID — hard-unique only when present (spec section 5)
  passportNumber String?   @map("passport_number")
  phone          String?
  email          String?
  address        String?
  emergencyContact String? @map("emergency_contact")
  photoAssetId   String?   @map("photo_asset_id")
  notes          String?
  active         Boolean   @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  employees Employee[]

  @@index([tenantId, personalId])
  @@index([tenantId, lastName, firstName])
  @@map("hr_physical_persons")
}

model Employee {
  id                    String    @id @default(uuid())
  tenantId              String    @map("tenant_id")
  physicalPersonId      String    @map("physical_person_id")
  personnelNumber       String?   @map("personnel_number")
  employeeCode          String?   @map("employee_code")
  defaultOrganizationId String?   @map("default_organization_id")
  defaultLanguage       String?   @map("default_language")
  corporateEmail        String?   @map("corporate_email")
  corporatePhone        String?   @map("corporate_phone")
  bankAccountReference  String?   @map("bank_account_reference") // sensitive, permission-gated at the service layer
  status                String    @default("ACTIVE") // ACTIVE|INACTIVE (an Employee itself is never "terminated" — its Employments are)
  hireFirstDate         DateTime? @map("hire_first_date") @db.Date
  lastTerminationDate   DateTime? @map("last_termination_date") @db.Date
  // Phase 26 bridge (spec section 27) — HR's own Employee/Employment
  // graph has no native link to an application User account; workflow
  // approver resolution (MANAGER/DEPARTMENT_HEAD/...) needs one to
  // actually assign a real, loggable approver. Nullable/optional — an
  // employee never linked simply cannot be resolved as an approver
  // (spec section 88's own "block, don't silently skip").
  linkedUserId          String?   @map("linked_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  version   Int      @default(1)

  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  physicalPerson PhysicalPerson @relation(fields: [physicalPersonId], references: [id])
  linkedUser     User?          @relation(fields: [linkedUserId], references: [id])

  employments        Employment[]
  attributeHistories EmployeeAttributeHistory[]

  @@unique([tenantId, personnelNumber])
  @@index([tenantId, physicalPersonId])
  @@map("hr_employees")
}

model Position {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  code        String
  name        String
  jobFamily   String? @map("job_family")
  grade       String?
  category    String?
  description String?
  active      Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  version   Int      @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  staffingPositions StaffingPosition[]
  employments       Employment[]
  assignments       EmployeeAssignment[]

  @@unique([tenantId, code])
  @@map("hr_positions")
}

/// Effective-dated version container (spec section 82) — a new
/// reorganization creates a new StaffingTable row rather than mutating an
/// existing one; historical reporting resolves the version whose
/// [effectiveFrom, effectiveTo) window covers the report date.
model StaffingTable {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  organizationId String    @map("organization_id")
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date
  status         String    @default("ACTIVE") // DRAFT|ACTIVE|SUPERSEDED
  version        Int       @default(1)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  organization Organization       @relation(fields: [organizationId], references: [id])
  positions    StaffingPosition[]

  @@index([tenantId, organizationId, status])
  @@map("hr_staffing_tables")
}

model StaffingPosition {
  id                  String    @id @default(uuid())
  tenantId            String    @map("tenant_id")
  staffingTableId     String    @map("staffing_table_id")
  organizationId      String    @map("organization_id")
  departmentId        String    @map("department_id")
  branchId            String?   @map("branch_id")
  positionId          String    @map("position_id")
  grade               String?
  headcountLimit      Int       @default(1) @map("headcount_limit")
  fteLimit            Decimal   @default(1) @map("fte_limit") @db.Decimal(5, 4)
  salaryRangeReference String?  @map("salary_range_reference")
  workScheduleDefault String?   @map("work_schedule_default")
  locationId          String?   @map("location_id")
  costCenterId        String?   @map("cost_center_id")
  activeFrom          DateTime  @map("active_from") @db.Date
  activeTo            DateTime? @map("active_to") @db.Date
  status              String    @default("ACTIVE") // ACTIVE|CLOSED
  overstaffPolicy     String    @default("WARNING") @map("overstaff_policy") // BLOCK|WARNING|APPROVAL_REQUIRED|ALLOW

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  staffingTable StaffingTable @relation(fields: [staffingTableId], references: [id])
  organization  Organization  @relation(fields: [organizationId], references: [id])
  department    Department    @relation(fields: [departmentId], references: [id])
  branch        Branch?       @relation(fields: [branchId], references: [id])
  position      Position      @relation(fields: [positionId], references: [id])

  employments EmployeeAssignment[]

  @@index([tenantId, organizationId, status])
  @@index([tenantId, departmentId])
  @@map("hr_staffing_positions")
}

model Employment {
  id                 String    @id @default(uuid())
  tenantId           String    @map("tenant_id")
  employeeId         String    @map("employee_id")
  organizationId     String    @map("organization_id")
  employmentType     String    @map("employment_type") // FULL_TIME|PART_TIME|TEMPORARY|FIXED_TERM|CONTRACT|INTERNSHIP|SECONDARY_EMPLOYMENT|SEASONAL
  employmentStatus   String    @default("PLANNED") @map("employment_status") // PLANNED|ACTIVE|SUSPENDED|ON_LEAVE|TERMINATED|CANCELLED — derived/kept in sync from EmploymentStatusHistory
  employmentStartDate DateTime @map("employment_start_date") @db.Date
  employmentEndDate  DateTime? @map("employment_end_date") @db.Date
  primaryEmployment  Boolean   @default(true) @map("primary_employment")
  staffingPositionId String?   @map("staffing_position_id")
  departmentId       String    @map("department_id")
  positionId         String    @map("position_id")
  branchId           String?   @map("branch_id")
  managerEmploymentId String?  @map("manager_employment_id")
  workScheduleId     String?   @map("work_schedule_id") // soft reference — full WorkSchedule master model is Phase 18
  fte                Decimal   @default(1) @map("fte") @db.Decimal(5, 4)
  probationEndDate   DateTime? @map("probation_end_date") @db.Date
  locationId         String?   @map("location_id")
  costCenterId       String?   @map("cost_center_id")
  projectId          String?   @map("project_id")
  previousEmploymentId String? @map("previous_employment_id") // set on rehire (spec section 47/48) — links back without reopening the old row

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  version   Int      @default(1)

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  department   Department   @relation(fields: [departmentId], references: [id])
  position     Position     @relation(fields: [positionId], references: [id])
  branch       Branch?      @relation(fields: [branchId], references: [id])
  manager      Employment?  @relation("EmploymentManager", fields: [managerEmploymentId], references: [id])
  subordinates Employment[] @relation("EmploymentManager")
  previousEmployment Employment? @relation("EmploymentRehire", fields: [previousEmploymentId], references: [id])
  rehires      Employment[] @relation("EmploymentRehire")

  contracts        EmploymentContract[]
  assignments      EmployeeAssignment[]
  scheduleAssignments WorkScheduleAssignment[]
  statusHistory    EmploymentStatusHistory[]
  leaveRecords     LeaveRecord[]
  absenceRecords   AbsenceRecord[]
  hireDocuments    HireDocument[]
  transfers        EmployeeTransfer[]
  terminations     TerminationDocument[]
  attributeHistories EmployeeAttributeHistory[]

  dailyWorkPlans      EmployeeDailyWorkPlan[]
  attendanceEvents    AttendanceEvent[]
  attendanceIntervals AttendanceInterval[]
  timeEntries         TimeEntry[]
  overtimeRecords     OvertimeRecord[]
  timeCorrections     TimeCorrection[]
  timesheetLines      TimesheetLine[]
  payrollTimeInputs   PayrollTimeInput[]

  payrollCompensationAssignments EmployeeCompensationAssignment[]
  payrollEmployeeTaxProfiles     EmployeeTaxProfile[]
  payrollVariableInputs          PayrollVariableInput[]
  payrollExecutionOrders         PayrollExecutionOrder[]
  payrollDeductionCarryForwardBalances DeductionCarryForwardBalance[]
  payrollAverageEarningsBases    AverageEarningsBase[]
  payrollCalculationResults      PayrollCalculationResult[]
  payrollRecalculationRequests   PayrollRecalculationRequest[]
  payrollLiabilities             PayrollLiability[]
  expenseClaims                  ExpenseClaim[]

  @@index([tenantId, employeeId])
  @@index([tenantId, organizationId, employmentStatus])
  @@index([tenantId, managerEmploymentId])
  @@map("hr_employments")
}

/// Self-versioning (spec section 12): amending a contract creates a NEW
/// row with an incremented `versionNumber` and closes the previous row's
/// `effectiveTo` — never a mutation in place, never a separate child
/// "Version" table (disclosed simplification, see docs/HR_CORE.md).
model EmploymentContract {
  id                 String    @id @default(uuid())
  tenantId           String    @map("tenant_id")
  employmentId       String    @map("employment_id")
  contractNumber     String    @map("contract_number")
  versionNumber      Int       @default(1) @map("version_number")
  contractDate       DateTime  @map("contract_date") @db.Date
  effectiveFrom      DateTime  @map("effective_from") @db.Date
  effectiveTo        DateTime? @map("effective_to") @db.Date
  contractType       String    @map("contract_type")
  probationPeriodMonths Int?   @map("probation_period_months")
  workLocation       String?   @map("work_location")
  workingTimeType    String?   @map("working_time_type")
  baseCompensationReference String? @map("base_compensation_reference")
  conditions         String?
  signedStatus       String    @default("UNSIGNED") @map("signed_status") // UNSIGNED|SIGNED|PENDING
  attachmentAssetId  String?   @map("attachment_asset_id")
  changeSummary      String?   @map("change_summary") // spec section 12's "changes"
  sourceDocumentType String?   @map("source_document_type")
  sourceDocumentId   String?   @map("source_document_id")
  approvedBy         String?   @map("approved_by")
  status             String    @default("ACTIVE") // ACTIVE|SUPERSEDED|CANCELLED
  version            Int       @default(1)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  employment Employment @relation(fields: [employmentId], references: [id])

  @@index([tenantId, employmentId, versionNumber])
  @@map("hr_employment_contracts")
}

/// Authoritative assignment history (spec sections 22-23) — Employment's
/// own department/position/etc. columns above are the LATEST snapshot for
/// convenience joins only; `EmployeeAssignmentService.getStateAsOf` is the
/// only correct way to answer "what was true on date X" (spec section 51).
model EmployeeAssignment {
  id                 String    @id @default(uuid())
  tenantId           String    @map("tenant_id")
  employmentId       String    @map("employment_id")
  effectiveFrom      DateTime  @map("effective_from") @db.Date
  effectiveTo        DateTime? @map("effective_to") @db.Date
  organizationId     String    @map("organization_id")
  departmentId       String    @map("department_id")
  branchId           String?   @map("branch_id")
  positionId         String    @map("position_id")
  staffingPositionId String?   @map("staffing_position_id")
  managerEmploymentId String?  @map("manager_employment_id")
  locationId         String?   @map("location_id")
  fte                Decimal   @map("fte") @db.Decimal(5, 4)
  costCenterId       String?   @map("cost_center_id")
  projectId          String?   @map("project_id")
  reason             String?
  sourceDocumentType String    @map("source_document_type")
  sourceDocumentId   String    @map("source_document_id")

  createdAt DateTime @default(now()) @map("created_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  employment       Employment        @relation(fields: [employmentId], references: [id])
  department       Department        @relation(fields: [departmentId], references: [id])
  position         Position          @relation(fields: [positionId], references: [id])
  branch           Branch?           @relation(fields: [branchId], references: [id])
  staffingPosition StaffingPosition? @relation(fields: [staffingPositionId], references: [id])

  @@index([tenantId, employmentId, effectiveFrom])
  @@index([tenantId, staffingPositionId])
  @@map("hr_employee_assignments")
}

model HireDocument {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  organizationId String   @map("organization_id")
  documentType   String   @default("HR_HIRE") @map("document_type")
  number         String?
  documentDate   DateTime @map("document_date") @db.Date
  postingDate    DateTime? @map("posting_date") @db.Date

  employmentId       String  @map("employment_id") // the PLANNED Employment created alongside this document
  physicalPersonId   String  @map("physical_person_id")
  employeeId         String  @map("employee_id")
  isRehire           Boolean @default(false) @map("is_rehire")
  hireDate           DateTime @map("hire_date") @db.Date
  responsibleHrUserId String? @map("responsible_hr_user_id")

  status        DocumentStatus @default(DRAFT)
  postingStatus PostingStatus  @default(NOT_POSTED) @map("posting_status")

  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by")
  postedAt     DateTime? @map("posted_at")
  postedBy     String?   @map("posted_by")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelledBy  String?   @map("cancelled_by")
  deletionMark Boolean   @default(false) @map("deletion_mark")
  version      Int       @default(1)

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  employment   Employment   @relation(fields: [employmentId], references: [id])

  @@unique([tenantId, number])
  @@map("hr_hire_documents")
}

model EmployeeTransfer {
