  startDate    DateTime @map("start_date") @db.Date
  endDate      DateTime @map("end_date") @db.Date
  reason       String?
  supportingDocumentAssetId String? @map("supporting_document_asset_id")
  status       String   @default("RECORDED") // RECORDED|APPROVED|REJECTED

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  employment Employment @relation(fields: [employmentId], references: [id])

  @@index([tenantId, employmentId, startDate])
  @@map("hr_absence_records")
}

model TerminationDocument {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  organizationId String   @map("organization_id")
  documentType   String   @default("HR_TERMINATION") @map("document_type")
  number         String?
  documentDate   DateTime @map("document_date") @db.Date
  postingDate    DateTime? @map("posting_date") @db.Date

  employmentId     String    @map("employment_id")
  terminationDate  DateTime  @map("termination_date") @db.Date
  lastWorkingDate  DateTime? @map("last_working_date") @db.Date
  terminationReason String   @map("termination_reason") // resignation|employer_termination|contract_expiry|retirement|redundancy|mutual_agreement|death|transfer_to_another_legal_entity|other
  legalReference   String?   @map("legal_reference")
  noticeDate       DateTime? @map("notice_date") @db.Date
  comment          String?
  responsibleHrUserId String? @map("responsible_hr_user_id")

  status        DocumentStatus @default(DRAFT)
  postingStatus PostingStatus  @default(NOT_POSTED) @map("posting_status")

  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by")
  postedAt     DateTime? @map("posted_at")
  postedBy     String?   @map("posted_by")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelledBy  String?   @map("cancelled_by")
  deletionMark Boolean   @default(false) @map("deletion_mark")
  version      Int       @default(1)

