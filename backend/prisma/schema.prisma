/// Generic localization/attribute extension point (spec section 59) —
/// deliberately NOT used for core fields (spec's own "Overuse etmə; core
/// fields typed entities-də qalsın"), only for tax/social/disability-style
/// attributes that vary by jurisdiction and don't warrant their own column.
model EmployeeAttributeHistory {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  employeeId    String?   @map("employee_id")
  employmentId  String?   @map("employment_id")
  attributeType String    @map("attribute_type") // TAX_STATUS|RESIDENT_STATUS|SOCIAL_INSURANCE_CATEGORY|DISABILITY_CATEGORY|OTHER
  value         String
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  sourceDocumentType String? @map("source_document_type")
  sourceDocumentId   String? @map("source_document_id")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  employee   Employee?   @relation(fields: [employeeId], references: [id])
  employment Employment? @relation(fields: [employmentId], references: [id])

  @@index([tenantId, employeeId, attributeType])
  @@index([tenantId, employmentId, attributeType])
  @@map("hr_employee_attribute_histories")
}

// ============================================================
// PHASE 18 — WORK TIME / TIMESHEET (docx spec Phase 18)
// See docs/WORK_TIME.md for the disclosed-simplifications list. Three
// layers, never merged (spec section 1): Planned (EmployeeDailyWorkPlan),
// Actual (AttendanceEvent -> AttendanceInterval -> TimeEntry), Payroll
// Input (PayrollTimeInput, sourced ONLY from a LOCKED Timesheet).
// ============================================================

model ProductionCalendar {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  organizationId String?  @map("organization_id") // nullable = tenant-wide default calendar
  localizationCode String @default("AZ") @map("localization_code")
  year           Int
  name           String
  version        Int      @default(1)
  effectiveFrom  DateTime @map("effective_from") @db.Date
  status         String   @default("ACTIVE") // DRAFT|ACTIVE|SUPERSEDED

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
  days         ProductionCalendarDay[]

  @@unique([tenantId, organizationId, year, version])
  @@index([tenantId, year, status])
  @@map("production_calendars")
}

model ProductionCalendarDay {
  id                 String    @id @default(uuid())
  tenantId           String    @map("tenant_id")
  calendarId         String    @map("calendar_id")
  date               DateTime  @db.Date
  dayType            String    @map("day_type") // WORKDAY|WEEKEND|HOLIDAY|SHORTENED_WORKDAY|TRANSFERRED_WORKDAY|NON_WORKING_DAY
  defaultWorkingHours Decimal  @default(8) @map("default_working_hours") @db.Decimal(5, 2)
  holidayCode        String?   @map("holiday_code")
  shortenedByHours   Decimal?  @map("shortened_by_hours") @db.Decimal(5, 2)
  transferredFromDate DateTime? @map("transferred_from_date") @db.Date
  transferredToDate  DateTime? @map("transferred_to_date") @db.Date
  notes              String?

  tenant   Tenant             @relation(fields: [tenantId], references: [id])
  calendar ProductionCalendar @relation(fields: [calendarId], references: [id])

  @@unique([calendarId, date])
  @@index([tenantId, date])
  @@map("production_calendar_days")
}

model WorkScheduleTemplate {
  id                 String  @id @default(uuid())
  tenantId           String  @map("tenant_id")
  code               String
  name               String
  scheduleType       String  @map("schedule_type") // STANDARD_WEEK|SHIFT|ROTATING|FLEXIBLE|PART_TIME|CUSTOM
  cycleLengthDays    Int     @default(7) @map("cycle_length_days")
  defaultWeeklyHours Decimal @default(40) @map("default_weekly_hours") @db.Decimal(5, 2)
  usesProductionCalendar Boolean @default(true) @map("uses_production_calendar")
  fteAppliesToHours  Boolean @default(true) @map("fte_applies_to_hours") // spec section 14 — schedule design is configurable on whether FTE prorates planned hours
  active             Boolean @default(true)
  version            Int     @default(1)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant   Tenant                 @relation(fields: [tenantId], references: [id])
  patterns WorkSchedulePattern[]

  @@unique([tenantId, code])
  @@map("work_schedule_templates")
}

model WorkSchedulePattern {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  scheduleTemplateId String  @map("schedule_template_id")
  cycleDay          Int      @map("cycle_day") // 1-based position within the template's cycleLengthDays
  workStartTime     String?  @map("work_start_time") // "HH:mm", local to the assignment's org
  workEndTime       String?  @map("work_end_time")
  breakMinutes      Int      @default(0) @map("break_minutes")
  plannedHours      Decimal  @default(0) @map("planned_hours") @db.Decimal(5, 2)
  crossesMidnight   Boolean  @default(false) @map("crosses_midnight")
  shiftTemplateId   String?  @map("shift_template_id")
  dayType           String   @default("WORKDAY") @map("day_type") // WORKDAY|OFF — a pattern day can itself be a scheduled day off (e.g. 2-on/2-off)

  tenant           Tenant                @relation(fields: [tenantId], references: [id])
  scheduleTemplate WorkScheduleTemplate  @relation(fields: [scheduleTemplateId], references: [id])
  shiftTemplate    ShiftTemplate?        @relation(fields: [shiftTemplateId], references: [id])

  @@unique([scheduleTemplateId, cycleDay])
  @@map("work_schedule_patterns")
}

model ShiftTemplate {
  id            String  @id @default(uuid())
  tenantId      String  @map("tenant_id")
  code          String
  name          String
  startTime     String  @map("start_time") // "HH:mm"
  endTime       String  @map("end_time")
  breakMinutes  Int     @default(0) @map("break_minutes")
  plannedHours  Decimal @map("planned_hours") @db.Decimal(5, 2)
  crossesMidnight Boolean @default(false) @map("crosses_midnight")

  tenant   Tenant                @relation(fields: [tenantId], references: [id])
  patterns WorkSchedulePattern[]

  @@unique([tenantId, code])
  @@map("shift_templates")
}

model TimeCode {
  id                 String  @id @default(uuid())
  tenantId           String  @map("tenant_id")
  code               String
  name               String
  countsAsWorkedTime Boolean @default(true) @map("counts_as_worked_time")
  countsAsPaidTime   Boolean @default(true) @map("counts_as_paid_time")
  payrollCode        String? @map("payroll_code")
  requiresDocument   Boolean @default(false) @map("requires_document")
  overlapPriority    Int     @default(100) @map("overlap_priority") // lower = takes precedence when intervals overlap (spec section 85-86)
  affectsFte         Boolean @default(false) @map("affects_fte")
  accountingCategory String? @map("accounting_category")
  active             Boolean @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  timeEntries TimeEntry[]

  @@unique([tenantId, code])
  @@map("time_codes")
}

/// Derived projection, never manually overwritten (spec section 13) —
/// generated by DailyWorkPlanService from the effective
/// WorkScheduleAssignment (Phase 17) + WorkScheduleTemplate/Pattern +
/// ProductionCalendarDay for that date. Regenerating simply upserts by
/// [employmentId, date]; APPROVED/LOCKED timesheet periods are never
/// silently regenerated (spec section 63).
model EmployeeDailyWorkPlan {
  id                    String   @id @default(uuid())
  tenantId              String   @map("tenant_id")
  employmentId          String   @map("employment_id")
  date                  DateTime @db.Date
  scheduleAssignmentId  String?  @map("schedule_assignment_id") // Phase 17 WorkScheduleAssignment.id
  productionCalendarId  String?  @map("production_calendar_id")
  shiftTemplateId       String?  @map("shift_template_id")
  plannedStart          String?  @map("planned_start")
  plannedEnd            String?  @map("planned_end")
  plannedHours          Decimal  @default(0) @map("planned_hours") @db.Decimal(5, 2)
  plannedWorkdayFraction Decimal @default(0) @map("planned_workday_fraction") @db.Decimal(4, 3)
  plannedDayType        String   @map("planned_day_type") // WORKDAY|WEEKEND|HOLIDAY|SHORTENED_WORKDAY|TRANSFERRED_WORKDAY|NON_WORKING_DAY|OFF (schedule pattern day off)
  fte                   Decimal  @default(1) @map("fte") @db.Decimal(5, 4)
  generationVersion     Int      @default(1) @map("generation_version")
  generationStatus      String   @default("GENERATED") @map("generation_status") // GENERATED|OVERRIDDEN|LOCKED

  createdAt DateTime @default(now()) @map("created_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  employment Employment @relation(fields: [employmentId], references: [id])

  @@unique([employmentId, date])
  @@index([tenantId, date])
  @@map("employee_daily_work_plans")
}

/// Raw, immutable clock data (spec section 19) — never itself a payroll
/// hour. `sourceSystem` + `externalEventId` unique together (spec section
/// 104) makes re-importing the same biometric event idempotent.
model AttendanceEvent {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  employmentId     String   @map("employment_id")
  eventTimestamp   DateTime @map("event_timestamp")
  eventType        String   @map("event_type") // CLOCK_IN|CLOCK_OUT|BREAK_START|BREAK_END|OTHER
  locationId       String?  @map("location_id")
  deviceId         String?  @map("device_id")
  sourceSystem     String   @default("MANUAL") @map("source_system") // BIOMETRIC|ACCESS_CONTROL|MOBILE|MANUAL|API|IMPORT
  externalEventId  String?  @map("external_event_id")
  status           String   @default("RAW") // RAW|INTERPRETED|DUPLICATE|EXCEPTION

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  employment Employment @relation(fields: [employmentId], references: [id])

  @@unique([tenantId, sourceSystem, externalEventId])
  @@index([tenantId, employmentId, eventTimestamp])
  @@map("attendance_events")
}

/// Interpreted work interval (spec section 20) — a paired IN/OUT (or a
/// flagged MISSING_CLOCK_OUT/DUPLICATE exception) derived from
/// AttendanceEvent, never mutating the raw events themselves.
model AttendanceInterval {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  employmentId  String    @map("employment_id")
  workDate      DateTime  @map("work_date") @db.Date // business date the interval is attributed to (spec section 17 anchor rule)
  startEventId  String?   @map("start_event_id")
  endEventId    String?   @map("end_event_id")
  startTime     DateTime? @map("start_time")
  endTime       DateTime? @map("end_time")
  durationMinutes Int?    @map("duration_minutes")
  status        String    @default("COMPLETE") // COMPLETE|MISSING_CLOCK_OUT|DUPLICATE|SCHEDULE_DEVIATION|REVIEWED
  reviewedBy    String?   @map("reviewed_by")
  reviewedAt    DateTime? @map("reviewed_at")

  createdAt DateTime @default(now()) @map("created_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  employment Employment @relation(fields: [employmentId], references: [id])

  @@index([tenantId, employmentId, workDate])
  @@map("attendance_intervals")
}

/// Normalized actual record (spec section 23) — the base+premium
/// classification model (spec section 47): `hours` is the BASE
/// REGULAR/OVERTIME classification; `nightHours`/`holidayHours`/
/// `weekendHours` are PREMIUM attributes describing the same hours from a
/// different angle, never additional hours on top (spec section 48 — "2h
/// overtime during night" stays 2h worked, not 4h).
model TimeEntry {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  employmentId     String   @map("employment_id")
  workDate         DateTime @map("work_date") @db.Date
  startTime        DateTime?
  endTime          DateTime?
  hours            Decimal  @db.Decimal(5, 2)
  timeCodeId       String   @map("time_code_id")
  nightHours       Decimal  @default(0) @map("night_hours") @db.Decimal(5, 2)
  holidayHours     Decimal  @default(0) @map("holiday_hours") @db.Decimal(5, 2)
  weekendHours     Decimal  @default(0) @map("weekend_hours") @db.Decimal(5, 2)
  source           String   @default("MANUAL") @map("source") // ATTENDANCE|MANUAL|LEAVE|ABSENCE|BUSINESS_TRIP|CORRECTION
  sourceDocumentType String? @map("source_document_type")
  sourceDocumentId String?  @map("source_document_id")
  status           String   @default("ACTIVE") // ACTIVE|SUPERSEDED|CANCELLED — superseded by a TimeCorrection, never physically overwritten (spec section 58)
  approvalStatus   String   @default("PENDING") @map("approval_status") // PENDING|APPROVED|REJECTED

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  employment Employment @relation(fields: [employmentId], references: [id])
  timeCode   TimeCode   @relation(fields: [timeCodeId], references: [id])

  @@index([tenantId, employmentId, workDate])
  @@map("time_entries")
}

model OvertimeRecord {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  employmentId   String   @map("employment_id")
  date           DateTime @db.Date
  requestedHours Decimal? @map("requested_hours") @db.Decimal(5, 2)
  approvedHours  Decimal? @map("approved_hours") @db.Decimal(5, 2)
  actualHours    Decimal? @map("actual_hours") @db.Decimal(5, 2)
  reason         String?
  approvedBy     String?  @map("approved_by")
  source         String   @default("MANUAL") @map("source")
  status         String   @default("REQUESTED") // REQUESTED|APPROVED|REJECTED|CANCELLED

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  employment Employment @relation(fields: [employmentId], references: [id])

  @@index([tenantId, employmentId, date])
  @@map("overtime_records")
}

/// Correction as a delta, never an in-place overwrite (spec section 58)
/// — `originalTimeEntryId` is marked SUPERSEDED and a fresh TimeEntry is
/// created; this row is the audit trail linking the two together with a
/// reason.
model TimeCorrection {
  id                  String   @id @default(uuid())
  tenantId            String   @map("tenant_id")
  employmentId        String   @map("employment_id")
  workDate            DateTime @map("work_date") @db.Date
  originalTimeEntryId String?  @map("original_time_entry_id")
  newTimeEntryId      String?  @map("new_time_entry_id")
  reason              String   // MISSING_PUNCH|WRONG_TIME_CODE|WRONG_SHIFT|APPROVED_OVERTIME_CORRECTION|LATE_LEAVE_ENTRY|PAYROLL_CORRECTION|DEVICE_FAILURE|OTHER
  comment             String?
  requiresRecalculation Boolean @default(false) @map("requires_recalculation") // spec section 59 WorkTimeRecalculationRequired flag
  status              String   @default("APPLIED") // APPLIED|PENDING_APPROVAL|REJECTED
  approvedBy          String?  @map("approved_by")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  employment Employment @relation(fields: [employmentId], references: [id])

  @@index([tenantId, employmentId, workDate])
  @@map("time_corrections")
}

model Timesheet {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  organizationId String    @map("organization_id")
  departmentId   String?   @map("department_id")
  periodStart    DateTime  @map("period_start") @db.Date
  periodEnd      DateTime  @map("period_end") @db.Date
  number         String?
  responsibleUserId String? @map("responsible_user_id")
  status         String    @default("DRAFT") // DRAFT|GENERATED|IN_PROGRESS|PENDING_APPROVAL|APPROVED|LOCKED|REOPENED|CANCELLED
  generatedAt    DateTime? @map("generated_at")
  submittedAt    DateTime? @map("submitted_at")
  approvedAt     DateTime? @map("approved_at")
  approvedBy     String?   @map("approved_by")
  lockedAt       DateTime? @map("locked_at")
  reopenedAt     DateTime? @map("reopened_at")
  reopenReason   String?   @map("reopen_reason")
  version        Int       @default(1)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  organization Organization      @relation(fields: [organizationId], references: [id])
  department   Department?       @relation(fields: [departmentId], references: [id])
  lines        TimesheetLine[]
  payrollTimeInputs PayrollTimeInput[]

  @@unique([tenantId, number])
  @@index([tenantId, organizationId, periodStart])
  @@map("timesheets")
}

/// THE central approved/normalized register per spec section 108
/// ("WorkTimeRegister") — this build does not keep a second, near-
/// identical table for it (disclosed simplification, see
/// docs/WORK_TIME.md): a `TimesheetLine` on a LOCKED `Timesheet` IS the
/// authoritative work-time register row for that employment/date.
model TimesheetLine {
  id                  String  @id @default(uuid())
  tenantId            String  @map("tenant_id")
  timesheetId         String  @map("timesheet_id")
  employmentId        String  @map("employment_id")
  workDate            DateTime @map("work_date") @db.Date
  departmentId        String?  @map("department_id") // the effective department AS OF workDate (spec section 69), not the timesheet's own header department
  plannedHours        Decimal @default(0) @map("planned_hours") @db.Decimal(5, 2)
  regularHours        Decimal @default(0) @map("regular_hours") @db.Decimal(5, 2)
  overtimeHours       Decimal @default(0) @map("overtime_hours") @db.Decimal(5, 2)
  nightHours          Decimal @default(0) @map("night_hours") @db.Decimal(5, 2)
  holidayHours        Decimal @default(0) @map("holiday_hours") @db.Decimal(5, 2)
  weekendHours        Decimal @default(0) @map("weekend_hours") @db.Decimal(5, 2)
  leaveHours          Decimal @default(0) @map("leave_hours") @db.Decimal(5, 2)
  absenceHours        Decimal @default(0) @map("absence_hours") @db.Decimal(5, 2)
  businessTripHours   Decimal @default(0) @map("business_trip_hours") @db.Decimal(5, 2)
  paidHours           Decimal @default(0) @map("paid_hours") @db.Decimal(5, 2)
  unpaidHours         Decimal @default(0) @map("unpaid_hours") @db.Decimal(5, 2)
  workedDayFraction   Decimal @default(0) @map("worked_day_fraction") @db.Decimal(4, 3)
  timeCodeSummary     String? @map("time_code_summary") // e.g. "REGULAR_WORK:8" — display/debug aid, never a calculation input
  validationStatus    String  @default("OK") @map("validation_status") // OK|EXCEPTION|UNEXPLAINED_DIFFERENCE|OVERLAP

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  timesheet  Timesheet  @relation(fields: [timesheetId], references: [id])
  employment Employment @relation(fields: [employmentId], references: [id])

  @@unique([timesheetId, employmentId, workDate])
  @@index([tenantId, employmentId, workDate])
  @@map("timesheet_lines")
}

/// The ONLY input Phase 19 Payroll may read (spec sections 54-56) — never
/// raw attendance, never an unlocked timesheet. Generated exclusively
/// from a LOCKED Timesheet's lines, aggregated by time-code/premium.
model PayrollTimeInput {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  organizationId String   @map("organization_id")
  employmentId   String   @map("employment_id")
  payrollPeriod  DateTime @map("payroll_period") @db.Date // first day of the period month
  timeCode       String   @map("time_code")
  premiumType    String?  @map("premium_type") // NIGHT|HOLIDAY|WEEKEND|null
  hours          Decimal  @default(0) @db.Decimal(7, 2)
  days           Decimal  @default(0) @db.Decimal(6, 2)
  sourceTimesheetId String @map("source_timesheet_id")
  calculationVersion Int   @default(1) @map("calculation_version")
  status         String   @default("DRAFT") // DRAFT|VALIDATED|APPROVED|LOCKED|REPLACED
  effectiveDate  DateTime @map("effective_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  employment   Employment   @relation(fields: [employmentId], references: [id])
  sourceTimesheet Timesheet @relation(fields: [sourceTimesheetId], references: [id])

  @@index([tenantId, organizationId, payrollPeriod, status])
  @@index([tenantId, employmentId, payrollPeriod])
  @@map("payroll_time_inputs")
}

model WorkTimePeriod {
  id                  String    @id @default(uuid())
  tenantId            String    @map("tenant_id")
  organizationId      String    @map("organization_id")
  periodStart         DateTime  @map("period_start") @db.Date
  periodEnd           DateTime  @map("period_end") @db.Date
  status              String    @default("OPEN") // OPEN|CALCULATING|APPROVED|LOCKED|REOPENED
  timesheetStatus     String    @default("DRAFT") @map("timesheet_status")
  payrollInputStatus  String    @default("DRAFT") @map("payroll_input_status")
  lockedAt            DateTime? @map("locked_at")
  reopenedAt          DateTime? @map("reopened_at")

  createdAt DateTime @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([tenantId, organizationId, periodStart])
  @@map("work_time_periods")
}

// ============================================================
// PHASE 19 — PAYROLL / GROSS-TO-NET ENGINE (docx spec Phase 19)
// See docs/PAYROLL.md for the disclosed-simplifications list. The core
// engine is jurisdiction-agnostic — every AZ-specific number (tax bands,
// contribution rates, overtime/night multipliers, the 30.4 leave-pay
// divisor) lives in `PayrollRateBracket` rows, seeded as data, never as a
// literal in a calculation service (spec sections 3, 27, 30, 37, 51, 131).
// ============================================================

model PayrollRateBracket {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  bracketType    String    @map("bracket_type") // INCOME_TAX|SOCIAL_INSURANCE|UNEMPLOYMENT_INSURANCE|MEDICAL_INSURANCE|OVERTIME_MULTIPLIER|NIGHT_PREMIUM|HOLIDAY_PREMIUM|DEDUCTION_CAP|AVERAGE_PAY_DIVISOR|MINIMUM_WAGE
  payerType      String?   @map("payer_type") // EMPLOYEE|EMPLOYER — null for brackets with no payer split (e.g. AVERAGE_PAY_DIVISOR)
  regime         String    @default("DEFAULT") // e.g. NON_OIL_PRIVATE — lets several regimes coexist per bracketType
  sequence       Int       @default(1) // ordering within a progressive band set
  thresholdFrom  Decimal   @default(0) @map("threshold_from") @db.Decimal(14, 2)
  thresholdTo    Decimal?  @map("threshold_to") @db.Decimal(14, 2)
  fixedComponent Decimal   @default(0) @map("fixed_component") @db.Decimal(14, 4)
  percentage     Decimal   @default(0) @db.Decimal(7, 4) // e.g. 0.1000 = 10%
  flatValue      Decimal?  @map("flat_value") @db.Decimal(14, 4) // for non-percentage brackets (e.g. AVERAGE_PAY_DIVISOR = 30.4, OVERTIME_MULTIPLIER = 2)
  legalReference String?   @map("legal_reference")
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date
  status         String    @default("ACTIVE") // DRAFT|ACTIVE|SUPERSEDED

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, bracketType, regime, effectiveFrom])
  @@map("payroll_rate_brackets")
}

model PayrollEarningDefinition {
  id             String  @id @default(uuid())
  tenantId       String  @map("tenant_id")
  code           String  // BASE_SALARY|HOURLY_PAY|OVERTIME_PAY|NIGHT_PREMIUM|HOLIDAY_PREMIUM|WEEKEND_PREMIUM|BONUS|COMMISSION|ALLOWANCE|LEAVE_PAY|SICK_PAY|BUSINESS_TRIP_PAY|DOWNTIME_PAY|SEVERANCE|UNUSED_LEAVE_COMPENSATION|OTHER
  name           String
  calculationStrategy String @default("MANUAL") @map("calculation_strategy") // MONTHLY_SALARY|HOURLY|OVERTIME|NIGHT_PREMIUM|HOLIDAY_PREMIUM|LEAVE_AVERAGE_PAY|BONUS|MANUAL
  taxableIncome  Boolean @default(true) @map("taxable_income")
  socialInsuranceBase Boolean @default(true) @map("social_insurance_base")
  unemploymentBase Boolean @default(true) @map("unemployment_base")
  medicalInsuranceBase Boolean @default(true) @map("medical_insurance_base")
  averageEarningsInclusion Boolean @default(true) @map("average_earnings_inclusion")
  grossPayInclusion Boolean @default(true) @map("gross_pay_inclusion")
  employerCostInclusion Boolean @default(false) @map("employer_cost_inclusion") // true only for employer-side items (contributions handled separately; reserved for e.g. employer-paid benefits)
  accountingMappingProfile String? @map("accounting_mapping_profile")
  benefitPayer   String  @default("EMPLOYER") @map("benefit_payer") // EMPLOYER|SOCIAL_INSURANCE_FUND|GOVERNMENT|OTHER
  defaultMultiplier Decimal? @map("default_multiplier") @db.Decimal(6, 3) // contract multiplier for OVERTIME_PAY/HOLIDAY_PREMIUM strategies — effective multiplier = max(statutory bracket, this)
  priority       Int     @default(100)
  active         Boolean @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
  @@map("payroll_earning_definitions")
}

model PayrollDeductionDefinition {
  id             String  @id @default(uuid())
  tenantId       String  @map("tenant_id")
  code           String  // INCOME_TAX|EMPLOYEE_SOCIAL_INSURANCE|EMPLOYEE_UNEMPLOYMENT_INSURANCE|EMPLOYEE_MEDICAL_INSURANCE|ALIMONY|EXECUTION_ORDER|UNION_DUES|EMPLOYEE_LOAN|EMPLOYEE_ADVANCE_RECOVERY|DAMAGE_RECOVERY|VOLUNTARY_DEDUCTION|OTHER
  name           String
  isStatutory    Boolean @default(false) @map("is_statutory")
  preTax         Boolean @default(false) @map("pre_tax")
  calculationOrder Int   @default(100) @map("calculation_order") // spec section 62's statutory withholding order — lower runs first
  calculationMethod String @default("FIXED") @map("calculation_method") // PERCENTAGE|FIXED|FORMULA|BRACKET
  percentage     Decimal? @db.Decimal(7, 4)
  fixedAmount    Decimal? @map("fixed_amount") @db.Decimal(14, 2)
  capAmount      Decimal? @map("cap_amount") @db.Decimal(14, 2)
  floorAmount    Decimal? @map("floor_amount") @db.Decimal(14, 2)
  consentRequired Boolean @default(false) @map("consent_required")
  accountingMappingProfile String? @map("accounting_mapping_profile")
  active         Boolean @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
  @@map("payroll_deduction_definitions")
}

/// Effective-dated (spec sections 9-12) — a salary change NEVER overwrites
/// the prior row; it closes `effectiveTo` and inserts a new one.
model EmployeeCompensationAssignment {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  employmentId   String    @map("employment_id")
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date
  compensationType String  @default("REGULAR") @map("compensation_type") // REGULAR|ACTING|TEMPORARY
  payBasis       String    @map("pay_basis") // MONTHLY_SALARY|HOURLY|DAILY|PIECE_RATE|FIXED_PERIOD_AMOUNT
  baseSalary     Decimal?  @map("base_salary") @db.Decimal(14, 2)
  hourlyRate     Decimal?  @map("hourly_rate") @db.Decimal(14, 4)
  dailyRate      Decimal?  @map("daily_rate") @db.Decimal(14, 4)
  currencyId     String    @map("currency_id")
  fteBasis       String    @default("ACTUAL_ASSIGNED_SALARY") @map("fte_basis") // FULL_FTE_RATE|ACTUAL_ASSIGNED_SALARY — spec section 25
  salaryGrade    String?   @map("salary_grade")
  normBasis      String    @default("WORKING_DAYS") @map("norm_basis") // WORKING_DAYS|WORKING_HOURS|CALENDAR_DAYS|FIXED_RULE — spec section 22
  sourceDocumentType String? @map("source_document_type")
  sourceDocumentId String? @map("source_document_id")
  status         String    @default("ACTIVE") // ACTIVE|SUPERSEDED|CANCELLED

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  employment Employment @relation(fields: [employmentId], references: [id])
  currency   Currency   @relation(fields: [currencyId], references: [id])

  @@index([tenantId, employmentId, effectiveFrom])
  @@map("payroll_compensation_assignments")
}

/// Effective-dated (spec section 48). `mainWorkplace` is itself
/// effective-dated (spec section 88), never a plain boolean on Employee.
model EmployeeTaxProfile {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  employmentId   String    @map("employment_id")
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date
  taxResidency   String    @default("RESIDENT") @map("tax_residency") // RESIDENT|NON_RESIDENT
  mainWorkplace  Boolean   @default(true) @map("main_workplace")
  sectorCategory String    @default("NON_OIL_PRIVATE") @map("sector_category") // resolves which PayrollRateBracket.regime applies
  taxRegime      String    @default("DEFAULT") @map("tax_regime")
  exemptionAmount Decimal  @default(0) @map("exemption_amount") @db.Decimal(14, 2) // flat monthly exemption — disclosed simplification for spec's full PayrollTaxRelief combinability engine, see docs/PAYROLL.md
  exemptionCodes String?   @map("exemption_codes") // comma-separated reference codes, informational
  supportingDocumentAssetId String? @map("supporting_document_asset_id")
  status         String    @default("ACTIVE") // ACTIVE|SUPERSEDED

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  employment Employment @relation(fields: [employmentId], references: [id])

  @@index([tenantId, employmentId, effectiveFrom])
  @@map("payroll_employee_tax_profiles")
}

/// Bonus/allowance/manual input (spec sections 32-33). Each row carries
/// its own taxable/social/unemployment/medical/average-pay flags —
/// defaulted from its `PayrollEarningDefinition` but overridable per row
/// for a one-off exception.
model PayrollVariableInput {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  employmentId   String   @map("employment_id")
  earningCode    String   @map("earning_code")
  payrollPeriod  DateTime @map("payroll_period") @db.Date
  amount         Decimal? @db.Decimal(14, 2)
  percentage     Decimal? @db.Decimal(7, 4) // percentage-of-base bonus models
  quantity       Decimal? @db.Decimal(10, 2)
  sourceDocumentType String? @map("source_document_type")
  sourceDocumentId String? @map("source_document_id")
  approvedBy     String?  @map("approved_by")
  status         String   @default("APPROVED") // PENDING|APPROVED|REJECTED
  effectiveDate  DateTime @map("effective_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  employment Employment @relation(fields: [employmentId], references: [id])

  @@index([tenantId, employmentId, payrollPeriod])
  @@map("payroll_variable_inputs")
}

/// Alimony/execution-document deductions (spec sections 65-66). Never a
/// blind gross×%; `calculationMethod` + `capAmount` +
/// `protectedMinimum` implement the statutory-limit shape (spec
/// section 64) without hardcoding a percentage in code.
model PayrollExecutionOrder {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  employmentId   String    @map("employment_id")
  orderType      String    @map("order_type") // ALIMONY|EXECUTION_ORDER|OTHER
  creditor       String
  courtReference String?   @map("court_reference")
  calculationMethod String @default("PERCENTAGE") @map("calculation_method") // PERCENTAGE|FIXED
  percentage     Decimal?  @db.Decimal(7, 4)
  fixedAmount    Decimal?  @map("fixed_amount") @db.Decimal(14, 2)
  priority       Int       @default(100)
  capAmount      Decimal?  @map("cap_amount") @db.Decimal(14, 2)
  protectedMinimum Decimal? @map("protected_minimum") @db.Decimal(14, 2) // net pay floor this order may not go below
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date
  status         String    @default("ACTIVE") // ACTIVE|ENDED|SUSPENDED

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  employment Employment @relation(fields: [employmentId], references: [id])

  @@index([tenantId, employmentId, status])
  @@map("payroll_execution_orders")
}

/// Deduction arrears carried forward, never silently lost (spec section 130).
model DeductionCarryForwardBalance {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  employmentId   String   @map("employment_id")
  deductionCode  String   @map("deduction_code")
  sourceExecutionOrderId String? @map("source_execution_order_id")
  originPeriod   DateTime @map("origin_period") @db.Date
  amount         Decimal  @db.Decimal(14, 2)
  resolvedAmount Decimal  @default(0) @map("resolved_amount") @db.Decimal(14, 2)
  status         String   @default("OUTSTANDING") // OUTSTANDING|PARTIALLY_RESOLVED|RESOLVED

  createdAt DateTime @default(now()) @map("created_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  employment Employment @relation(fields: [employmentId], references: [id])

  @@index([tenantId, employmentId, status])
  @@map("payroll_deduction_carry_forward_balances")
}

/// Traceable leave/sick average-pay computation (spec sections 35-39).
model AverageEarningsBase {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  employmentId      String   @map("employment_id")
  calculationType   String   @map("calculation_type") // LEAVE_PAY|UNUSED_LEAVE_COMPENSATION|SICK_PAY|TERMINATION_SETTLEMENT
  referencePeriodStart DateTime @map("reference_period_start") @db.Date
  referencePeriodEnd   DateTime @map("reference_period_end") @db.Date
  includedMonths    Int      @map("included_months")
  totalIncludedEarnings Decimal @map("total_included_earnings") @db.Decimal(14, 2)
  divisor           Decimal  @map("divisor") @db.Decimal(8, 4) // e.g. 30.4 — read from a PayrollRateBracket, never hardcoded
  averageDaily      Decimal  @map("average_daily") @db.Decimal(14, 4)
  averageMonthly    Decimal  @map("average_monthly") @db.Decimal(14, 4)
  paidDays          Decimal  @map("paid_days") @db.Decimal(6, 2)
  resultAmount      Decimal  @map("result_amount") @db.Decimal(14, 2)
  traceDetail       String?  @map("trace_detail") // JSON: per-month included/excluded earnings breakdown (spec section 39)
  sourceDocumentType String? @map("source_document_type")
  sourceDocumentId  String?  @map("source_document_id")

  createdAt DateTime @default(now()) @map("created_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  employment Employment @relation(fields: [employmentId], references: [id])

  @@index([tenantId, employmentId, calculationType])
  @@map("payroll_average_earnings_bases")
}

model PayrollPeriod {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  organizationId String    @map("organization_id")
  periodType     String    @default("MONTHLY") @map("period_type")
  year           Int
  month          Int
  periodStart    DateTime  @map("period_start") @db.Date
  periodEnd      DateTime  @map("period_end") @db.Date
  paymentDate    DateTime? @map("payment_date") @db.Date
  workTimePeriodId String? @map("work_time_period_id")
  status         String    @default("OPEN") // OPEN|INPUT_COLLECTION|READY_TO_CALCULATE|CALCULATING|CALCULATED|REVIEW|APPROVED|POSTED|PAYMENT_READY|PARTIALLY_PAID|PAID|CLOSED|REOPENED|ERROR
  calculationVersion Int   @default(0) @map("calculation_version")
  openedAt       DateTime  @default(now()) @map("opened_at")
  calculatedAt   DateTime? @map("calculated_at")
  approvedAt     DateTime? @map("approved_at")
  approvedBy     String?   @map("approved_by")
  postedAt       DateTime? @map("posted_at")
  closedAt       DateTime? @map("closed_at")
  reopenedAt     DateTime? @map("reopened_at")
  reopenReason   String?   @map("reopen_reason")

  tenant       Tenant                @relation(fields: [tenantId], references: [id])
  organization Organization          @relation(fields: [organizationId], references: [id])
  runs         PayrollCalculationRun[]
  results      PayrollCalculationResult[]
  liabilities  PayrollLiability[]

  @@unique([tenantId, organizationId, year, month, periodType])
  @@map("payroll_periods")
}

model PayrollCalculationRun {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  organizationId String    @map("organization_id")
  payrollPeriodId String   @map("payroll_period_id")
  runType        String    @default("REGULAR") // PREVIEW|REGULAR|RECALCULATION|RETROACTIVE|TERMINATION|OFF_CYCLE|FINAL
  version        Int       @default(1)
  status         String    @default("CALCULATING") // CALCULATING|CALCULATED|ERROR|POSTED
  startedAt      DateTime  @default(now()) @map("started_at")
  completedAt    DateTime? @map("completed_at")
  initiatedBy    String?   @map("initiated_by")
  employeesProcessed Int   @default(0) @map("employees_processed")
  employeesFailed Int      @default(0) @map("employees_failed")
  totalGross     Decimal   @default(0) @map("total_gross") @db.Decimal(16, 2)
  totalNet       Decimal   @default(0) @map("total_net") @db.Decimal(16, 2)
  totalTaxes     Decimal   @default(0) @map("total_taxes") @db.Decimal(16, 2)
  totalEmployerCost Decimal @default(0) @map("total_employer_cost") @db.Decimal(16, 2)
  postingBatchId String?   @map("posting_batch_id")

  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  organization Organization     @relation(fields: [organizationId], references: [id])
  period       PayrollPeriod    @relation(fields: [payrollPeriodId], references: [id])
  results      PayrollCalculationResult[]
  errors       PayrollCalculationError[]

  @@index([tenantId, organizationId, payrollPeriodId, runType])
  @@map("payroll_calculation_runs")
}

model PayrollCalculationResult {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  organizationId String   @map("organization_id")
  employmentId   String   @map("employment_id")
  payrollPeriodId String  @map("payroll_period_id")
  calculationRunId String @map("calculation_run_id")
  version        Int      @default(1)
  currencyId     String   @map("currency_id")
  gross          Decimal  @default(0) @db.Decimal(14, 2)
  taxableIncome  Decimal  @default(0) @map("taxable_income") @db.Decimal(14, 2)
  employeeDeductions Decimal @default(0) @map("employee_deductions") @db.Decimal(14, 2)
  net            Decimal  @default(0) @db.Decimal(14, 2)
  employerContributions Decimal @default(0) @map("employer_contributions") @db.Decimal(14, 2)
  employerTotalCost Decimal @default(0) @map("employer_total_cost") @db.Decimal(14, 2)
  status         String   @default("CALCULATED") // CALCULATED|ERROR|SUPERSEDED|POSTED
  supersedesResultId String? @map("supersedes_result_id") // retro versioning (spec section 91) — the prior version, never deleted

  createdAt DateTime @default(now()) @map("created_at")

  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  organization Organization   @relation(fields: [organizationId], references: [id])
  employment Employment       @relation(fields: [employmentId], references: [id])
  period     PayrollPeriod    @relation(fields: [payrollPeriodId], references: [id])
  run        PayrollCalculationRun @relation(fields: [calculationRunId], references: [id])
  lines      PayrollResultLine[]

  @@unique([employmentId, payrollPeriodId, version])
  @@index([tenantId, organizationId, payrollPeriodId])
  @@map("payroll_calculation_results")
}

model PayrollResultLine {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  resultId       String   @map("result_id")
  calculationCode String  @map("calculation_code") // earning/deduction/contribution code
  lineType       String   @map("line_type") // EARNING|DEDUCTION|EMPLOYER_CONTRIBUTION
  quantity       Decimal? @db.Decimal(10, 2)
  rate           Decimal? @db.Decimal(14, 4)
  baseAmount     Decimal? @map("base_amount") @db.Decimal(14, 2)
  multiplier     Decimal? @db.Decimal(6, 3)
  amount         Decimal  @db.Decimal(14, 2)
  taxable        Boolean  @default(false)
  socialBase     Boolean  @default(false) @map("social_base")
  unemploymentBase Boolean @default(false) @map("unemployment_base")
  medicalBase    Boolean  @default(false) @map("medical_base")
  sourceInput    String?  @map("source_input") // e.g. "PayrollTimeInput:OVERTIME" — traceability (spec section 78-79)
  sourceRule     String?  @map("source_rule") // e.g. legalReference of the bracket applied
  calculationSequence Int @default(0) @map("calculation_sequence")
  explanation    String?  // human-readable formula trace (spec section 78)

  tenant Tenant                   @relation(fields: [tenantId], references: [id])
  result PayrollCalculationResult @relation(fields: [resultId], references: [id])

  @@index([resultId])
  @@map("payroll_result_lines")
}

model PayrollCalculationError {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  calculationRunId String @map("calculation_run_id")
  employmentId   String?  @map("employment_id")
  calculationCode String? @map("calculation_code")
  errorCode      String   @map("error_code") // MISSING_COMPENSATION|MISSING_TIME_INPUT|MISSING_TAX_PROFILE|INVALID_EXEMPTION|MISSING_LEGAL_RULE|CALCULATION_DEPENDENCY_CYCLE|CONTRIBUTION_BASE_NEGATIVE|DEDUCTION_LIMIT_EXCEEDED|NEGATIVE_NET_PAY|MISSING_ACCOUNT_MAPPING|RETRO_DEPENDENCY_UNRESOLVED
  message        String
  severity       String   @default("ERROR") // INFO|WARNING|ERROR|BLOCKING
  blocking       Boolean  @default(true)
  resolved       Boolean  @default(false)

  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant                @relation(fields: [tenantId], references: [id])
  run    PayrollCalculationRun @relation(fields: [calculationRunId], references: [id])

  @@index([tenantId, calculationRunId, resolved])
  @@map("payroll_calculation_errors")
}

model PayrollRecalculationRequest {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  employmentId   String    @map("employment_id")
  earliestAffectedPeriod DateTime @map("earliest_affected_period") @db.Date
  reason         String    // SALARY_CHANGE|TIME_CORRECTION|LEAVE_CORRECTION|TAX_PROFILE_CHANGE|LEGAL_RULE_CORRECTION|HR_ASSIGNMENT_CORRECTION|MANUAL_ADJUSTMENT
  sourceDocumentType String? @map("source_document_type")
  sourceDocumentId String?  @map("source_document_id")
  status         String    @default("PENDING") // PENDING|IN_PROGRESS|RESOLVED|CANCELLED

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  employment Employment @relation(fields: [employmentId], references: [id])

  @@index([tenantId, employmentId, status])
  @@map("payroll_recalculation_requests")
}

/// Central subledger (spec sections 99-103) — GL posting and payment
/// allocation both reference this, never a bare "employee.salary - tax"
/// number.
model PayrollLiability {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  organizationId String    @map("organization_id")
  employmentId   String?   @map("employment_id") // null for a pooled statutory liability not tracked per-employee
  liabilityType  String    @map("liability_type") // EMPLOYEE_NET_PAY|INCOME_TAX_PAYABLE|SOCIAL_INSURANCE_PAYABLE|UNEMPLOYMENT_INSURANCE_PAYABLE|MEDICAL_INSURANCE_PAYABLE|ALIMONY_PAYABLE|UNION_DUES_PAYABLE|OTHER_DEDUCTION_PAYABLE
  creditor       String?   // for ALIMONY_PAYABLE/OTHER_DEDUCTION_PAYABLE — the named creditor
  currencyId     String    @map("currency_id")
  payrollPeriodId String   @map("payroll_period_id")
  sourceResultId String?   @map("source_result_id")
  dueDate        DateTime? @map("due_date") @db.Date
  accrued        Decimal   @default(0) @db.Decimal(14, 2)
  paid           Decimal   @default(0) @db.Decimal(14, 2)
  adjusted       Decimal   @default(0) @db.Decimal(14, 2)
  outstanding    Decimal   @default(0) @db.Decimal(14, 2)
  status         String    @default("OPEN") // OPEN|PARTIALLY_PAID|PAID|WRITTEN_OFF

  createdAt DateTime @default(now()) @map("created_at")

  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  organization Organization       @relation(fields: [organizationId], references: [id])
  employment   Employment?        @relation(fields: [employmentId], references: [id])
  period       PayrollPeriod      @relation(fields: [payrollPeriodId], references: [id])
  allocations  PayrollPaymentAllocation[]

  @@index([tenantId, organizationId, payrollPeriodId, liabilityType])
  @@index([tenantId, employmentId, status])
  @@map("payroll_liabilities")
}

/// Links an ACTUAL payment (a Phase 13/14/15 SettlementPayment — spec
/// sections 105-107, never a duplicate bank/cash engine) to the payroll
/// liability(ies) it settles.
model PayrollPaymentAllocation {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  liabilityId    String   @map("liability_id")
  paymentDocumentType String @map("payment_document_type")
  paymentDocumentId String @map("payment_document_id")
  amount         Decimal  @db.Decimal(14, 2)
  allocationDate DateTime @map("allocation_date") @db.Date
  status         String   @default("ACTIVE") // ACTIVE|REVERSED

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant    Tenant           @relation(fields: [tenantId], references: [id])
  liability PayrollLiability @relation(fields: [liabilityId], references: [id])

  @@index([tenantId, liabilityId])
  @@map("payroll_payment_allocations")
}

// ============================================================
// PHASE 20 — EXPENSES / COST CENTERS / EMPLOYEE EXPENSES (docx spec Phase 20)
// See docs/EXPENSES.md for the disclosed-simplifications list. Employee
// advance/settlement reuses Phase 15's own AccountablePersonMovement and
// Phase 13/14/15's own SettlementPayment — never a duplicate ledger
// (spec sections 21, 26-28).
// ============================================================

model ExpenseCategory {
  id             String  @id @default(uuid())
  tenantId       String  @map("tenant_id")
  organizationId String  @map("organization_id")
  code           String
  name           String
  accountingMappingProfile String? @map("accounting_mapping_profile") // AccountingMappingService key — falls back to OTHER_OPERATING_EXPENSE if unset
  vatTreatmentProfile String? @map("vat_treatment_profile") // Phase 5 Tax Engine profile code — never a hardcoded VAT rate here
  receiptRequirement String @default("REQUIRED_ABOVE_THRESHOLD") @map("receipt_requirement") // REQUIRED|OPTIONAL|NOT_REQUIRED|REQUIRED_ABOVE_THRESHOLD
  receiptThreshold Decimal? @map("receipt_threshold") @db.Decimal(14, 2)
  businessPurposeRequired Boolean @default(false) @map("business_purpose_required")
  allowedPaymentMethods String? @map("allowed_payment_methods") // comma-separated PaymentSourceType values, null = all allowed
  prepaidEligible Boolean @default(false) @map("prepaid_eligible")
  capitalizableEligible Boolean @default(false) @map("capitalizable_eligible")
  fixedAssetEligible Boolean @default(false) @map("fixed_asset_eligible")
  inventoryCostEligible Boolean @default(false) @map("inventory_cost_eligible")
  allocationRequired Boolean @default(false) @map("allocation_required")
  perTransactionLimit Decimal? @map("per_transaction_limit") @db.Decimal(14, 2) // spec section 10's own policy-rule shape, kept minimal — see docs/EXPENSES.md
  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  claimLines   ExpenseClaimLine[]
  prepaidExpenses PrepaidExpense[]

  @@unique([organizationId, code])
  @@map("expense_categories")
}

/// Financial responsibility/expense-collection dimension — deliberately
/// NOT the same concept as Department (spec sections 4-5): one department
/// can contain several cost centers.
model CostCenter {
  id                  String    @id @default(uuid())
  tenantId            String    @map("tenant_id")
  organizationId      String    @map("organization_id")
  code                String
  name                String
  parentCostCenterId  String?   @map("parent_cost_center_id")
  departmentId        String?   @map("department_id")
  responsiblePersonId String?   @map("responsible_person_id")
  effectiveFrom       DateTime  @default(now()) @map("effective_from") @db.Date
  effectiveTo         DateTime? @map("effective_to") @db.Date
  active              Boolean   @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  organization Organization       @relation(fields: [organizationId], references: [id])
  department   Department?        @relation(fields: [departmentId], references: [id])
  responsible  ResponsiblePerson? @relation(fields: [responsiblePersonId], references: [id])
  parent       CostCenter?        @relation("CostCenterHierarchy", fields: [parentCostCenterId], references: [id])
  children     CostCenter[]       @relation("CostCenterHierarchy")

  claimLines        ExpenseClaimLine[]
  driverValues      AllocationDriverValue[]
  allocationsAsSource AllocationRule[]        @relation("AllocationRuleSource")
  budgets           ExpenseBudget[]

  @@unique([organizationId, code])
  @@map("cost_centers")
}

model ExpenseClaim {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  organizationId String    @map("organization_id")
  documentType   String    @default("EXPENSE_CLAIM") @map("document_type")
  number         String?
  documentDate   DateTime  @map("document_date") @db.Date
  postingDate    DateTime? @map("posting_date") @db.Date

  employeeId     String    @map("employee_id")
  employmentId   String    @map("employment_id")
  expensePeriodStart DateTime @map("expense_period_start") @db.Date
  expensePeriodEnd   DateTime @map("expense_period_end") @db.Date
  currencyId     String    @map("currency_id")
  totalClaimedAmount Decimal @default(0) @map("total_claimed_amount") @db.Decimal(14, 2)
  totalApprovedAmount Decimal @default(0) @map("total_approved_amount") @db.Decimal(14, 2)
  advanceAmount  Decimal   @default(0) @map("advance_amount") @db.Decimal(14, 2)
  reimbursementDue Decimal @default(0) @map("reimbursement_due") @db.Decimal(14, 2)
  employeeDebtDue  Decimal @default(0) @map("employee_debt_due") @db.Decimal(14, 2)
  approvalStatus String    @default("PENDING") @map("approval_status") // PENDING|PARTIALLY_APPROVED|APPROVED|REJECTED
  responsibleManagerId String? @map("responsible_manager_id")
  comment        String?

  status        DocumentStatus @default(DRAFT)
  postingStatus PostingStatus  @default(NOT_POSTED) @map("posting_status")

  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by")
  postedAt     DateTime? @map("posted_at")
  postedBy     String?   @map("posted_by")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelledBy  String?   @map("cancelled_by")
  deletionMark Boolean   @default(false) @map("deletion_mark")
  version      Int       @default(1)

  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  organization Organization       @relation(fields: [organizationId], references: [id])
  employment   Employment         @relation(fields: [employmentId], references: [id])
  lines        ExpenseClaimLine[]

  @@unique([tenantId, number])
  @@map("expense_claims")
}

model ExpenseClaimLine {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  claimId        String   @map("claim_id")
  expenseDate    DateTime @map("expense_date") @db.Date
  expenseCategoryId String @map("expense_category_id")
  merchant       String?
  supplierTaxId  String?  @map("supplier_tax_id")
  description    String?
  businessPurpose String? @map("business_purpose")
  transactionCurrencyId String @map("transaction_currency_id")
  transactionAmount Decimal @map("transaction_amount") @db.Decimal(14, 2)
  exchangeRate   Decimal? @map("exchange_rate") @db.Decimal(18, 8)
  baseAmount     Decimal  @map("base_amount") @db.Decimal(14, 2)
  taxAmount      Decimal  @default(0) @map("tax_amount") @db.Decimal(14, 2)
  recoverableVat Decimal  @default(0) @map("recoverable_vat") @db.Decimal(14, 2)
  nonrecoverableVat Decimal @default(0) @map("nonrecoverable_vat") @db.Decimal(14, 2)
  approvedAmount Decimal? @map("approved_amount") @db.Decimal(14, 2)
  paymentSourceType String @map("payment_source_type") // EMPLOYEE_PERSONAL_FUNDS|EMPLOYEE_ADVANCE|CASH_DESK|BANK|CORPORATE_CARD|SUPPLIER_PAYABLE|OTHER
  costCenterId   String?  @map("cost_center_id")
  projectId      String?  @map("project_id")
  departmentId   String?  @map("department_id")
  allocationRuleId String? @map("allocation_rule_id")
  sourceDocumentType String? @map("source_document_type")
  sourceDocumentId String? @map("source_document_id")
  classification String   @default("CURRENT_EXPENSE") @map("classification") // CURRENT_EXPENSE|PREPAID_EXPENSE|INVENTORY_COST|FIXED_ASSET|CIP|EMPLOYEE_RECEIVABLE|SUPPLIER_SETTLEMENT|NONDEDUCTIBLE_EXPENSE|OTHER
  prepaidCandidate Boolean @default(false) @map("prepaid_candidate")
  capitalizableCandidate Boolean @default(false) @map("capitalizable_candidate")
  policyStatus   String   @default("OK") @map("policy_status") // OK|EXCEEDS_LIMIT|MISSING_RECEIPT|MISSING_BUSINESS_PURPOSE|EXCEPTION_APPROVED
  taxStatus      String   @default("NOT_APPLICABLE") @map("tax_status") // VALID|MISSING|INVALID|DUPLICATE|REVIEW_REQUIRED|NOT_APPLICABLE
  rejectionReason String? @map("rejection_reason")

  createdAt DateTime @default(now()) @map("created_at")

  tenant   Tenant           @relation(fields: [tenantId], references: [id])
  claim    ExpenseClaim     @relation(fields: [claimId], references: [id])
  category ExpenseCategory  @relation(fields: [expenseCategoryId], references: [id])
  costCenter CostCenter?    @relation(fields: [costCenterId], references: [id])

  receipts    ExpenseReceipt[]
  allocations ExpenseAllocation[]
  prepaidExpense PrepaidExpense?

  @@index([tenantId, claimId])
  @@map("expense_claim_lines")
}

model ExpenseReceipt {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  claimLineId    String   @map("claim_line_id")
  assetId        String?  @map("asset_id") // uploaded file reference
  documentType   String   @map("document_type") // FISCAL_RECEIPT|INVOICE|E_INVOICE|TICKET|HOTEL_INVOICE|BOARDING_PASS|CONTRACT|PAYMENT_CONFIRMATION|OTHER
  documentNumber String?  @map("document_number")
  supplier       String?
  supplierTaxId  String?  @map("supplier_tax_id")
  documentDate   DateTime? @map("document_date") @db.Date
  amount         Decimal? @db.Decimal(14, 2)
  currencyId     String?  @map("currency_id")
  attachmentHash String?  @map("attachment_hash") // spec section 18 duplicate-detection signal
  validationStatus String @default("PENDING") @map("validation_status") // PENDING|VALID|INVALID|DUPLICATE_SUSPECTED
  uploadedBy     String?  @map("uploaded_by")
  uploadedAt     DateTime @default(now()) @map("uploaded_at")

  tenant Tenant           @relation(fields: [tenantId], references: [id])
  line   ExpenseClaimLine @relation(fields: [claimLineId], references: [id])

  @@index([tenantId, claimLineId])
  @@index([tenantId, supplier, documentNumber, amount])
  @@map("expense_receipts")
}

/// One claim line split across multiple cost objects (spec sections
/// 54-56) — `targetType`/`targetId` is a soft polymorphic reference
/// (COST_CENTER|DEPARTMENT|PROJECT|BRANCH|PRODUCT|CAMPAIGN|FIXED_ASSET|
/// OTHER), consistent with this codebase's established soft-reference
/// convention rather than a separate generic `CostObject` master table
/// (disclosed simplification, see docs/EXPENSES.md).
model ExpenseAllocation {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  claimLineId    String   @map("claim_line_id")
  targetType     String   @map("target_type")
  targetId       String   @map("target_id")
  allocationMethod String @default("MANUAL_PERCENTAGE") @map("allocation_method") // MANUAL_PERCENTAGE|DRIVER_BASED|FIXED_WEIGHT
  allocationPercentage Decimal? @map("allocation_percentage") @db.Decimal(7, 4)
  allocationQuantity Decimal? @map("allocation_quantity") @db.Decimal(14, 4)
  allocatedAmount Decimal  @map("allocated_amount") @db.Decimal(14, 2)
  effectivePeriod DateTime @map("effective_period") @db.Date
  sourceDriverId String?  @map("source_driver_id")
  status         String   @default("ACTIVE") // ACTIVE|REVERSED

  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant           @relation(fields: [tenantId], references: [id])
  line   ExpenseClaimLine @relation(fields: [claimLineId], references: [id])

  @@index([tenantId, claimLineId])
  @@map("expense_allocations")
}

model AllocationDriver {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  code     String // HEADCOUNT|FTE|AREA_SQM|REVENUE|WORKED_HOURS|DIRECT_LABOR_HOURS|MACHINE_HOURS|SALES_VOLUME|MANUAL_PERCENTAGE|FIXED_WEIGHT
  name     String
  sourceType String @default("MANUAL") @map("source_type") // MANUAL|HR_HEADCOUNT|HR_FTE|WORK_TIME_HOURS|MANUAL_MASTER
  active   Boolean @default(true)

  tenant Tenant                  @relation(fields: [tenantId], references: [id])
  values AllocationDriverValue[]
  rules  AllocationRule[]

  @@unique([tenantId, code])
  @@map("allocation_drivers")
}

model AllocationDriverValue {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  driverId     String   @map("driver_id")
  period       DateTime @db.Date
  costCenterId String   @map("cost_center_id")
  value        Decimal  @db.Decimal(18, 4)
  source       String   @default("MANUAL") // MANUAL|COMPUTED
  status       String   @default("ACTIVE") // ACTIVE|SUPERSEDED

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  driver     AllocationDriver @relation(fields: [driverId], references: [id])
  costCenter CostCenter @relation(fields: [costCenterId], references: [id])

  @@unique([driverId, period, costCenterId])
  @@map("allocation_driver_values")
}

model AllocationRule {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  organizationId String    @map("organization_id")
  code           String
  name           String
  sourceCostCenterId String @map("source_cost_center_id")
  expenseCategoryFilter String? @map("expense_category_filter") // comma-separated ExpenseCategory codes, null = all
  allocationType String    @default("DRIVER_BASED") @map("allocation_type") // DIRECT|STEP_DOWN|RECIPROCAL_FUTURE|MANUAL|DRIVER_BASED
  driverId       String?   @map("driver_id")
  targetCostCenterIds String @map("target_cost_center_ids") // comma-separated CostCenter ids
  allocationFrequency String @default("MONTHLY") @map("allocation_frequency")
  roundingRule   String    @default("LAST_LINE_ABSORBS") @map("rounding_rule") // spec section 56 — no unexplained residual
  sequence       Int       @default(1) // step-down ordering (spec section 73)
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date
  status         String    @default("ACTIVE") // ACTIVE|INACTIVE

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant           Tenant           @relation(fields: [tenantId], references: [id])
  organization     Organization     @relation(fields: [organizationId], references: [id])
  sourceCostCenter CostCenter       @relation("AllocationRuleSource", fields: [sourceCostCenterId], references: [id])
  driver           AllocationDriver? @relation(fields: [driverId], references: [id])
  runs             CostAllocationRun[]

  @@unique([tenantId, code])
  @@map("allocation_rules")
}

model CostAllocationRun {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  organizationId String    @map("organization_id")
  ruleId         String    @map("rule_id")
  period         DateTime  @db.Date
  status         String    @default("PREVIEW") // PREVIEW|CALCULATING|CALCULATED|APPROVED|POSTED|REVERSED|ERROR
  sourceAmount   Decimal   @default(0) @map("source_amount") @db.Decimal(14, 2)
  allocatedAmount Decimal  @default(0) @map("allocated_amount") @db.Decimal(14, 2)
  residual       Decimal   @default(0) @db.Decimal(14, 2)
  calculationVersion Int   @default(1) @map("calculation_version")
  postingBatchId String?   @map("posting_batch_id")
  initiatedBy    String?   @map("initiated_by")

  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  tenant       Tenant                @relation(fields: [tenantId], references: [id])
  organization Organization          @relation(fields: [organizationId], references: [id])
  rule         AllocationRule        @relation(fields: [ruleId], references: [id])
  lines        CostAllocationRunLine[]

  @@index([tenantId, organizationId, period])
  @@map("cost_allocation_runs")
}

model CostAllocationRunLine {
  id                 String  @id @default(uuid())
  tenantId           String  @map("tenant_id")
  runId              String  @map("run_id")
  targetCostCenterId String  @map("target_cost_center_id")
  driverValue        Decimal? @map("driver_value") @db.Decimal(18, 4)
  percentage         Decimal? @db.Decimal(7, 4)
  amount             Decimal @db.Decimal(14, 2)

  tenant Tenant            @relation(fields: [tenantId], references: [id])
  run    CostAllocationRun @relation(fields: [runId], references: [id])

  @@index([tenantId, runId])
  @@map("cost_allocation_run_lines")
}

model PrepaidExpense {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  organizationId String    @map("organization_id")
  sourceDocumentType String @map("source_document_type") // EXPENSE_CLAIM_LINE|PURCHASE_INVOICE|OTHER
  sourceDocumentId String  @map("source_document_id")
  sourceClaimLineId String? @unique @map("source_claim_line_id")
  expenseCategoryId String @map("expense_category_id")
  originalAmount Decimal   @map("original_amount") @db.Decimal(14, 2)
  currencyId     String    @map("currency_id")
  baseAmount     Decimal   @map("base_amount") @db.Decimal(14, 2)
  recognitionStartDate DateTime @map("recognition_start_date") @db.Date
  recognitionEndDate   DateTime @map("recognition_end_date") @db.Date
  allocationMethod String  @default("STRAIGHT_LINE_BY_MONTH") @map("allocation_method") // STRAIGHT_LINE_BY_MONTH|STRAIGHT_LINE_BY_DAY|FIXED_SCHEDULE|MANUAL|USAGE_BASED
  costCenterId   String?   @map("cost_center_id")
  projectId      String?   @map("project_id")
  recognizedAmount Decimal @default(0) @map("recognized_amount") @db.Decimal(14, 2)
  remainingAmount Decimal  @map("remaining_amount") @db.Decimal(14, 2)
  status         String    @default("DRAFT") // DRAFT|ACTIVE|FULLY_RECOGNIZED|CANCELLED|ADJUSTED

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant       Tenant                   @relation(fields: [tenantId], references: [id])
  organization Organization             @relation(fields: [organizationId], references: [id])
  claimLine    ExpenseClaimLine?        @relation(fields: [sourceClaimLineId], references: [id])
  expenseCategory ExpenseCategory       @relation(fields: [expenseCategoryId], references: [id])
  schedule     PrepaidExpenseSchedule[]

  @@index([tenantId, organizationId, status])
  @@map("prepaid_expenses")
}

model PrepaidExpenseSchedule {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  prepaidExpenseId String  @map("prepaid_expense_id")
  period         DateTime  @db.Date
  plannedRecognitionAmount Decimal @map("planned_recognition_amount") @db.Decimal(14, 2)
  recognizedAmount Decimal @default(0) @map("recognized_amount") @db.Decimal(14, 2)
  status         String    @default("PENDING") // PENDING|RECOGNIZED|SKIPPED
  postingReference String? @map("posting_reference")

  recognizedAt DateTime? @map("recognized_at")

  tenant  Tenant         @relation(fields: [tenantId], references: [id])
  prepaid PrepaidExpense @relation(fields: [prepaidExpenseId], references: [id])

  @@unique([prepaidExpenseId, period])
  @@map("prepaid_expense_schedules")
}

model ExpenseBudget {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  organizationId String   @map("organization_id")
  period         DateTime @db.Date
  costCenterId   String?  @map("cost_center_id")
  expenseCategoryId String? @map("expense_category_id")
  projectId      String?  @map("project_id")
  currencyId     String   @map("currency_id")
  budgetAmount   Decimal  @default(0) @map("budget_amount") @db.Decimal(14, 2)
  revisedBudgetAmount Decimal? @map("revised_budget_amount") @db.Decimal(14, 2)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  costCenter   CostCenter?  @relation(fields: [costCenterId], references: [id])

  @@index([tenantId, organizationId, period])
  @@map("expense_budgets")
}

// ============================================================
// PHASE 21 — MANUFACTURING / PRODUCTION (docx spec Phase 21)
// See docs/MANUFACTURING.md for the disclosed-simplifications list.
// Reuses Phase 10's InventoryMovementService/StockReservation and Phase
// 11's InventoryCostingService directly — production is never a second
// inventory/costing engine (spec section 2's own "don't duplicate").
// ============================================================

model BillOfMaterials {
  id             String  @id @default(uuid())
  tenantId       String  @map("tenant_id")
  organizationId String? @map("organization_id")
  code           String
  name           String
  active         Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
  versions     BOMVersion[]

  @@unique([tenantId, code])
  @@map("bill_of_materials")
}

/// Immutable once APPROVED/ACTIVE (spec section 8) — a change always
/// creates a NEW version; a ProductionOrder freezes the version it used
/// at release time (spec section 28).
model BOMVersion {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  bomId          String    @map("bom_id")
  outputProductId String   @map("output_product_id")
  versionCode    String    @map("version_code")
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date
  baseOutputQuantity Decimal @default(1) @map("base_output_quantity") @db.Decimal(18, 6)
  baseUnitId     String    @map("base_unit_id")
  status         String    @default("DRAFT") // DRAFT|REVIEW|APPROVED|ACTIVE|EXPIRED|CANCELLED
  productionType String    @default("MAKE_TO_STOCK") @map("production_type") // MAKE_TO_STOCK|MAKE_TO_ORDER|ASSEMBLY|DISASSEMBLY|PROCESS|REWORK|SUBCONTRACTING
  yieldPercentage Decimal  @default(100) @map("yield_percentage") @db.Decimal(6, 3)
  approvedBy     String?   @map("approved_by")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant Tenant       @relation(fields: [tenantId], references: [id])
  bom    BillOfMaterials @relation(fields: [bomId], references: [id])
  lines  BOMLine[]
  productionOrders ProductionOrder[]

  @@unique([bomId, versionCode])
  @@index([tenantId, outputProductId, status])
  @@map("bom_versions")
}

model BOMLine {
  id             String  @id @default(uuid())
  tenantId       String  @map("tenant_id")
  bomVersionId   String  @map("bom_version_id")
  componentProductId String @map("component_product_id")
  quantity       Decimal @db.Decimal(18, 6)
  unitId         String  @map("unit_id")
  scrapFactor    Decimal @default(0) @map("scrap_factor") @db.Decimal(6, 4) // fraction, e.g. 0.05 = 5% allowed process scrap (spec section 11)
  fixedQuantity  Boolean @default(false) @map("fixed_quantity") // true = does not scale with output batch size
  substitutionGroup String? @map("substitution_group")
  operationSequence Int?  @map("operation_sequence") // links to a RoutingOperation.sequence, nullable — see docs/MANUFACTURING.md
  consumptionType String  @default("MATERIAL") @map("consumption_type") // MATERIAL|SEMI_FINISHED|PACKAGING|CONSUMABLE|SERVICE|PHANTOM|BY_PRODUCT_REFERENCE
  sequence       Int     @default(1)

  tenant  Tenant     @relation(fields: [tenantId], references: [id])
  version BOMVersion @relation(fields: [bomVersionId], references: [id])

  @@index([tenantId, bomVersionId])
  @@map("bom_lines")
}

model WorkCenter {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  organizationId String    @map("organization_id")
  code           String
  name           String
  departmentId   String?   @map("department_id")
  groupCode      String?   @map("group_code") // e.g. "CUTTING", "ASSEMBLY" — WorkCenterGroup folded in, see docs/MANUFACTURING.md
  costCenterId   String?   @map("cost_center_id")
  capacityHoursPerDay Decimal @default(8) @map("capacity_hours_per_day") @db.Decimal(6, 2)
  hourlyMachineRate Decimal? @map("hourly_machine_rate") @db.Decimal(14, 4)
  active         Boolean   @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  routingOperations RoutingOperation[]
  operationExecutions OperationExecution[]
  machineTimeInputs MachineTimeInput[]

  @@unique([organizationId, code])
  @@map("work_centers")
}

model Routing {
  id             String  @id @default(uuid())
  tenantId       String  @map("tenant_id")
  organizationId String? @map("organization_id")
  code           String
  name           String
  active         Boolean @default(true)

  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  versions RoutingVersion[]

  @@unique([tenantId, code])
  @@map("routings")
}

model RoutingVersion {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  routingId      String    @map("routing_id")
  outputProductId String   @map("output_product_id")
  versionCode    String    @map("version_code")
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date
  baseQuantity   Decimal   @default(1) @map("base_quantity") @db.Decimal(18, 6)
  status         String    @default("DRAFT") // DRAFT|APPROVED|ACTIVE|EXPIRED|CANCELLED

  tenant     Tenant             @relation(fields: [tenantId], references: [id])
  routing    Routing            @relation(fields: [routingId], references: [id])
  operations RoutingOperation[]
  productionOrders ProductionOrder[]

  @@unique([routingId, versionCode])
  @@index([tenantId, outputProductId, status])
  @@map("routing_versions")
}

model RoutingOperation {
  id             String  @id @default(uuid())
  tenantId       String  @map("tenant_id")
  routingVersionId String @map("routing_version_id")
  operationCode  String  @map("operation_code")
  name           String
  sequence       Int
  workCenterId   String  @map("work_center_id")
  setupTimeMinutes Decimal @default(0) @map("setup_time_minutes") @db.Decimal(10, 2)
  runTimePerUnitMinutes Decimal @default(0) @map("run_time_per_unit_minutes") @db.Decimal(10, 4)
  laborStandardHours Decimal? @map("labor_standard_hours") @db.Decimal(10, 4) // standard labor hours per base output unit
  machineStandardHours Decimal? @map("machine_standard_hours") @db.Decimal(10, 4)
  subcontracted  Boolean @default(false)
  backflushMaterials Boolean @default(false) @map("backflush_materials")

  tenant  Tenant         @relation(fields: [tenantId], references: [id])
  version RoutingVersion @relation(fields: [routingVersionId], references: [id])
  workCenter WorkCenter  @relation(fields: [workCenterId], references: [id])

  operationExecutions OperationExecution[]
  laborInputs ProductionLaborInput[]
  machineTimeInputs MachineTimeInput[]

  @@unique([routingVersionId, sequence])
  @@map("routing_operations")
}

model ProductionOrder {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  organizationId String    @map("organization_id")
  documentType   String    @default("PRODUCTION_ORDER") @map("document_type")
  number         String?
  documentDate   DateTime  @map("document_date") @db.Date
  postingDate    DateTime? @map("posting_date") @db.Date

  productionStartDate DateTime? @map("production_start_date") @db.Date
  plannedEndDate DateTime? @map("planned_end_date") @db.Date
  productionType String   @default("MAKE_TO_STOCK") @map("production_type")
  outputWarehouseId String @map("output_warehouse_id")
  bomVersionId   String   @map("bom_version_id") // frozen at release (spec section 28)
  routingVersionId String? @map("routing_version_id")
  costCenterId   String?  @map("cost_center_id")
  projectId      String?  @map("project_id")
  responsibleUserId String? @map("responsible_user_id")
  plannedOutputQuantity Decimal @map("planned_output_quantity") @db.Decimal(18, 6)
  priority       Int      @default(100)

  calculationStatus String @default("NOT_CALCULATED") @map("calculation_status") // NOT_CALCULATED|PROVISIONAL|FINAL
  closeStatus    String   @default("OPEN") @map("close_status") // OPEN|READY_TO_CLOSE|CLOSED

  status        DocumentStatus @default(DRAFT)
  postingStatus PostingStatus  @default(NOT_POSTED) @map("posting_status")

  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by")
  postedAt     DateTime? @map("posted_at")
  postedBy     String?   @map("posted_by")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelledBy  String?   @map("cancelled_by")
  deletionMark Boolean   @default(false) @map("deletion_mark")
  version      Int       @default(1)

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  bomVersion   BOMVersion   @relation(fields: [bomVersionId], references: [id])
  routingVersion RoutingVersion? @relation(fields: [routingVersionId], references: [id])
  outputWarehouse Warehouse  @relation(fields: [outputWarehouseId], references: [id])

  outputs      ProductionOrderOutput[]
  requirements ProductionMaterialRequirement[]
  materialIssues MaterialIssue[]
  operationExecutions OperationExecution[]
  laborInputs  ProductionLaborInput[]
  machineTimeInputs MachineTimeInput[]
  outputReceipts ProductionOutputReceipt[]
  scrapRecords ScrapRecord[]
  costMovements ProductionCostMovement[]
  variances    ProductionVariance[]

  @@unique([tenantId, number])
  @@index([tenantId, organizationId, status])
  @@map("production_orders")
}

model ProductionOrderOutput {
  id             String  @id @default(uuid())
  tenantId       String  @map("tenant_id")
  productionOrderId String @map("production_order_id")
  productId      String  @map("product_id")
  plannedQuantity Decimal @map("planned_quantity") @db.Decimal(18, 6)
  receivedQuantity Decimal @default(0) @map("received_quantity") @db.Decimal(18, 6)
  unitId         String  @map("unit_id")
  outputType     String  @default("MAIN_PRODUCT") @map("output_type") // MAIN_PRODUCT|CO_PRODUCT|BY_PRODUCT
  costAllocationMethod String @default("BY_QUANTITY") @map("cost_allocation_method") // BY_QUANTITY|BY_WEIGHT|BY_VOLUME|BY_STANDARD_COST|BY_NET_REALIZABLE_VALUE|BY_FIXED_PERCENTAGE|MANUAL_APPROVED
  allocationWeight Decimal? @map("allocation_weight") @db.Decimal(10, 4) // used by BY_FIXED_PERCENTAGE/BY_STANDARD_COST/BY_NET_REALIZABLE_VALUE
  plannedWarehouseId String? @map("planned_warehouse_id")

  tenant Tenant          @relation(fields: [tenantId], references: [id])
  order  ProductionOrder @relation(fields: [productionOrderId], references: [id])
  receipts ProductionOutputReceipt[]

  @@index([tenantId, productionOrderId])
  @@map("production_order_outputs")
}

/// Exploded from the frozen BOM version at release (spec sections 29-30)
/// — later BOM changes never silently alter an already-released order's
/// own requirement rows.
model ProductionMaterialRequirement {
  id             String  @id @default(uuid())
  tenantId       String  @map("tenant_id")
  productionOrderId String @map("production_order_id")
  sourceBomLineId String? @map("source_bom_line_id")
  componentProductId String @map("component_product_id")
  unitId         String  @map("unit_id")
  requiredQuantity Decimal @map("required_quantity") @db.Decimal(18, 6)
  issuedQuantity Decimal @default(0) @map("issued_quantity") @db.Decimal(18, 6)
  returnedQuantity Decimal @default(0) @map("returned_quantity") @db.Decimal(18, 6)
  consumedQuantity Decimal @default(0) @map("consumed_quantity") @db.Decimal(18, 6)
  warehouseId    String  @map("warehouse_id")
  reservationStatus String @default("NONE") @map("reservation_status") // NONE|PARTIAL|FULL
  reservedQuantity Decimal @default(0) @map("reserved_quantity") @db.Decimal(18, 6)

  tenant Tenant          @relation(fields: [tenantId], references: [id])
  order  ProductionOrder @relation(fields: [productionOrderId], references: [id])

  @@index([tenantId, productionOrderId])
  @@map("production_material_requirements")
}

model MaterialIssue {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  organizationId String   @map("organization_id")
  documentType   String   @default("PRODUCTION_MATERIAL_ISSUE") @map("document_type")
  number         String?
  documentDate   DateTime @map("document_date") @db.Date
  postingDate    DateTime? @map("posting_date") @db.Date

  productionOrderId String @map("production_order_id")
  warehouseId    String   @map("warehouse_id")
  issueType      String   @default("ISSUE") @map("issue_type") // ISSUE|RETURN — a return is the SAME document type with negative-direction lines (spec section 40, disclosed simplification)

  status        DocumentStatus @default(DRAFT)
  postingStatus PostingStatus  @default(NOT_POSTED) @map("posting_status")

  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by")
  postedAt     DateTime? @map("posted_at")
  postedBy     String?   @map("posted_by")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelledBy  String?   @map("cancelled_by")
  deletionMark Boolean   @default(false) @map("deletion_mark")
  version      Int       @default(1)

  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  organization Organization     @relation(fields: [organizationId], references: [id])
  order        ProductionOrder  @relation(fields: [productionOrderId], references: [id])
  warehouse    Warehouse        @relation(fields: [warehouseId], references: [id])
  lines        MaterialIssueLine[]

  @@unique([tenantId, number])
  @@map("production_material_issues")
}

model MaterialIssueLine {
  id             String  @id @default(uuid())
  tenantId       String  @map("tenant_id")
  issueId        String  @map("issue_id")
  requirementId  String? @map("requirement_id")
  productId      String  @map("product_id")
  unitId         String  @map("unit_id")
  batchId        String? @map("batch_id")
  quantity       Decimal @db.Decimal(18, 6) // always positive; issueType on the header carries the direction

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  issue  MaterialIssue @relation(fields: [issueId], references: [id])

  @@index([tenantId, issueId])
  @@map("production_material_issue_lines")
}

model OperationExecution {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  productionOrderId String @map("production_order_id")
  routingOperationId String? @map("routing_operation_id")
  workCenterId   String    @map("work_center_id")
  executionDate  DateTime  @map("execution_date") @db.Date
  startedAt      DateTime? @map("started_at")
  completedAt    DateTime? @map("completed_at")
  goodQuantity   Decimal   @default(0) @map("good_quantity") @db.Decimal(18, 6)
  scrapQuantity  Decimal   @default(0) @map("scrap_quantity") @db.Decimal(18, 6)
  reworkQuantity Decimal   @default(0) @map("rework_quantity") @db.Decimal(18, 6)
  laborHours     Decimal   @default(0) @map("labor_hours") @db.Decimal(10, 4)
  machineHours   Decimal   @default(0) @map("machine_hours") @db.Decimal(10, 4)
  status         String    @default("STARTED") // NOT_STARTED|STARTED|PARTIALLY_COMPLETED|COMPLETED|FAILED|CANCELLED

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant  Tenant           @relation(fields: [tenantId], references: [id])
  order   ProductionOrder  @relation(fields: [productionOrderId], references: [id])
  routingOperation RoutingOperation? @relation(fields: [routingOperationId], references: [id])
  workCenter WorkCenter    @relation(fields: [workCenterId], references: [id])

  @@index([tenantId, productionOrderId])
  @@map("operation_executions")
}

model ProductionLaborInput {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  productionOrderId String @map("production_order_id")
  routingOperationId String? @map("routing_operation_id")
  employmentId   String?  @map("employment_id")
  workDate       DateTime @map("work_date") @db.Date
  hours          Decimal  @db.Decimal(10, 4)
  sourceType     String   @default("MANUAL") @map("source_type") // MANUAL|WORK_TIME_REGISTER|STANDARD_PROVISIONAL
  costMethod     String   @default("STANDARD_PROVISIONAL") @map("cost_method") // STANDARD_PROVISIONAL|ACTUAL_PAYROLL_COST|HYBRID
  hourlyRate     Decimal  @db.Decimal(14, 4)
  costAmount     Decimal  @map("cost_amount") @db.Decimal(14, 2)
  status         String   @default("ACTIVE") // ACTIVE|REVERSED

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant Tenant          @relation(fields: [tenantId], references: [id])
  order  ProductionOrder @relation(fields: [productionOrderId], references: [id])
  routingOperation RoutingOperation? @relation(fields: [routingOperationId], references: [id])

  @@index([tenantId, productionOrderId])
  @@map("production_labor_inputs")
}

model MachineTimeInput {
  id             String  @id @default(uuid())
  tenantId       String  @map("tenant_id")
  productionOrderId String @map("production_order_id")
  routingOperationId String? @map("routing_operation_id")
  workCenterId   String  @map("work_center_id")
  workDate       DateTime @map("work_date") @db.Date
  hours          Decimal @db.Decimal(10, 4)
  rate           Decimal @db.Decimal(14, 4)
  costAmount     Decimal @map("cost_amount") @db.Decimal(14, 2)
  status         String  @default("ACTIVE") // ACTIVE|REVERSED

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant Tenant          @relation(fields: [tenantId], references: [id])
  order  ProductionOrder @relation(fields: [productionOrderId], references: [id])
  workCenter WorkCenter  @relation(fields: [workCenterId], references: [id])
  routingOperation RoutingOperation? @relation(fields: [routingOperationId], references: [id])

  @@index([tenantId, productionOrderId])
  @@map("machine_time_inputs")
}

/// Serves BOTH finished-goods AND semi-finished-goods receipt (spec
/// sections 63-65) — one table, `outputKind` discriminates, rather than a
/// separate `SemiFinishedReceipt` (disclosed simplification, see
/// docs/MANUFACTURING.md). `provisionalUnitCost`/`costingStatus` support
/// the sell-before-final-cost flow (spec sections 68-69) — Phase 11's own
/// recalculation architecture adjusts the layer later.
model ProductionOutputReceipt {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  organizationId String   @map("organization_id")
  documentType   String   @default("PRODUCTION_OUTPUT_RECEIPT") @map("document_type")
  number         String?
  documentDate   DateTime @map("document_date") @db.Date
  postingDate    DateTime? @map("posting_date") @db.Date

  productionOrderId String @map("production_order_id")
  outputId       String   @map("output_id")
  outputKind     String   @default("FINISHED") @map("output_kind") // FINISHED|SEMI_FINISHED
  warehouseId    String   @map("warehouse_id")
  batchId        String?  @map("batch_id")
  goodQuantity   Decimal  @map("good_quantity") @db.Decimal(18, 6)
  provisionalUnitCost Decimal? @map("provisional_unit_cost") @db.Decimal(18, 6)
  costingStatus  String   @default("PROVISIONAL") @map("costing_status") // PROVISIONAL|FINAL
  qualityStatus  String   @default("ACCEPTED") @map("quality_status") // ACCEPTED|QUARANTINE|REJECTED|REWORK

  status        DocumentStatus @default(DRAFT)
  postingStatus PostingStatus  @default(NOT_POSTED) @map("posting_status")

  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by")
  postedAt     DateTime? @map("posted_at")
  postedBy     String?   @map("posted_by")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelledBy  String?   @map("cancelled_by")
  deletionMark Boolean   @default(false) @map("deletion_mark")
  version      Int       @default(1)

  tenant       Tenant                @relation(fields: [tenantId], references: [id])
  organization Organization          @relation(fields: [organizationId], references: [id])
  order        ProductionOrder       @relation(fields: [productionOrderId], references: [id])
  output       ProductionOrderOutput @relation(fields: [outputId], references: [id])
  warehouse    Warehouse             @relation(fields: [warehouseId], references: [id])

  @@unique([tenantId, number])
  @@map("production_output_receipts")
}

model ScrapRecord {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  productionOrderId String @map("production_order_id")
  operationExecutionId String? @map("operation_execution_id")
  productId      String   @map("product_id")
  scrapType      String   @map("scrap_type") // NORMAL_PROCESS_SCRAP|ABNORMAL_SCRAP|REUSABLE_SCRAP|DEFECT|SPOILAGE|REWORK
  quantity       Decimal  @db.Decimal(18, 6)
  unitId         String   @map("unit_id")
  valuationPolicy String  @default("ZERO") @map("valuation_policy") // ZERO|REFERENCE_VALUE|RECOVERABLE_VALUE|REDUCE_WIP_COST
  referenceValue Decimal? @map("reference_value") @db.Decimal(18, 6)
  receivedToInventory Boolean @default(false) @map("received_to_inventory")
  warehouseId    String?  @map("warehouse_id")
  recordDate     DateTime @map("record_date") @db.Date
  notes          String?

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant Tenant          @relation(fields: [tenantId], references: [id])
  order  ProductionOrder @relation(fields: [productionOrderId], references: [id])

  @@index([tenantId, productionOrderId])
  @@map("scrap_records")
}

/// Serves both the spec's own `WIPMovementRegister` AND
/// `ProductionCostMovementRegister` — WIP balance IS the accumulation of
/// unclosed cost movements for a production order (disclosed
/// simplification, see docs/MANUFACTURING.md): summing
/// `costIn - costOut` for an order gives its WIP balance directly,
/// without a second, near-identical table.
model ProductionCostMovement {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  organizationId String   @map("organization_id")
  productionOrderId String @map("production_order_id")
  operationExecutionId String? @map("operation_execution_id")
  outputReceiptId String? @map("output_receipt_id")
  costComponent  String   @map("cost_component") // DIRECT_MATERIAL|DIRECT_LABOR|MACHINE|SUBCONTRACTING|PRODUCTION_OVERHEAD|OTHER_DIRECT|SCRAP_LOSS|COST_ADJUSTMENT
  costIn         Decimal  @default(0) @map("cost_in") @db.Decimal(18, 2)
  costOut        Decimal  @default(0) @map("cost_out") @db.Decimal(18, 2)
  quantityIn     Decimal? @map("quantity_in") @db.Decimal(18, 6)
  quantityOut    Decimal? @map("quantity_out") @db.Decimal(18, 6)
  sourceDocumentType String @map("source_document_type")
  sourceDocumentId String  @map("source_document_id")
  effectiveDate  DateTime @map("effective_date") @db.Date
  reversed       Boolean  @default(false)

  createdAt DateTime @default(now()) @map("created_at")

  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  organization Organization    @relation(fields: [organizationId], references: [id])
  order        ProductionOrder @relation(fields: [productionOrderId], references: [id])

  @@index([tenantId, productionOrderId, costComponent])
  @@index([tenantId, sourceDocumentType, sourceDocumentId])
  @@map("production_cost_movements")
}

model ProductionOverheadPool {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  organizationId String   @map("organization_id")
  period         DateTime @db.Date
  costCenterId   String?  @map("cost_center_id")
  workCenterGroupCode String? @map("work_center_group_code")
  costType       String   @default("OTHER") @map("cost_type") // FACTORY_RENT|UTILITIES|INDIRECT_LABOR|DEPRECIATION|MAINTENANCE|SUPERVISION|OTHER
  amount         Decimal  @db.Decimal(18, 2)
  allocatedAmount Decimal @default(0) @map("allocated_amount") @db.Decimal(18, 2)
  driverType     String   @default("DIRECT_LABOR_HOURS") @map("driver_type") // DIRECT_LABOR_HOURS|MACHINE_HOURS|DIRECT_MATERIAL_COST|UNITS_PRODUCED
  status         String   @default("OPEN") // OPEN|ALLOCATED

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([tenantId, organizationId, period])
  @@map("production_overhead_pools")
}

model ProductionVariance {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  productionOrderId String @map("production_order_id")
  varianceType   String   @map("variance_type") // MATERIAL_USAGE|MATERIAL_PRICE|LABOR_EFFICIENCY|LABOR_RATE|OVERHEAD|YIELD
  standardQuantity Decimal? @map("standard_quantity") @db.Decimal(18, 6)
  actualQuantity Decimal? @map("actual_quantity") @db.Decimal(18, 6)
  standardRate   Decimal? @map("standard_rate") @db.Decimal(14, 4)
  actualRate     Decimal? @map("actual_rate") @db.Decimal(14, 4)
  standardCost   Decimal? @map("standard_cost") @db.Decimal(18, 2)
  actualCost     Decimal? @map("actual_cost") @db.Decimal(18, 2)
  varianceAmount Decimal  @map("variance_amount") @db.Decimal(18, 2)
  favorable      Boolean  @map("favorable")
  calculationRunReference String? @map("calculation_run_reference")

  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant          @relation(fields: [tenantId], references: [id])
  order  ProductionOrder @relation(fields: [productionOrderId], references: [id])

  @@index([tenantId, productionOrderId])
  @@map("production_variances")
}
// ============================================================
// Phase 22 — Financial Period Close Orchestrator
// See docs/MONTH_CLOSE.md
// ============================================================

model FinancialPeriod {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  organizationId String   @map("organization_id")
  fiscalYear     Int      @map("fiscal_year")
  periodNumber   Int      @map("period_number")
  periodStart    DateTime @map("period_start") @db.Date
  periodEnd      DateTime @map("period_end") @db.Date
  periodType     String   @default("MONTH") @map("period_type") // MONTH|QUARTER|YEAR|ADJUSTMENT_PERIOD
  status         String   @default("OPEN") // OPEN|PRE_CLOSE|CLOSE_IN_PROGRESS|SOFT_CLOSED|HARD_CLOSED|REOPENING|REOPENED|ERROR
  softCloseAt    DateTime? @map("soft_close_at")
  hardCloseAt    DateTime? @map("hard_close_at")
  closedBy       String?  @map("closed_by")
  closeRunId     String?  @map("close_run_id") // latest authoritative close run, informational
  reopenCount    Int      @default(0) @map("reopen_count")
  dataVersion    Int      @default(0) @map("data_version") // period mutation token (spec section 25)
  version        Int      @default(1)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  closeRuns      PeriodCloseRun[]
  accruals       PeriodAccrual[]
  reopenRequests PeriodReopenRequest[]
  snapshots      PeriodCloseSnapshot[]

  @@unique([tenantId, organizationId, fiscalYear, periodNumber, periodType])
  @@index([tenantId, organizationId, status])
}

model PeriodClosePolicy {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  organizationId String?   @map("organization_id") // null = tenant-wide default
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date

  requireBankReconciliation        Boolean @default(true) @map("require_bank_reconciliation")
  requireCashDailyClose            Boolean @default(true) @map("require_cash_daily_close")
  requireInventoryCostFinalization Boolean @default(true) @map("require_inventory_cost_finalization")
  requireInventoryCount            Boolean @default(false) @map("require_inventory_count")
  requirePayrollClose              Boolean @default(true) @map("require_payroll_close")
  requireFaDepreciation            Boolean @default(true) @map("require_fa_depreciation")
  requirePrepaidRecognition        Boolean @default(true) @map("require_prepaid_recognition")
  requireProductionCosting         Boolean @default(true) @map("require_production_costing")
  requireFxRevaluation             Boolean @default(true) @map("require_fx_revaluation")
  toleranceProfile                 String  @default("STANDARD") @map("tolerance_profile")
  softCloseAllowed                 Boolean @default(true) @map("soft_close_allowed")
  reopenPolicy                     String  @default("APPROVAL_REQUIRED") @map("reopen_policy")
  approvalProfile                  String? @map("approval_profile")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([tenantId, organizationId, effectiveFrom])
}

model PeriodCloseRun {
  id                       String    @id @default(uuid())
  tenantId                 String    @map("tenant_id")
  financialPeriodId        String    @map("financial_period_id")
  organizationId           String    @map("organization_id")
  closeType                String    @map("close_type") // PREVIEW|PRE_CLOSE|REGULAR_CLOSE|RECLOSE|YEAR_END_CLOSE|DIAGNOSTIC
  status                   String    @default("CREATED") // CREATED|VALIDATING|RUNNING|WAITING_DEPENDENCY|BLOCKED|FAILED|READY_TO_FINALIZE|FINALIZING|COMPLETED|CANCELLED
  startedAt                DateTime? @map("started_at")
  completedAt              DateTime? @map("completed_at")
  initiatedBy              String    @map("initiated_by")
  calculationVersion       Int       @default(1) @map("calculation_version")
  retryCount                Int      @default(0) @map("retry_count")
  currentStep               String?  @map("current_step")
  totalSteps                Int      @default(0) @map("total_steps")
  successfulSteps            Int     @default(0) @map("successful_steps")
  warningSteps               Int     @default(0) @map("warning_steps")
  failedSteps                Int     @default(0) @map("failed_steps")
  blockingIssueCount          Int    @default(0) @map("blocking_issue_count")
  closeSnapshotId              String? @map("close_snapshot_id")
  periodDataVersionAtStart     Int?    @map("period_data_version_at_start") // spec section 25
  supersedesRunId              String? @map("supersedes_run_id") // reclose chain (v1 -> v2)

  createdAt DateTime @default(now()) @map("created_at")

  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  financialPeriod FinancialPeriod @relation(fields: [financialPeriodId], references: [id])
  organization    Organization    @relation(fields: [organizationId], references: [id])

  steps                 PeriodCloseStep[]
  issues                PeriodCloseIssue[]
  reconciliationResults PeriodReconciliationResult[]
  adjustmentBatches     PeriodCloseAdjustmentBatch[]
  taxResults            TaxPeriodCloseResult[]
  fxRuns                FXRevaluationRun[]
  snapshot              PeriodCloseSnapshot?

  @@index([tenantId, organizationId, financialPeriodId, status])
}

model PeriodCloseStep {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  closeRunId      String    @map("close_run_id")
  stepCode        String    @map("step_code")
  name            String
  sequence        Int
  dependencyGroup String?   @map("dependency_group")
  status          String    @default("NOT_STARTED") // NOT_STARTED|READY|RUNNING|SUCCESS|WARNING|BLOCKED|FAILED|SKIPPED|INVALIDATED
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")
  serviceName     String?   @map("service_name")
  resultSummary   Json?     @map("result_summary")
  warnings        Json?
  errors          Json?
  retryable       Boolean   @default(true)
  idempotencyKey  String?   @map("idempotency_key")

  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  closeRun PeriodCloseRun @relation(fields: [closeRunId], references: [id])
  issues   PeriodCloseIssue[]

  @@unique([closeRunId, stepCode])
  @@index([tenantId, closeRunId, status])
}

model CloseStepDependency {
  id              String  @id @default(uuid())
  tenantId        String  @map("tenant_id")
  predecessorStep String  @map("predecessor_step")
  successorStep   String  @map("successor_step")
  dependencyType  String  @default("MUST_COMPLETE") @map("dependency_type") // MUST_COMPLETE|MUST_VALIDATE|OPTIONAL|CONDITIONAL
  blocking        Boolean @default(true)
  conditionRule   String? @map("condition_rule")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, predecessorStep, successorStep])
}

model PeriodCloseIssue {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  closeRunId      String    @map("close_run_id")
  stepId          String?   @map("step_id")
  issueCode       String    @map("issue_code")
  severity        String    @default("WARNING") // INFO|WARNING|ERROR|BLOCKING
  blocking        Boolean   @default(false)
  sourceModule    String?   @map("source_module")
  sourceEntity    String?   @map("source_entity")
  description     String
  suggestedAction String?   @map("suggested_action")
  assignedTo      String?   @map("assigned_to")
  status          String    @default("OPEN") // OPEN|IN_REVIEW|RESOLVED|ACCEPTED_EXCEPTION|WAIVED
  resolvedAt      DateTime? @map("resolved_at")
  resolvedBy      String?   @map("resolved_by")
  resolutionNote  String?   @map("resolution_note")

  createdAt DateTime @default(now()) @map("created_at")

  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  closeRun PeriodCloseRun @relation(fields: [closeRunId], references: [id])
  step     PeriodCloseStep? @relation(fields: [stepId], references: [id])

  @@index([tenantId, closeRunId, status, blocking])
}

model ReconciliationRule {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  code             String
  name             String
  sourceSystem     String    @map("source_system") // INVENTORY|AR|AP|BANK|CASH|PAYROLL|FIXED_ASSETS|ACCUMULATED_DEPRECIATION|PREPAID|WIP|TAX
  sourceMetric     String    @map("source_metric")
  targetMappingKey String    @map("target_mapping_key") // resolved via AccountingMappingService
  dimensions       Json?
  tolerance        Decimal   @default(0.01) @map("tolerance") @db.Decimal(18, 6)
  severity         String    @default("BLOCKING")
  effectiveFrom    DateTime  @default(now()) @map("effective_from") @db.Date
  effectiveTo      DateTime? @map("effective_to") @db.Date
  blocking         Boolean   @default(true)
  active           Boolean   @default(true)

  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant                        @relation(fields: [tenantId], references: [id])
  results PeriodReconciliationResult[]

  @@unique([tenantId, code])
}

model PeriodReconciliationResult {
  id                 String  @id @default(uuid())
  tenantId           String  @map("tenant_id")
  closeRunId         String  @map("close_run_id")
  ruleId             String  @map("rule_id")
  sourceAmount       Decimal @map("source_amount") @db.Decimal(18, 6)
  targetAmount       Decimal @map("target_amount") @db.Decimal(18, 6)
  difference         Decimal @db.Decimal(18, 6)
  tolerance          Decimal @db.Decimal(18, 6)
  status             String  @default("MATCH") // MATCH|WITHIN_TOLERANCE|WARNING|DIFFERENCE|BLOCKING|RESOLVED
  drilldownReference String? @map("drilldown_reference")
  resolvedBy         String? @map("resolved_by")
  resolutionNote     String? @map("resolution_note")

  createdAt DateTime @default(now()) @map("created_at")

  tenant   Tenant             @relation(fields: [tenantId], references: [id])
  closeRun PeriodCloseRun     @relation(fields: [closeRunId], references: [id])
  rule     ReconciliationRule @relation(fields: [ruleId], references: [id])

  @@index([tenantId, closeRunId, status])
}

model FXRevaluationRun {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  organizationId  String   @map("organization_id")
  closeRunId      String?  @map("close_run_id")
  period          String // YYYY-MM
  closingRateDate DateTime @map("closing_rate_date") @db.Date
  status          String   @default("DRAFT") // DRAFT|POSTED|REVERSED
  journalEntryId  String?  @map("journal_entry_id")
  createdBy       String   @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")

  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  organization Organization    @relation(fields: [organizationId], references: [id])
  closeRun     PeriodCloseRun? @relation(fields: [closeRunId], references: [id])
  items        FXRevaluationItem[]

  @@unique([tenantId, organizationId, period])
}

model FXRevaluationItem {
  id                       String   @id @default(uuid())
  tenantId                 String   @map("tenant_id")
  runId                    String   @map("run_id")
  sourceType               String   @map("source_type") // AR|AP
  sourceId                 String   @map("source_id")
  currencyId               String   @map("currency_id")
  foreignAmount            Decimal  @map("foreign_amount") @db.Decimal(18, 6)
  historicalCarryingAmount Decimal  @map("historical_carrying_amount") @db.Decimal(18, 6)
  closingRate              Decimal  @map("closing_rate") @db.Decimal(18, 8)
  revaluedBaseAmount       Decimal  @map("revalued_base_amount") @db.Decimal(18, 6)
