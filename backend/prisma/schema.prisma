  // Fixed Asset Subledger (docx spec Phase 16)
  FixedAssetCategory              FixedAssetCategory[]
  FixedAssetAcquisitionCandidate  FixedAssetAcquisitionCandidate[]
  CapitalInvestmentProject        CapitalInvestmentProject[]
  CapitalInvestmentCost           CapitalInvestmentCost[]
  FixedAsset                      FixedAsset[]
  FixedAssetTransfer              FixedAssetTransfer[]
  FixedAssetPolicyChange          FixedAssetPolicyChange[]
  FixedAssetModernization         FixedAssetModernization[]
  FixedAssetImpairment            FixedAssetImpairment[]
  FixedAssetDisposal              FixedAssetDisposal[]
  FixedAssetDepreciationRun       FixedAssetDepreciationRun[]
  FixedAssetDepreciationLine      FixedAssetDepreciationLine[]
  FixedAssetInventoryCount        FixedAssetInventoryCount[]
  FixedAssetInventoryResult       FixedAssetInventoryResult[]
  FixedAssetOpeningBalance        FixedAssetOpeningBalance[]

  // HR Core / Employment Lifecycle Engine (docx spec Phase 17)
  PhysicalPerson            PhysicalPerson[]
  Employee                  Employee[]
  Employment                Employment[]
  EmploymentContract        EmploymentContract[]
  EmploymentContractVersion EmploymentContractVersion[]
  Position                  Position[]
  StaffingTable             StaffingTable[]
  StaffingPosition          StaffingPosition[]
  HireDocument              HireDocument[]
  EmployeeAssignment        EmployeeAssignment[]
  EmployeeTransfer          EmployeeTransfer[]
  WorkScheduleAssignment    WorkScheduleAssignment[]
  LeaveRecord               LeaveRecord[]
  AbsenceRecord             AbsenceRecord[]
  EmploymentStatusHistory   EmploymentStatusHistory[]
