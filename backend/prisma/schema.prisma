// ============================================================================
// PHASE 0 — SYSTEM ARCHITECTURE & FOUNDATION CORE
// Prisma schema for the multi-tenant ERP/accounting platform foundation.
//
// This file intentionally does NOT model any business module (Sales,
// Purchase, Inventory, Payroll, Tax, Banking, Fixed Assets, ...).
// It models only the reusable platform foundation described in Phase 0:
// tenancy, identity, RBAC, reference-data base shape, document framework
// contracts, numbering, currency, periods, audit, settings, idempotency
// and a generic document-relationship / register-movement foundation.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// 4/5. TENANT ARCHITECTURE & USER MODEL
// ----------------------------------------------------------------------------

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

/// Tenant = highest business isolation boundary (the account/workspace).
/// Organization/legal-entity configuration is intentionally out of scope for
/// Phase 0 (belongs to Phase 1) — `Organization` below is only the minimal
/// scope placeholder so later phases can attach without restructuring.
model Tenant {
  id              String       @id @default(uuid())
  code            String       @unique
  name            String
  legalName       String?      @map("legal_name")
  baseCurrencyId  String?      @map("base_currency_id")
  timezone        String       @default("Asia/Baku")
  locale          String       @default("az-AZ")
  defaultLanguage String       @default("az") @map("default_language")
  status          TenantStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  version   Int      @default(1)

  baseCurrency                            Currency?                                @relation(fields: [baseCurrencyId], references: [id])
  memberships                             TenantMembership[]
  organizations                           Organization[]
  roles                                   Role[]
  currencies                              Currency[]                               @relation("TenantCurrencies")
  exchangeRates                           ExchangeRate[]
  numberSequences                         NumberSequence[]
  periods                                 AccountingPeriod[]
  documentLinks                           DocumentLink[]
  auditEvents                             AuditEvent[]
  settings                                Setting[]
  idempotencyKeys                         IdempotencyKey[]
  foundationTestDocuments                 FoundationTestDocument[]
  registerMovements                       RegisterMovement[]
  responsiblePersons                      ResponsiblePerson[]
  unitsOfMeasure                          UnitOfMeasure[]
  banks                                   Bank[]
  productCategories                       ProductCategory[]
  productParentCategories                 ProductParentCategory[]
  products                                Product[]
  unitConversions                         UnitConversion[]
  counterparties                          Counterparty[]
  counterpartyAddresses                   CounterpartyAddress[]
  counterpartyContacts                    CounterpartyContact[]
  priceLists                              PriceList[]
  productPrices                           ProductPrice[]
  salesOrders                             SalesOrder[]
  salesOrderLines                         SalesOrderLine[]
  salesInvoices                           SalesInvoice[]
  salesInvoiceLines                       SalesInvoiceLine[]
  chartsOfAccounts                        ChartOfAccounts[]
  accounts                                Account[]
  accountingDimensionDefinitions          AccountingDimensionDefinition[]
  accountingMappings                      AccountingMapping[]
  journalEntries                          JournalEntry[]
  accountingMovements                     AccountingMovement[]
  postingRuns                             PostingRun[]
  taxRules                                TaxRule[]
  taxRegistrations                        TaxRegistration[]
  productTaxProfiles                      ProductTaxProfile[]
  counterpartyTaxProfiles                 CounterpartyTaxProfile[]
  taxMovements                            TaxMovement[]
  customerRequests                        CustomerRequest[]
  customerRequestLines                    CustomerRequestLine[]
  commercialOffers                        CommercialOffer[]
  commercialOfferLines                    CommercialOfferLine[]
  documentLineLinks                       DocumentLineLink[]
  stockReservations                       StockReservation[]
  shipmentPlans                           ShipmentPlan[]
  shipmentPlanLines                       ShipmentPlanLine[]
  orderPaymentSchedules                   OrderPaymentSchedule[]
  orderHolds                              OrderHold[]
  shipments                               Shipment[]
  shipmentLines                           ShipmentLine[]
  settlementObligations                   SettlementObligation[]
  salesReturns                            SalesReturn[]
  salesReturnLines                        SalesReturnLine[]
  purchaseRequirements                    PurchaseRequirement[]
  purchaseRequirementLines                PurchaseRequirementLine[]
  purchaseOrders                          PurchaseOrder[]
  purchaseOrderLines                      PurchaseOrderLine[]
  purchaseDeliveryScheduleLines           PurchaseDeliveryScheduleLine[]
  purchaseOrderHolds                      PurchaseOrderHold[]
  purchaseOrderPaymentSchedules           PurchaseOrderPaymentSchedule[]
  supplierProductCodes                    SupplierProductCode[]
  supplyPegs                              SupplyPeg[]
  goodsReceipts                           GoodsReceipt[]
  goodsReceiptLines                       GoodsReceiptLine[]
  purchaseInvoices                        PurchaseInvoice[]
  purchaseInvoiceLines                    PurchaseInvoiceLine[]
  supplierPayables                        SupplierPayable[]
  purchaseReturns                         PurchaseReturn[]
  purchaseReturnLines                     PurchaseReturnLine[]
  additionalPurchaseCosts                 AdditionalPurchaseCost[]
  additionalPurchaseCostLines             AdditionalPurchaseCostLine[]
  purchaseCostAllocations                 PurchaseCostAllocation[]
  purchaseMatchingResults                 PurchaseMatchingResult[]
  warehouseLocations                      WarehouseLocation[]
  batches                                 Batch[]
  serialNumbers                           SerialNumber[]
  inventoryMovements                      InventoryMovement[]
  documentLineSerials                     DocumentLineSerial[]
  counterpartyBankAccounts                CounterpartyBankAccount[]
  counterpartyContracts                   CounterpartyContract[]
  counterpartyContractAmendments          CounterpartyContractAmendment[]
  counterpartyContractLines               CounterpartyContractLine[]
  counterpartyContractPaymentInstallments CounterpartyContractPaymentInstallment[]
  counterpartyDocuments                   CounterpartyDocument[]
  warehouseTransfers                      WarehouseTransfer[]
  warehouseTransferLines                  WarehouseTransferLine[]
  internalConsumptions                    InternalConsumption[]
  internalConsumptionLines                InternalConsumptionLine[]
  inventoryAdjustments                    InventoryAdjustment[]
  inventoryAdjustmentLines                InventoryAdjustmentLine[]
  inventoryStatusTransfers                InventoryStatusTransfer[]
  inventoryStatusTransferLines            InventoryStatusTransferLine[]
  approvalSteps                           ApprovalStep[]
  PaymentRequest                          PaymentRequest[]
  PaymentOrder                            PaymentOrder[]
  PaymentAllocation                       PaymentAllocation[]
  CashTransaction                         CashTransaction[]
  BankStatementLine                       BankStatementLine[]
  PeriodReopenRequest                     PeriodReopenRequest[]
  IncomingBankPayment                     IncomingBankPayment[]
  InternalBankTransfer                    InternalBankTransfer[]
  BankFee                                 BankFee[]
  FXConversion                            FXConversion[]
  BankReconciliation                      BankReconciliation[]
  TreasuryPaymentApprovalRule             TreasuryPaymentApprovalRule[]
  TreasuryLiquidityPolicy                 TreasuryLiquidityPolicy[]
  CashierAssignment                       CashierAssignment[]
