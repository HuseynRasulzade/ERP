// ============================================================================
// PHASE 0 — SYSTEM ARCHITECTURE & FOUNDATION CORE
// Prisma schema for the multi-tenant ERP/accounting platform foundation.
//
// This file intentionally does NOT model any business module (Sales,
// Purchase, Inventory, Payroll, Tax, Banking, Fixed Assets, ...).
// It models only the reusable platform foundation described in Phase 0:
// tenancy, identity, RBAC, reference-data base shape, document framework
// contracts, numbering, currency, periods, audit, settings, idempotency
// and a generic document-relationship / register-movement foundation.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// 4/5. TENANT ARCHITECTURE & USER MODEL
// ----------------------------------------------------------------------------

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

/// Tenant = highest business isolation boundary (the account/workspace).
/// Organization/legal-entity configuration is intentionally out of scope for
/// Phase 0 (belongs to Phase 1) — `Organization` below is only the minimal
/// scope placeholder so later phases can attach without restructuring.
model Tenant {
  id              String       @id @default(uuid())
  code            String       @unique
  name            String
  legalName       String?      @map("legal_name")
  baseCurrencyId  String?      @map("base_currency_id")
  timezone        String       @default("Asia/Baku")
  locale          String       @default("az-AZ")
  defaultLanguage String       @default("az") @map("default_language")
  status          TenantStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  version   Int      @default(1)

  baseCurrency                   Currency?                       @relation(fields: [baseCurrencyId], references: [id])
  memberships                    TenantMembership[]
  organizations                  Organization[]
  roles                          Role[]
  currencies                     Currency[]                      @relation("TenantCurrencies")
  exchangeRates                  ExchangeRate[]
  numberSequences                NumberSequence[]
  periods                        AccountingPeriod[]
  documentLinks                  DocumentLink[]
  auditEvents                    AuditEvent[]
  settings                       Setting[]
  idempotencyKeys                IdempotencyKey[]
  foundationTestDocuments        FoundationTestDocument[]
  registerMovements              RegisterMovement[]
  responsiblePersons             ResponsiblePerson[]
  unitsOfMeasure                 UnitOfMeasure[]
  productCategories              ProductCategory[]
  products                       Product[]
  unitConversions                UnitConversion[]
  counterparties                 Counterparty[]
  counterpartyAddresses          CounterpartyAddress[]
  counterpartyContacts           CounterpartyContact[]
  priceLists                     PriceList[]
  productPrices                  ProductPrice[]
  salesOrders                    SalesOrder[]
  salesOrderLines                SalesOrderLine[]
  salesInvoices                  SalesInvoice[]
  salesInvoiceLines              SalesInvoiceLine[]
  chartsOfAccounts               ChartOfAccounts[]
  accounts                       Account[]
  accountingDimensionDefinitions AccountingDimensionDefinition[]
  accountingMappings             AccountingMapping[]
  journalEntries                 JournalEntry[]
  accountingMovements            AccountingMovement[]
  postingRuns                    PostingRun[]
  taxRules                       TaxRule[]
  taxRegistrations               TaxRegistration[]
  productTaxProfiles             ProductTaxProfile[]
  counterpartyTaxProfiles        CounterpartyTaxProfile[]
  taxMovements                   TaxMovement[]
  customerRequests               CustomerRequest[]
  customerRequestLines           CustomerRequestLine[]
  commercialOffers               CommercialOffer[]
  commercialOfferLines           CommercialOfferLine[]
  documentLineLinks              DocumentLineLink[]
  stockReservations              StockReservation[]
  shipmentPlans                  ShipmentPlan[]
  shipmentPlanLines              ShipmentPlanLine[]
  orderPaymentSchedules          OrderPaymentSchedule[]
  orderHolds                     OrderHold[]

  @@map("tenants")
}

/// Organization = the legal accounting/business entity under a tenant
/// (Phase 1, section 3). A tenant may contain one or many organizations;
/// this is the structural root everything else in Phase 1 hangs off.
model Organization {
  id                 String  @id @default(uuid())
  tenantId           String  @map("tenant_id")
  code               String
  name               String
  fullLegalName      String? @map("full_legal_name")
  shortName          String? @map("short_name")
  legalForm          String? @map("legal_form")
  taxId              String? @map("tax_id")
  registrationNumber String? @map("registration_number")
  countryCode        String  @default("AZ") @map("country_code")
  registeredAddress  String? @map("registered_address")
  actualAddress      String? @map("actual_address")
  phone              String?
  email              String?
  website            String?
  baseCurrencyId     String? @map("base_currency_id")
  timezone           String  @default("Asia/Baku")
  locale             String  @default("az-AZ")
  defaultLanguage    String  @default("az") @map("default_language")
  active             Boolean @default(true)

  // Organization-level defaults (section 5/31). Each FK is validated at the
  // service layer to belong to this same organization before being set —
  // never trust these across organizations.
  defaultBranchId      String? @map("default_branch_id")
  defaultWarehouseId   String? @map("default_warehouse_id")
  defaultCashboxId     String? @map("default_cashbox_id")
  defaultBankAccountId String? @map("default_bank_account_id")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  baseCurrency Currency? @relation("OrganizationBaseCurrency", fields: [baseCurrencyId], references: [id])

  defaultBranch      Branch?      @relation("OrgDefaultBranch", fields: [defaultBranchId], references: [id])
  defaultWarehouse   Warehouse?   @relation("OrgDefaultWarehouse", fields: [defaultWarehouseId], references: [id])
  defaultCashbox     Cashbox?     @relation("OrgDefaultCashbox", fields: [defaultCashboxId], references: [id])
  defaultBankAccount BankAccount? @relation("OrgDefaultBankAccount", fields: [defaultBankAccountId], references: [id])

  periods             AccountingPeriod[]
  branches            Branch[]             @relation("OrgBranches")
  departments         Department[]         @relation("OrgDepartments")
  warehouses          Warehouse[]          @relation("OrgWarehouses")
  cashboxes           Cashbox[]            @relation("OrgCashboxes")
  bankAccounts        BankAccount[]        @relation("OrgBankAccounts")
  accountingPolicies  AccountingPolicy[]   @relation("OrgAccountingPolicies")
  taxProfiles         TaxProfile[]         @relation("OrgTaxProfiles")
  accessGrants        OrganizationAccess[]
  productCategories   ProductCategory[]
  products            Product[]
  counterparties      Counterparty[]
  priceLists          PriceList[]
  salesOrders         SalesOrder[]
  salesInvoices       SalesInvoice[]
  chartsOfAccounts    ChartOfAccounts[]
  accounts            Account[]
  accountingMappings  AccountingMapping[]
  journalEntries      JournalEntry[]
  accountingMovements AccountingMovement[]
  postingRuns         PostingRun[]
  taxRegistrations    TaxRegistration[]
  productTaxProfiles  ProductTaxProfile[]
  taxMovements        TaxMovement[]
  customerRequests    CustomerRequest[]
  commercialOffers    CommercialOffer[]
  stockReservations   StockReservation[]
  shipmentPlans       ShipmentPlan[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, active])
  @@map("organizations")
}

/// Optional operating subdivision of an Organization (section 6).
model Branch {
  id              String  @id @default(uuid())
  tenantId        String  @map("tenant_id")
  organizationId  String  @map("organization_id")
  code            String
  name            String
  address         String?
  phone           String?
  email           String?
  managerPersonId String? @map("manager_person_id")
  active          Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  organization Organization       @relation("OrgBranches", fields: [organizationId], references: [id])
  manager      ResponsiblePerson? @relation(fields: [managerPersonId], references: [id])

  departments             Department[]
  warehouses              Warehouse[]
  cashboxes               Cashbox[]
  defaultForOrganizations Organization[] @relation("OrgDefaultBranch")

  @@unique([organizationId, code])
  @@index([organizationId, active])
  @@map("branches")
}

/// Hierarchical department within an Organization (section 7/8).
model Department {
  id                 String  @id @default(uuid())
  tenantId           String  @map("tenant_id")
  organizationId     String  @map("organization_id")
  branchId           String? @map("branch_id")
  parentDepartmentId String? @map("parent_department_id")
  code               String
  name               String
  managerPersonId    String? @map("manager_person_id")
  active             Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  organization     Organization       @relation("OrgDepartments", fields: [organizationId], references: [id])
  branch           Branch?            @relation(fields: [branchId], references: [id])
  parentDepartment Department?        @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id])
  children         Department[]       @relation("DepartmentHierarchy")
  manager          ResponsiblePerson? @relation(fields: [managerPersonId], references: [id])

  @@unique([organizationId, code])
  @@index([organizationId, parentDepartmentId])
  @@index([organizationId, active])
  @@map("departments")
}

/// Lightweight, tenant-global responsible-person reference (section 9/10) —
/// NOT the future Phase 17 Employee model. May optionally link to a system
/// User but is never required to.
model ResponsiblePerson {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  displayName String  @map("display_name")
  email       String?
  phone       String?
  userId      String? @map("user_id")
  active      Boolean @default(true)
  notes       String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  version   Int      @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  managedBranches    Branch[]
  managedDepartments Department[]
  managedWarehouses  Warehouse[]
  managedCashboxes   Cashbox[]
  customerRequests   CustomerRequest[]

  @@index([tenantId, active])
  @@map("responsible_persons")
}

/// Structural warehouse master data ONLY (section 11/12) — no stock
/// balances or movements until Phase 10.
model Warehouse {
  id                  String  @id @default(uuid())
  tenantId            String  @map("tenant_id")
  organizationId      String  @map("organization_id")
  branchId            String? @map("branch_id")
  code                String
  name                String
  warehouseType       String  @default("STANDARD") @map("warehouse_type")
  address             String?
  responsiblePersonId String? @map("responsible_person_id")
  allowNegativeStock  Boolean @default(false) @map("allow_negative_stock")
  active              Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  organization Organization       @relation("OrgWarehouses", fields: [organizationId], references: [id])
  branch       Branch?            @relation(fields: [branchId], references: [id])
  responsible  ResponsiblePerson? @relation(fields: [responsiblePersonId], references: [id])

  defaultForOrganizations Organization[]     @relation("OrgDefaultWarehouse")
  salesOrders             SalesOrder[]
  stockReservations       StockReservation[]
  shipmentPlans           ShipmentPlan[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
  @@index([organizationId, branchId])
  @@map("warehouses")
}

/// Structural cashbox master data ONLY (section 13) — no cash balances or
/// movements until Phase 15.
model Cashbox {
  id                  String  @id @default(uuid())
  tenantId            String  @map("tenant_id")
  organizationId      String  @map("organization_id")
  branchId            String? @map("branch_id")
  code                String
  name                String
  currencyId          String  @map("currency_id")
  responsiblePersonId String? @map("responsible_person_id")
  active              Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  organization Organization       @relation("OrgCashboxes", fields: [organizationId], references: [id])
  branch       Branch?            @relation(fields: [branchId], references: [id])
  currency     Currency           @relation(fields: [currencyId], references: [id])
  responsible  ResponsiblePerson? @relation(fields: [responsiblePersonId], references: [id])

  defaultForOrganizations Organization[] @relation("OrgDefaultCashbox")

  @@unique([organizationId, code])
  @@index([organizationId, active])
  @@map("cashboxes")
}

/// Organization bank account MASTER DATA ONLY (section 14/15) — no
/// statements/payments/reconciliation until Phase 14.
model BankAccount {
  id                   String    @id @default(uuid())
  tenantId             String    @map("tenant_id")
  organizationId       String    @map("organization_id")
  bankName             String    @map("bank_name")
  bankCode             String?   @map("bank_code")
  branchName           String?   @map("branch_name")
  accountName          String    @map("account_name")
  iban                 String
  swiftBic             String?   @map("swift_bic")
  currencyId           String    @map("currency_id")
  correspondentAccount String?   @map("correspondent_account")
  accountType          String    @default("CURRENT") @map("account_type")
  isDefault            Boolean   @default(false) @map("is_default")
  active               Boolean   @default(true)
  openedDate           DateTime? @map("opened_date") @db.Date
  closedDate           DateTime? @map("closed_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  organization Organization @relation("OrgBankAccounts", fields: [organizationId], references: [id])
  currency     Currency     @relation(fields: [currencyId], references: [id])

  defaultForOrganizations Organization[] @relation("OrgDefaultBankAccount")

  @@index([organizationId, active])
  @@index([iban])
  @@map("bank_accounts")
}

/// Accounting policy METADATA + effective dating ONLY (section 16-18) — no
/// chart of accounts / journal entries / posting rules until Phase 4.
model AccountingPolicy {
  id                     String    @id @default(uuid())
  tenantId               String    @map("tenant_id")
  organizationId         String    @map("organization_id")
  code                   String
  name                   String
  validFrom              DateTime  @map("valid_from") @db.Date
  validTo                DateTime? @map("valid_to") @db.Date
  status                 String    @default("ACTIVE")
  inventoryCostingMethod String    @default("WEIGHTED_AVERAGE") @map("inventory_costing_method")
  baseCurrencyId         String?   @map("base_currency_id")
  taxProfileId           String?   @map("tax_profile_id")
  settings               Json?
  active                 Boolean   @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  organization Organization @relation("OrgAccountingPolicies", fields: [organizationId], references: [id])
  baseCurrency Currency?    @relation(fields: [baseCurrencyId], references: [id])
  taxProfile   TaxProfile?  @relation(fields: [taxProfileId], references: [id])

  @@unique([organizationId, code, validFrom])
  @@index([organizationId, validFrom, validTo])
  @@map("accounting_policies")
}

/// Organization tax identity/configuration FOUNDATION ONLY (section 19) —
/// no VAT rates / tax calculation / tax posting until Phase 5.
model TaxProfile {
  id                    String    @id @default(uuid())
  tenantId              String    @map("tenant_id")
  organizationId        String    @map("organization_id")
  code                  String
  name                  String
  countryCode           String    @default("AZ") @map("country_code")
  taxId                 String?   @map("tax_id")
  vatRegistered         Boolean   @default(false) @map("vat_registered")
  vatRegistrationDate   DateTime? @map("vat_registration_date") @db.Date
  vatDeregistrationDate DateTime? @map("vat_deregistration_date") @db.Date
  taxRegimeCode         String?   @map("tax_regime_code")
  validFrom             DateTime  @map("valid_from") @db.Date
  validTo               DateTime? @map("valid_to") @db.Date
  active                Boolean   @default(true)
  metadata              Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  version   Int      @default(1)

  organization       Organization       @relation("OrgTaxProfiles", fields: [organizationId], references: [id])
  accountingPolicies AccountingPolicy[]

  @@unique([organizationId, code, validFrom])
  @@index([organizationId, validFrom, validTo])
  @@map("tax_profiles")
}

/// Organization-scoped access grant (section 22): a tenant membership does
/// NOT automatically have access to every organization in the tenant —
/// access must be explicitly granted per organization.
model OrganizationAccess {
  id                 String @id @default(uuid())
  tenantMembershipId String @map("tenant_membership_id")
  organizationId     String @map("organization_id")
  accessLevel        String @default("FULL") @map("access_level")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  membership   TenantMembership @relation(fields: [tenantMembershipId], references: [id])
  organization Organization     @relation(fields: [organizationId], references: [id])

  @@unique([tenantMembershipId, organizationId])
  @@index([organizationId])
  @@map("organization_access")
}

enum MembershipStatus {
  ACTIVE
  DISABLED
  INVITED
}

/// Global system user, independent from tenant membership/authorization.
model User {
  id            String           @id @default(uuid())
  email         String           @unique
  passwordHash  String           @map("password_hash")
  displayName   String           @map("display_name")
  status        MembershipStatus @default(ACTIVE)
  locale        String           @default("az-AZ")
  timezone      String?
  isSystemAdmin Boolean          @default(false) @map("is_system_admin")
  lastLoginAt   DateTime?        @map("last_login_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships        TenantMembership[]
  refreshTokens      RefreshToken[]
  responsiblePersons ResponsiblePerson[]

  @@map("users")
}

/// A user's membership inside a single tenant. Authorization (roles) is
/// attached here, never on the global User — a user may have different
/// rights in different tenants.
model TenantMembership {
  id         String           @id @default(uuid())
  tenantId   String           @map("tenant_id")
  userId     String           @map("user_id")
  status     MembershipStatus @default(ACTIVE)
  joinedAt   DateTime         @default(now()) @map("joined_at")
  disabledAt DateTime?        @map("disabled_at")

  tenant             Tenant               @relation(fields: [tenantId], references: [id])
  user               User                 @relation(fields: [userId], references: [id])
  roles              MembershipRole[]
  organizationAccess OrganizationAccess[]

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("tenant_memberships")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

// ----------------------------------------------------------------------------
// 6. ROLE BASED ACCESS CONTROL
// ----------------------------------------------------------------------------

/// Role is tenant-scoped (tenantId null => a system-level role template,
/// e.g. the seeded "Tenant Administrator" role definition source).
model Role {
  id          String  @id @default(uuid())
  tenantId    String? @map("tenant_id")
  code        String
  name        String
  description String?
  isSystem    Boolean @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at")

  tenant      Tenant?          @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  memberships MembershipRole[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("roles")
}

/// Explicit machine-readable permission codes (never hardcoded role-name checks).
model Permission {
  id          String  @id @default(uuid())
  code        String  @unique
  description String?
  module      String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Multiple roles per membership.
model MembershipRole {
  membershipId String @map("membership_id")
  roleId       String @map("role_id")

  membership TenantMembership @relation(fields: [membershipId], references: [id])
  role       Role             @relation(fields: [roleId], references: [id])

  assignedAt DateTime @default(now()) @map("assigned_at")

  @@id([membershipId, roleId])
  @@map("membership_roles")
}

// ----------------------------------------------------------------------------
// 3.4 / 52. ENUMERATION FOUNDATION
// Stable, language-neutral codes for extensible business enumerations.
// Closed, structurally-critical state machines (document/posting/period
// status) additionally use native Prisma enums below for compile-time
// safety; EnumType/EnumValue covers the open-ended, display-facing ones
// (e.g. currency rate type, numbering reset policy) and localized labels.
// ----------------------------------------------------------------------------

model EnumType {
  id          String  @id @default(uuid())
  code        String  @unique
  description String?

  values EnumValue[]

  @@map("enum_types")
}

model EnumValue {
  id         String  @id @default(uuid())
  enumTypeId String  @map("enum_type_id")
  code       String
  sortOrder  Int     @default(0) @map("sort_order")
  active     Boolean @default(true)

  enumType     EnumType               @relation(fields: [enumTypeId], references: [id])
  translations EnumValueTranslation[]

  @@unique([enumTypeId, code])
  @@map("enum_values")
}

model EnumValueTranslation {
  id          String @id @default(uuid())
  enumValueId String @map("enum_value_id")
  locale      String
  label       String

  enumValue EnumValue @relation(fields: [enumValueId], references: [id])

  @@unique([enumValueId, locale])
  @@map("enum_value_translations")
}

// ----------------------------------------------------------------------------
// 17/18. CURRENCY & EXCHANGE RATE FOUNDATION
// ----------------------------------------------------------------------------

/// Global currency master data (ISO 4217). Not tenant-owned: currencies are
/// shared reference data, but a Tenant may additionally register a
/// tenant-specific currency via `TenantCurrencies` if genuinely required.
model Currency {
  id            String  @id @default(uuid())
  code          String  @unique // ISO 4217 alpha code, e.g. AZN
  numericCode   String? @map("numeric_code")
  name          String
  symbol        String?
  decimalPlaces Int     @default(2) @map("decimal_places")
  active        Boolean @default(true)

  tenantsUsingAsBase Tenant[]
  tenantOverrides    Tenant[]       @relation("TenantCurrencies")
  exchangeRatesFrom  ExchangeRate[] @relation("FromCurrency")
  exchangeRatesTo    ExchangeRate[] @relation("ToCurrency")

  organizationsUsingAsBase Organization[]         @relation("OrganizationBaseCurrency")
  cashboxes                Cashbox[]
  bankAccounts             BankAccount[]
  accountingPolicies       AccountingPolicy[]
  counterparties           Counterparty[]
  priceLists               PriceList[]
  salesOrders              SalesOrder[]
  salesInvoices            SalesInvoice[]
  journalEntryLines        JournalEntryLine[]
  accountingMovements      AccountingMovement[]
  customerRequests         CustomerRequest[]
  commercialOffers         CommercialOffer[]
  orderPaymentSchedules    OrderPaymentSchedule[]

  @@map("currencies")
}

model ExchangeRate {
  id             String   @id @default(uuid())
  tenantId       String?  @map("tenant_id") // null = system-level shared rate
  currencyId     String   @map("currency_id")
  baseCurrencyId String   @map("base_currency_id")
  effectiveDate  DateTime @map("effective_date") @db.Date
  rate           Decimal  @db.Decimal(24, 10)
  multiplier     Decimal  @default(1) @db.Decimal(18, 6)
  divisor        Decimal  @default(1) @db.Decimal(18, 6)
  rateType       String   @default("OFFICIAL") @map("rate_type")
  source         String?

  createdAt DateTime @default(now()) @map("created_at")

  tenant       Tenant?  @relation(fields: [tenantId], references: [id])
  currency     Currency @relation("FromCurrency", fields: [currencyId], references: [id])
  baseCurrency Currency @relation("ToCurrency", fields: [baseCurrencyId], references: [id])

  @@unique([tenantId, currencyId, baseCurrencyId, effectiveDate, rateType], map: "uq_exchange_rate_scope")
  @@index([tenantId, currencyId, effectiveDate])
  @@map("exchange_rates")
}

// ----------------------------------------------------------------------------
// 15/16. NUMBERING ENGINE
// ----------------------------------------------------------------------------

model NumberSequence {
  id           String  @id @default(uuid())
  tenantId     String  @map("tenant_id")
  code         String
  documentType String  @map("document_type")
  prefix       String  @default("")
  suffix       String? @default("")
  nextNumber   BigInt  @default(1) @map("next_number")
  padding      Int     @default(6)
  resetPolicy  String  @default("NEVER") @map("reset_policy") // NEVER | YEARLY | MONTHLY
  scopeType    String  @default("TENANT_DOCUMENT_TYPE") @map("scope_type")
  currentYear  Int?    @map("current_year")
  currentMonth Int?    @map("current_month")
  active       Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  version   Int      @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
  @@index([tenantId, documentType])
  @@map("number_sequences")
}

// ----------------------------------------------------------------------------
// 20/21/22. ACCOUNTING / BUSINESS PERIOD FOUNDATION
// ----------------------------------------------------------------------------

enum PeriodStatus {
  OPEN
  SOFT_CLOSED
  CLOSED
}

model AccountingPeriod {
  id             String       @id @default(uuid())
  tenantId       String       @map("tenant_id")
  organizationId String?      @map("organization_id")
  year           Int
  month          Int
  startDate      DateTime     @map("start_date") @db.Date
  endDate        DateTime     @map("end_date") @db.Date
  status         PeriodStatus @default(OPEN)
  closedAt       DateTime?    @map("closed_at")
  closedBy       String?      @map("closed_by")
  reopenedAt     DateTime?    @map("reopened_at")
  reopenedBy     String?      @map("reopened_by")
  version        Int          @default(1)

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@unique([tenantId, organizationId, year, month])
  @@index([tenantId, startDate, endDate])
  @@map("accounting_periods")
}

// ----------------------------------------------------------------------------
// 23/24/25. AUDIT INFRASTRUCTURE
// ----------------------------------------------------------------------------

model AuditEvent {
  id             String   @id @default(uuid())
  tenantId       String?  @map("tenant_id") // null only for platform/system-admin events
  eventType      String   @map("event_type")
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  action         String
  userId         String?  @map("user_id")
  timestamp      DateTime @default(now())
  requestId      String?  @map("request_id")
  correlationId  String?  @map("correlation_id")
  ipAddress      String?  @map("ip_address")
  clientMetadata Json?    @map("client_metadata")
  oldValues      Json?    @map("old_values")
  newValues      Json?    @map("new_values")
  metadata       Json?
  reason         String?

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, timestamp])
  @@map("audit_events")
}

// ----------------------------------------------------------------------------
// 26/27/28/29. DOCUMENT RELATIONSHIP FOUNDATION / CREATE BASED ON / REVERSAL
// ----------------------------------------------------------------------------

model DocumentLink {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  sourceDocumentType String   @map("source_document_type")
  sourceDocumentId   String   @map("source_document_id")
  targetDocumentType String   @map("target_document_type")
  targetDocumentId   String   @map("target_document_id")
  relationType       String   @map("relation_type") // CREATED_BASED_ON | RELATED | REVERSAL_OF | CORRECTION_OF
  createdAt          DateTime @default(now()) @map("created_at")
  createdBy          String?  @map("created_by")
  metadata           Json?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, sourceDocumentType, sourceDocumentId])
  @@index([tenantId, targetDocumentType, targetDocumentId])
  @@map("document_links")
}

// ----------------------------------------------------------------------------
// 32/33. CONFIGURATION / SETTINGS (scoped + effective-dated)
// ----------------------------------------------------------------------------

enum SettingScope {
  SYSTEM
  TENANT
  ORGANIZATION
}

/// Effective-dated, scoped settings. Resolution picks the row whose scope
/// matches and whose [validFrom, validTo) window contains the business date
/// in question (see SettingsService.resolve()).
model Setting {
  id        String       @id @default(uuid())
  scope     SettingScope
  scopeId   String?      @map("scope_id") // null for SYSTEM scope
  key       String
  value     Json
  validFrom DateTime     @default(dbgenerated("'1970-01-01'")) @map("valid_from") @db.Date
  validTo   DateTime?    @map("valid_to") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant Tenant? @relation(fields: [scopeId], references: [id], map: "settings_tenant_scope_fkey")

  @@index([scope, scopeId, key, validFrom])
  @@map("settings")
}

// ----------------------------------------------------------------------------
// 36. IDEMPOTENCY FOUNDATION
// ----------------------------------------------------------------------------

model IdempotencyKey {
  id           String  @id @default(uuid())
  tenantId     String? @map("tenant_id")
  key          String
  operation    String
  requestHash  String  @map("request_hash")
  status       String  @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED | FAILED
  resultRef    String? @map("result_ref")
  responseBody Json?   @map("response_body")

  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime? @map("expires_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key, operation])
  @@map("idempotency_keys")
}

// ----------------------------------------------------------------------------
// 3.3 / 64. REGISTER FOUNDATION (contracts only — no business registers yet)
// A generic movement table used solely by the demo posting handler to prove
// the posting framework end to end. Real business registers (Stock,
// Settlement, Accounting, Payroll...) will define their own strongly-typed
// tables in later phases and reuse this same recorder/ownership shape.
// ----------------------------------------------------------------------------

model RegisterMovement {
  id                   String   @id @default(uuid())
  tenantId             String   @map("tenant_id")
  registerCode         String   @map("register_code")
  recorderDocumentType String   @map("recorder_document_type")
  recorderDocumentId   String   @map("recorder_document_id")
  recorderLineId       String?  @map("recorder_line_id")
  businessDate         DateTime @map("business_date") @db.Date
  postingTimestamp     DateTime @default(now()) @map("posting_timestamp")
  sequence             BigInt
  movementType         String?  @map("movement_type")
  dimensions           Json?
  resources            Json?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, recorderDocumentType, recorderDocumentId])
  @@index([tenantId, registerCode, businessDate])
  @@map("register_movements")
}

// ----------------------------------------------------------------------------
// 8/9/10/58. DOCUMENT BASE MODEL — DEMO/REFERENCE DOCUMENT
//
// FoundationTestDocument is the ONLY concrete document table in Phase 0.
// It exists purely to exercise the framework (save/post/unpost/numbering/
// audit/period-guard/document-links) end to end. It must not be treated as
// a production business feature. Every field below mirrors the reusable
// BaseDocument contract defined in `src/document-framework/base-document.ts`
// — later phases copy this same field set into their own concrete tables
// rather than inheriting from a single generic "documents" table.
// ----------------------------------------------------------------------------

enum DocumentStatus {
  DRAFT
  ACTIVE
  CANCELLED
  DELETION_MARKED
}

enum PostingStatus {
  NOT_POSTED
  POSTED
  POSTING_FAILED
}

model FoundationTestDocument {
  id             String         @id @default(uuid())
  tenantId       String         @map("tenant_id")
  organizationId String?        @map("organization_id")
  documentType   String         @default("FOUNDATION_TEST_DOCUMENT") @map("document_type")
  number         String?
  documentDate   DateTime       @map("document_date") @db.Date
  postingDate    DateTime?      @map("posting_date") @db.Date
  status         DocumentStatus @default(DRAFT)
  postingStatus  PostingStatus  @default(NOT_POSTED) @map("posting_status")
  currencyId     String?        @map("currency_id")
  exchangeRate   Decimal?       @map("exchange_rate") @db.Decimal(24, 10)
  amount         Decimal        @default(0) @db.Decimal(18, 2)
  description    String?

  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by")
  postedAt     DateTime? @map("posted_at")
  postedBy     String?   @map("posted_by")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelledBy  String?   @map("cancelled_by")
  deletionMark Boolean   @default(false) @map("deletion_mark")
  version      Int       @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, number])
  @@index([tenantId, documentDate])
  @@index([tenantId, status])
  @@map("foundation_test_documents")
}

// ----------------------------------------------------------------------------
// PHASE 2 — PRODUCT/NOMENCLATURE MASTER DATA
//
// Foundation for product catalog management: units of measure, product
// categories (hierarchical), and products. This is master data only —
// no inventory movements, pricing, or stock balances yet (those belong
// to later phases). Products are organization-scoped following the Phase 1
// pattern: a product belongs to exactly one organization.
// ----------------------------------------------------------------------------

/// Unit of Measure — tenant-level shared resource (section 79).
/// Basic measurement units (kg, piece, liter, meter, etc.) that products
/// reference. No conversion factors yet (Phase 3+).
model UnitOfMeasure {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  code        String
  name        String
  symbol      String? // kg, pcs, L, m
  unitType    String  @default("QUANTITY") @map("unit_type") // QUANTITY | WEIGHT | VOLUME | LENGTH | AREA | TIME
  description String?
  active      Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  tenant               Tenant                @relation(fields: [tenantId], references: [id])
  products             Product[]
  conversionsFrom      UnitConversion[]      @relation("ConversionFromUnit")
  conversionsTo        UnitConversion[]      @relation("ConversionToUnit")
  productPrices        ProductPrice[]        @relation("ProductPriceUnit")
  salesOrderLines      SalesOrderLine[]      @relation("SalesOrderLineUnit")
  salesInvoiceLines    SalesInvoiceLine[]    @relation("SalesInvoiceLineUnit")
  journalEntryLines    JournalEntryLine[]
  accountingMovements  AccountingMovement[]
  customerRequestLines CustomerRequestLine[] @relation("CustomerRequestLineUnit")
  commercialOfferLines CommercialOfferLine[] @relation("CommercialOfferLineUnit")

  @@unique([tenantId, code])
  @@index([tenantId, active])
  @@map("units_of_measure")
}

/// Product Category — hierarchical classification (section 80).
/// Organization-scoped category tree (parent-child relationships).
/// Cycles are validated at the service layer.
model ProductCategory {
  id               String  @id @default(uuid())
  tenantId         String  @map("tenant_id")
  organizationId   String  @map("organization_id")
  parentCategoryId String? @map("parent_category_id")
  code             String
  name             String
  description      String?
  active           Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  organization    Organization      @relation(fields: [organizationId], references: [id])
  parentCategory  ProductCategory?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id])
  childCategories ProductCategory[] @relation("CategoryHierarchy")
  products        Product[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
  @@index([organizationId, parentCategoryId])
  @@map("product_categories")
}

enum ProductType {
  GOODS // Physical goods (inventory tracked)
  SERVICE // Services (no inventory)
  WORK // Work/labor
  SET // Product set/bundle (Phase 3+)
}

/// Product — organization-scoped product master data (section 81-84).
/// Master data only: no stock balances, no pricing, no supplier/customer
/// references yet (those are Phase 3+). A product's identity must stay
/// stable once transactional documents reference it: deactivate rather
/// than repurpose.
model Product {
  id             String      @id @default(uuid())
  tenantId       String      @map("tenant_id")
  organizationId String      @map("organization_id")
  categoryId     String?     @map("category_id")
  code           String
  name           String
  fullName       String?     @map("full_name")
  productType    ProductType @default(GOODS) @map("product_type")
  baseUnitId     String      @map("base_unit_id") // primary UOM
  description    String?
  sku            String? // Stock Keeping Unit
  barcode        String?
  manufacturer   String?
  brand          String?
  model          String?
  weight         Decimal?    @db.Decimal(18, 6)
  weightUnitId   String?     @map("weight_unit_id")
  volume         Decimal?    @db.Decimal(18, 6)
  volumeUnitId   String?     @map("volume_unit_id")

  // Inventory tracking flags (Phase 10 uses these)
  trackInventory     Boolean @default(true) @map("track_inventory")
  allowNegativeStock Boolean @default(false) @map("allow_negative_stock")

  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  tenant               Tenant                @relation(fields: [tenantId], references: [id])
  organization         Organization          @relation(fields: [organizationId], references: [id])
  category             ProductCategory?      @relation(fields: [categoryId], references: [id])
  baseUnit             UnitOfMeasure         @relation(fields: [baseUnitId], references: [id])
  prices               ProductPrice[]
  salesOrderLines      SalesOrderLine[]
  salesInvoiceLines    SalesInvoiceLine[]
  taxProfiles          ProductTaxProfile[]
  customerRequestLines CustomerRequestLine[]
  commercialOfferLines CommercialOfferLine[]
  stockReservations    StockReservation[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
  @@index([organizationId, categoryId])
  @@index([tenantId, sku])
  @@index([tenantId, barcode])
  @@map("products")
}

// ----------------------------------------------------------------------------
// PHASE 3 — COUNTERPARTY MASTER DATA + PRICING
//
// Foundation for customer/supplier management and pricing: unit conversions,
// counterparties (customers, suppliers, both), contact persons, addresses,
// price lists, and product prices. This is master data only — no sales orders,
// purchase orders, invoices, or payments yet (those belong to Phase 4+).
// ----------------------------------------------------------------------------

/// Unit Conversion — defines conversion factors between units (section 85).
/// Example: 1 kg = 1000 g, 1 box = 12 pieces
/// Conversions are tenant-scoped since measurement standards are standardized
/// at the tenant level.
model UnitConversion {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  fromUnitId  String  @map("from_unit_id")
  toUnitId    String  @map("to_unit_id")
  factor      Decimal @db.Decimal(18, 6) // fromUnit * factor = toUnit
  description String?
  active      Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  fromUnit UnitOfMeasure @relation("ConversionFromUnit", fields: [fromUnitId], references: [id])
  toUnit   UnitOfMeasure @relation("ConversionToUnit", fields: [toUnitId], references: [id])

  @@unique([tenantId, fromUnitId, toUnitId])
  @@index([tenantId, active])
  @@map("unit_conversions")
}

enum CounterpartyType {
  CUSTOMER // Sells to
  SUPPLIER // Buys from
  BOTH // Both customer and supplier
}

/// Counterparty — organization-scoped customer/supplier master data (section 86-89).
/// A counterparty can be a customer, supplier, or both. This is master data only:
/// no invoices, orders, or payment history yet (Phase 4+).
model Counterparty {
  id                 String           @id @default(uuid())
  tenantId           String           @map("tenant_id")
  organizationId     String           @map("organization_id")
  counterpartyType   CounterpartyType @map("counterparty_type")
  code               String
  name               String
  fullLegalName      String?          @map("full_legal_name")
  taxId              String?          @map("tax_id")
  registrationNumber String?          @map("registration_number")
  phone              String?
  email              String?
  website            String?
  paymentTerms       Int?             @map("payment_terms") // days
  creditLimit        Decimal?         @map("credit_limit") @db.Decimal(18, 2)
  currencyId         String?          @map("currency_id")
  notes              String?
  active             Boolean          @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  tenant           Tenant                  @relation(fields: [tenantId], references: [id])
  organization     Organization            @relation(fields: [organizationId], references: [id])
  currency         Currency?               @relation(fields: [currencyId], references: [id])
  addresses        CounterpartyAddress[]
  contacts         CounterpartyContact[]
  priceLists       PriceList[]
  salesOrders      SalesOrder[]
  salesInvoices    SalesInvoice[]
  taxProfile       CounterpartyTaxProfile?
  customerRequests CustomerRequest[]
  commercialOffers CommercialOffer[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
  @@index([organizationId, counterpartyType])
  @@index([tenantId, taxId])
  @@map("counterparties")
}

enum AddressType {
  LEGAL // Legal/registered address
  SHIPPING // Shipping address
  BILLING // Billing address
  OTHER // Other
}

/// Counterparty Address — delivery/billing addresses for counterparties.
model CounterpartyAddress {
  id             String      @id @default(uuid())
  tenantId       String      @map("tenant_id")
  counterpartyId String      @map("counterparty_id")
  addressType    AddressType @map("address_type")
  addressLine1   String      @map("address_line1")
  addressLine2   String?     @map("address_line2")
  city           String
  stateProvince  String?     @map("state_province")
  postalCode     String?     @map("postal_code")
  countryCode    String      @default("AZ") @map("country_code")
  isDefault      Boolean     @default(false) @map("is_default")
  active         Boolean     @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  counterparty Counterparty @relation(fields: [counterpartyId], references: [id])

  @@index([counterpartyId, active])
  @@index([counterpartyId, isDefault])
  @@map("counterparty_addresses")
}

/// Counterparty Contact — contact persons for counterparties.
model CounterpartyContact {
  id             String  @id @default(uuid())
  tenantId       String  @map("tenant_id")
  counterpartyId String  @map("counterparty_id")
  firstName      String  @map("first_name")
  lastName       String  @map("last_name")
  position       String?
  phone          String?
  mobile         String?
  email          String?
  isPrimary      Boolean @default(false) @map("is_primary")
  notes          String?
  active         Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  counterparty Counterparty @relation(fields: [counterpartyId], references: [id])

  @@index([counterpartyId, active])
  @@index([counterpartyId, isPrimary])
  @@map("counterparty_contacts")
}

enum PriceListType {
  SALE // Sales price list
  PURCHASE // Purchase price list
}

/// Price List — organization-scoped pricing rules (section 90-92).
/// A price list defines prices for products, optionally for specific
/// counterparties, categories, or date ranges. Effective-dated.
model PriceList {
  id             String        @id @default(uuid())
  tenantId       String        @map("tenant_id")
  organizationId String        @map("organization_id")
  priceListType  PriceListType @map("price_list_type")
  code           String
  name           String
  description    String?
  currencyId     String        @map("currency_id")
  validFrom      DateTime      @map("valid_from") @db.Date
  validTo        DateTime?     @map("valid_to") @db.Date
  counterpartyId String?       @map("counterparty_id") // null = applies to all
  priority       Int           @default(0) // higher priority wins
  includesTax    Boolean       @default(false) @map("includes_tax")
  active         Boolean       @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  organization Organization   @relation(fields: [organizationId], references: [id])
  currency     Currency       @relation(fields: [currencyId], references: [id])
  counterparty Counterparty?  @relation(fields: [counterpartyId], references: [id])
  prices       ProductPrice[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
  @@index([organizationId, priceListType, validFrom, validTo])
  @@index([organizationId, counterpartyId])
  @@map("price_lists")
}

/// Product Price — individual product prices within a price list.
model ProductPrice {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  priceListId String   @map("price_list_id")
  productId   String   @map("product_id")
  unitId      String   @map("unit_id") // can be different from product's base unit
  price       Decimal  @db.Decimal(18, 6)
  minQuantity Decimal  @default(1) @map("min_quantity") @db.Decimal(18, 6)
  maxQuantity Decimal? @map("max_quantity") @db.Decimal(18, 6)
  active      Boolean  @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  priceList PriceList     @relation(fields: [priceListId], references: [id])
  product   Product       @relation(fields: [productId], references: [id])
  unit      UnitOfMeasure @relation("ProductPriceUnit", fields: [unitId], references: [id])

  @@unique([priceListId, productId, unitId, minQuantity])
  @@index([priceListId, active])
  @@index([productId, active])
  @@map("product_prices")
}

// ----------------------------------------------------------------------------
// PHASE 4 — SALES DOCUMENTS (ORDERS + INVOICES)
//
// First real business documents on the DocumentFramework: SalesOrder and
// SalesInvoice with line items. Header field set mirrors BaseDocumentFields
// (same shape as FoundationTestDocument) plus counterparty, currency, and
// totals snapshotted at save time. Prices snapshot resolvePrice() output at
// save — posting never re-resolves prices.
// ----------------------------------------------------------------------------

/// Sales Order — customer order document (DRAFT -> POSTED reserves nothing
/// yet; stock reservation is a later phase concern).
model SalesOrder {
  id               String         @id @default(uuid())
  tenantId         String         @map("tenant_id")
  organizationId   String         @map("organization_id")
  counterpartyId   String         @map("counterparty_id")
  documentType     String         @default("SALES_ORDER") @map("document_type")
  number           String?
  documentDate     DateTime       @map("document_date") @db.Date
  postingDate      DateTime?      @map("posting_date") @db.Date
  status           DocumentStatus @default(DRAFT)
  postingStatus    PostingStatus  @default(NOT_POSTED) @map("posting_status")
  currencyId       String?        @map("currency_id")
  exchangeRate     Decimal?       @map("exchange_rate") @db.Decimal(24, 10)
  subtotal         Decimal        @default(0) @db.Decimal(18, 2)
  taxTotal         Decimal        @default(0) @map("tax_total") @db.Decimal(18, 2)
  grandTotal       Decimal        @default(0) @map("grand_total") @db.Decimal(18, 2)
  priceIncludesTax Boolean        @default(false) @map("price_includes_tax")
  description      String?

  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by")
  postedAt     DateTime? @map("posted_at")
  postedBy     String?   @map("posted_by")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelledBy  String?   @map("cancelled_by")
  deletionMark Boolean   @default(false) @map("deletion_mark")
  version      Int       @default(1)

  // Phase 6 — Sales Pre-Order & Order Management: SalesOrder serves as this
  // spec's CustomerOrder (it already has no accounting consequence, which
  // is exactly what CustomerOrder requires — see docs/SALES_PREORDER.md
  // for the full mapping rationale rather than a duplicate table).
  // `postingStatus = POSTED` IS the CONFIRMED state (spec section 22's
  // ConfirmCustomerOrder command reuses the existing document-framework
  // post command, with SalesOrderPostingHandler.validateForPosting
  // carrying the Phase 6 confirmation checks).
  fulfillmentStatus     String    @default("NOT_STARTED") @map("fulfillment_status")
  reservationStatus     String    @default("NOT_RESERVED") @map("reservation_status")
  orderPaymentStatus    String    @default("NOT_PAID") @map("order_payment_status")
  creditStatus          String    @default("NOT_CHECKED") @map("credit_status")
  approvalStatus        String    @default("NOT_REQUIRED") @map("approval_status")
  salesChannel          String?   @map("sales_channel")
  priority              String    @default("NORMAL")
  externalReference     String?   @map("external_reference")
  requestedDeliveryDate DateTime? @map("requested_delivery_date") @db.Date
  promisedDeliveryDate  DateTime? @map("promised_delivery_date") @db.Date
  warehouseId           String?   @map("warehouse_id")
  shipmentPaymentPolicy String    @default("NO_RESTRICTION") @map("shipment_payment_policy")
  sourceOfferId         String?   @map("source_offer_id")

  tenant          Tenant                 @relation(fields: [tenantId], references: [id])
  organization    Organization           @relation(fields: [organizationId], references: [id])
  counterparty    Counterparty           @relation(fields: [counterpartyId], references: [id])
  currency        Currency?              @relation(fields: [currencyId], references: [id])
  warehouse       Warehouse?             @relation(fields: [warehouseId], references: [id])
  sourceOffer     CommercialOffer?       @relation(fields: [sourceOfferId], references: [id])
  lines           SalesOrderLine[]
  holds           OrderHold[]
  paymentSchedule OrderPaymentSchedule[]
  ShipmentPlan    ShipmentPlan[]

  @@unique([tenantId, number])
  @@index([tenantId, documentDate])
  @@index([tenantId, status])
  @@index([organizationId, counterpartyId])
  @@index([organizationId, fulfillmentStatus])
  @@index([organizationId, creditStatus])
  @@map("sales_orders")
}

model SalesOrderLine {
  id               String  @id @default(uuid())
  tenantId         String  @map("tenant_id")
  salesOrderId     String  @map("sales_order_id")
  position         Int     @default(0)
  productId        String  @map("product_id")
  unitId           String  @map("unit_id")
  quantity         Decimal @db.Decimal(18, 6)
  price            Decimal @db.Decimal(18, 6)
  lineTotal        Decimal @map("line_total") @db.Decimal(18, 2)
  taxRate          Decimal @default(0) @map("tax_rate") @db.Decimal(18, 2)
  taxAmount        Decimal @default(0) @map("tax_amount") @db.Decimal(18, 2)
  lineTotalWithTax Decimal @default(0) @map("line_total_with_tax") @db.Decimal(18, 2)
  priceListId      String? @map("price_list_id")
  productPriceId   String? @map("product_price_id")
  description      String?

  // Phase 6 additions (spec sections 15, 26-27, 40, 94)
  cancelledQuantity Decimal @default(0) @map("cancelled_quantity") @db.Decimal(18, 6)
  reservationPolicy String  @default("TRY_RESERVE") @map("reservation_policy")
  fulfillmentPolicy String  @default("ALLOW_PARTIAL") @map("fulfillment_policy")
  isService         Boolean @default(false) @map("is_service")
  warehouseId       String? @map("warehouse_id")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  tenant           Tenant             @relation(fields: [tenantId], references: [id])
  salesOrder       SalesOrder         @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product          Product            @relation(fields: [productId], references: [id])
  unit             UnitOfMeasure      @relation("SalesOrderLineUnit", fields: [unitId], references: [id])
  ShipmentPlanLine ShipmentPlanLine[]

  @@index([salesOrderId, position])
  @@index([tenantId, productId])
  @@map("sales_order_lines")
}

/// Sales Invoice — billing document, creatable standalone or based on a
/// SalesOrder (CreateBasedOn SALES_ORDER => SALES_INVOICE).
model SalesInvoice {
  id               String         @id @default(uuid())
  tenantId         String         @map("tenant_id")
  organizationId   String         @map("organization_id")
  counterpartyId   String         @map("counterparty_id")
  documentType     String         @default("SALES_INVOICE") @map("document_type")
  number           String?
  documentDate     DateTime       @map("document_date") @db.Date
  postingDate      DateTime?      @map("posting_date") @db.Date
  status           DocumentStatus @default(DRAFT)
  postingStatus    PostingStatus  @default(NOT_POSTED) @map("posting_status")
  currencyId       String?        @map("currency_id")
  exchangeRate     Decimal?       @map("exchange_rate") @db.Decimal(24, 10)
  subtotal         Decimal        @default(0) @db.Decimal(18, 2)
  taxTotal         Decimal        @default(0) @map("tax_total") @db.Decimal(18, 2)
  grandTotal       Decimal        @default(0) @map("grand_total") @db.Decimal(18, 2)
  priceIncludesTax Boolean        @default(false) @map("price_includes_tax")
  description      String?

  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by")
  postedAt     DateTime? @map("posted_at")
  postedBy     String?   @map("posted_by")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelledBy  String?   @map("cancelled_by")
  deletionMark Boolean   @default(false) @map("deletion_mark")
  version      Int       @default(1)

  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  organization Organization       @relation(fields: [organizationId], references: [id])
  counterparty Counterparty       @relation(fields: [counterpartyId], references: [id])
  currency     Currency?          @relation(fields: [currencyId], references: [id])
  lines        SalesInvoiceLine[]

  @@unique([tenantId, number])
  @@index([tenantId, documentDate])
  @@index([tenantId, status])
  @@index([organizationId, counterpartyId])
  @@map("sales_invoices")
}

model SalesInvoiceLine {
  id                String  @id @default(uuid())
  tenantId          String  @map("tenant_id")
  salesInvoiceId    String  @map("sales_invoice_id")
  position          Int     @default(0)
  productId         String  @map("product_id")
  unitId            String  @map("unit_id")
  quantity          Decimal @db.Decimal(18, 6)
  price             Decimal @db.Decimal(18, 6)
  lineTotal         Decimal @map("line_total") @db.Decimal(18, 2)
  taxRate           Decimal @default(0) @map("tax_rate") @db.Decimal(18, 2)
  taxAmount         Decimal @default(0) @map("tax_amount") @db.Decimal(18, 2)
  lineTotalWithTax  Decimal @default(0) @map("line_total_with_tax") @db.Decimal(18, 2)
  priceListId       String? @map("price_list_id")
  productPriceId    String? @map("product_price_id")
  sourceOrderLineId String? @map("source_order_line_id")
  description       String?

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  salesInvoice SalesInvoice  @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  product      Product       @relation(fields: [productId], references: [id])
  unit         UnitOfMeasure @relation("SalesInvoiceLineUnit", fields: [unitId], references: [id])

  @@index([salesInvoiceId, position])
  @@index([tenantId, productId])
  @@map("sales_invoice_lines")
}

// ============================================================================
// ACCOUNTING CORE — CHART OF ACCOUNTS & DOUBLE-ENTRY POSTING ENGINE
// (docx spec "Phase 4 — Accounting Core & Azerbaijan Chart of Accounts";
// named by content rather than a phase number here because this repo's own
// Phase 4 already means Sales Documents. See docs/ACCOUNTING_CORE.md.)
//
// Architecture: Business Document -> Posting Handler -> AccountingPostingBatch
// -> AccountingPostingEngine -> JournalEntry -> AccountingMovement -> GL.
// AccountingMovement is the only source of truth for balances — never a
// cached account.balance column (spec section 4).
// ============================================================================

/// System template (tenantId=null) vs a tenant's own adopted chart
/// (tenantId set) — spec section 7. Sections/Groups always hang off the
/// system template only (shared classification metadata); Accounts hang
/// off the tenant's adopted chart so each tenant can extend its own copy
/// without ever touching the template.
model ChartOfAccounts {
  id               String    @id @default(uuid())
  tenantId         String?   @map("tenant_id") // null = system template
  code             String
  name             String
  countryCode      String    @default("AZ") @map("country_code")
  localizationCode String    @default("AZ_STANDARD_COA") @map("localization_code")
  versionCode      String    @default("1.0") @map("version_code")
  validFrom        DateTime  @default(now()) @map("valid_from") @db.Date
  validTo          DateTime? @map("valid_to") @db.Date
  systemTemplate   Boolean   @default(false) @map("system_template")
  active           Boolean   @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  version   Int      @default(1)

  tenant         Tenant?                     @relation(fields: [tenantId], references: [id])
  sections       FinancialStatementSection[]
  accounts       Account[]
  Organization   Organization?               @relation(fields: [organizationId], references: [id])
  organizationId String?

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("charts_of_accounts")
}

/// Top-level reporting node (spec section 9) — never posting_allowed.
model FinancialStatementSection {
  id                String  @id @default(uuid())
  chartOfAccountsId String  @map("chart_of_accounts_id")
  code              String
  name              String
  sequence          Int     @default(0)
  statementType     String  @default("BALANCE_SHEET") @map("statement_type") // BALANCE_SHEET | INCOME_STATEMENT
  active            Boolean @default(true)

  chart    ChartOfAccounts           @relation(fields: [chartOfAccountsId], references: [id])
  groups   FinancialStatementGroup[]
  accounts Account[]

  @@unique([chartOfAccountsId, code])
  @@map("financial_statement_sections")
}

/// Second-level reporting node (spec section 10) — never posting_allowed.
model FinancialStatementGroup {
  id        String  @id @default(uuid())
  sectionId String  @map("section_id")
  code      String
  name      String
  sequence  Int     @default(0)
  active    Boolean @default(true)

  section  FinancialStatementSection @relation(fields: [sectionId], references: [id])
  accounts Account[]

  @@unique([sectionId, code])
  @@map("financial_statement_groups")
}

enum AccountClass {
  ASSET
  CONTRA_ASSET
  LIABILITY
  CONTRA_LIABILITY
  EQUITY
  CONTRA_EQUITY
  REVENUE
  CONTRA_REVENUE
  EXPENSE
  PROFIT_LOSS
  TAX_EXPENSE
  OFF_BALANCE
}

enum NormalBalance {
  DEBIT
  CREDIT
  BOTH
}

/// A posting-eligible or purely-structural ledger account (spec sections
/// 21-24, 79-82). Code is always a STRING (section 79) — 414-1, 205.01 etc
/// are valid and hierarchy is explicit via parentAccountId, never inferred
/// from code length/prefix (section 152).
model Account {
  id                          String        @id @default(uuid())
  tenantId                    String?       @map("tenant_id") // null = system template account (see ChartOfAccounts)
  organizationId              String?       @map("organization_id") // null = shared across the tenant's organizations
  chartOfAccountsId           String        @map("chart_of_accounts_id")
  parentAccountId             String?       @map("parent_account_id")
  financialStatementSectionId String?       @map("financial_statement_section_id")
  financialStatementGroupId   String?       @map("financial_statement_group_id")
  code                        String
  name                        String
  description                 String?
  accountClass                AccountClass  @map("account_class")
  normalBalance               NormalBalance @map("normal_balance")
  postingAllowed              Boolean       @default(true) @map("posting_allowed")
  offBalance                  Boolean       @default(false) @map("off_balance")
  currencyTracking            Boolean       @default(false) @map("currency_tracking")
  quantityTracking            Boolean       @default(false) @map("quantity_tracking")
  systemAccount               Boolean       @default(false) @map("system_account")
  customizable                Boolean       @default(true)
  active                      Boolean       @default(true)
  validFrom                   DateTime      @default(now()) @map("valid_from") @db.Date
  validTo                     DateTime?     @map("valid_to") @db.Date
  // Seed provenance (spec section 77) so upgrades never clobber org edits.
  sourceTemplate              String?       @default("AZ_STANDARD_COA") @map("source_template")
  templateVersion             String?       @map("template_version")
  systemSeed                  Boolean       @default(false) @map("system_seed")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  tenant       Tenant?                    @relation(fields: [tenantId], references: [id])
  organization Organization?              @relation(fields: [organizationId], references: [id])
  chart        ChartOfAccounts            @relation(fields: [chartOfAccountsId], references: [id])
  parent       Account?                   @relation("AccountHierarchy", fields: [parentAccountId], references: [id])
  children     Account[]                  @relation("AccountHierarchy")
  section      FinancialStatementSection? @relation(fields: [financialStatementSectionId], references: [id])
  group        FinancialStatementGroup?   @relation(fields: [financialStatementGroupId], references: [id])

  dimensionRules      AccountDimensionRule[]
  accountingMappings  AccountingMapping[]
  journalEntryLines   JournalEntryLine[]
  accountingMovements AccountingMovement[]

  @@unique([tenantId, chartOfAccountsId, code])
  @@index([tenantId, active])
  @@index([tenantId, parentAccountId])
  @@map("accounts")
}

/// Subconto definition (spec sections 25-26). Kept tenant-nullable (null =
/// system-defined, shared) following the ExchangeRate precedent elsewhere
/// in this schema for shared-vs-tenant rows.
model AccountingDimensionDefinition {
  id                  String  @id @default(uuid())
  tenantId            String? @map("tenant_id") // null = system-defined, shared
  code                String
  name                String
  valueType           String  @default("REFERENCE") @map("value_type") // REFERENCE | TEXT | NUMBER
  referenceEntityType String? @map("reference_entity_type") // e.g. PARTNER, WAREHOUSE, PRODUCT ...
  active              Boolean @default(true)
  systemDefined       Boolean @default(true) @map("system_defined")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  dimensionRules        AccountDimensionRule[]
  journalLineDimensions JournalLineDimension[]
  movementDimensions    AccountingMovementDimension[]

  @@unique([tenantId, code])
  @@map("accounting_dimension_definitions")
}

/// Which dimensions an Account requires/allows (spec section 27), kept
/// effective-dated so a rule added later never invalidates historical
/// entries (spec section 82).
model AccountDimensionRule {
  id                    String    @id @default(uuid())
  accountId             String    @map("account_id")
  dimensionDefinitionId String    @map("dimension_definition_id")
  required              Boolean   @default(true)
  sequence              Int       @default(0)
  balanceTracking       Boolean   @default(true) @map("balance_tracking")
  turnoverTracking      Boolean   @default(true) @map("turnover_tracking")
  quantityTracking      Boolean   @default(false) @map("quantity_tracking")
  validFrom             DateTime  @default(now()) @map("valid_from") @db.Date
  validTo               DateTime? @map("valid_to") @db.Date
  active                Boolean   @default(true)

  account   Account                       @relation(fields: [accountId], references: [id])
  dimension AccountingDimensionDefinition @relation(fields: [dimensionDefinitionId], references: [id])

  @@unique([accountId, dimensionDefinitionId, validFrom])
  @@map("account_dimension_rules")
}

/// Semantic mapping key -> Account (spec sections 39-43). Business modules
/// resolve e.g. "SALES_REVENUE" through here — never a literal account code
/// in code. organizationId=null means a tenant-wide default; a matching
/// organization-specific row takes precedence (see AccountingMappingService).
model AccountingMapping {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  organizationId String?   @map("organization_id")
  mappingKey     String    @map("mapping_key")
  accountId      String    @map("account_id")
  validFrom      DateTime  @default(now()) @map("valid_from") @db.Date
  validTo        DateTime? @map("valid_to") @db.Date
  priority       Int       @default(0)
  active         Boolean   @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  version   Int      @default(1)

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
  account      Account       @relation(fields: [accountId], references: [id])

  @@index([tenantId, organizationId, mappingKey, validFrom])
  @@map("accounting_mappings")
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  REVERSED
}

/// The accounting document/operation header (spec section 31). Status is
/// never edited directly by API (section 31) — only through post/unpost/
/// reverse commands on JournalEntryService / AccountingPostingEngine.
model JournalEntry {
  id                 String             @id @default(uuid())
  tenantId           String             @map("tenant_id")
  organizationId     String             @map("organization_id")
  journalNumber      String             @map("journal_number")
  businessDate       DateTime           @map("business_date") @db.Date
  postingDate        DateTime           @map("posting_date") @db.Date
  sourceDocumentType String?            @map("source_document_type")
  sourceDocumentId   String?            @map("source_document_id")
  operationType      String             @default("MANUAL") @map("operation_type") // MANUAL | OPENING_BALANCE | SYSTEM_DOCUMENT | REVERSAL | PERIOD_CLOSE
  generatedBy        String             @default("MANUAL_OPERATION") @map("generated_by")
  description        String?
  status             JournalEntryStatus @default(DRAFT)
  isManual           Boolean            @default(true) @map("is_manual")
  isOpeningBalance   Boolean            @default(false) @map("is_opening_balance")
  isReversal         Boolean            @default(false) @map("is_reversal")
  reversalOfEntryId  String?            @map("reversal_of_entry_id")
  generation         Int                @default(1)

  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  String?   @map("created_by")
  postedAt   DateTime? @map("posted_at")
  postedBy   String?   @map("posted_by")
  reversedAt DateTime? @map("reversed_at")
  reversedBy String?   @map("reversed_by")
  version    Int       @default(1)

  tenant            Tenant         @relation(fields: [tenantId], references: [id])
  organization      Organization   @relation(fields: [organizationId], references: [id])
  reversalOf        JournalEntry?  @relation("JournalEntryReversal", fields: [reversalOfEntryId], references: [id])
  reversedByEntries JournalEntry[] @relation("JournalEntryReversal")

  lines     JournalEntryLine[]
  movements AccountingMovement[]

  @@unique([tenantId, journalNumber])
  @@index([tenantId, organizationId, businessDate])
  @@index([tenantId, sourceDocumentType, sourceDocumentId])
  @@map("journal_entries")
}

enum EntrySide {
  DEBIT
  CREDIT
}

/// One debit-or-credit line of a JournalEntry (spec section 32) — a single
/// `side` + one positive amount, never separate debit/credit columns
/// (section 32 preference).
model JournalEntryLine {
  id                    String    @id @default(uuid())
  journalEntryId        String    @map("journal_entry_id")
  sequence              Int       @default(0)
  accountId             String    @map("account_id")
  side                  EntrySide
  amountBase            Decimal   @map("amount_base") @db.Decimal(20, 4)
  transactionCurrencyId String?   @map("transaction_currency_id")
  amountTransaction     Decimal?  @map("amount_transaction") @db.Decimal(20, 4)
  exchangeRate          Decimal?  @map("exchange_rate") @db.Decimal(20, 10)
  quantity              Decimal?  @db.Decimal(20, 6)
  quantityUnitId        String?   @map("quantity_unit_id")
  description           String?
  sourceDocumentLineId  String?   @map("source_document_line_id")

  createdAt DateTime @default(now()) @map("created_at")

  journalEntry JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account        @relation(fields: [accountId], references: [id])
  currency     Currency?      @relation(fields: [transactionCurrencyId], references: [id])
  quantityUnit UnitOfMeasure? @relation(fields: [quantityUnitId], references: [id])

  dimensions JournalLineDimension[]

  @@index([journalEntryId, sequence])
  @@index([accountId])
  @@map("journal_entry_lines")
}

/// Dimension value attached to a (still-mutable, pre-posting) journal line
/// (spec section 33). One dimension type per line, enforced by the unique
/// constraint.
model JournalLineDimension {
  id                    String  @id @default(uuid())
  journalLineId         String  @map("journal_line_id")
  dimensionDefinitionId String  @map("dimension_definition_id")
  referenceType         String  @map("reference_type")
  referenceId           String  @map("reference_id")
  scalarValue           String? @map("scalar_value")

  createdAt DateTime @default(now()) @map("created_at")

  line      JournalEntryLine              @relation(fields: [journalLineId], references: [id], onDelete: Cascade)
  dimension AccountingDimensionDefinition @relation(fields: [dimensionDefinitionId], references: [id])

  @@unique([journalLineId, dimensionDefinitionId])
  @@map("journal_line_dimensions")
}

/// Immutable posted register row (spec sections 34-36) — the single
/// authoritative source for every balance/turnover query. Never UPDATEd
/// once written; corrections only ever add new movements (reversal) or
/// happen via unpost+repost while the period is open.
model AccountingMovement {
  id                    String    @id @default(uuid())
  tenantId              String    @map("tenant_id")
  organizationId        String    @map("organization_id")
  journalEntryId        String    @map("journal_entry_id")
  journalLineId         String    @map("journal_line_id")
  sourceDocumentType    String?   @map("source_document_type")
  sourceDocumentId      String?   @map("source_document_id")
  sourceDocumentLineId  String?   @map("source_document_line_id")
  accountId             String    @map("account_id")
  side                  EntrySide
  businessDate          DateTime  @map("business_date") @db.Date
  postingTimestamp      DateTime  @default(now()) @map("posting_timestamp")
  // Native DB sequence (not app-computed) so deterministic ordering holds
  // under concurrent posting without a hand-rolled counter (spec section 65).
  postingSequence       BigInt    @default(autoincrement()) @map("posting_sequence")
  amountBase            Decimal   @map("amount_base") @db.Decimal(20, 4)
  transactionCurrencyId String?   @map("transaction_currency_id")
  amountTransaction     Decimal?  @map("amount_transaction") @db.Decimal(20, 4)
  exchangeRate          Decimal?  @map("exchange_rate") @db.Decimal(20, 10)
  quantity              Decimal?  @db.Decimal(20, 6)
  quantityUnitId        String?   @map("quantity_unit_id")
  reversalOfMovementId  String?   @map("reversal_of_movement_id")

  createdAt DateTime @default(now()) @map("created_at")

  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  organization        Organization         @relation(fields: [organizationId], references: [id])
  journalEntry        JournalEntry         @relation(fields: [journalEntryId], references: [id])
  account             Account              @relation(fields: [accountId], references: [id])
  currency            Currency?            @relation(fields: [transactionCurrencyId], references: [id])
  quantityUnit        UnitOfMeasure?       @relation(fields: [quantityUnitId], references: [id])
  reversalOf          AccountingMovement?  @relation("MovementReversal", fields: [reversalOfMovementId], references: [id])
  reversedByMovements AccountingMovement[] @relation("MovementReversal")

  dimensions AccountingMovementDimension[]

  @@index([tenantId, organizationId, businessDate])
  @@index([organizationId, accountId, businessDate])
  @@index([journalEntryId])
  @@index([tenantId, sourceDocumentType, sourceDocumentId])
  @@index([accountId, businessDate])
  @@map("accounting_movements")
}

/// Dimension value frozen onto a posted movement at posting time (spec
/// section 35) — deliberately separate from JournalLineDimension so the
/// posted register stays historically reproducible even if the (still
/// mutable, pre-posting) journal line dimensions were later changed via
/// unpost/repost.
model AccountingMovementDimension {
  id                    String  @id @default(uuid())
  accountingMovementId  String  @map("accounting_movement_id")
  dimensionDefinitionId String  @map("dimension_definition_id")
  referenceType         String  @map("reference_type")
  referenceId           String  @map("reference_id")
  scalarValue           String? @map("scalar_value")

  createdAt DateTime @default(now()) @map("created_at")

  movement  AccountingMovement            @relation(fields: [accountingMovementId], references: [id], onDelete: Cascade)
  dimension AccountingDimensionDefinition @relation(fields: [dimensionDefinitionId], references: [id])

  @@unique([accountingMovementId, dimensionDefinitionId])
  @@index([dimensionDefinitionId, referenceId])
  @@map("accounting_movement_dimensions")
}

/// Posting-generation history (spec section 92) — one row per post/repost
/// attempt for a source document, independent of the generic AuditEvent
/// stream so "what posting generations exist for this document" is a
/// direct query rather than an AuditEvent scan.
model PostingRun {
  id                 String    @id @default(uuid())
  tenantId           String    @map("tenant_id")
  organizationId     String    @map("organization_id")
  sourceDocumentType String    @map("source_document_type")
  sourceDocumentId   String    @map("source_document_id")
  generation         Int
  startedAt          DateTime  @default(now()) @map("started_at")
  completedAt        DateTime? @map("completed_at")
  status             String    @default("RUNNING") // RUNNING | SUCCEEDED | FAILED
  actor              String?
  correlationId      String?   @map("correlation_id")
  failureCode        String?   @map("failure_code")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([tenantId, sourceDocumentType, sourceDocumentId, generation])
  @@index([tenantId, sourceDocumentType, sourceDocumentId])
  @@map("posting_runs")
}

// ============================================================================
// TAX ENGINE — VERSION-AWARE, EFFECTIVE-DATED TAX RULES ENGINE
// (docx spec "Phase 5 — Tax Engine & Azerbaijan Localization Engine".)
//
// Architecture: TaxContext -> TaxRuleResolver -> TaxCalculationResult ->
// TaxRegisterService (writes TaxMovement) -> caller merges the returned
// AccountingPostingLine[] into its own AccountingPostingEngine.postBatch
// call so Tax Register + GL post atomically in ONE transaction (spec
// section 5/67) — the Tax Engine itself never writes AccountingMovement.
//
// TaxType/TaxRate/TaxRule/TaxCategory/TaxCode/TaxExemption/TaxLegalSource
// are modeled as SHARED system rows (tenantId=null) rather than per-tenant
// clones, unlike Accounting Core's Account — this is genuinely universal
// Azerbaijan tax law, not tenant-customizable data (spec section 146:
// "legal standard VAT rate may be system-defined"). Only TaxRegistration,
// ProductTaxProfile, CounterpartyTaxProfile and TaxMovement are
// tenant/organization data.
// ============================================================================

model TaxLegalSource {
  id              String    @id @default(uuid())
  jurisdiction    String    @default("AZ")
  sourceType      String // TAX_CODE | AMENDING_LAW | PRESIDENTIAL_DECREE | CABINET_RULE | TAX_AUTHORITY_GUIDANCE
  title           String
  sourceUrl       String    @map("source_url")
  lawNumber       String?   @map("law_number")
  adoptionDate    DateTime? @map("adoption_date") @db.Date
  publicationDate DateTime? @map("publication_date") @db.Date
  effectiveFrom   DateTime? @map("effective_from") @db.Date
  effectiveTo     DateTime? @map("effective_to") @db.Date
  sourceVersion   String    @default("1.0") @map("source_version")
  status          String    @default("ACTIVE") // ACTIVE | REPEALED | SUPERSEDED | DRAFT
  notes           String?

  createdAt DateTime @default(now()) @map("created_at")

  taxRates TaxRate[]
  taxRules TaxRule[]

  @@map("tax_legal_sources")
}

model TaxType {
  id          String  @id @default(uuid())
  code        String  @unique // VAT | CORPORATE_INCOME_TAX | ... (spec section 12)
  name        String
  description String?
  active      Boolean @default(true)

  taxRates      TaxRate[]
  taxRules      TaxRule[]
  taxCodes      TaxCode[]
  taxExemptions TaxExemption[]

  @@map("tax_types")
}

/// Distinct from TaxCode (spec section 90): a classification products/
/// transactions are tagged with; TaxRule + business date resolves the
/// actual treatment/rate for a given category.
model TaxCategory {
  id          String  @id @default(uuid())
  code        String  @unique // STANDARD_VAT | ZERO_RATED_EXPORT | VAT_EXEMPT | OUT_OF_SCOPE | ...
  name        String
  description String?
  active      Boolean @default(true)

  productProfiles ProductTaxProfile[]

  @@map("tax_categories")
}

/// Reporting/classification code, separate from TaxCategory (spec section 90).
model TaxCode {
  id          String    @id @default(uuid())
  taxTypeId   String    @map("tax_type_id")
  code        String
  name        String
  description String?
  validFrom   DateTime  @default(now()) @map("valid_from") @db.Date
  validTo     DateTime? @map("valid_to") @db.Date
  active      Boolean   @default(true)

  taxType TaxType @relation(fields: [taxTypeId], references: [id])

  @@unique([taxTypeId, code])
  @@map("tax_codes")
}

enum TaxRateType {
  STANDARD
  ZERO
  EXEMPT
  OUT_OF_SCOPE
  SPECIAL
}

model TaxRate {
  id                    String      @id @default(uuid())
  taxTypeId             String      @map("tax_type_id")
  jurisdiction          String      @default("AZ")
  code                  String
  rate                  Decimal     @db.Decimal(9, 4) // percentage, e.g. 18.0000
  rateType              TaxRateType @map("rate_type")
  effectiveFrom         DateTime    @map("effective_from") @db.Date
  effectiveTo           DateTime?   @map("effective_to") @db.Date
  legalSourceId         String?     @map("legal_source_id")
  legalArticleReference String?     @map("legal_article_reference")
  status                String      @default("ACTIVE") // ACTIVE | FUTURE_EFFECTIVE | EXPIRED | REPEALED | SUPERSEDED
  systemDefined         Boolean     @default(true) @map("system_defined")

  createdAt DateTime @default(now()) @map("created_at")
  version   Int      @default(1)

  taxType     TaxType         @relation(fields: [taxTypeId], references: [id])
  legalSource TaxLegalSource? @relation(fields: [legalSourceId], references: [id])
  taxRules    TaxRule[]

  @@unique([taxTypeId, jurisdiction, code, effectiveFrom])
  @@index([taxTypeId, jurisdiction, effectiveFrom])
  @@map("tax_rates")
}

enum TaxTreatment {
  STANDARD_RATE
  ZERO_RATED
  EXEMPT
  OUT_OF_SCOPE
  REVERSE_CHARGE
  SPECIAL_RATE
}

enum TaxRuleStatus {
  DRAFT
  REVIEWED
  APPROVED
  ACTIVE
  FUTURE_EFFECTIVE
  EXPIRED
  REPEALED
  SUPERSEDED
  INACTIVE
}

/// The first-class legal rule (spec section 6-9). Never destructively
/// edited when law changes — a new law-effective period always means a
/// NEW row, never mutating an existing one's dates/treatment in place
/// (spec section 8).
model TaxRule {
  id                       String        @id @default(uuid())
  tenantId                 String?       @map("tenant_id") // null = system localization rule
  localizationCode         String        @default("AZ_TAX") @map("localization_code")
  taxTypeId                String        @map("tax_type_id")
  code                     String
  name                     String
  description              String?
  ruleCategory             String        @map("rule_category") // STANDARD | ZERO_RATE | EXEMPT | OUT_OF_SCOPE | REVERSE_CHARGE
  effectiveFrom            DateTime      @map("effective_from") @db.Date
  effectiveTo              DateTime?     @map("effective_to") @db.Date
  status                   TaxRuleStatus @default(ACTIVE)
  priority                 Int           @default(0)
  legalSourceId            String?       @map("legal_source_id")
  legalArticleReference    String?       @map("legal_article_reference")
  legalSubarticleReference String?       @map("legal_subarticle_reference")
  calculationMethod        String        @default("PERCENTAGE_OF_BASE") @map("calculation_method")
  rateId                   String?       @map("rate_id")
  treatment                TaxTreatment
  exemptionCode            String?       @map("exemption_code")
  // Structured condition predicates (spec section 91 — never free-form
  // executable code): all populated fields must match the TaxContext for
  // this rule to be a candidate. Null/omitted means "matches any".
  conditionOperationType   String?       @map("condition_operation_type") // SALE | PURCHASE | null=any
  conditionTaxCategoryCode String?       @map("condition_tax_category_code")
  conditionTaxpayerSide    String?       @map("condition_taxpayer_side") // SELLER | BUYER | SELF_ASSESSED
  systemDefined            Boolean       @default(true) @map("system_defined")
  active                   Boolean       @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  version   Int      @default(1)

  tenant      Tenant?         @relation(fields: [tenantId], references: [id])
  taxType     TaxType         @relation(fields: [taxTypeId], references: [id])
  rate        TaxRate?        @relation(fields: [rateId], references: [id])
  legalSource TaxLegalSource? @relation(fields: [legalSourceId], references: [id])

  @@index([taxTypeId, localizationCode, effectiveFrom])
  @@index([tenantId])
  @@map("tax_rules")
}

model TaxExemption {
  id               String    @id @default(uuid())
  taxTypeId        String    @map("tax_type_id")
  code             String
  name             String
  description      String?
  legalSourceId    String?   @map("legal_source_id")
  articleReference String?   @map("article_reference")
  validFrom        DateTime  @default(now()) @map("valid_from") @db.Date
  validTo          DateTime? @map("valid_to") @db.Date
  status           String    @default("ACTIVE")

  taxType TaxType @relation(fields: [taxTypeId], references: [id])

  @@unique([taxTypeId, code])
  @@map("tax_exemptions")
}

/// Organization tax registration (spec sections 21-23) — effective-dated,
/// never a single boolean flag.
model TaxRegistration {
  id                 String    @id @default(uuid())
  tenantId           String    @map("tenant_id")
  organizationId     String    @map("organization_id")
  taxType            String    @map("tax_type") // TaxType.code
  registrationNumber String?   @map("registration_number")
  jurisdiction       String    @default("AZ")
  validFrom          DateTime  @map("valid_from") @db.Date
  validTo            DateTime? @map("valid_to") @db.Date
  status             String    @default("REGISTERED") // REGISTERED | NOT_REGISTERED | SUSPENDED
  legalBasis         String?   @map("legal_basis")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  version   Int      @default(1)

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([tenantId, organizationId, taxType, validFrom])
  @@map("tax_registrations")
}

/// Product tax classification (spec section 19) — effective-dated, never a
/// permanent single category on Product itself.
model ProductTaxProfile {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  productId      String    @map("product_id")
  organizationId String?   @map("organization_id")
  taxCategoryId  String    @map("tax_category_id")
  jurisdiction   String    @default("AZ")
  validFrom      DateTime  @default(now()) @map("valid_from") @db.Date
  validTo        DateTime? @map("valid_to") @db.Date
  active         Boolean   @default(true)

  createdAt DateTime @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  product      Product       @relation(fields: [productId], references: [id])
  taxCategory  TaxCategory   @relation(fields: [taxCategoryId], references: [id])
  Organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([productId, validFrom])
  @@map("product_tax_profiles")
}

/// Counterparty tax context (spec section 20) — deliberately minimal,
/// referencing Counterparty rather than duplicating its legal-identity
/// fields (taxId already lives on Counterparty from Phase 3).
model CounterpartyTaxProfile {
  id                String    @id @default(uuid())
  tenantId          String    @map("tenant_id")
  counterpartyId    String    @unique @map("counterparty_id")
  residency         String    @default("RESIDENT") // RESIDENT | NON_RESIDENT
  vatRegistered     Boolean   @default(false) @map("vat_registered")
  vatRegisteredFrom DateTime? @map("vat_registered_from") @db.Date
  specialTaxStatus  String?   @map("special_tax_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  counterparty Counterparty @relation(fields: [counterpartyId], references: [id])

  @@map("counterparty_tax_profiles")
}

enum TaxMovementDirection {
  OUTPUT
  INPUT
}

/// The Tax Register (spec sections 64-66) — an operational register
/// distinct from the GL, immutable once posted. `journalEntryId` gives the
/// mandatory drilldown (spec section 108): summary -> TaxMovement ->
/// source document -> Journal Entry.
model TaxMovement {
  id                   String               @id @default(uuid())
  tenantId             String               @map("tenant_id")
  organizationId       String               @map("organization_id")
  taxType              String               @map("tax_type")
  taxCode              String?              @map("tax_code")
  taxTreatment         TaxTreatment         @map("tax_treatment")
  sourceDocumentType   String?              @map("source_document_type")
  sourceDocumentId     String?              @map("source_document_id")
  sourceLineId         String?              @map("source_line_id")
  taxPointDate         DateTime             @map("tax_point_date") @db.Date
  reportingPeriod      String               @map("reporting_period") // "YYYY-MM"
  taxableBase          Decimal              @map("taxable_base") @db.Decimal(20, 4)
  taxAmount            Decimal              @map("tax_amount") @db.Decimal(20, 4)
  recoverableAmount    Decimal              @default(0) @map("recoverable_amount") @db.Decimal(20, 4)
  nonrecoverableAmount Decimal              @default(0) @map("nonrecoverable_amount") @db.Decimal(20, 4)
  currencyId           String?              @map("currency_id")
  baseCurrencyAmount   Decimal?             @map("base_currency_amount") @db.Decimal(20, 4)
  direction            TaxMovementDirection
  taxRuleId            String               @map("tax_rule_id")
  taxRateId            String?              @map("tax_rate_id")
  postingGeneration    Int                  @default(1) @map("posting_generation")
  journalEntryId       String?              @map("journal_entry_id")
  reversalOfMovementId String?              @map("reversal_of_movement_id")

  createdAt DateTime @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([tenantId, organizationId, taxPointDate])
  @@index([organizationId, taxType, reportingPeriod])
  @@index([tenantId, sourceDocumentType, sourceDocumentId])
  @@index([taxRuleId])
  @@map("tax_movements")
}

// ============================================================================
// SALES PRE-ORDER & ORDER MANAGEMENT (docx spec Phase 6)
//
// Request -> Offer -> (Sales)Order -> Reservation / Payment Schedule ->
// Shipment Plan. None of these create accounting consequences — no
// JournalEntry, no AccountingMovement, no TaxMovement — see
// docs/SALES_PREORDER.md. SalesOrder itself (Phase 0-4's existing model)
// plays the role of this spec's "CustomerOrder": its own extension above
// adds the multi-axis status fields this phase requires.
//
// Simplification disclosed in docs/SALES_PREORDER.md: the spec's
// Partner/Contract/Agreement/PriceType concepts are NOT modeled as
// separate entities here — Phase 3 as actually built stops at
// Counterparty + PriceList, and this phase reuses those directly rather
// than inventing parallel entities the rest of the codebase doesn't have.
// ============================================================================

model CustomerRequest {
  id                    String    @id @default(uuid())
  tenantId              String    @map("tenant_id")
  organizationId        String    @map("organization_id")
  documentType          String    @default("CUSTOMER_REQUEST") @map("document_type")
  number                String?
  documentDate          DateTime  @map("document_date") @db.Date
  counterpartyId        String    @map("counterparty_id")
  currencyId            String?   @map("currency_id")
  requestedDeliveryDate DateTime? @map("requested_delivery_date") @db.Date
  salesManagerId        String?   @map("sales_manager_id")
  sourceChannel         String?   @map("source_channel")
  status                String    @default("DRAFT")
  description           String?
  externalReference     String?   @map("external_reference")

  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String?   @map("created_by")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  updatedBy   String?   @map("updated_by")
  cancelledAt DateTime? @map("cancelled_at")
  cancelledBy String?   @map("cancelled_by")
  version     Int       @default(1)

  tenant       Tenant                @relation(fields: [tenantId], references: [id])
  organization Organization          @relation(fields: [organizationId], references: [id])
  counterparty Counterparty          @relation(fields: [counterpartyId], references: [id])
  currency     Currency?             @relation(fields: [currencyId], references: [id])
  salesManager ResponsiblePerson?    @relation(fields: [salesManagerId], references: [id])
  lines        CustomerRequestLine[]
  offers       CommercialOffer[]

  @@unique([tenantId, number])
  @@index([tenantId, documentDate])
  @@index([organizationId, counterpartyId])
  @@index([organizationId, status])
  @@map("customer_requests")
}

model CustomerRequestLine {
  id                    String    @id @default(uuid())
  tenantId              String    @map("tenant_id")
  customerRequestId     String    @map("customer_request_id")
  position              Int       @default(0)
  productId             String    @map("product_id")
  unitId                String    @map("unit_id")
  quantity              Decimal   @db.Decimal(18, 6)
  requestedPrice        Decimal?  @map("requested_price") @db.Decimal(18, 6)
  requestedDeliveryDate DateTime? @map("requested_delivery_date") @db.Date
  notes                 String?

  createdAt DateTime @default(now()) @map("created_at")

  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  customerRequest CustomerRequest @relation(fields: [customerRequestId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id])
  unit            UnitOfMeasure   @relation("CustomerRequestLineUnit", fields: [unitId], references: [id])

  @@index([customerRequestId, position])
  @@map("customer_request_lines")
}

model CommercialOffer {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  organizationId   String    @map("organization_id")
  documentType     String    @default("COMMERCIAL_OFFER") @map("document_type")
  number           String?
  documentDate     DateTime  @map("document_date") @db.Date
  validUntil       DateTime? @map("valid_until") @db.Date
  counterpartyId   String    @map("counterparty_id")
  currencyId       String?   @map("currency_id")
  priceIncludesTax Boolean   @default(false) @map("price_includes_tax")
  status           String    @default("DRAFT")
  subtotal         Decimal   @default(0) @db.Decimal(18, 2)
  taxTotal         Decimal   @default(0) @map("tax_total") @db.Decimal(18, 2)
  grandTotal       Decimal   @default(0) @map("grand_total") @db.Decimal(18, 2)
  description      String?
  sourceRequestId  String?   @map("source_request_id")

  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String?   @map("created_by")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  updatedBy   String?   @map("updated_by")
  sentAt      DateTime? @map("sent_at")
  acceptedAt  DateTime? @map("accepted_at")
  rejectedAt  DateTime? @map("rejected_at")
  cancelledAt DateTime? @map("cancelled_at")
  version     Int       @default(1)

  tenant        Tenant                @relation(fields: [tenantId], references: [id])
  organization  Organization          @relation(fields: [organizationId], references: [id])
  counterparty  Counterparty          @relation(fields: [counterpartyId], references: [id])
  currency      Currency?             @relation(fields: [currencyId], references: [id])
  sourceRequest CustomerRequest?      @relation(fields: [sourceRequestId], references: [id])
  lines         CommercialOfferLine[]
  ordersCreated SalesOrder[]

  @@unique([tenantId, number])
  @@index([tenantId, documentDate])
  @@index([organizationId, counterpartyId])
  @@index([organizationId, status])
  @@map("commercial_offers")
}

model CommercialOfferLine {
  id                   String    @id @default(uuid())
  tenantId             String    @map("tenant_id")
  commercialOfferId    String    @map("commercial_offer_id")
  position             Int       @default(0)
  productId            String    @map("product_id")
  unitId               String    @map("unit_id")
  quantity             Decimal   @db.Decimal(18, 6)
  price                Decimal   @db.Decimal(18, 6)
  discountPercent      Decimal?  @map("discount_percent") @db.Decimal(9, 4)
  discountAmount       Decimal?  @map("discount_amount") @db.Decimal(18, 2)
  lineTotal            Decimal   @map("line_total") @db.Decimal(18, 2)
  taxRate              Decimal   @default(0) @map("tax_rate") @db.Decimal(18, 2)
  taxAmount            Decimal   @default(0) @map("tax_amount") @db.Decimal(18, 2)
  lineTotalWithTax     Decimal   @default(0) @map("line_total_with_tax") @db.Decimal(18, 2)
  priceListId          String?   @map("price_list_id")
  productPriceId       String?   @map("product_price_id")
  expectedDeliveryDate DateTime? @map("expected_delivery_date") @db.Date
  description          String?

  createdAt DateTime @default(now()) @map("created_at")
  version   Int      @default(1)

  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  commercialOffer CommercialOffer @relation(fields: [commercialOfferId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id])
  unit            UnitOfMeasure   @relation("CommercialOfferLineUnit", fields: [unitId], references: [id])

  @@index([commercialOfferId, position])
  @@map("commercial_offer_lines")
}

/// Generic line-level execution link (spec sections 29-30, 128) — how much
/// of one document's line has flowed into another. Used today for
/// Offer->Order line provenance; Phase 7 reuses this same table for
/// Order->Shipment without any schema change here.
model DocumentLineLink {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  sourceDocumentType String   @map("source_document_type")
  sourceDocumentId   String   @map("source_document_id")
  sourceLineId       String   @map("source_line_id")
  targetDocumentType String   @map("target_document_type")
  targetDocumentId   String   @map("target_document_id")
  targetLineId       String   @map("target_line_id")
  quantity           Decimal  @db.Decimal(18, 6)
  amount             Decimal? @db.Decimal(18, 2)
  relationType       String   @map("relation_type")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, sourceDocumentType, sourceDocumentId, sourceLineId])
  @@index([tenantId, targetDocumentType, targetDocumentId])
  @@map("document_line_links")
}

/// A planning/commitment object — NOT inventory issue (spec sections 37-42).
/// No StockMovement, no physical quantity change. availableQuantity in
/// this build is a placeholder (see docs/SALES_PREORDER.md) since no
/// Inventory module (Phase 10) exists yet to source real physical stock.
model StockReservation {
  id                 String    @id @default(uuid())
  tenantId           String    @map("tenant_id")
  organizationId     String    @map("organization_id")
  sourceDocumentType String    @map("source_document_type")
  sourceDocumentId   String    @map("source_document_id")
  sourceLineId       String    @map("source_line_id")
  productId          String    @map("product_id")
  warehouseId        String    @map("warehouse_id")
  quantity           Decimal   @db.Decimal(18, 6)
  status             String    @default("ACTIVE")
  reservationDate    DateTime  @default(now()) @map("reservation_date")
  validUntil         DateTime? @map("valid_until")

  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  String?   @map("created_by")
  releasedAt DateTime? @map("released_at")
  releasedBy String?   @map("released_by")
  version    Int       @default(1)

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id])

  @@index([tenantId, organizationId, productId, warehouseId, status])
  @@index([tenantId, sourceDocumentType, sourceDocumentId, sourceLineId])
  @@map("stock_reservations")
}

model ShipmentPlan {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  organizationId  String   @map("organization_id")
  salesOrderId    String   @map("sales_order_id")
  plannedDate     DateTime @map("planned_date") @db.Date
  warehouseId     String?  @map("warehouse_id")
  deliveryAddress String?  @map("delivery_address")
  carrier         String?
  status          String   @default("DRAFT")
  notes           String?

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
  version   Int      @default(1)

  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  organization Organization       @relation(fields: [organizationId], references: [id])
  salesOrder   SalesOrder         @relation(fields: [salesOrderId], references: [id])
  warehouse    Warehouse?         @relation(fields: [warehouseId], references: [id])
  lines        ShipmentPlanLine[]

  @@index([tenantId, salesOrderId])
  @@map("shipment_plans")
}

model ShipmentPlanLine {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  shipmentPlanId   String    @map("shipment_plan_id")
  salesOrderLineId String    @map("sales_order_line_id")
  plannedQuantity  Decimal   @map("planned_quantity") @db.Decimal(18, 6)
  warehouseId      String?   @map("warehouse_id")
  plannedDate      DateTime? @map("planned_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at")

  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  shipmentPlan   ShipmentPlan   @relation(fields: [shipmentPlanId], references: [id], onDelete: Cascade)
  salesOrderLine SalesOrderLine @relation(fields: [salesOrderLineId], references: [id])

  @@index([shipmentPlanId])
  @@index([salesOrderLineId])
  @@map("shipment_plan_lines")
}

model OrderPaymentSchedule {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  salesOrderId String   @map("sales_order_id")
  sequence     Int      @default(0)
  dueDate      DateTime @map("due_date") @db.Date
  percentage   Decimal? @db.Decimal(9, 4)
  amount       Decimal  @db.Decimal(18, 2)
  currencyId   String?  @map("currency_id")
  scheduleType String   @default("INSTALLMENT") @map("schedule_type")
  status       String   @default("PLANNED")

  createdAt DateTime @default(now()) @map("created_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  currency   Currency?  @relation(fields: [currencyId], references: [id])

  @@index([salesOrderId, sequence])
  @@map("order_payment_schedules")
}

/// Structured hold (spec sections 85-87) rather than encoding the reason
/// only in a comment. Multiple holds may coexist; the order is actionable
/// only once every ACTIVE hold is RELEASED.
model OrderHold {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  salesOrderId String    @map("sales_order_id")
  holdType     String    @map("hold_type") // CREDIT | CUSTOMER_REQUEST | STOCK | MANUAL | APPROVAL
  reason       String?
  status       String    @default("ACTIVE")
  placedAt     DateTime  @default(now()) @map("placed_at")
  placedBy     String?   @map("placed_by")
  releasedAt   DateTime? @map("released_at")
  releasedBy   String?   @map("released_by")

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@index([salesOrderId, status])
  @@map("order_holds")
}
