  createdAt DateTime @default(now()) @map("created_at")

  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  organization    Organization    @relation(fields: [organizationId], references: [id])
  financialPeriod FinancialPeriod @relation(fields: [financialPeriodId], references: [id])
  currency        Currency        @relation(fields: [currencyId], references: [id])

  @@index([tenantId, organizationId, financialPeriodId, status])
}

model DeferredRevenueSchedule {
  id                   String    @id @default(uuid())
  tenantId             String    @map("tenant_id")
  organizationId       String    @map("organization_id")
  sourceDocumentType   String    @map("source_document_type")
  sourceDocumentId     String    @map("source_document_id")
  counterpartyId       String?   @map("counterparty_id")
  totalAmount          Decimal   @map("total_amount") @db.Decimal(18, 6)
  recognizedAmount     Decimal   @default(0) @map("recognized_amount") @db.Decimal(18, 6)
